standaloneModules.worldActions = ((function()
type Object = { Name: unknown, Parent: { Name: unknown }, CanTouch: unknown }
type Cell = { value: unknown }
type Traversal = { getDescendants: (unknown) -> { Object }, root: Cell }
type Cleanup = { getDescendants: (unknown) -> { Object }, root: Cell, remove: (Object) -> () }

local function barriers(bindings: Cleanup)
    local remove = bindings.remove
    local getDescendants = bindings.getDescendants
    local root = bindings.root

    return function()
        local objects = getDescendants(root.value)

        for index = 1, #objects do
            local object = objects[index]
            local name = object.Name

            if name ~= "InvisWall" and name ~= "GlitchProof" then
                continue
            end

            remove(object)
        end
    end
end

local function footsteps(bindings: Cleanup, settings: { DisableFootstepsPerk: unknown })
    local remove = bindings.remove
    local getDescendants = bindings.getDescendants
    local root = bindings.root

    return function(enabled: unknown)
        settings.DisableFootstepsPerk = enabled

        if not enabled then
            return
        end

        local objects = getDescendants(root.value)

        for index = 1, #objects do
            local object = objects[index]

            if object.Name == "Footsteps" then
                remove(object)
            end
        end
    end
end

local function scanner(bindings: Traversal, settings: { Map: unknown, DisableBankScanner: unknown })
    local getDescendants = bindings.getDescendants
    local root = bindings.root

    return function(enabled: unknown)
        settings.DisableBankScanner = enabled

        if not settings.Map then
            return
        end

        local objects = getDescendants(root.value)

        for index = 1, #objects do
            local object = objects[index]

            if object.Name ~= "Sensor" or object.Parent.Name ~= "MetalDetector" then
                continue
            end

            object.CanTouch = not enabled
            return
        end
    end
end

local function respawn(findChild: (unknown, string) -> { ResetOnSpawn: unknown }?, parent: unknown)
    return function(enabled: unknown)
        local gui = findChild(parent, "MainGUI")

        if not gui then
            return
        end

        gui.ResetOnSpawn = not enabled
    end
end

local function shadows(lighting: { value: { GlobalShadows: unknown } })
    return function(enabled: unknown)
        lighting.value.GlobalShadows = not enabled
    end
end

return { barriers = barriers, footsteps = footsteps, scanner = scanner, respawn = respawn, shadows = shadows }
end)())

