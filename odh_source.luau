standaloneModules.createBombActivation = ((function()
type Values = { [string]: any }
type Bindings = {
    state: Values,
    getReady: () -> unknown,
    setReady: (unknown) -> (),
    getMouse: () -> Values,
    getHandle: () -> Values,
    getCharacter: () -> unknown,
    getRoot: () -> Values,
    getCamera: () -> Values,
    vector: (...number) -> any,
    frame: (...number) -> unknown,
    fire: (unknown, unknown, number) -> (),
    getRemote: () -> unknown,
    wait: (number) -> (),
}

return function(bindings: Bindings)
    return function()
        if not bindings.getReady() then return end
        local mouse = bindings.getMouse()
        local handle = bindings.getHandle()
        handle.Transparency = 1
        mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
        bindings.setReady(nil)
        local position: unknown
        if bindings.state.FakeBombClutch then
            if not bindings.getCharacter() then return end
            local root = bindings.getRoot()
            if not root then return end
            local direction = bindings.getCamera().CFrame.LookVector
            local origin = root.Position + direction * 5
            local cross = origin.Cross
            local right = cross(bindings.vector(0, 1, 0), direction)
            local up = cross(direction, right)
            position = bindings.frame(origin.X, origin.Y, origin.Z,
                right.X, up.X, direction.X, right.Y, up.Y, direction.Y, right.Z, up.Z, direction.Z)
        else
            position = mouse.Hit
        end
        bindings.fire(bindings.getRemote(), position, 50)
        bindings.wait(22)
        handle.Transparency = 0
        mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
        bindings.setReady(true)
    end
end
end)() :: unknown)

