standaloneModules.createGameHelpers = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = { state: Values, getChildren: (unknown) -> { Values } }

return function(bindings: Bindings)
    local state = bindings.state
    local rolesData: Cell = { value = nil }
    local getChildren = bindings.getChildren

    local function findWeapon(player: Values, name: string): unknown
        local character = player.Character
        if not character then return nil end
        for _, child in getChildren(character) do
            if child.Name == name and child.ClassName == "Tool" then return child end
        end
        for _, child in getChildren(player.Backpack) do
            if child.Name == name and child.ClassName == "Tool" then return child end
        end
        return nil
    end

    state.is_alive = function(name: unknown): boolean?
        local roles = rolesData.value :: Values?
        if not roles then return nil end
        local data = roles[name :: string] :: Values?
        if not data then return nil end
        if data.Dead then return not data.Dead end
        return not data.Killed
    end
    state.find_gun = function(player: Values): unknown return findWeapon(player, "Gun") end
    state.find_knife = function(player: Values): unknown return findWeapon(player, "Knife") end
    return { rolesData = rolesData }
end
end)() :: unknown)

standaloneModules.simulateGamePrediction = ((function()
type Values = { [string]: any }

local function colliders(parts, character, localCharacter, probes, isDescendant)
    local result, hasTruss = {}, nil
    for _, part in parts do
        if part == probes[1] or part == probes[2] or part == probes[3] then continue end
        if isDescendant(part, character) then continue end
        if localCharacter and isDescendant(part, localCharacter) then continue end
        if not part.CanCollide then continue end
        result[#result + 1] = part
        if part.ClassName == "TrussPart" then hasTruss = true end
    end
    return result, hasTruss
end

local function flatBlock(part, block)
    if part.ClassName ~= "Part" or part.Shape ~= block then return false end
    local orientation = part.Orientation
    local x, z = math.abs(orientation.X), math.abs(orientation.Z)
    return (x == 0 or x == 180) and (z == 0 or z == 180)
end

local function groundHeight(parts, position, rotation, api)
    local highest = nil
    for _, part in parts do
        if flatBlock(part, api.block) then
            local height = part.Position.Y + part.Size.Y / 2
            if height < position.Y - 1 and (not highest or highest < height) then
                highest = height
                continue
            end
        end

        local params = api.params()
        params.FilterDescendantsInstances = { part }
        params.FilterType = api.include
        local origin = api.frame(api.vector(position.X, position.Y - 1, position.Z)) * rotation
        local hit = api.blockcast(api.workspace, origin, api.thinSize, api.vector(0, -2, 0), params)
        if hit and (not highest or highest < hit.Position.Y) then highest = hit.Position.Y end
    end
    return highest
end

local function ceilingHeight(parts, position, rotation, api)
    local lowest = nil
    for _, part in parts do
        if flatBlock(part, api.block) then
            local height = part.Position.Y - part.Size.Y / 2
            if position.Y + 1.9 < height and (not lowest or height < lowest) then
                lowest = height
                continue
            end
        end

        local params = api.params()
        params.FilterDescendantsInstances = { part }
        params.FilterType = api.include
        local origin = api.frame(api.vector(position.X, position.Y - 2, position.Z)) * rotation
        local hit = api.blockcast(api.workspace, origin, api.thinSize, api.vector(0, 1, 0), params)
        if hit and (not lowest or hit.Position.Y < lowest) then lowest = hit.Position.Y end
    end
    return lowest
end

local function accelerateAxis(value, direction, unitDirection, acceleration, interval)
    local target = direction * 16
    local amount = acceleration * math.abs(if direction == 0 then unitDirection else direction) * interval
    if target < value then return math.max(target, value - amount) end
    if value < target then return math.min(target, value + amount) end
    return target
end

return function(bindings: Values, character, localCharacter, root, humanoid, hand, mode)
    local api = bindings.simulation
    local vector, frame = bindings.vector, api.frame
    local settings, prefix = bindings.state, mode .. "Settings_"
    local predictJump, maximumTime = settings[prefix .. "PredictJump"], settings[prefix .. "MaxSimulationTime"]
    local ping, offset = settings[prefix .. "Ping"], settings[prefix .. "PositionOffset"]
    local predictLag, interval = settings[prefix .. "PredictLag"], settings[prefix .. "PredictionInterval"]
    local horizontalMultiplier = settings[prefix .. "PredictionHorizontalMultiplier"]
    local verticalMultiplier = settings[prefix .. "PredictionVerticalMultiplier"]
    if not (interval > 0 and interval < math.huge) then return nil end

    local startedAt = api.clock()
    local position, velocity = root.Position, root.Velocity
    local direction, destination = humanoid.MoveDirection, humanoid.WalkToPoint
    local handPosition = hand.Position
    local rotation = api.angles(0, root.Orientation.Y * 0.017453292519943295, 0)
    local horizontal = vector(1, 0, 1)
    local lowerOffset, upperOffset = vector(0, 2, 0), vector(0, 1.5, 0)
    local castOffset = vector(0, 1.001, 0)
    local probes = { api.create("Part"), api.create("Part"), api.create("Part") }
    local params = api.params()
    for index, probe in probes do
        local shifts = { -lowerOffset, vector(0, 0, 0), upperOffset }
        probe.Name = "\n"
        probe.Transparency = 1
        probe.Size = vector(2, 2, 1)
        probe.CFrame = frame(position + shifts[index]) * rotation
        probe.Anchored = true
        probe.Parent = api.workspace
    end
    params.FilterDescendantsInstances = { probes[1], probes[2], probes[3], character, localCharacter }
    params.FilterType = api.exclude
    if direction == vector(0, 0, 0) and destination ~= vector(0, 0, 0) then
        direction = frame(position * horizontal, destination * horizontal).LookVector
    end

    local floor = api.workspace.FallenPartsDestroyHeight
    local blockcast, touching = api.blockcast, probes[1].GetTouchingParts
    local handHorizontal = api.vector2(handPosition.X, handPosition.Z)
    local context = table.clone(api)
    context.vector, context.thinSize = vector, vector(2, 0.002, 1)
    local elapsed, acceleration, step = 0, 750, interval
    local distance, elevation, previous

    local function moveProbes(target)
        probes[1].Position = target - lowerOffset
        probes[2].Position = target
        probes[3].Position = target + upperOffset
    end

    local function contacts(probe)
        return colliders(touching(probe), character, localCharacter, probes, api.isDescendant)
    end

    local function run()
        while true do
            local now = api.clock()
            local lag = if predictLag then now - startedAt else 0
            local adjusted = position + offset
            distance = (api.vector2(adjusted.X, adjusted.Z) - handHorizontal).Magnitude
            elevation = math.atan((adjusted.Y - handPosition.Y) / distance)
            local duration = ping / 1000 + lag
            step = if duration - elapsed <= step then duration - elapsed else interval
            previous = adjusted - offset
            if duration <= elapsed or maximumTime <= elapsed or previous.Y <= floor then break end

            if destination ~= vector(0, 0, 0) then
                direction = frame(root.Position * horizontal, destination * horizontal).LookVector
            end
            local dx, dz = direction.X, direction.Z
            position = previous + vector(
                (velocity.X * step + acceleration * dx * step ^ 2 / 2) * horizontalMultiplier,
                (velocity.Y * step - 196.2 * step ^ 2 / 2) * verticalMultiplier,
                (velocity.Z * step + acceleration * dz * step ^ 2 / 2) * horizontalMultiplier)

            local nextX = accelerateAxis(velocity.X, dx, velocity.Unit.X, acceleration, step)
            local afterX = vector(nextX, velocity.Y, velocity.Z)
            local nextZ = accelerateAxis(afterX.Z, dz, afterX.Unit.Z, acceleration, step)
            velocity = vector(afterX.X, afterX.Y, nextZ) - vector(0, 196.2 * step, 0)

            local bottom = blockcast(api.workspace, frame(previous - castOffset) * rotation,
                context.thinSize, (previous - castOffset) - (position - castOffset), params)
            local top = blockcast(api.workspace, frame(previous + castOffset) * rotation,
                context.thinSize, (previous + castOffset) - (position + castOffset), params)
            if bottom and bottom.Position.Y <= previous.Y then
                position = vector(position.X, bottom.Position.Y + 3, position.Z)
            elseif top and previous.Y <= top.Position.Y then
                position = vector(position.X, top.Position.Y - 2, position.Z)
            end

            moveProbes(position)
            local middleParts, onTruss = contacts(probes[2])
            if #middleParts > 0 then
                if onTruss then
                    velocity = vector(0, 16, 0)
                else
                    local movement = frame(previous, position).LookVector.Unit
                    position += vector(-movement.X, 0, 0)
                    moveProbes(position)
                    if #contacts(probes[2]) > 0 then
                        position += vector(movement.X, 0, -movement.Z)
                        moveProbes(position)
                        if #contacts(probes[2]) > 0 then position = previous end
                    end
                end
            end

            moveProbes(position)
            local lowerParts, lowerTruss = contacts(probes[1])
            if not lowerTruss and #lowerParts > 0 and velocity.Y <= step then
                local ground = groundHeight(lowerParts, position, rotation, context)
                acceleration = 142
                if ground then
                    position = vector(position.X, ground + 3, position.Z)
                    velocity *= horizontal
                    acceleration = 750
                    if predictJump and humanoid.Jump then velocity = vector(velocity.X, 50, velocity.Z) end
                end
            end

            moveProbes(position)
            local upperParts, upperTruss = contacts(probes[3])
            if not upperTruss and #upperParts > 0 and -step <= velocity.Y then
                local ceiling = ceilingHeight(lowerParts, position, rotation, context)
                if ceiling then
                    position = vector(position.X, ceiling - 2, position.Z)
                    velocity *= vector(1, -1, 1)
                end
            end
            if #lowerParts == 0 and #upperParts == 0 then acceleration = 142 end
            elapsed += step
        end
        local result = previous + offset
        return vector(result.X, distance * math.tan(elevation) + handPosition.Y, result.Z)
    end

    local ok, result = pcall(run)
    for _, probe in probes do api.destroy(probe) end
    if not ok then error(result, 0) end
    return result
end
end)())


standaloneModules.createGamePrediction = ((function()
local simulate = standaloneModules.simulateGamePrediction
type Values = { [string]: any }
type Bindings = {
    state: Values,
    owner: Values,
    getLocalCharacter: () -> unknown,
    find: (unknown, string) -> Values?,
    raycast: (unknown, unknown) -> Values?,
    vector: (number, number, number) -> any,
    simulation: Values,
}

local function horizontal(value: number, adjustment: number): number
    if value > 0 then return value + (adjustment + 0.075) end
    if value < 0 then return value - (adjustment - 0.075) end
    return value
end

local function vertical(value: number, adjustment: number): number
    if value > 0 then return value + adjustment end
    if value < 0 then return value - adjustment end
    return value
end

local function electroVertical(value: number): number
    if value > 1 then return value - 0.15 end
    if value < -1 then return value + 0.15 end
    if value > 0 then return value + 0.05 end
    if value < 0 then return value - 0.05 end
    return value
end

local function calculate(root: Values, humanoid: Values, position: any, mode: unknown, bindings: Bindings): unknown
    local velocity = root.Velocity
    if not (0.19 < velocity.Magnitude) then
        return position + humanoid.MoveDirection * 0.2
    end

    local direction = velocity.Unit
    local vector = bindings.vector
    if mode == "Remi" then
        local scaled = direction * 2.225
        local adjustment = bindings.owner.Ping / 2500
        local x = horizontal(scaled.X, adjustment)
        local y = vertical(scaled.Y - 0.5, adjustment)
        local z = horizontal(scaled.Z, adjustment)
        return position + vector(x, y, z) + humanoid.MoveDirection * 0.8
    end
    if mode == "Ubuntu" or mode == "Rectum" then
        local scaled = direction * (1.8 + bindings.owner.Ping / 15000)
        return position + vector(scaled.X, math.clamp(scaled.Y, -1.8, 1.8), scaled.Z) + humanoid.MoveDirection * 0.7
    end
    if mode == "Electro" then
        local scaled = direction * 2.05
        return position + vector(scaled.X, electroVertical(scaled.Y), scaled.Z) + humanoid.MoveDirection * (0.9 + bindings.owner.Ping / 1500)
    end
    if mode == "Tiāncái" then
        local movement = root.AssemblyLinearVelocity.Unit * velocity.Magnitude / 17 + humanoid.MoveDirection
        return position + vector(movement.X, math.clamp(movement.Y, -2, 2.5), movement.Z) * bindings.state.TiancaiSettings_Offset
    end
    return nil
end

return function(bindings: Bindings)
    local state = bindings.state
    local find = bindings.find

    return function(player: Values, mode: unknown, skipWall: unknown): unknown
        local character = player.Character
        local localCharacter = bindings.getLocalCharacter()
        if not character or not localCharacter then return nil end
        local root = find(character, "HumanoidRootPart")
        if not root then return nil end
        local humanoid = find(character, "Humanoid")
        if not humanoid then return nil end
        local position = root.Position

        local prediction
        if mode == "Revert" or mode == "Flux" then
            local hand = find(localCharacter, "RightHand")
            if not hand then return nil end
            prediction = simulate(bindings, character, localCharacter, root, humanoid, hand, mode)
        else
            prediction = calculate(root, humanoid, position, mode, bindings)
        end
        if not prediction then return nil end
        if skipWall or not state.PredictionWallCheck then return prediction end
        local hand = find(localCharacter, "RightHand")
        if not hand then return nil end
        local origin = hand.Position
        local hit = bindings.raycast(origin, (position - origin).Unit * 500)
        if not hit or not hit.Instance then return nil end
        local instance: any = hit.Instance
        if instance == character or instance.Parent == character or instance.Parent.Parent == character then return prediction end
        return nil
    end
end
end)() :: unknown)

