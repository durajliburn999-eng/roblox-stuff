standaloneModules.setupMmvRoleEvent = ((function()
local refreshRound = standaloneModules.refreshMmvRound
local createRolesNotifier = standaloneModules.createRolesNotifier
local resolveRole = standaloneModules.resolveMmvRole
local findRoleSelector = standaloneModules.findMmvRoleSelector
local presentRole = standaloneModules.presentMmvRole
local exposeRoles = standaloneModules.exposeMmvRoles

type Values = { [string]: any }
type Bindings = { state: Values, owner: Values, playerName: string, playerGui: unknown, find: unknown,
    label: unknown, chanceRemote: unknown, invoke: unknown, clock: unknown, send: unknown,
    join: unknown, format: unknown, wait: unknown, signal: unknown, connect: (unknown, unknown) -> unknown }
local refresh = (refreshRound :: unknown) :: (Values, (...unknown) -> (), unknown) -> ()
local makeNotifier = (createRolesNotifier :: unknown) :: (Values) -> (number, number, unknown) -> ()
local selectRole = (resolveRole :: unknown) :: (unknown, string) -> (boolean, unknown)
local findSelector = (findRoleSelector :: unknown) :: (unknown, (unknown, string) -> unknown) -> unknown
local showRole = (presentRole :: unknown) :: (Values) -> ()
local expose = (exposeRoles :: unknown) :: (Values) -> ()

return function(bindings: Bindings): Values
    local payload = {}
    local notify = bindings.owner.Notify
    local format = bindings.format :: (string, ...unknown) -> unknown
    local wait = bindings.wait :: () -> ()
    local playerName = bindings.playerName
    local playerGui = bindings.playerGui
    local find = bindings.find :: (unknown, string) -> unknown
    local clock, invoke = bindings.clock, bindings.invoke
    local send = bindings.send
    local label, chanceRemote = bindings.label, bindings.chanceRemote
    local worker = coroutine.create(function(values: { unknown })
        local roles = bindings.state.roles
        local capturedRoles = { Murderers = roles.Murderers, Sheriffs = roles.Sheriffs, Hero = false }
        local refreshRoles = bindings.state.refresh_roles
        local roleColors = bindings.state.role_colors
        local notifyRoles = makeNotifier({ join = { value = bindings.join }, notify = { value = notify },
            format = { value = bindings.format }, state = { roles = capturedRoles } })
        while true do
            refresh(bindings.state, refreshRoles, values[1])
            local hero = roles.Hero
            local perks = roles.MurderersPerk
            local murdererCount, sheriffCount = #capturedRoles.Murderers, #capturedRoles.Sheriffs
            if bindings.state.AutoFarm and bindings.state.AFKFarmMode then
                repeat wait() until bindings.state.Map
            end
            if bindings.state.AutoNotifyRoles then notifyRoles(murdererCount, sheriffCount, hero) end
            if bindings.state.AutoNotifyMurdererPerk and murdererCount == 1 then
                notify(format('<font color="rgb(0, 255, 0)">%*</font> is using <font color="rgb(255, 0, 0)">%*</font> Perk.',
                    capturedRoles.Murderers[1], perks[1]))
            end
            if bindings.state.AutoExposeRoles then
                expose({ murderers = capturedRoles.Murderers, sheriffs = capturedRoles.Sheriffs,
                    murdererCount = murdererCount, sheriffCount = sheriffCount, hero = hero, send = send })
            end
            if bindings.state.AutoExposeMurdererPerk and murdererCount == 1 then
                send(format("%* is using %* Perk.", capturedRoles.Murderers[1], perks[1]))
            end
            local hasRole, role = selectRole(values[1], playerName)
            if hasRole then
                local title = findSelector(playerGui, find)
                if title then
                    showRole({ title = title, label = label, state = bindings.state, role = role, colors = roleColors,
                        chanceRemote = chanceRemote, invoke = invoke, format = format, clock = clock, wait = wait })
                end
            end
            values = coroutine.yield()
        end
    end)
    local function onRole(role: unknown)
        payload[1] = role
        coroutine.resume(worker, payload)
    end
    local connection = bindings.connect(bindings.signal, onRole)
    return { worker = worker, callback = onRole, connection = connection }
end
end)() :: unknown)

standaloneModules.setupGameWorld = ((function()
local removeWorldObject = standaloneModules.removeWorldObject
local trackGunDrop = standaloneModules.trackWorldGunDrop
local configureCoinSound = standaloneModules.configureWorldCoinSound
local configureSensor = standaloneModules.configureWorldSensor
local configureClutch = standaloneModules.configureWorldClutch
local processThrowingKnife = standaloneModules.processWorldThrowingKnife
local processProjectile = standaloneModules.processWorldProjectile
local processKnifeWeld = standaloneModules.processWorldKnifeWeld

type Values = { [string]: any }
type Bindings = { state: Values, characterState: Values, owner: Values, workspace: Values,
    connect: (unknown, unknown) -> unknown, destroy: unknown, dot: unknown, format: unknown,
    player: unknown, playerName: unknown, players: unknown, sound: unknown,
    find: unknown, waitForChild: unknown, wait: unknown, offset: unknown, jumping: unknown }
local remove = (removeWorldObject :: unknown) :: (string, unknown, Values, unknown) -> boolean
local track = (trackGunDrop :: unknown) :: (unknown, Values) -> ()
local configureSound = (configureCoinSound :: unknown) :: (string, unknown, Values) -> boolean
local configureDetector = (configureSensor :: unknown) :: (unknown, Values) -> ()
local configureThrown = (configureClutch :: unknown) :: (string, unknown, Values) -> ()
local processKnife = (processThrowingKnife :: unknown) :: (Values, Values) -> ()
local processPart = (processProjectile :: unknown) :: (Values, Values) -> ()
local processWeld = (processKnifeWeld :: unknown) :: (Values, Values) -> ()

return function(bindings: Bindings): Values
    local knifeBindings = { settings = bindings.state, murderers = (bindings.state.roles :: Values).Murderers,
        playerName = bindings.playerName, players = bindings.players, sound = bindings.sound,
        find = bindings.find, dot = bindings.dot, kill = bindings.state.kill_player, wait = bindings.wait }
    local projectileBindings = { player = bindings.player, findGun = bindings.state.find_gun, find = bindings.find }
    local weldBindings = { settings = bindings.state, murderers = (bindings.state.roles :: Values).Murderers,
        playerName = bindings.playerName, waitForChild = bindings.waitForChild }

    local function added(object: Values)
        local name = object.Name :: string
        if name == "Part" then
            processPart(object, projectileBindings)
            return
        end
        if name == "KnifeStickWield" then
            processWeld(object, weldBindings)
            return
        end
        if name == "ThrowingKnife" then
            processKnife(object, knifeBindings)
            return
        end
        if remove(name, object, bindings.state, bindings.destroy) then return end
        if configureSound(name, object, bindings.state) then return end

        if name == "Sensor" then
            configureDetector(object, bindings.state)
            return
        end

        if name == "Handle" or name == "Handle2" then
            local characterState = bindings.characterState
            configureThrown(name, object, { state = bindings.state, workspace = bindings.workspace, player = bindings.player,
                offset = bindings.offset, find = bindings.find, wait = bindings.wait,
                getRoot = function() return characterState.root end, getHumanoid = function() return characterState.humanoid end,
                getChangeState = function() return characterState.changeState end, jumping = bindings.jumping })
            return
        end

        if name == "GunDrop" then
            track(object, { settings = bindings.state, getRoot = function() return bindings.characterState.root end,
                dot = bindings.dot, format = bindings.format, notify = bindings.owner.Notify })
        end
    end

    local connection = bindings.connect(bindings.workspace.DescendantAdded, added)
    return { callback = added, connection = connection }
end
end)() :: unknown)

