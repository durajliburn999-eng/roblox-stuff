standaloneModules.createBloxCheckQuest = ((function()
local quests = standaloneModules.bloxQuestData :: any

type Values = { [string]: any }
type Quest = { equal: number?, atLeast: number?, atMost: number?, display: string?, enemy: string, quest: string,
    stage: number, questFrame: { number }, enemyFrame: { number }, entrance: { number }? }

return function(bindings: Values)
    return function(): ...unknown
        local world, frame, level = bindings.getWorld(), bindings.getFrame(), bindings.settings.MyLevel
        local entries: { Quest }? = nil
        if world.__BFFirstSea then entries = quests.first
        elseif world.__BFSecondSea then entries = quests.second
        elseif world.__BFThirdSea then entries = quests.third end
        if not entries then return nil, nil, nil, nil, nil, nil, nil end

        for _, entry in entries do
            local matches = if entry.equal then level == entry.equal else false
            if not matches and entry.atLeast then matches = level >= entry.atLeast end
            if not matches and entry.atMost then matches = level <= entry.atMost end
            if not matches then continue end
            local questFrame = frame(table.unpack(entry.questFrame))
            local enemyFrame = frame(table.unpack(entry.enemyFrame))
            local entrance = if entry.entrance then bindings.getVector()(table.unpack(entry.entrance)) else nil
            return entry.display, entry.enemy, entry.quest, entry.stage, questFrame, enemyFrame, entrance
        end
        return nil, nil, nil, nil, nil, nil, nil
    end
end
end)())

standaloneModules.createBloxEnergyWorker = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local settings, signal = bindings.settings, bindings.characterAdded
    local waitCharacter, getChangedSignal, connect = bindings.waitCharacter, bindings.getChangedSignal, bindings.connect
    return function(character: any)
        local highest = 0
        local energy: any = nil
        local function restoreEnergy()
            if not settings.InfiniteEnergy then return end
            local current = energy.Value
            if current < highest then
                energy.Value = highest
                return
            end
            highest = current
        end
        while true do
            if character and character.Parent then
                bindings.getWait()(1)
                energy = character.Energy
                highest = energy.Value
                connect(getChangedSignal(energy, "Value"), restoreEnergy)
            end
            character = waitCharacter(signal)
        end
    end
end
end)())

standaloneModules.setupBloxGame = ((function()
local createEnergyWorker = standaloneModules.createBloxEnergyWorker
local createCheckQuest = standaloneModules.createBloxCheckQuest

type Values = { [string]: any }
local makeEnergyWorker = (createEnergyWorker :: unknown) :: (Values) -> (unknown) -> ()
local makeCheckQuest = (createCheckQuest :: unknown) :: (Values) -> () -> ...unknown

return function(bindings: Values)
    local ownerUi, settings = bindings.ownerUi, bindings.settings
    local player = ownerUi.player
    local getChangedSignal = player.GetPropertyChangedSignal
    local level = player.Data.Level
    ownerUi.connect(getChangedSignal(level, "Value"), function()
        settings.MyLevel = level.Value
    end)
    settings.MyLevel = level.Value

    local characterAdded = player.CharacterAdded
    local waitCharacter = characterAdded.Wait
    local energyWorker = makeEnergyWorker({ settings = settings, characterAdded = characterAdded,
        getWait = function() return ownerUi.wait end, waitCharacter = waitCharacter,
        getChangedSignal = getChangedSignal, connect = ownerUi.connect })
    ownerUi.spawn(function(_, _, _, _, _, _, _, _, _, character)
        energyWorker(character)
    end, "InfiniteEnergy", "Value", "Parent", "Energy", settings, characterAdded, waitCharacter,
        getChangedSignal, ownerUi.connect, bindings.characterState.character)

    settings.CheckQuest = makeCheckQuest({ settings = settings, getWorld = function() return bindings.owner end,
        getFrame = function() return ownerUi.frame end, getVector = function() return ownerUi.vector3 end })
end
end)())

