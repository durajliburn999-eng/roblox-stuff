local selectManualGunShot = (function()
type Vector = typeof(setmetatable({}, { __mul = function(value, _scale) return value end }))
type Ray = { Origin: Vector, Direction: Vector }
type Camera = { ViewportSize: { X: number, Y: number } }
type Bindings = {
    settings: { SharpShooter: unknown },
    reticle: unknown,
    getProperty: (unknown, string) -> unknown,
    getCursor: () -> { X: number, Y: number },
    getCamera: () -> Camera,
    getRandom: () -> ((number, number) -> number),
    screenRay: (Camera, number, number) -> Ray,
    raycast: (Vector, Vector) -> { Instance: unknown, Position: unknown }?,
    getGun: () -> { Handle: { CFrame: unknown } },
}

local function cursorRay(bindings: Bindings): Ray
    local cursor = bindings.getCursor()

    if bindings.settings.SharpShooter then
        local camera = bindings.getCamera()
        local x, y = cursor.X, cursor.Y
        return bindings.screenRay(camera, x, y)
    end

    local random = bindings.getRandom()
    local camera = bindings.getCamera()
    local x = cursor.X
    local jitter = random(-10, 10)
    x += jitter
    local y = cursor.Y
    jitter = random(-10, 10)
    y += jitter
    return bindings.screenRay(camera, x, y)
end

local function manualRay(bindings: Bindings): Ray
    local reticle = bindings.reticle

    if not reticle then
        return cursorRay(bindings)
    end

    local enabled = bindings.getProperty(reticle, "Enabled")

    if not enabled then
        return cursorRay(bindings)
    end

    local camera = bindings.getCamera()
    local viewport = camera.ViewportSize
    local isSharp = bindings.settings.SharpShooter
    local x, y = viewport.X / 2, viewport.Y / 2
    y -= if isSharp then 50 else 36
    return bindings.screenRay(camera, x, y)
end

return function(bindings: Bindings): ...unknown
    local ray = manualRay(bindings)
    local origin = ray.Origin
    local direction = ray.Direction * 900
    local hit = bindings.raycast(origin, direction)

    if not hit or not hit.Instance then
        return
    end

    local position = hit.Position
    local gun = bindings.getGun()
    return true, position, gun.Handle.CFrame
end
end)()

local selectPredictedGunShot = (function()
type Vector = typeof(setmetatable({ Unit = (nil :: unknown) :: unknown }, {
    __sub = function(left, _right) return left end,
    __mul = function(left, _right) return left end,
}))
type Frame = typeof(setmetatable({}, { __mul = function(left, _right) return left end }))
type Part = { Parent: Part?, Position: Vector, CFrame: Frame }
type Player = { Character: Part? }
type Settings = {
    GunCustomTarget: unknown,
    GunCustomTargetPlayer: Player?,
    roles: { Murderers: { unknown } },
    GunSilentAimPrediction: unknown,
    PiercerBullet: unknown,
    predict_movement: unknown,
}
type Bindings = {
    settings: Settings,
    environment: { firing: unknown },
    findPlayer: (unknown) -> Player?,
    getCharacter: () -> Part?,
    find: (unknown, string) -> unknown,
    raycast: (Vector, Vector) -> { Instance: Part? }?,
    getProtect: () -> ((unknown, ...unknown) -> (boolean, unknown)),
    getFrame: () -> ((number, number, number) -> Frame),
    getGun: () -> { Handle: { CFrame: Frame } },
}

local function selectTarget(bindings: Bindings): Player?
    local settings = bindings.settings

    if settings.GunCustomTarget then
        return settings.GunCustomTargetPlayer
    end

    local murderer = settings.roles.Murderers[1]

    if not murderer then
        bindings.environment.firing = nil
        return nil
    end

    return bindings.findPlayer(murderer)
end

local function intersectsTarget(bindings: Bindings, character: Part): boolean
    local localCharacter = bindings.getCharacter()

    if not localCharacter then
        return false
    end

    local targetRoot = bindings.find(character, "HumanoidRootPart") :: Part?

    if not targetRoot then
        return false
    end

    local rightHand = bindings.find(localCharacter, "RightHand") :: Part?

    if not rightHand then
        return false
    end

    local origin = rightHand.Position
    local direction = targetRoot.Position - origin
    direction = (direction.Unit :: Vector) * 500
    local hit = bindings.raycast(origin, direction)

    if not hit or not hit.Instance then
        return false
    end

    local part = hit.Instance

    if part == character then
        return true
    end

    part = part.Parent :: Part

    if part == character then
        return true
    end

    return part.Parent == character
end

return function(bindings: Bindings): ...unknown
    local settings = bindings.settings
    local player = selectTarget(bindings)

    if not player then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local mode = settings.GunSilentAimPrediction

    if not mode then
        mode = "Remi"
    end

    local piercing = settings.PiercerBullet

    if not piercing and mode == "Ubuntu" then
        piercing = intersectsTarget(bindings, character)
    end

    local protect = bindings.getProtect()
    local predict = settings.predict_movement
    local ok, position = protect(predict, player, mode)

    if not ok or not position then
        return
    end

    if piercing then
        local targetRoot = bindings.find(character, "HumanoidRootPart") :: Part?

        if targetRoot then
            local frame = targetRoot.CFrame
            local makeFrame = bindings.getFrame()
            local offset = makeFrame(0, 0, 2.5)
            local origin = frame * offset

            if origin then
