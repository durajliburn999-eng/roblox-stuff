            primary[key] = "#" .. bindings.format(bindings.convert(bindings.primaryColors[key]))
        end
        for key in bindings.secondaryKeys do
            secondary[key] = "#" .. bindings.format(bindings.convert(bindings.secondaryColors[key]))
        end
        for key in bindings.secondaryVariantKeys do
            secondaryVariant[key] = "#" .. bindings.format(bindings.convert(bindings.secondaryVariantColors[key]))
        end
        for key in bindings.surfaceKeys do
            surface[key] = "#" .. bindings.format(bindings.convert(bindings.surfaceColors[key]))
        end

