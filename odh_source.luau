local shortcuts = (function()
type Input = { UserInputType: unknown }
type InputTypes = { Touch: unknown, MouseButton1: unknown }
type PressBindings = { inputTypes: InputTypes, clock: () -> number, setPressedAt: (number) -> () }
type ReleaseBindings = {
    inputTypes: InputTypes, clock: () -> number, pressedAt: () -> number,
    setPressedAt: (number) -> (), selectValue: (unknown) -> (), value: unknown, activate: () -> (),
}
type AppearanceBindings = {
    label: unknown, button: unknown,
    setTextSize: (unknown) -> (), setWidth: (unknown) -> (), setHeight: (unknown) -> (),
    width: () -> unknown, height: () -> unknown, image: () -> unknown,
    fadeOut: () -> unknown, fadeIn: () -> unknown,
    transition: (unknown) -> (), wait: (number) -> (), images: { [unknown]: unknown },
    writeProperty: (unknown, string, unknown) -> (),
    makeSize: () -> ((number, unknown, number, unknown) -> unknown),
}

local Shortcuts = {}

function Shortcuts.createPressHandler(bindings: PressBindings)
    local inputTypes = bindings.inputTypes
    local clock = bindings.clock

    return function(input: Input)
        local inputType = input.UserInputType

        if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then
            return
        end

        bindings.setPressedAt(clock())
    end
end

function Shortcuts.createReleaseHandler(bindings: ReleaseBindings)
    local inputTypes = bindings.inputTypes
    local clock = bindings.clock
    local selectValue = bindings.selectValue
    local value = bindings.value
    local activate = bindings.activate

    return function(input: Input)
        local inputType = input.UserInputType

        if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then
            return
        end

        if clock() - bindings.pressedAt() > 0.3 then
            return
        end

        bindings.setPressedAt(0)
        selectValue(value)
        activate()
    end
end

function Shortcuts.createAppearanceHandler(bindings: AppearanceBindings)
    local label = bindings.label
    local button = bindings.button
    local transition = bindings.transition
    local wait = bindings.wait
    local images = bindings.images
    local writeProperty = bindings.writeProperty

    return function(setting: unknown, value: unknown)
        if setting == 0 then
            bindings.setTextSize(value)
            writeProperty(label, "TextSize", value)
            return
        end

        if setting == 1 then
            bindings.setWidth(value)
            writeProperty(button, "Size", bindings.makeSize()(0.0095, value, 0.0095, bindings.height()))
            return
        end

        if setting == 2 then
            bindings.setHeight(value)
            writeProperty(button, "Size", bindings.makeSize()(0.0095, bindings.width(), 0.0095, value))
            return
        end

        local image = bindings.image()
        transition(bindings.fadeOut())
        wait(0.5)
        writeProperty(image, "Image", images[value])
        transition(bindings.fadeIn())
    end
end

return Shortcuts
end)()

local emotes = (function()
-- Emote playback and favorite callbacks.
type Track = { Play: (Track) -> () }
type Humanoid = { RigType: unknown, PlayEmoteAndGetAnimTrackById: (Humanoid, unknown) -> unknown }
type PlaybackBindings = {
    getHumanoid: () -> Humanoid?,
    unsupportedRig: unknown,
    getNotify: () -> ((string, number) -> ()),
    emoteId: unknown,
}
type Entry = { id: unknown, name: unknown }
type FavoriteBindings = {
    favorites: { Entry },
    emoteId: unknown,
    getSelected: () -> unknown,
    setSelected: (boolean) -> (),
    getEntry: () -> Entry?,
    setEntry: (Entry) -> (),
    emoteName: unknown,
    button: unknown,
    selectedImage: unknown,
    unselectedImage: unknown,
    save: (unknown, ...unknown) -> (),
    destination: unknown,
    serialize: ({ Entry }) -> ...unknown,
    remove: ({ Entry }, number) -> (),
    write: (unknown, string, unknown) -> (),
}

local function playback(bindings: PlaybackBindings)
    local unsupportedRig = bindings.unsupportedRig
    local emoteId = bindings.emoteId

    return function()
        local humanoid = bindings.getHumanoid()

        if not humanoid then
            return
        end

        if humanoid.RigType == unsupportedRig then
            local notify = bindings.getNotify()
            notify("This emote is only for R15.", 2)
            return
        end

        local track = humanoid:PlayEmoteAndGetAnimTrackById(emoteId)

        if not track or track == true then
            return
        end

        (track :: Track):Play()
    end
end

local function favorite(bindings: FavoriteBindings)
    local favorites = bindings.favorites
    local emoteId = bindings.emoteId
    local emoteName = bindings.emoteName
    local button = bindings.button
    local selectedImage = bindings.selectedImage
    local save = bindings.save
    local destination = bindings.destination
    local serialize = bindings.serialize
    local unselectedImage = bindings.unselectedImage
    local remove = bindings.remove
    local write = bindings.write

    return function()
        local wasSelected = bindings.getSelected()
        local entry = bindings.getEntry()
        bindings.setSelected(not wasSelected)

        if not entry then
            local created = { id = emoteId, name = emoteName }
            entry = created
            bindings.setEntry(created)
        end

        if not wasSelected then
            write(button, "Image", selectedImage)
            favorites[#favorites + 1] = entry :: Entry
            save(destination, serialize(favorites))
            return
        end

        write(button, "Image", unselectedImage)

        for index = 1, #favorites do
            if favorites[index].id == emoteId then
                remove(favorites, index)
                break
            end
        end

        save(destination, serialize(favorites))
    end
end

return { playback = playback, favorite = favorite }
end)()

local browseEmotes = (function()
-- Record5593: local page cache and emote catalog traversal.
type Page = { status: unknown, data: { unknown }?, nextPageCursor: string? }
type Bindings = {
    isFile: (string) -> unknown,
    readFile: (string) -> string?,
    request: (string, string, nil, string) -> string?,
    wait: (number) -> (),
    decode: (string) -> Page?,
    saveFile: (string, string) -> (),
    favorites: { unknown },
    renderPage: ({ unknown }, boolean) -> (),
}

local function readPage(bindings: Bindings, path: string, cursor: string, refresh: unknown): (string?, boolean?)
    if not refresh and bindings.isFile(path) then
        local text = bindings.readFile(path)
        return text, true
    end

    local body = if cursor == "" then "{}" else '{"cursor":"' .. cursor .. '"}'
    local text = bindings.request("https://api.overdrivehub.xyz/v1/proxy/roblox_emotes", "POST", nil, body)
    return text, nil
end

return function(bindings: Bindings)
    local cursor = ""
    local refresh: boolean? = nil

    while true do
        local key = cursor

        if cursor == "" then
            key = "__init__"
        end

        local path = ("Ixry Shizuka/files/roblox_emotes_cache/%*.json"):format(key)
        local text, cached = readPage(bindings, path, cursor, refresh)
        bindings.wait(5)

        if not text then
            continue
        end

        local page = bindings.decode(text)

        if not page then
            if not cached then
                return
            end

            refresh = true
            continue
        end

        if page.status ~= 200 then
            if not cached then
                return
            end

            refresh = true
            continue
        end

        local items = page.data

        if not items then
            if not cached then
                return
            end

            refresh = true
            continue
        end

        if cached then
            bindings.wait(0.5)
        end

        if not cached then
            bindings.saveFile(path, text)
        end

        refresh = nil
        local nextCursor = nil

        if items ~= bindings.favorites then
            nextCursor = page.nextPageCursor

            if nextCursor == cursor then
                refresh = true
                continue
            end
        end

        bindings.renderPage(items, false)

        if not nextCursor then
            return
        end

        cursor = nextCursor
    end
end
end)()

local layoutEmoteCard = (function()
