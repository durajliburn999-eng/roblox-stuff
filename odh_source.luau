local createSliderInput = (function()
type Fields = {
    unit: number, decimalPoint: string, oneDecimal: string, twoDecimals: string,
    minimum: string, maximum: string, filler: string, size: string, zero: number, height: number,
    valueLabel: string, text: string, settings: string, featureName: string, callback: string, save: string,
    invalidInputMessage: string, warningLevel: number,
}
type Bindings = {
    getNumberParser: () -> ((unknown) -> number?),
    getNotify: () -> ((string, number) -> ()),
    getStringConverter: () -> ((number) -> string),
    getFind: () -> ((string, string) -> number?),
    getFormat: () -> ((string, number) -> string),
    getSizeConstructor: () -> ((number, number, number, number) -> unknown),
}
type Slider = { [string]: unknown }

return function(bindings: Bindings, fields: Fields)
    local function normalize(value: number, minimum: number, maximum: number): number
        if minimum > value then
            return minimum
        end

        if maximum < value then
            return maximum
        end

        if value // fields.unit == value then
            return value
        end

        local text = bindings.getStringConverter()(value)
        local decimalPlaces = #text - (bindings.getFind()(text, fields.decimalPoint) :: number)

        if decimalPlaces == fields.unit then
            return bindings.getNumberParser()(bindings.getFormat()(fields.oneDecimal, value)) :: number
        end

        return bindings.getNumberParser()(bindings.getFormat()(fields.twoDecimals, value)) :: number
    end

    return function(slider: Slider, input: unknown)
        local value = bindings.getNumberParser()(input)

        if not value then
            bindings.getNotify()(fields.invalidInputMessage, fields.warningLevel)
            return
        end

        local minimum, maximum = slider[fields.minimum] :: number, slider[fields.maximum] :: number
        value = normalize(value, minimum, maximum)
        local filler = slider[fields.filler] :: { [string]: unknown }
        local sizeField = fields.size
        filler[sizeField] = bindings.getSizeConstructor()(
            (value - minimum) / (maximum - minimum) / fields.unit,
            fields.zero,
            fields.zero,
            fields.height
        )
        local label = slider[fields.valueLabel] :: { [string]: unknown }
        label[fields.text] = value
        local settings = slider[fields.settings] :: { [string]: unknown }
        settings[slider[fields.featureName] :: string] = value
        local callback = slider[fields.callback] :: (number) -> ()
        callback(value)
        local save = slider[fields.save] :: () -> ()
        save()
    end
end
end)()

local createColorInput = (function()
type Fields = {
    hexInput: string, text: string, originalValues: string, unit: number,
    toHSV: string, toHex: string, hexPrefix: string, rgbFormat: string,
