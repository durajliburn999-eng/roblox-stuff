standaloneModules.createObjectLabelWorker = ((function()
type Values = { [any]: any }
type Bindings = {
    options: Values,
    active: Values,
    settings: Values,
    getWait: () -> (() -> ()),
    getDot: () -> ((unknown, unknown) -> number)?,
    getFormat: () -> ((string, ...unknown) -> string),
    getRoot: () -> Values?,
    destroy: (unknown) -> (),
}

return function(bindings: Bindings)
    return function(billboard: Values, label: Values, object: Values, title: unknown, className: unknown, global: unknown, key: unknown)
        local wait = bindings.getWait()
        local dot = bindings.getDot()
        local format = bindings.getFormat()
        local getPivot = if className == "Model" then object.GetPivot else nil
        while bindings.active[object] and billboard.Enabled do
            local option = bindings.options[key]
            if not option then wait(); continue end
            if not option[6] then break end
            if not object.Parent then bindings.active[object] = nil; break end
            wait()
            if not bindings.settings.ESPDisplayDistance then label.Text = title; continue end
            local root = bindings.getRoot()
            if not root then label.Text = title; continue end
            local position = if className == "Model" then getPivot(object).Position else object.Position
            local distance = position - root.Position
            label.Text = format("%*", title, (dot :: (unknown, unknown) -> number)(distance, distance) ^ 0.5)
        end
        if global then billboard.Enabled = false; return end
        bindings.destroy(billboard)
    end
end
end)() :: unknown)

standaloneModules.createObjectTracerWorker = ((function()
type Values = { [any]: any }
type Bindings = {
    options: Values, active: Values, settings: Values, tracers: Values, origins: Values,
    getWait: () -> (() -> ()), getProject: () -> ((unknown, unknown) -> (any, unknown)),
    getCamera: () -> unknown, atan2: (number, number) -> number,
    getVector: () -> ((number, number) -> any), getOffset: () -> ((number, number) -> unknown),
    destroy: (unknown) -> (),
}

return function(bindings: Bindings)
    return function(line: Values, object: Values, _title: unknown, className: unknown, global: unknown, key: unknown)
        local wait, project, camera = bindings.getWait(), bindings.getProject(), bindings.getCamera()
        local offset, vector = bindings.getOffset(), bindings.getVector()
        local getPivot = if className == "Model" then object.GetPivot else nil
        local last: unknown = nil
        while bindings.active[object] do
            local option = bindings.options[key]
            if not option then wait(); continue end
            if not option[6] then break end
            if not object.Parent then bindings.active[object], bindings.tracers[object] = nil, nil; break end
            wait()
            local position = if className == "Model" then getPivot(object).Position else object.Position
            local projected, visible = project(camera, position)
            if last == projected then continue end
            if not visible then line.Visible = false; last = projected; continue end
            local origin = bindings.origins[bindings.settings.TracerLocation]
            local point = vector(projected.X, projected.Y)
            local delta = point - origin
            local center = (point + origin) / 2
            line.Position = offset(center.X, center.Y)
            line.Rotation = bindings.atan2(delta.Y, delta.X) * 57.29577951308232
            line.Size = offset(delta.Magnitude, 1)
            line.Visible = true
            last = projected
        end
        if global then line.Visible = false; return end
        bindings.destroy(line)
    end
end
end)() :: unknown)

standaloneModules.createObjectBoxWorker = ((function()
type Values = { [any]: any }
type Bindings = {
    options: Values, active: Values, boxes: Values,
    getWait: () -> (() -> ()), getProject: () -> ((unknown, unknown) -> (any, unknown)),
    getCamera: () -> any, atan2: (number, number) -> number,
    getOffset: () -> ((number, number) -> unknown), getVector: () -> ((number, number) -> any),
    getFrame: () -> ((unknown, unknown) -> any), destroy: (unknown) -> (),
}

return function(bindings: Bindings)
    return function(folder: unknown, top: Values, right: Values, left: Values, bottom: Values, object: Values,
        firstOffset: unknown, secondOffset: unknown, thirdOffset: unknown, fourthOffset: unknown,
        _title: unknown, className: unknown, global: unknown, key: unknown)
        local wait, project, camera = bindings.getWait(), bindings.getProject(), bindings.getCamera()
        local offset, vector, frame = bindings.getOffset(), bindings.getVector(), bindings.getFrame()
        local getPivot = if className == "Model" then object.GetPivot else nil
        local last: unknown = nil
        while bindings.active[object] do
            local option = bindings.options[key]
            if not option then wait(); continue end
            if not option[6] then break end
            if not object.Parent then bindings.active[object], bindings.boxes[object] = nil, nil; break end
            wait()
            local position = if className == "Model" then getPivot(object).Position else object.Position
            local current = frame(position, camera.CFrame.Position)
            if last == current then continue end
            local first, firstVisible = project(camera, current * firstOffset)
            local second, secondVisible = project(camera, current * secondOffset)
            local third, thirdVisible = project(camera, current * thirdOffset)
            local fourth, fourthVisible = project(camera, current * fourthOffset)
            first, second, third, fourth = vector(first.X, first.Y), vector(second.X, second.Y), vector(third.X, third.Y), vector(fourth.X, fourth.Y)
            if firstVisible then
                local delta, center = second - first, (second + first) / 2
                top.Position = offset(center.X, center.Y)
                top.Rotation = bindings.atan2(delta.X, delta.Y) * 57.29577951308232
                top.Size = offset(delta.Magnitude, 1)
            end
            if secondVisible then
                local delta, center = fourth - second, (fourth + second) / 2
                right.Position = offset(center.X, center.Y)
                right.Rotation = bindings.atan2(delta.Y, delta.X) * 57.29577951308232
                right.Size = offset(delta.Magnitude, 1)
            end
            if thirdVisible then
                local delta, center = first - third, (first + third) / 2
                left.Position = offset(center.X, center.Y)
                left.Rotation = bindings.atan2(delta.Y, delta.X) * 57.29577951308232
                left.Size = offset(delta.Magnitude, 1)
            end
            if fourthVisible then
                local delta, center = third - fourth, (third + fourth) / 2
                bottom.Position = offset(center.X, center.Y)
                bottom.Rotation = bindings.atan2(delta.Y, delta.X) * 57.29577951308232
                bottom.Size = offset(delta.Magnitude, 1)
            end
            top.Visible, right.Visible, left.Visible, bottom.Visible = firstVisible, secondVisible, thirdVisible, fourthVisible
            last = current
        end
        if global then
            top.Visible, right.Visible, left.Visible, bottom.Visible = false, false, false, false
            return
        end
        bindings.destroy(folder)
    end
end
end)() :: unknown)

