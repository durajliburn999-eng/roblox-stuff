standaloneModules.createPromptActions = ((function()
type Prompt = { ClassName: unknown, MaxActivationDistance: unknown }
type Bindings = {
    root: { value: unknown },
    getDescendants: (unknown) -> { Prompt },
    fire: (Prompt) -> (),
    previous: { [Prompt]: unknown },
}

return function(bindings: Bindings)
    local root = bindings.root
    local getDescendants = bindings.getDescendants
    local fire = bindings.fire
    local previous = bindings.previous

    local function setUnlimited(enabled: unknown)
        local objects = getDescendants(root.value)

        if enabled then
            for index = 1, #objects do
                local object = objects[index]

                if object.ClassName ~= "ProximityPrompt" then
                    continue
                end

                previous[object] = object.MaxActivationDistance
                object.MaxActivationDistance = 999999
            end

            return
        end

        for index = 1, #objects do
            local object = objects[index]

            if object.ClassName ~= "ProximityPrompt" then
                continue
            end

            local saved = previous[object]

            if not saved then
                continue
            end

            previous[object] = nil
            object.MaxActivationDistance = saved
        end
    end

    local function fireAll()
        local objects = getDescendants(root.value)

        for index = 1, #objects do
            local object = objects[index]

            if object.ClassName == "ProximityPrompt" then
                fire(object)
            end
        end
    end

    return { setUnlimited = setUnlimited, fireAll = fireAll }
end
end)())

