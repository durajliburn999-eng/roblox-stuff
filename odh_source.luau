standaloneModules.createKnifeThrowHooks = ((function()
type Values = { [string]: any }

return function(state: Values, settings: Values, clock: () -> number, wait: (...any) -> (), finish: (boolean) -> (), lower: (string) -> string, mouseButton2: unknown)
    local function begin(weight: number, checkInterrupted: boolean)
        local track = state.track
        state.action1 = true
        state.action2 = nil
        track:Play(0.1, weight, 1 / state.throwSpeed)

        if settings.FastThrow then wait() else wait(state.adjustedSpeed) end
        if checkInterrupted and not state.action1 then return end

        track:Stop()
        finish(true)
        state.action1 = nil
    end

    local function secondaryUp()
        if clock() - state.pressedAt > 0.3 then return end
        if state.action1 or state.action2 or state.action3 or not state.equipped then return end
        begin(2.5, true)
    end

    local function keyDown(key: string)
        if lower(key) ~= "e" then return end
        if state.action2 or state.action1 or state.action3 or not state.equipped then return end
        begin(1, true)
    end

    local function inputEnded(input: Values)
        if input.UserInputType ~= mouseButton2 then return end
        if clock() - state.pressedAt > 0.3 then return end
        if state.action2 or state.action1 or state.action3 or not state.equipped then return end
        begin(1, false)
    end

    return { secondaryUp = secondaryUp, keyDown = keyDown, inputEnded = inputEnded }
end
end)())

