standaloneModules.createUiDashboardTweens = ((function()
type Node = { [string]: unknown }
type Stats = { overview: unknown, fps: { group: unknown }, ping: { group: unknown } }
type Bindings = {
    createTween: (unknown, unknown, unknown, Node) -> unknown,
    owner: Node,
    makeNoAnimation: (Node) -> unknown,
    getFromScale: unknown,
    tweenService: unknown,
    tweenInfo: unknown,
    fromScale: (number, number) -> unknown,
    fromOffset: (number, number) -> unknown,
    size: (number, number, number, number) -> unknown,
    accentColor: unknown,
    getAccentColor: (() -> unknown)?,
    makeParticleInfo: (() -> unknown)?,
    playInitial: ((unknown, boolean) -> ())?,
    window: unknown,
    header: { version: unknown, minimize: unknown, icon: unknown },
    maximize: unknown,
    identity: { identity: unknown },
    stats: Stats,
    tabBar: unknown,
    navigation: { navigate: unknown, indicator: unknown },
    search: { bar: unknown },
    whitelist: { bar: unknown },
}

return function(bindings: Bindings)
    local tween = bindings.createTween
    local service = bindings.tweenService
    local info = bindings.tweenInfo
    local scale = bindings.fromScale
    local offset = bindings.fromOffset
    local header, stats = bindings.header, bindings.stats
    local tabReveal = tween(service, bindings.tabBar, info, { Position = scale(0.5, 0.85) })
    local overviewReveal = tween(service, stats.overview, info, { Position = scale(0.18, 0.3), GroupTransparency = 0 })
    local fpsReveal = tween(service, stats.fps.group, info, { Position = scale(0.8, 0.325), GroupTransparency = 0 })
    local pingReveal = tween(service, stats.ping.group, info, { Position = scale(0.8, 0.6), GroupTransparency = 0 })
    local whitelistReveal = tween(service, bindings.whitelist.bar, info, { Position = scale(0.2, 0.6), GroupTransparency = 0 })
    local versionReveal = tween(service, header.version, info, { Position = scale(0.035, 0.035), TextTransparency = 0 })
    if bindings.playInitial then bindings.playInitial(versionReveal, true) end
    local identityReveal = tween(service, bindings.identity.identity, info, { Position = scale(0.7, 0.1), GroupTransparency = 0 })
    if bindings.playInitial then bindings.playInitial(identityReveal, true) end
    local minimizeReveal = tween(service, header.minimize, info, { Position = scale(0.91, 0.1), BackgroundTransparency = 0.5 })
    if bindings.playInitial then bindings.playInitial(minimizeReveal, true) end
    local minimizeIconReveal = tween(service, header.icon, info, { ImageTransparency = 0 })
    if bindings.playInitial then
        bindings.playInitial(minimizeIconReveal, true)
        bindings.playInitial(tabReveal, false)
        bindings.playInitial(overviewReveal, false)
        bindings.playInitial(fpsReveal, false)
        bindings.playInitial(pingReveal, false)
    end
    local overviewHide = tween(service, stats.overview, info, { Position = scale(0.18, 0.5), GroupTransparency = 1 })
    bindings.owner.overview_animation = overviewHide
    local fpsHide = tween(service, stats.fps.group, info, { Position = scale(1, 0.325), GroupTransparency = 1 })
    bindings.owner.fps_animation = fpsHide
    local pingHide = tween(service, stats.ping.group, info, { Position = scale(1, 0.6), GroupTransparency = 1 })
    bindings.owner.ping_animation = pingHide
    local tabHide = tween(service, bindings.tabBar, info, { Position = scale(0.5, 1.2) })
    bindings.owner.tabframe_animation = tabHide
    local navigateReveal = tween(service, bindings.navigation.navigate, info, { ImageTransparency = 0 })
    bindings.owner.tabnavigate_animation = navigateReveal
    local indicatorReveal = tween(service, bindings.navigation.indicator, info, { TextTransparency = 0 })
    bindings.owner.tabindicator_animation = indicatorReveal
    local searchReveal = tween(service, bindings.search.bar, info, { GroupTransparency = 0 })
    bindings.owner.searchbar_animation = searchReveal
    local whitelistHide = tween(service, bindings.whitelist.bar, info, { Position = scale(0.2, 0.8), GroupTransparency = 1 })
    bindings.owner.whitelistbar_animation = whitelistHide
    bindings.owner.NoAnimWidgetInit = bindings.makeNoAnimation({ getFromScale = bindings.getFromScale,
        overview = stats.overview, fps = stats.fps.group, ping = stats.ping.group, whitelist = bindings.whitelist.bar,
        tabs = bindings.tabBar, navigate = bindings.navigation.navigate, indicator = bindings.navigation.indicator, search = bindings.search.bar })
    local accentColor = if bindings.getAccentColor then bindings.getAccentColor() else bindings.accentColor
    local particleInfo = if bindings.makeParticleInfo then bindings.makeParticleInfo() else nil
    local minimizeHighlight = tween(service, header.minimize, info, { BackgroundTransparency = 0, BackgroundColor3 = accentColor })
    local windowClose = tween(service, bindings.window, info, { Size = offset(0, 0) })
    local windowOpen = tween(service, bindings.window, info, { Size = offset(600, 300) })
    local maximizeShow = tween(service, bindings.maximize, info, { Size = bindings.size(0.025, 35, 0.025, 35) })
    local maximizeHighlight = tween(service, bindings.maximize, info, { BackgroundTransparency = 0, BackgroundColor3 = accentColor })
    local maximizeHide = tween(service, bindings.maximize, info, { Size = offset(0, 0) })
    return { tabReveal = tabReveal, overviewReveal = overviewReveal, fpsReveal = fpsReveal, pingReveal = pingReveal,
        whitelistReveal = whitelistReveal, versionReveal = versionReveal, identityReveal = identityReveal,
        minimizeReveal = minimizeReveal, minimizeIconReveal = minimizeIconReveal,
        overview_animation = overviewHide, fps_animation = fpsHide, ping_animation = pingHide,
        tabframe_animation = tabHide, tabnavigate_animation = navigateReveal, tabindicator_animation = indicatorReveal,
        searchbar_animation = searchReveal, whitelistbar_animation = whitelistHide,
        minimizeHighlight = minimizeHighlight, windowClose = windowClose, windowOpen = windowOpen,
        maximizeShow = maximizeShow, maximizeHighlight = maximizeHighlight, maximizeHide = maximizeHide,
        particleInfo = particleInfo, transitionInfo = info }
end
end)() :: unknown)

