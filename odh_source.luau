return function(tab: unknown, bindings: Values): Values
    local ownerUi, environment, settings = bindings.ownerUi, bindings.environment, bindings.settings
    local character = bindings.characterCells
    local methods = ownerUi.playerMethods
    local info: Values = { value = nil }
    local state = makeState({ settings = settings, dispatch = bindings.stateDispatch, transform = bindings.stateTransform })
    local farmWorker, earningsWorker

    local function prepareFarm(): Values
        local roles = settings.roles
        local vector, frame = ownerUi.vector3, ownerUi.frame
        local find, getDescendants = methods.findFirstChild, methods.getDescendants
        local function isA(object: Values, name: string): unknown return object:IsA(name) end
        local farm = { settings = settings, player = ownerUi.playerName, localName = ownerUi.playerName,
            isAlive = function(name: unknown) return settings.is_alive(name) end,
            character = character.character, humanoid = character.humanoid, root = character.root,
            players = ownerUi.players, murderers = roles.Murderers, sheriffs = roles.Sheriffs,
            findPlayer = bindings.findPlayer, flingAction = bindings.fling, killAction = function(player: unknown) return settings.kill_player(player) end,
            start = environment.pcall, wait = ownerUi.wait, cleanup = bindings.destroy,
            findChild = find, findCoin = ownerUi.playerGui.GetAttribute, getChildren = ownerUi.childCache, getDescendants = getDescendants, isA = isA,
            createBody = environment.Instance.new, makeFrame = frame, dot = ownerUi.dot, touch = environment.firetouchinterest,
            cross = function(left: Values, right: unknown) return left:Cross(right) end,
            initialValues = { angles = environment.CFrame.Angles, vector = vector, frame = frame } }
        local function run(invocation: Values)
            invocation.destination = { getChildren = ownerUi.childCache, makeFrame = frame,
                above = { makeVector = vector, getDescendants = getDescendants, isA = isA, dot = ownerUi.dot },
                void = { parent = environment.workspace, findChild = find, create = environment.Instance.new,
                    size = invocation.platformSize, platformFrame = invocation.platformFrame, destination = invocation.destination } }
            runWorker(invocation)
        end
        farmWorker = makeWorker(farm, run)
        earningsWorker = makeEarnings({ settings = settings, wait = ownerUi.wait, paragraph = info.value,
            clock = function() return environment.__inertClock.now end, format = environment.string.format,
            currencies = (standaloneModules.farmUiOptions :: { [string]: any }).coinTypes })
        return makeActions({ settings = settings, spawn = ownerUi.spawn, farmWorker = farmWorker, earningsWorker = earningsWorker })
    end

    local section = populate(tab, { farmInfo = info, options = standaloneModules.farmUiOptions, prepareFarm = prepareFarm }, {}, state)
    return { section = section, info = info, farmWorker = farmWorker, earningsWorker = earningsWorker }
end
end)() :: unknown)

