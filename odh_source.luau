standaloneModules.createBombCharacterBinder = ((function()
type Values = { [string]: any }
type Bindings = {
    getWait: () -> (() -> ()),
    getChildren: (unknown) -> { Values },
    getDisconnect: () -> ((unknown) -> ()),
    getConnection: () -> unknown,
    setConnection: (unknown) -> (),
    setReady: (unknown) -> (),
    setHandle: (unknown) -> (),
    setRemote: (unknown) -> (),
    getMouse: () -> Values,
    find: (unknown, string) -> Values?,
    getConnect: () -> ((unknown, unknown) -> unknown),
    activate: unknown,
}

return function(bindings: Bindings)
    return function(character: unknown)
        local wait = bindings.getWait()
        bindings.getDisconnect()(bindings.getConnection())
        bindings.setReady(true)
        bindings.setConnection(nil)
        bindings.setHandle(nil)
        bindings.setRemote(nil)
        bindings.getMouse().Icon = ""

        while true do
            local children = bindings.getChildren(character)
            for index = 1, #children do
                local child = children[index]
                if child.Name ~= "FakeBomb" or child.ClassName ~= "Tool" then continue end

                local client = bindings.find(child, "Client")
                if client then client.Enabled = false end
                bindings.setHandle(bindings.find(child, "Handle"))
                bindings.setRemote(bindings.find(child, "Remote"))
                local connect = bindings.getConnect()
                bindings.setConnection(connect(child.Activated, bindings.activate))
                return
            end
            wait()
        end
    end
end
end)() :: unknown)

