    local isMode = bindings.isMode
    local modeOwner = bindings.modeOwner
    local getMode = bindings.getMode
    local getWait = bindings.getWait
    local getIdle = bindings.getIdle
    local getPlayers = bindings.getPlayers
    local sheriffs = bindings.sheriffs
