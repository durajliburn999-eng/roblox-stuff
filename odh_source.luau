    local handle = bindings.waitFor(gun, "Handle")
    local sounds = bindings.find(gun, "Sounds")
    local gunshot = bindings.find(handle, "Gunshot") :: Sound?

    if not gunshot then
        gunshot = bindings.find(sounds, "Gunshot") :: Sound?

        if not gunshot then
            gunshot = bindings.find(gun, "Gunshot") :: Sound?
        end
    end

    local reload = bindings.find(handle, "Reload") :: Sound?

    if not reload then
        reload = bindings.find(sounds, "Reload") :: Sound?

        if not reload then
            reload = bindings.find(gun, "Reload") :: Sound?
        end
    end

    bindings.setReload(reload)

    if gunshot and settings.CustomGunshotEnabled then
        local soundId = gunshotSoundId(settings)

        if soundId then
            gunshot.SoundId = soundId
        end
    end

    if reload and settings.CustomGunReloadEnabled then
        local soundId = reloadSoundId(settings)

        if soundId then
            reload.SoundId = soundId
        end
    end

    settings.MM2_Gunshot = gunshot
    settings.MM2_Gun_Reload = reload
    settings.MM2_Gunshot_Original = (gunshot :: Sound).SoundId
    local storedReload = bindings.getReload() :: Sound
    settings.MM2_Gun_Reload_Original = storedReload.SoundId
    return handle, gunshot :: Sound
end
end)()

