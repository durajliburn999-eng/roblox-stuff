}

return function(context: Context)
    local render = renderers[context.style]

    if render then
        render(context)
    end
end
end)()

local classifyEspObject = (function()
-- Record538: classify objects for the shared ESP styles.
type Object = { Name: string, ClassName: string, Parent: Object? }
type Context = {
    object: Object,
    objectName: string,
    active: unknown,
    options: unknown,
    environment: { [unknown]: unknown },
    gameName: unknown,
    coinId: unknown,
    color: unknown,
    getCoinColors: () -> { [unknown]: unknown }?,
    getAttribute: (Object, string) -> unknown,
    getRgb: () -> ((number, number, number) -> unknown),
    getWorkspace: () -> unknown,
    getDefaultColor: () -> unknown,
}

local function classifyBloxObject(context: Context)
    local object = context.object
    local className = object.ClassName
    local useModelPath = className == "Model"

    if not context.active then
        -- The alternate original branch reads this environment slot before falling through.
        local _unused = context.environment[0.25]
        useModelPath = true
    end

    if useModelPath then
        local parent = object.Parent

        if not context.options then
            local active = context.active :: { [unknown]: unknown }
            active[nil] = nil
        end

        if parent and parent.Name == "ChestModels" then
            local ancestor = parent.Parent
            local workspace = context.getWorkspace()

            if ancestor == workspace then
                context.objectName = "%bloxfruits_chest%"
            end
        end

        return
    end

    if className ~= "Part" then
        return
    end

    local parent = object.Parent

    if not parent or parent.Name ~= "Locations" then
        return
    end

    parent = parent.Parent

    if not parent or parent.Name ~= "_WorldOrigin" then
        return
    end

    parent = parent.Parent
    local workspace = context.getWorkspace()

    if parent == workspace then
        context.objectName = "%bloxfruits_islands%"
    end
end

return function(context: Context)
    local name = context.objectName

    if name == "Coin_Server" then
        local colors = context.getCoinColors()

        if colors then
            local attribute = context.getAttribute
            local id = attribute(context.object, "CoinID")
            context.coinId = id
            context.color = colors[id]
        end

        return
    end

    if name == "GunDrop" then
        context.color = context.getRgb()(0, 0, 255)
        return
    end

    if name == "ThrowingKnife" then
        context.color = context.getRgb()(255, 0, 0)
        return
    end

    if context.gameName == "Blade Ball" then
        local attribute = context.getAttribute
        local realBall = attribute(context.object, "realBall")

        if realBall then
            context.color = context.getRgb()(0, 0, 255)
            context.objectName = "%bladeball_ball%"
            return
        end
    end

    if context.gameName == "Blox Fruits" then
        classifyBloxObject(context)
    end

    context.color = context.getDefaultColor()
end
end)()

