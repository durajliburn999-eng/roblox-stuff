    uppercase: (string) -> string,
    getFormat: () -> ((string, ...unknown) -> string),
    fromHSV: (number, number, number) -> unknown,
}

local function clamp(value: number): number
    if value > 255 then
        return 255
    end

    if value < 0 then
        return 0
    end

    return value
end

return function(bindings: Bindings)
    local getNumber = bindings.getNumber
    local getPosition = bindings.getPosition
    local getColor = bindings.getColor
    local uppercase = bindings.uppercase
    local getFormat = bindings.getFormat
    local fromHSV = bindings.fromHSV

    return function(picker: Picker, red: unknown, green: unknown, blue: unknown)
        local number = getNumber()
        local r, g, b = number(red), number(green), number(blue)

        if not r or not g or not b then
            picker.RGBInput.Text = picker.OriginalValues[2]
            return
        end

        local position = getPosition()
        r, g, b = clamp(r), clamp(g), clamp(b)
        local color = getColor()(r, g, b)
        local hue, saturation, brightness = color:ToHSV()
        local hex = "#" .. uppercase((color:ToHex()))
        local rgb = getFormat()("%s, %s, %s", r, g, b)
        local original = picker.OriginalValues
        picker.Canvas.BackgroundColor3 = fromHSV(hue, 1, 1)
        picker.Preview.BackgroundColor3 = color
        picker.Cursor.Position = position(saturation, 1 - brightness)
        picker.HueSliderCursor.Position = position(0.5, hue)
        picker.PreviewHex.Text = hex
        picker.HexInput.Text = hex
        picker.RGBInput.Text = rgb
        original[1], original[2] = hex, rgb
        picker.Colorpicker_Settings[picker.feature_name] = hex
        picker.SaveConfigs()
        picker.Callback(color)
    end
end
end)())

