        message.RichText = true
        message.TextYAlignment = bindings.textAlignment
        message.AutomaticSize = bindings.automaticSize
        row.AutomaticSize = bindings.automaticSize
        state.busy = true

        while state.view.Parent == state.screen and row.Parent == state.log and row.Visible do
            message.Text = bindings.format(bindings.template)
            bindings.wait()
        end

        state.busy = false
    end
end
