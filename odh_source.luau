            find = (ownerUi.playerMethods :: Values).findFirstChild, getWorkspace = function() return environment.workspace end,
            getPlayerName = function() return ownerUi.playerName end, fire = ownerUi.fireServer, command = target })
    end
    local actions = newDeploy(command)
