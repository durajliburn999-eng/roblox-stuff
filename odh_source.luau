standaloneModules.createGameRoundEvents = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local state, roles = bindings.state, bindings.roles
    local seen, currencies = {}, {}

    local function collected(name: string, current: unknown, maximum: unknown, amount: Values)
        if state.AutoFarm then
            local key = "Earned" .. name
            state[key] = (bindings.getNumber()(state[key]) or 0) + amount.Value
        end

        state[name .. "Full"] = current == maximum
        if seen[name] then return end
        seen[name] = true
        currencies[#currencies + 1] = name
    end

    local function roundEnded()
        local wait = bindings.getWait()
        local murderers, sheriffs = roles.Murderers, roles.Sheriffs
        for index = 1, #currencies do
            local name = currencies[index]
            state[name .. "Full"] = nil
            seen[name] = nil
            currencies[index] = nil
        end

        wait(5)
        for name in murderers do murderers[name] = nil end
        for name in sheriffs do sheriffs[name] = nil end
        state.SheriffGun_REMOTE = nil
        roles.Hero = nil
        wait(5)
        state.CoinContainer = nil
        state.Map = nil
    end

    return { collected = collected, roundEnded = roundEnded }
end
