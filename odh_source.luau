    local raw = buffer.create(2048)
    buffer.copy(raw, 0, prefix, 0, 3)
    buffer.writeu8(raw, 3, selector + 129)
    local first, second, third = order(selector, tags.string, tags.number, tags.byte)
    buffer.writeu8(raw, 4, first)
    buffer.writeu8(raw, 5, second)
    buffer.writeu8(raw, 6, third)
    buffer.writeu8(raw, 7, marker)

    local length = 10
    for _, field in fields do
        length = write(raw, length, field.name, field.value, tags, key)
    end
    local payloadLength = length - 10
    buffer.writeu8(raw, 8, payloadLength // 256)
    buffer.writeu8(raw, 9, payloadLength % 256)

    local frame = buffer.create(length * 2)
    for index = 0, length - 1 do
        local offset = index * 2
        local word = encode(buffer.readu8(raw, index), offset, if index < 3 then 0 else key)
        buffer.writeu16(frame, offset, word)
    end
    return buffer.tostring(frame)
end
end)() :: unknown)

