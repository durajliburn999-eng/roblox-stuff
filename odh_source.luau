local getWorldHalfHeight = (function()
type Frame = { RightVector: { Y: number }, UpVector: { Y: number }, LookVector: { Y: number } }
type Size = { X: number, Y: number, Z: number }

return function(frame: Frame, size: Size): number
    local width = math.abs(frame.RightVector.Y) * size.X
    local height = math.abs(frame.UpVector.Y) * size.Y
    local depth = math.abs(frame.LookVector.Y) * size.Z
    return (width + height + depth) / 2
end
end)()

local farmTargetFrames = (function()
type Frame = typeof(setmetatable({ X = 0, Y = 0, Z = 0 }, { __mul = function(left, _right) return left end }))
type Constructor = (number, number, number) -> Frame

local function standard(coin: Frame, makeFrame: Constructor): Frame
    local x = coin.X
    local y = coin.Y + 2
    local z = coin.Z
    return makeFrame(x, y, z)
end

local function safe(coin: Frame, makeFrame: Constructor, rotation: Frame): Frame
    local x = coin.X
    local y = coin.Y - 2.85
    local z = coin.Z
    return makeFrame(x, y, z) * rotation
end

local function lay(coin: Frame, makeFrame: Constructor, rotation: Frame): Frame
    local x = coin.X
    local y = coin.Y
    local z = coin.Z
    return makeFrame(x, y, z) * rotation
end

return { standard = standard, safe = safe, lay = lay }
end)()

local updateFarmTargetTimer = (function()
type Bindings = {
    settings: { TweenDelay: unknown },
    previousCoin: unknown,
    olderCoin: unknown,
    timer: { value: number },
    find: (unknown, string) -> unknown,
    wait: (unknown) -> (),
}

return function(selected: unknown, bindings: Bindings): unknown
    local previous = bindings.previousCoin

    if previous and previous ~= selected then
        local delay = bindings.settings.TweenDelay

        if delay ~= 0 then
            bindings.wait(delay)
        end
    end

    if not previous or not bindings.olderCoin or selected ~= bindings.olderCoin then
        bindings.timer.value = 0
        return selected
    end

    if bindings.find(previous, "Collected") then
        bindings.timer.value = 0
        return selected
    end

    local timer = bindings.timer.value

    if 3 <= timer then
        timer = -2
        selected = previous
    end

    bindings.timer.value = timer + 1
    return selected
end
end)()

local avoidFarmMurderer = (function()
type Vector = typeof(setmetatable({ Magnitude = 0, Unit = (nil :: unknown) :: unknown }, {
    __sub = function(left, _right) return left end,
    __add = function(left, _right) return left end,
    __mul = function(left, _right) return left end,
    __unm = function(value) return value end,
}))
type Frame = { Position: Vector, RightVector: Vector, LookVector: Vector }
type Root = { Position: Vector, CFrame: Frame }
type Player = { Character: unknown }
type Bindings = {
    enabled: unknown,
    murderers: { unknown },
    localName: unknown,
    root: Root,
    target: { Position: Vector },
    findPlayer: (unknown) -> Player?,
    find: (unknown, string) -> Root?,
    dot: (Vector, Vector) -> number,
    cross: (Vector, Vector) -> Vector,
    up: Vector,
}

return function(bindings: Bindings): Vector
    local root = bindings.root
    local target = bindings.target

    local function direct(): Vector
        return target.Position - root.Position
    end

    if not bindings.enabled then
        return direct()
    end

    local murderer = bindings.murderers[1]

    if not murderer or murderer == bindings.localName then
        return direct()
    end

    local player = bindings.findPlayer(murderer)

    if not player then
        return direct()
    end

    local character = player.Character

    if not character then
        return direct()
    end

    local enemyRoot = bindings.find(character, "HumanoidRootPart")

    if not enemyRoot then
        return direct()
    end

    local origin = root.Position
    local enemyPosition = enemyRoot.Position
    local enemyDisplacement = enemyPosition - origin

    if not (enemyDisplacement.Magnitude <= 15) then
        return target.Position - origin
    end

    local targetDisplacement = target.Position - origin
    local projection = bindings.dot(enemyDisplacement, targetDisplacement.Unit :: Vector)

    if not (0 < projection) or not (projection < targetDisplacement.Magnitude) then
        return target.Position - origin
    end

    local frame = enemyRoot.CFrame
    local right = frame.RightVector
    local cross = bindings.cross(targetDisplacement, bindings.up)
    local comparison = if cross.Magnitude < 0.001 then frame.LookVector else right
    local offset = if 0 < bindings.dot(cross, comparison) then right * 8 else -right * 8
    local avoidance = enemyPosition + offset - origin

    if 1 < avoidance.Magnitude then
        return avoidance
    end

    return target.Position - origin
end
end)()

local orientFarmTarget = (function()
