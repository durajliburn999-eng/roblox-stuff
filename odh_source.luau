    getThrowSpeed: () -> number,
    setAdjustedSpeed: (number) -> (),
    setHasteTrail: (unknown) -> (),
}

local function setupHasteTrail(bindings: Bindings)
    local torso = bindings.find(bindings.character, "UpperTorso")

    if not torso then
        return
    end

    local existing = bindings.waitFor(torso, "HasteTrail", 3)

    if existing then
        bindings.write(existing, "Enabled", false)
        bindings.setHasteTrail(existing)
        return
    end

    local template = bindings.findTemplate(bindings.knifeClient, "HasteTrail")

    if not template then
        return
    end

    local neck = bindings.find(torso, "NeckAttachment")

    if not neck then
        return
    end

    local waist = bindings.find(torso, "WaistRigAttachment")

    if not waist then
        return
    end

    local trail = template:Clone()
    bindings.write(trail, "Name", "HasteTrail")
    bindings.write(trail, "Parent", torso)
    bindings.write(trail, "Attachment0", neck)
    bindings.write(trail, "Attachment1", waist)
    bindings.write(trail, "Enabled", false)
    bindings.setHasteTrail(trail)
end

return function(bindings: Bindings)
    local roles = bindings.getRoles()
    local role = (bindings.getRoles() :: unknown) :: Role?

    if roles then
        role = roles[bindings.getPlayerName()]
    end

    if not role then
        return
    end

    local perk = role.Perk
    local throwSpeed = bindings.getAttribute(bindings.knife, "ThrowSpeed")

    if not throwSpeed then
        throwSpeed = 1
    end

    bindings.setThrowSpeed(throwSpeed :: number)
    bindings.setAdjustedSpeed(bindings.getThrowSpeed() / 1.25)

    if perk == "Haste" then
        setupHasteTrail(bindings)
    end
end
end)()

