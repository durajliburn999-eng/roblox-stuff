    local notifyCell = bindings.notify
    local formatCell = bindings.format
    local state = bindings.state

    return function(capturedMurdererCount: number?, capturedSheriffCount: number?, capturedHero: unknown?)
        local join = joinCell.value
        local notify = notifyCell.value
        local format = formatCell.value
        local roles = state.roles
