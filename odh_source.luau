standaloneModules.initializeUiConsole = ((function()
local createMessage = standaloneModules.createUiConsoleMessage
local createObserver = standaloneModules.createUiConsoleObserver

type Values = { [string]: any }
local makeMessage = (createMessage :: unknown) :: (Values) -> (Values) -> ()
local makeObserver = (createObserver :: unknown) :: (Values) -> Values

return function(bindings: Values)
    local random = bindings.random
    local marker = bindings.format("%*_ODH2026_EAUBI_CONSOLEDEV_%*_PROC_ASEIT_AES_STARLIGHT", random(1, 999999), random(1, 999999))
    local warningColor = bindings.fromRGB(255, 218, 68)
    local messageColor = bindings.fromRGB(255, 255, 255)
    local imagePosition = bindings.fromOffset(3, 0.125)
    bindings.warn(marker)

    local state = {}
    local onMessage = makeMessage({ state = state, findChild = bindings.waitForChild, warningColor = warningColor,
        marker = marker, substring = bindings.substring, match = bindings.match, format = bindings.concat,
        wait = bindings.wait, automaticSize = bindings.automaticSize, imagePosition = imagePosition,
        messageColor = messageColor, textAlignment = bindings.textAlignment, template = bindings.entries })
    local observer = makeObserver({ state = state, findChild = bindings.findChild, waitForChild = bindings.waitForChild,
        getChildren = bindings.getChildren, connect = bindings.connect, disconnect = bindings.disconnect, onMessage = onMessage })
    local findChild, getChildren, connect = bindings.findChild, bindings.getChildren, bindings.connect
    local master = findChild(bindings.coreGui, "DevConsoleMaster")
    local window = master and findChild(master, "DevConsoleWindow")
    state.screen = window and findChild(window, "DevConsoleUI")

    if state.screen then
        connect(state.screen.ChildAdded, observer.onViewAdded)
        connect(state.screen.ChildRemoved, observer.onViewRemoved)
        for _, child in getChildren(state.screen) do
            if child.Name ~= "MainView" then continue end
            observer.onViewAdded(child)
            break
        end
    end

    connect(bindings.coreGui.ChildAdded, observer.onConsoleAdded)
    return { state = state, marker = marker, observer = observer }
end
end)() :: unknown)

