                write(context.image, context.offsetKey, context.vector())
                write(context.owner, context.ownerImageKey, if metadata[context.hideKey] then nil else context.image)
            end

            for frame = 0, lastFrame :: number do
                local x = frame % (columns :: number) * (width :: number)
                local y = frame // (columns :: number) * (height :: number)
                write(context.image, context.offsetKey, context.vector(x, y))
                context.wait(frameDelay :: number)
            end
        end

        previous = current
    end
