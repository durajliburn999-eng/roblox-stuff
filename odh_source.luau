standaloneModules.createPointerFeedback = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local pressedAt = 0
    local inputTypes = bindings.inputTypes

    local function began(input: Values)
        local inputType = input.UserInputType
        if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then return end
        pressedAt = bindings.clock()
    end

    local function ended(input: Values)
        if bindings.clock() - pressedAt > 0.3 then return end
        local inputType = input.UserInputType
        if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then return end
        local position = input.Position
        local x, y = position.X, position.Y

        for _, object in bindings.getObjects(bindings.coreGui, x, y) do
            if not bindings.isDescendant(object, bindings.root) then continue end
            local feedback = bindings.feedback
            feedback.BackgroundTransparency = 0.35
            feedback.Position = bindings.fromOffset(x, y)
            feedback.Size = bindings.fromOffset(0, 0)
            feedback.Visible = true
            bindings.play(bindings.tween)
            bindings.wait(bindings.completed)
            feedback.Visible = false
            return
        end
    end

    return began, ended
end
end)())

standaloneModules.createFireflies = ((function()
