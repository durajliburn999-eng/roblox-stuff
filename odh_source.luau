type Response = { [number]: unknown }
type Exchange = {
    response: Response,
    challenge: number,
    transformed: unknown,
    scaled: unknown,
    started: number,
    clock: () -> number,
}
local xor = (xorValue :: unknown) :: (number, number) -> number

return function(exchange: Exchange): (boolean, string?)
    local challenge = exchange.challenge
    local clock = exchange.clock
    if clock() - exchange.started < 0.001 then
        return false, "SON 😹"
    end
    if xor(challenge, 7273484) ~= exchange.transformed then
        return false, "SON 😹"
    end
    if challenge * 143 / 2 ~= exchange.scaled then
        return false, "SON 😹"
    end
    local proof = exchange.response[64]
    local interval = clock() // 35
    if not proof or xor((proof :: number) % 4294967296, interval) ~= 243246 then
        return false, "SON 😹"
    end
    return true, nil
end
end)() :: unknown)

