standaloneModules.createPremiumControls = ((function()
type Values = { [string]: unknown }
type SoundSpec = { sound: string, original: string, enabled: string, usePreset: string, presetId: string, assetId: string }
type Cell = { value: unknown }
type Bindings = {
    settings: Values,
    presets: { [string]: { [unknown]: unknown } },
    cursorX: Cell,
    cursorY: Cell,
    getVector2: () -> ((unknown, unknown) -> unknown),
    findChild: (unknown, string) -> Values?,
    playerGui: unknown,
}

local specs: { [string]: SoundSpec } = {
    ["Knife Kill"] = { sound = "MM2_Knife_Kill", original = "MM2_Knife_Kill_Original", enabled = "CustomKnifeKillEnabled",
        usePreset = "UseKnifeKillSoundPreset", presetId = "CustomKnifeKillId1", assetId = "CustomKnifeKillId2" },
    Gunshot = { sound = "MM2_Gunshot", original = "MM2_Gunshot_Original", enabled = "CustomGunshotEnabled",
        usePreset = "UseGunshotSoundPreset", presetId = "CustomGunshotId1", assetId = "CustomGunshotId2" },
    ["Gun Reload"] = { sound = "MM2_Gun_Reload", original = "MM2_Gun_Reload_Original", enabled = "CustomGunReloadEnabled",
        usePreset = "UseGunReloadSoundPreset", presetId = "CustomGunReloadId1", assetId = "CustomGunReloadId2" },
}

local function setSound(settings: Values, spec: SoundSpec, sound: Values, enabled: unknown, candidate: unknown)
    local value = candidate

    if not enabled or not value then
        value = settings[spec.original]
    end

    if value then
        sound.SoundId = value
    end
end

return function(bindings: Bindings)
    local settings = bindings.settings
    local presets = bindings.presets
    local cursorX = bindings.cursorX
    local cursorY = bindings.cursorY
    local getVector2 = bindings.getVector2
    local findChild = bindings.findChild
    local playerGui = bindings.playerGui
    local handlers: { [string]: unknown } = {}
    local throwPresets = presets["Knife Throw"]

    handlers["Knife Throw Sound Presets"] = function(value: unknown)
        settings.CustomKnifeThrowId1 = throwPresets[value]
    end
    handlers["Knife Throw Sound Asset Id"] = function(value: unknown)
        settings.CustomKnifeThrowId2 = "rbxassetid://" .. (value :: string)
    end

    for name, spec in specs do
        local presetMap = presets[name]
        handlers["Enable Custom " .. name .. " Sound"] = function(value: unknown)
            local sound = settings[spec.sound] :: Values?
            local candidate = if settings[spec.usePreset] then settings[spec.presetId] else settings[spec.assetId]
            settings[spec.enabled] = value

            if sound then
                setSound(settings, spec, sound, value, candidate)
            end
        end
        handlers[name .. " Sound Presets"] = function(value: unknown)
            local sound = settings[spec.sound] :: Values?
            local selected = presetMap[value]
            local candidate = if settings[spec.usePreset] then selected else settings[spec.assetId]
            settings[spec.presetId] = selected

            if sound then
                setSound(settings, spec, sound, settings[spec.enabled], candidate)
            end
        end
        handlers["Use " .. name .. " Sound Preset"] = function(value: unknown)
            local sound = settings[spec.sound] :: Values?
            local candidate = if settings[spec.usePreset] then settings[spec.presetId] else settings[spec.assetId]
            settings[spec.usePreset] = value

            if sound then
                setSound(settings, spec, sound, settings[spec.enabled], candidate)
            end
        end
        handlers[name .. " Sound Asset Id"] = function(value: unknown)
            local sound = settings[spec.sound] :: Values?
            local asset = "rbxassetid://" .. (value :: string)
            local candidate = if settings[spec.usePreset] then settings[spec.presetId] else asset
            settings[spec.assetId] = asset

            if sound then
                setSound(settings, spec, sound, settings[spec.enabled], candidate)
            end
        end
    end

    handlers["Cursor Size X"] = function(value: unknown)
        cursorX.value = value
        settings.CustomCursor_CursorSize = getVector2()(value, cursorY.value)
    end
    handlers["Cursor Size Y"] = function(value: unknown)
        cursorY.value = value
        settings.CustomCursor_CursorSize = getVector2()(cursorX.value, value)
    end
    handlers["Animated Cursor Style"] = function(value: unknown)
        settings.CustomCursor_AnimatedStyle = value
        local topbar = findChild(playerGui, "GameTopbar")

        if not topbar then
            return
        end

        local crosshair = findChild(topbar, "Crosshair")

        if crosshair then
            crosshair.Rotation = 0
        end
    end
    return handlers
end
end)())

standaloneModules.createPremiumTrade = ((function()
type Values = { [string]: unknown }
type Worker = { action: (unknown) -> (), target: unknown, getWait: () -> ((number?) -> ()), getIdle: () -> (() -> ()) }
type Bindings = {
    settings: Values, breakTrade: Worker, loopReset: Worker,
    resetAction: (unknown) -> (), resetTarget: unknown,
    getColorTransform: () -> ((unknown) -> unknown),
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local function worker(config: Worker, delay: number?)
        return function()
            local wait = config.getWait()
            local idle = config.getIdle()
            repeat
                while settings.BreakTrade do
                    config.action(config.target)
                    if delay then
                        wait(delay)
                    else
                        wait()
                    end
                end
                idle()
            until false
        end
    end
    return {
        breakTrade = worker(bindings.breakTrade, nil),
        loopReset = worker(bindings.loopReset, 2),
        reset = function() bindings.resetAction(bindings.resetTarget) end,
        shootColor = function(color: unknown)
            settings.CustomShootColorEffect = bindings.getColorTransform()(color)
        end,
    }
end
end)())

standaloneModules.createPremiumCursor = ((function()
type Values = { [string]: unknown }
type Bindings = {
    settings: Values, templates: Values, playerGui: unknown,
    getWait: () -> (() -> ()), getMouse: () -> Values, getIdle: () -> (() -> ()),
    findChild: (unknown, string) -> Values?,
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local function findCrosshair(): Values?
        local topbar = bindings.findChild(bindings.playerGui, "GameTopbar")
        if not topbar then return nil end
        return bindings.findChild(topbar, "Crosshair")
    end

    return {
        custom = function()
            local wait = bindings.getWait()
            local mouse = bindings.getMouse()
            local idle = bindings.getIdle()
            repeat
                local crosshair = findCrosshair()
                if not crosshair then idle(); continue end
                while settings.EnableCustomCursor do
                    wait()
                    local template = settings.CustomCursor_TemplateCursor
                    local image = if template == "Custom" then "rbxassetid://" .. (settings.CustomCursor_CustomId :: string) else bindings.templates[template :: string]
                    crosshair.Size = settings.CustomCursor_CursorSize
                    crosshair.Image = image
                    if not settings.CustomCursor_Animate then
                        crosshair.Rotation = settings.CustomCursor_CursorRotation
                    end
                    mouse.Icon = image
                end
                local default = bindings.templates.Default
                mouse.Icon = default
                crosshair.Icon = default
                crosshair.Rotation = 0
                idle()
            until false
        end,
        animate = function()
            local wait = bindings.getWait()
            local idle = bindings.getIdle()
            repeat
                local crosshair = findCrosshair()
                if not crosshair then idle(); continue end
                local rising: boolean? = nil
                while settings.CustomCursor_Animate do
                    wait()
                    local style = settings.CustomCursor_AnimatedStyle
                    if style == "Spinning Right" then
                        crosshair.Rotation = (crosshair.Rotation :: number) + (settings.CustomCursor_AnimatedSpeed :: number)
                    elseif style == "Spinning Left" then
                        crosshair.Rotation = (crosshair.Rotation :: number) - (settings.CustomCursor_AnimatedSpeed :: number)
                    elseif style == "Swinging" then
                        local rotation = crosshair.Rotation :: number
                        if rising then
                            if rotation < 90 then
                                crosshair.Rotation = rotation + (settings.CustomCursor_AnimatedSpeed :: number)
                                continue
                            end
                            rising = nil
                            continue
                        end
                        if rotation > -90 then
                            crosshair.Rotation = rotation - (settings.CustomCursor_AnimatedSpeed :: number)
                            continue
                        end
                        rising = true
                    end
                end
                crosshair.Rotation = 0
                idle()
            until false
        end,
    }
end
end)())

