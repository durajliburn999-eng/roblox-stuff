local updatePlayerEspWorkers = (function()
-- Original ESP worker lifecycle and line construction after243:520.
-- Requires the four recovered child factories.

type Object = { [string]: unknown }
type Context = {
    state: { [string]: unknown },
    playerName: string,
    wait: unknown, player: unknown, findChild: (unknown, string) -> Object?, settings: unknown,
    formatText: unknown, billboard: Object, nameLabel: Object,
    metadata: unknown, makeInstance: (string) -> Object, color: unknown,
    project: unknown, camera: unknown, makeVector: unknown, makeScale: unknown, atan2: unknown,
    makeFrame: unknown, character: unknown, parts: { string }, rigKey: string, rigIndex: number,
    isLabelEnabled: unknown, isFlatBoxEnabled: unknown, isTracerEnabled: unknown, isCubeBoxEnabled: unknown,
}
type Bindings = {
    getDistanceMetric: () -> unknown,
    getLocalRoot: () -> unknown,
    getStart: () -> ((unknown) -> unknown),
    getCancel: () -> ((unknown) -> ()),
    flatBoxParent: unknown,
    getLookAt: () -> unknown,
    firstOffset: unknown, secondOffset: unknown, thirdOffset: unknown, fourthOffset: unknown,
    tracerParent: unknown, tracerOrigins: unknown, cubeParent: unknown,
    destroy: (unknown) -> (),
}

local distanceWorker = (playerEspWorkers.distanceLabel :: unknown) :: (unknown) -> unknown
local tracerWorker = (playerEspWorkers.tracer :: unknown) :: (unknown) -> unknown
local flatWorker = (playerEspWorkers.flatBox :: unknown) :: (unknown) -> unknown
local cubeWorker = (playerEspWorkers.cubeBox :: unknown) :: (unknown) -> unknown

local function startWorker(context: Context, bindings: Bindings, key: string, callback: unknown)
    if context.state[key] then
        return
    end

    local start = bindings.getStart()
    context.state[key] = start(callback)
end

local function stopWorker(context: Context, bindings: Bindings, key: string)
    local worker = context.state[key]

    if not worker then
        return
    end

    local cancel = bindings.getCancel()
    cancel(worker)
    context.state[key] = nil
end

local function updateLabel(context: Context, bindings: Bindings)
    local key = context.playerName .. "_espOnRender"

    if context.isLabelEnabled then
        local lastKey = context.playerName .. "_espLastFunc"
        local callback = context.state[lastKey]

        if not callback then
            local distanceMetric = bindings.getDistanceMetric()
            local wait, player, displayName = context.wait, context.player, context.playerName
            callback = distanceWorker({
                getWait = function() return wait end, getPlayer = function() return player end,
                findChild = context.findChild, settings = context.settings, getName = function() return displayName end,
                format = context.formatText, billboard = context.billboard, getLocalRoot = bindings.getLocalRoot,
                label = context.nameLabel, distanceMetric = distanceMetric,
            })
            context.state[lastKey] = callback
        end

        startWorker(context, bindings, key, callback)
    end

    if not context.isLabelEnabled then
        stopWorker(context, bindings, key)
    end

    context.billboard.Enabled = context.isLabelEnabled
end

local function findFolder(context: Context, parent: unknown): Object
    local folder = context.findChild(parent, context.playerName)

    if folder then
        return folder
    end

    local created = context.makeInstance("Folder")
    created.Name = context.playerName
    created.Parent = parent
    return created
end

local function findLine(context: Context, parent: unknown, name: string): Object
    local line = context.findChild(parent, name)

    if not line then
        local created = context.makeInstance("Frame")
        line = created
        created.Name = name
        created.Parent = parent
        created.BorderSizePixel = 0
        created.AnchorPoint = context.metadata
    end

    local current = line :: Object
    current.BackgroundColor3 = context.color
    return current
end

local function updateFlatBox(context: Context, bindings: Bindings)
    local folder = findFolder(context, bindings.flatBoxParent)
    local top = findLine(context, folder, "1")
    local right = findLine(context, folder, "2")
    local left = findLine(context, folder, "3")
    local bottom = findLine(context, folder, "4")
    local key = context.playerName .. "_espboxOnRender"

    if context.isFlatBoxEnabled then
        local lastKey = context.playerName .. "_espboxLastFunc"
        local callback = context.state[lastKey]

        if not callback then
            local makeLookAt = bindings.getLookAt()
            local firstOffset, secondOffset, thirdOffset, fourthOffset = bindings.firstOffset, bindings.secondOffset, bindings.thirdOffset, bindings.fourthOffset
            local wait, player, project, camera, vector, scale, atan = context.wait, context.player, context.project, context.camera, context.makeVector, context.makeScale, context.atan2
            callback = flatWorker({
                getWait = function() return wait end, getPlayer = function() return player end,
                findChild = context.findChild, getProject = function() return project end, getCamera = function() return camera end,
                makeFrame = makeLookAt, firstOffset = firstOffset, secondOffset = secondOffset, thirdOffset = thirdOffset, fourthOffset = fourthOffset,
                getVector = function() return vector end, getScale = function() return scale end, getAtan2 = function() return atan end,
                top = top, right = right, left = left, bottom = bottom,
            })
            context.state[lastKey] = callback
        end

        startWorker(context, bindings, key, callback)
    end

    if not context.isFlatBoxEnabled then
        stopWorker(context, bindings, key)
        top.Visible = false
        right.Visible = false
        left.Visible = false
        bottom.Visible = false
    end
end

local function updateTracer(context: Context, bindings: Bindings)
    local parent = bindings.tracerParent
    local line = context.findChild(bindings.tracerParent, context.playerName)

    if not line then
        local created = context.makeInstance("Frame")
        line = created
        created.Name = context.playerName
        created.Parent = parent
        created.BorderSizePixel = 0
        created.AnchorPoint = context.metadata
    end

    local currentLine = line :: Object
    currentLine.BackgroundColor3 = context.color
    local key = context.playerName .. "_tracerOnRender"

    if context.isTracerEnabled then
        local lastKey = context.playerName .. "_tracerLastFunc"
        local callback = context.state[lastKey]

        if not callback then
            local origins = bindings.tracerOrigins
            local wait, player, project, camera, vector, scale, atan = context.wait, context.player, context.project, context.camera, context.makeVector, context.makeScale, context.atan2
            callback = tracerWorker({
                getWait = function() return wait end, getPlayer = function() return player end,
                line = currentLine, findChild = context.findChild,
                getProject = function() return project end, getCamera = function() return camera end,
                getVector = function() return vector end, origins = origins, settings = context.settings,
                getScale = function() return scale end, getAtan2 = function() return atan end,
            })
            context.state[lastKey] = callback
        end

        startWorker(context, bindings, key, callback)
    end

    if not context.isTracerEnabled then
        stopWorker(context, bindings, key)
        currentLine.Visible = false
    end
end

local function discardCubeLines(lines: { [number]: unknown }, bindings: Bindings)
    for base = 1, #lines, 13 do
        lines[base] = nil

        for index = base + 1, base + 12 do
            local line = lines[index]
            local destroy = bindings.destroy
            destroy(line)
            lines[index] = nil
        end
    end
end

local function hideCubeLines(lines: { [number]: unknown })
    for base = 1, #lines, 13 do
        for index = base + 1, base + 12 do
            local line = lines[index] :: Object
            line.Visible = false
        end
    end
end

local function populateCubeLines(context: Context, folder: Object, lines: { [number]: unknown })
    local base = 1

    for partIndex = 1, #context.parts do
        local partName = context.parts[partIndex]
        lines[base] = context.findChild(context.character, partName)

        for edge = 1, 12 do
            local name = ("%*%*%*"):format(partName, partIndex, edge)
            local line = context.findChild(folder, name)

            if line then
                line.BackgroundColor3 = context.color
            end

            if not line then
                local created = context.makeInstance("Frame")
                line = created
                created.Name = name
                created.Parent = folder
                created.BorderSizePixel = 0
                created.BackgroundColor3 = context.color
                created.AnchorPoint = context.metadata
            end

            lines[base + edge] = line
        end

        base += 13
    end
end

local function updateCubeBox(context: Context, bindings: Bindings)
    local folder = findFolder(context, bindings.cubeParent)
    local key = context.playerName .. "_espCubeOnRender"
    local linesKey = context.playerName .. "_espCubeQuads"
    local lines = context.state[linesKey] :: { [number]: unknown }?

    if not lines then
        lines = {}
    end

    context.state[linesKey] = lines
    local currentLines = lines :: { [number]: unknown }

    if not context.isCubeBoxEnabled then
        stopWorker(context, bindings, key)
        hideCubeLines(currentLines)
        context.state[context.rigKey] = context.rigIndex
        return
    end

    local lastKey = context.playerName .. "_espCubeLastFunc"
    local callback = context.state[lastKey]
    local previousRig = context.state[context.rigKey]

    if previousRig ~= context.rigIndex then
        discardCubeLines(currentLines, bindings)
    end

    populateCubeLines(context, folder, currentLines)

    if not callback then
        local wait, camera, project, atan, scale, vector, frame, player = context.wait, context.camera, context.project, context.atan2, context.makeScale, context.makeVector, context.makeFrame, context.player
        callback = cubeWorker({
            getWait = function() return wait end, getCamera = function() return camera end,
            getProject = function() return project end, getAtan2 = function() return atan end,
            getScale = function() return scale end, getVector = function() return vector end,
            getFrame = function() return frame end, parts = currentLines, getPlayer = function() return player end,
        })
        context.state[lastKey] = callback
    end

    startWorker(context, bindings, key, callback)
    context.state[context.rigKey] = context.rigIndex
end

return function(context: Context, bindings: Bindings)
    updateLabel(context, bindings)
    updateFlatBox(context, bindings)
    updateTracer(context, bindings)
    updateCubeBox(context, bindings)
end
end)()

