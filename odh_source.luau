        local minimizeColor = fromRGB(20, 20, 20)
        local fromOffset = dimensions.fromOffset :: (number, number) -> unknown
        local particleSetup = makeParticles({ createInstance = create, makeName = core.makeName, parent = core.base.root.screen,
            fromRGB = fromRGB, fromOffset = fromOffset, dimension = (environment.UDim :: Values).new,
            random = (environment.math :: Values).random, gradientColor = (selection.getGameGradient :: () -> unknown)(),
