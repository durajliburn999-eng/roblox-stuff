local createGunPickupHandler = (function()

type Player = { Character: unknown }
type Roles = { Sheriffs: { unknown }, Hero: unknown, Murderers: { unknown } }
type Settings = {
    GunDrop: unknown,
    refresh_roles: () -> (),
    roles: Roles,
    GunPickupNotify: unknown,
    AutoEquipGunUponPickUp: unknown,
    find_gun: (Player) -> unknown,
    SheriffGun_REMOTE: unknown,
}
type Bindings = {
    settings: Settings,
    isStopped: () -> unknown,
    checkpointClock: () -> number,
    checkpointWait: () -> (),
    canYield: () -> unknown,
    getWait: () -> (() -> ()),
    getNotify: () -> ((unknown) -> ()),
    getFormat: () -> ((string, unknown) -> unknown),
    getLocalPlayer: () -> unknown,
    getClock: () -> (() -> number),
    getGunPlayer: () -> Player,
    shooting: (Roles, unknown, unknown) -> unknown,
}
local shoot = (shootAfterGunPickup :: unknown) :: (unknown) -> ()

local function waitForGun(bindings: Bindings, wait: () -> (), checkpoint: () -> ()): (unknown, unknown)
    local settings = bindings.settings
    local clock = bindings.getClock()
    local player = bindings.getGunPlayer()
    local findGun = settings.find_gun
    local startedAt = clock()
    local gun: unknown = nil
    local remote: unknown = nil

    while true do
        checkpoint()

        if clock() - startedAt > 5 then
            break
        end

        if not player.Character then
            break
        end

        gun = findGun(player)
        remote = settings.SheriffGun_REMOTE

        if gun and remote then
            break
        end
    end

    wait()
    return gun, remote
end

return function(bindings: Bindings)
    local checkpoint = createCheckpoint(bindings.isStopped, bindings.checkpointClock, bindings.checkpointWait, bindings.canYield)

    return function(removed: unknown)
        local settings = bindings.settings

        if removed ~= settings.GunDrop then
            return
        end

        local wait = bindings.getWait()
        settings.GunDrop = nil
        wait()
        settings.refresh_roles()
        wait()
        local roles = settings.roles
        local sheriff = roles.Sheriffs[1]
        local isHero = roles.Hero

        if settings.GunPickupNotify and sheriff and isHero then
            local notify = bindings.getNotify()
            local format = bindings.getFormat()
            local message = format('<font color="rgb(0, 255, 0)">%*</font> grabbed the gun.', sheriff)
            notify(message)
        end

        if not settings.AutoEquipGunUponPickUp then
            return
        end

        local localPlayer = bindings.getLocalPlayer()

        if sheriff ~= localPlayer or not isHero then
            return
        end

        local gun, remote = waitForGun(bindings, wait, checkpoint)

        if not gun or not remote then
            return
        end

        shoot(bindings.shooting(roles, gun, remote))
    end
end
end)()

local selectFarmCoin = (function()

type Vector = typeof(setmetatable({}, { __sub = function(left, _right) return left end }))
type Coin = { Name: unknown, Position: Vector }
type Bindings = {
    settings: { [string]: unknown, CoinType: string, RareEggTopPriority: unknown },
    find: (Coin, string) -> unknown,
    dot: (Vector, Vector) -> number,
    origin: Vector,
    selectedType: string?,
}
local filter = (filterFarmCoin :: unknown) :: (unknown, Coin, string) -> (string?, string?)

return function(bindings: Bindings, coins: { Coin }): (Coin?, string?)
    local selected = bindings.selectedType or bindings.settings.CoinType
    local closestDistance = math.huge
    local closest: Coin? = nil
    local closestId: string? = nil

    for index = 1, #coins do
        local coin = coins[index]
        local decision, coinId = filter(bindings, coin, selected)

        if decision == "priority" then
            return coin, coinId
        end

        if decision ~= "normal" then
            continue
        end

        local displacement = bindings.origin - coin.Position
        local distance = bindings.dot(displacement, displacement)

        if closestDistance <= distance then
            continue
        end

        closestDistance = distance
        closest = coin
        closestId = coinId
    end

    return closest, closestId
end
end)()

