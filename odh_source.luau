standaloneModules.setupFarmMain = ((function()

type Values = { [string]: any }
local populate = (standaloneModules.populateFarmMainUi :: unknown) :: (unknown, Values, unknown, unknown) -> unknown
local makeActions = (createFarmUiActions :: unknown) :: (Values) -> Values
local makeWorker = (standaloneModules.createFarmWorker :: unknown) :: (Values, unknown) -> unknown
