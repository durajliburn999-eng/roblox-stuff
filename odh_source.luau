    settings: Settings,
    getWaitFrame: () -> (() -> ()),
    activationState: unknown,
    resetState: unknown,
    getState: () -> ((Humanoid) -> unknown),
    getDot: () -> ((Vector, Vector) -> number),
    zeroVelocity: Vector,
    getHumanoid: () -> Humanoid?,
    getRoot: () -> Root?,
