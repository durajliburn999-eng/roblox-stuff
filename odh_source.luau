            draggable = owner.addDraggable, drag = {}, prepareTweens = function()
                local navigation, search = nodes.navigation :: Values, nodes.search :: Values
                scroll = makeScrollIndicator({ owner = owner, createInstance = create, parent = shell.background,
                    navigate = navigation.navigate, indicator = navigation.indicator, search = search.bar,
                    fromScale = dimensions.fromScale, vector = (environment.Vector2 :: Values).new,
                    fromRGB = fromRGB, font = (enums.Font :: Values).Jura,
                    tweenInfo = playback.tweenInfo, cubic = playback.cubic, transitionInfo = tweens.transitionInfo,
                    createTween = playback.createTween, tweenService = playback.tweenService })
                local scrollData = scroll :: Values
                ;(core.playback.play :: (unknown, boolean?) -> ())(scrollData.reveal, true)
                local stats, whitelist = nodes.stats :: Values, nodes.whitelist :: Values
                local back = makeNavigationBack({ owner = owner, play = core.playback.play, sound = owner.TouchSFX,
                    search = search.bar, fromScale = dimensions.fromScale, overview = stats.overview,
                    fps = (stats.fps :: Values).group, ping = (stats.ping :: Values).group, whitelist = whitelist.bar,
                    tabs = nodes.tabBar, instruction = scrollData.instruction, navigate = navigation.navigate, indicator = navigation.indicator,
                    createTween = playback.createTween, tweenService = playback.tweenService, tweenInfo = tweens.transitionInfo,
                    goal = scrollData.containerGoal, tabReveal = tweens.tabReveal, overviewReveal = tweens.overviewReveal,
                    fpsReveal = tweens.fpsReveal, pingReveal = tweens.pingReveal, whitelistReveal = tweens.whitelistReveal,
                    hideSearch = scrollData.hideSearch, hideNavigate = scrollData.hideNavigate, hideIndicator = scrollData.hideIndicator,
                    restoreInstruction = scrollData.restore, destroy = core.playback.destroy })
                local connect = ownerUi.connect :: (unknown, () -> ()) -> ()
                connect((navigation.navigate :: Values).Activated, back)
                local makeSize = dimensions.new :: (number, number, number, number) -> unknown
                local tween = playback.createTween :: (unknown, unknown, unknown, Values) -> unknown
                local release = tween(playback.tweenService, nodes.maximize, tweens.transitionInfo, { Size = makeSize(0.025, 35, 0.025, 35) })
                local start = tween(playback.tweenService, nodes.maximize, tweens.transitionInfo, { Size = makeSize(0.025, 38, 0.025, 38) })
                return release, start
            end,
            open = { getBusy = function() return busy end, setBusy = function(value: boolean) busy = value end,
