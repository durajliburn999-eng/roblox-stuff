standaloneModules.configureWorldClutch = ((function()
type Values = { [string]: any }
type Frame = typeof(setmetatable({}, { __mul = function(left, _right) return left end }))
type Object = { Parent: unknown, Transparency: unknown, CFrame: Frame }
type Bindings = { state: Values, workspace: unknown, player: unknown, offset: Frame,
