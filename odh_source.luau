    anchor: unknown,
    updateTracer: unknown,
    boxParent: unknown,
    boxes: { [unknown]: unknown },
    getFrame: () -> ((number, number, number) -> { Position: unknown }),
    updateBox: unknown,
}
type Context = {
    bindings: Bindings,
    write: (unknown, string, unknown) -> (),
    object: Object,
    className: string,
    isGlobal: unknown,
    isEnabled: unknown,
    title: string,
    displayTitle: unknown,
    key: string,
    objectName: string,
    color: unknown,
    defaultColor: unknown,
    depthMode: unknown,
    environment: { _idk: unknown },
    format: (string, ...unknown) -> string,
    options: { [string]: { [number]: unknown } },
    style: string,
}

local function create(context: Context, className: string): Object
    return context.bindings.getCreate()(className)
end

local function objectSize(context: Context): unknown
    if context.className == "Model" then
        local getExtentsSize = context.object.GetExtentsSize :: (Object) -> unknown
        return (getExtentsSize(context.object))
    end

    return context.object.Size
end

local function renderCham(context: Context)
    local bindings, write = context.bindings, context.write
    local cham = bindings.active[context.key]

    if not cham then
        local name = context.title .. "_CHAM"

        if not context.isGlobal then
            cham = bindings.find(context.object, name)
        end

        if not cham then
            cham = create(context, "BoxHandleAdornment")
            write(cham, "Name", name)
            local parent: unknown = context.object

            if context.isGlobal then
                parent = bindings.chamParent
            end

            write(cham, "Parent", parent)
            write(cham, "Transparency", 0.7)
            write(cham, "Color3", context.color)
            write(cham, "Size", objectSize(context))
            write(cham, "AlwaysOnTop", true)
            write(cham, "ZIndex", 10)
        end
    end

    write(cham, "Adornee", context.object)
    write(cham, "Visible", context.isEnabled)

    if context.isGlobal then
        bindings.active[context.key] = cham
    end
end

local function renderHighlight(context: Context)
    local bindings, write = context.bindings, context.write
    local highlight: unknown = bindings.find(context.object, "_idk_")

    if not context.environment._idk then
        highlight = create(context, "Highlight")
        write(highlight, "Name", "_idk_")
        write(highlight, "Adornee", context.object)
        write(highlight, "DepthMode", context.depthMode)
        write(highlight, "OutlineColor", context.color)
        write(highlight, "FillColor", context.color)
        write(highlight, "Parent", context.object)
    end

    local outlineKey = context.format("Outline%*%*", context.objectName, context.className)
    local outline = context.options[outlineKey]
    local outlineTransparency = 1

    if outline and outline[6] then
        outlineTransparency = 0.25
    end

    write(highlight, "OutlineTransparency", outlineTransparency)
    local fillKey = context.format("Highlight%*%*", context.objectName, context.className)
    local fill = context.options[fillKey]
    local fillTransparency = 1

    if fill and fill[6] then
        fillTransparency = 0.25
    end

    write(highlight, "FillTransparency", fillTransparency)
end

local function createTitle(context: Context, billboard: unknown, size: unknown): Object
    local bindings, write = context.bindings, context.write
    local title = create(context, "TextLabel")
    write(title, "Name", "TxT")
    write(title, "BackgroundTransparency", 1)
    write(title, "Size", size)
    write(title, "Text", context.title)
    write(title, "Font", bindings.labelFont)
    write(title, "TextSize", 13)
    write(title, "TextColor3", context.defaultColor)
    write(title, "Parent", billboard)
    return title
end

local function renderLabel(context: Context)
    local bindings, write = context.bindings, context.write
    local size = bindings.labelSize
    local parent: unknown = context.object

    if context.isGlobal then
        parent = bindings.labelParent
    end

    local name = context.title .. "_ESP"
    local billboard: Object? = bindings.find(parent, name)

    if not billboard then
        billboard = create(context, "BillboardGui")
        write(billboard, "Name", name)
        write(billboard, "ExtentsOffset", bindings.labelOffset)
        write(billboard, "Size", size)
        write(billboard, "AlwaysOnTop", true)
        write(billboard, "Parent", parent)
    end

    write(billboard, "Adornee", context.object)
    write(billboard, "Enabled", context.isEnabled)
    local title = bindings.find(billboard, "TxT")

    if not title then
        title = createTitle(context, billboard, size)
    end

    local stroke = bindings.find(title, "Stroke")

    if not stroke then
        stroke = create(context, "UIStroke")
        write(stroke, "Name", "Stroke")
        write(stroke, "Transparency", 0.55)
        write(stroke, "Thickness", 2)
        write(stroke, "Parent", title)
    end

    write(stroke, "Color", context.color)

    if not context.isEnabled then
        return
    end

    bindings.active[context.object] = true
    local spawn = bindings.getSpawn()
    local update = bindings.updateLabel
    spawn(update, billboard, title, context.object, context.displayTitle, context.className, context.isGlobal, context.key)
end

local function renderTracer(context: Context)
    local bindings, write = context.bindings, context.write
    local parent = bindings.tracerParent
    local name = context.title .. "_TRACER"
    local tracer: unknown = nil

    if context.isGlobal then
        tracer = bindings.find(bindings.tracerParent, name)
    end

    if not context.isGlobal then
        tracer = bindings.tracers[context.object]
    end

    if not tracer then
