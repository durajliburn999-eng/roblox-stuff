standaloneModules.setupBloxWorldBeforeRaid = ((function()
local populate = standaloneModules.populateBloxWorldBeforeRaid
local createPurchases = standaloneModules.createBloxWorldPurchases
local workers = standaloneModules.bloxWorldWorkers

type Values = { [string]: any }
type WorkerSet = {
    autoTradeBone: (Values) -> unknown,
    autoBuyRandomFruit: (Values) -> unknown,
    autoLegendarySword: (Values) -> unknown,
    autoSeaPurchase: (Values, string, string, string) -> unknown,
    autoCraft: (Values, string, string) -> unknown,
}
local makePurchases = (createPurchases :: unknown) :: (Values) -> Values
local populateBeforeRaid = (populate :: unknown) :: (Values, Values, (number, string, unknown) -> unknown) -> unknown
local autoWorkers = (workers :: unknown) :: WorkerSet

return function(tab: Values, bindings: Values, state: (number, string, unknown) -> unknown)
    local ownerUi, settings, coroutineApi = bindings.ownerUi, bindings.settings, bindings.coroutineApi
    local remote = ownerUi.replicatedStorage.Remotes.CommF_
    local invoke = ownerUi.invokeServer
    local callbacks = makePurchases({ remote = remote, invoke = invoke })
    local workerBindings = { settings = settings, remote = remote, invoke = invoke,
        getWait = function() return ownerUi.wait end, getIdle = function() return coroutineApi.yield end,
        getString = function() return bindings.environment.tostring end,
        getRandom = function() return bindings.environment.math.random end }
    local generators: Values = {
        ["Auto Trade Bone"] = function() return autoWorkers.autoTradeBone(workerBindings) end,
        ["Auto Buy Random Fruit"] = function() return autoWorkers.autoBuyRandomFruit(workerBindings) end,
        ["Auto Buy Legendary Sword"] = function() return autoWorkers.autoLegendarySword(workerBindings) end,
        ["Auto Buy Gear"] = function() return autoWorkers.autoSeaPurchase(workerBindings, "AutoBuyGear", "UpgradeRace", "Buy") end,
        ["Auto Buy Haki Color"] = function() return autoWorkers.autoSeaPurchase(workerBindings, "AutoBuyHakiColor", "ColorsDealer", "2") end,
        ["Buy Selected Raid Chip"] = function()
            return function() invoke(remote, "RaidsNpc", "Select", settings.Raid_SelectChips) end
        end,
    }
    for _, option in { { "Common", "AutoCraftCommon" }, { "Rare", "AutoCraftRare" },
        { "Legendary", "AutoCraftLegendary" }, { "Mythical", "AutoCraftMythical" } } do
        generators["Auto Craft " .. option[1] .. " Scroll"] = function()
            return autoWorkers.autoCraft(workerBindings, option[2], option[1] .. "Scroll")
        end
    end
    setmetatable(callbacks, { __index = function(target, key): any
