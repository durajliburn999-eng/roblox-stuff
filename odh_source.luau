standaloneModules.createKnifeTimingHooks = ((function()
type Values = { [string]: any }

return function(state: Values, clock: () -> number, finish: () -> ())
    local function primaryDown()
        if state.action2 and not state.action3 then
            state.pressedAt = clock()
        end
    end

    local function secondaryDown()
        if state.action1 or state.action2 or state.action3 or not state.equipped then
            return
        end

        state.pressedAt = clock()
    end

    local function primaryUp()
        if clock() - state.pressedAt > 0.3 then return end
        if not state.action2 or state.action3 or not state.equipped then return end

        state.track:Stop()
