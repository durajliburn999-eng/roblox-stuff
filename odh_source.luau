standaloneModules.createMainAntiVoid = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    settings: Values, getWait: () -> (() -> ()), destination: unknown, getMove: () -> ((unknown, unknown) -> ()),
    zeroVelocity: unknown, threshold: number, getIdle: () -> (() -> ()), root: Cell, target: Cell,
}

return function(bindings: Bindings)
    return function()
        local wait, move, idle = bindings.getWait(), bindings.getMove(), bindings.getIdle()
        local below: boolean? = nil
        repeat
            while bindings.settings.AntiVoid do
                wait()
                local root = bindings.root.value :: Values?
                if not root then continue end
                local previous = below
                if (root.CFrame :: { Y: number }).Y > bindings.threshold then
                    below = nil
                    continue
                end
                if previous then
                    below = previous
                else
                    below = true
                    root.Velocity = bindings.zeroVelocity
                end
                local target = bindings.target.value
                if target then move(target, bindings.destination) end
            end
            idle()
        until false
    end
end
end)())

standaloneModules.createMainAntiFling = ((function()
type Values = { [string]: unknown }
type Player = { Character: unknown }
type Bindings = {
    settings: Values, findChild: (unknown, string) -> Values?, getDescendants: (unknown) -> { unknown },
    isA: (unknown, string) -> unknown, getPlayers: () -> { Player }, getWait: () -> (() -> ()),
    properties: unknown, zeroVelocity: unknown, getIdle: () -> (() -> ()),
}

return function(bindings: Bindings)
    return function()
        local players, wait, idle = bindings.getPlayers(), bindings.getWait(), bindings.getIdle()
        local settings = bindings.settings
        repeat
            while settings.AntiFling do
                wait()
                if settings.Flinging then continue end
                for index = 2, #players do
                    local player = players[index]
                    if not player then continue end
                    local character = player.Character
                    if not character then continue end
                    local root = bindings.findChild(character, "HumanoidRootPart")
                    if not root then continue end
                    local angular = root.AssemblyAngularVelocity :: { Magnitude: number }
                    if angular.Magnitude <= 50 then
                        local linear = root.AssemblyLinearVelocity :: { Magnitude: number }
                        if linear.Magnitude <= 100 then continue end
                    end
                    local descendants = bindings.getDescendants(character)
                    for descendantIndex = 1, #descendants do
                        local descendant = descendants[descendantIndex]
                        if not bindings.isA(descendant, "BasePart") then continue end
                        local part = descendant :: Values
                        part.CanCollide = false
                        part.AssemblyAngularVelocity = bindings.zeroVelocity
                        part.AssemblyLinearVelocity = bindings.zeroVelocity
                        part.CustomPhysicalProperties = bindings.properties
                    end
                end
            end
            idle()
        until false
    end
end
end)())

standaloneModules.createMainAppearance = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Subscription = { getConnect: () -> ((unknown, unknown) -> unknown), signal: unknown, connection: Cell, getDisconnect: () -> ((unknown) -> ()) }
type Bindings = {
    getWait: () -> ((number) -> ()), character: Cell, findChild: (unknown, string) -> Values?,
    getDescendants: (unknown) -> { Values }, korblox: Subscription, headless: Subscription,
}

return function(bindings: Bindings)
    local function korblox()
        bindings.getWait()(0.5)
        local character = bindings.character.value
        if not character then return end
        local lower = bindings.findChild(character, "RightLowerLeg")
        if not lower then return end
        local upper = bindings.findChild(character, "RightUpperLeg")
        if not upper then return end
        local foot = bindings.findChild(character, "RightFoot")
        if not foot then return end
        lower.MeshId = "http://www.roblox.com/asset/?id=902942093"
        lower.Transparency = 1
        upper.MeshId = "http://www.roblox.com/asset/?id=902942096"
        upper.TextureID = "http://roblox.com/asset/?id=902843398"
        foot.MeshId = "http://www.roblox.com/asset/?id=902942089"
        foot.Transparency = 1
    end
    local function headless()
        bindings.getWait()(0.5)
        local character = bindings.character.value
        if not character then return end
        local head = bindings.findChild(character, "Head")
        if not head then return end
        local descendants = bindings.getDescendants(head)
        for index = 1, #descendants do
            if descendants[index].ClassName == "Decal" then head.Transparency = 1 end
        end
        head.Transparency = 1
    end
    local function permanent(config: Subscription, apply: () -> ())
        return function(value: unknown)
            if value then
                config.connection.value = config.getConnect()(config.signal, apply)
                apply()
                return
            end
            config.getDisconnect()(config.connection.value)
        end
    end
    return { korblox = korblox, headless = headless, permanentKorblox = permanent(bindings.korblox, korblox),
        permanentHeadless = permanent(bindings.headless, headless) }
end
end)())

