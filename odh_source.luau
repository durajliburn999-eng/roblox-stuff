local playerEspWorkers = (function()
-- Four recovered children of player ESP builder 1421.
-- Distance label, tracer and flat/cube box drawing callbacks.
type Vector2 = typeof(setmetatable({ X = 0, Y = 0, Magnitude = 0 }, {
    __add = function(left, _right) return left end,
    __sub = function(left, _right) return left end,
    __div = function(left, _divisor) return left end,
}))
type Vector3 = typeof(setmetatable({}, { __sub = function(left, _right) return left end }))
type Root = { Parent: unknown, Position: Vector3 }
type Character = { Parent: unknown }
type Player = { Character: Character? }
type Line = { Visible: unknown, Position: unknown, Rotation: number, Size: unknown }
type DistanceBindings = {
    getWait: () -> (() -> ()),
    getPlayer: () -> Player,
    findChild: (Character, string) -> unknown,
    settings: { ESPDisplayDistance: unknown },
    getName: () -> unknown,
    format: (string, ...unknown) -> string,
    billboard: { Adornee: unknown },
    getLocalRoot: () -> Root?,
    label: { Text: unknown },
    distanceMetric: (Vector3, Vector3) -> number,
}
type TracerBindings = {
    getWait: () -> (() -> ()),
    getPlayer: () -> Player,
    line: Line,
    findChild: (Character, string) -> unknown,
    getProject: () -> ((unknown, Vector3) -> ({ X: number, Y: number }, boolean)),
    getCamera: () -> unknown,
    getVector: () -> ((number, number) -> Vector2),
    origins: { [unknown]: Vector2 },
    settings: { TracerLocation: unknown },
    getScale: () -> ((number, number) -> unknown),
    getAtan2: () -> ((number, number) -> number),
}

local function distanceLabel(bindings: DistanceBindings)
    local findChild, settings = bindings.findChild, bindings.settings
    local formatText, billboard, label, distanceMetric = bindings.format, bindings.billboard, bindings.label, bindings.distanceMetric

    return function()
        local wait = bindings.getWait()
        local player = bindings.getPlayer()
        local displayName = bindings.getName()
        local character: Character? = nil
        local root: Root? = nil
        local localRoot: Root? = nil

        repeat
            wait()

            if not character or not character.Parent then
                character = player.Character

                if not character then
                    continue
                end

                root = findChild(character, "HumanoidRootPart") :: Root?

                if not root then
                    character = nil
                    continue
                end

                billboard.Adornee = root
            end

            if not settings.ESPDisplayDistance then
                label.Text = displayName
                continue
            end

            if not localRoot or not localRoot.Parent then
                localRoot = bindings.getLocalRoot()

                if not localRoot then
                    label.Text = displayName
                    continue
                end
            end

            local displacement = (localRoot :: Root).Position - (root :: Root).Position
            label.Text = formatText("%*\nDistance: %.1f", displayName, distanceMetric(displacement, displacement) ^ 0.5)
        until false
    end
end

local function tracer(bindings: TracerBindings)
    local line, findChild, origins, settings = bindings.line, bindings.findChild, bindings.origins, bindings.settings

    return function()
        local wait = bindings.getWait()
        local player = bindings.getPlayer()
        local project = bindings.getProject()
        local camera = bindings.getCamera()
        local makeVector = bindings.getVector()
        local makeScale = bindings.getScale()
        local atan2 = bindings.getAtan2()
        local character: Character? = nil
        local root: Root? = nil

        repeat
            wait()

            if not character or not character.Parent then
                character = player.Character

                if not character then
                    line.Visible = false
                    continue
                end

                root = findChild(character, "HumanoidRootPart") :: Root?

                if not root then
                    line.Visible = false
                    character = nil
                    continue
                end
            end

            local position, visible = project(camera, (root :: Root).Position)
            line.Visible = visible

            if not visible then
                continue
            end

            local target = makeVector(position.X, position.Y)
            local origin = origins[settings.TracerLocation]
            local direction, midpoint = target - origin, (target + origin) / 2
            line.Position = makeScale(midpoint.X, midpoint.Y)
            line.Rotation = atan2(direction.Y, direction.X) * 57.29577951308232
            line.Size = makeScale(direction.Magnitude, 1)
        until false
    end
end



