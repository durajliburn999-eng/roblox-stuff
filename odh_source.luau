local populateCombatUi = (function()

type Section = {
    [string]: unknown,
    AddLabel: (Section, ...unknown) -> (),
    AddParagraph: (Section, ...unknown) -> (),
    AddToggle: (Section, ...unknown) -> unknown,
    AddButton: (Section, ...unknown) -> (),
    AddSlider: (Section, ...unknown) -> unknown,
    AddDropdown: (Section, ...unknown) -> (),
    AddPlayerDropdown: (Section, ...unknown) -> (),
    AddTextBox: (Section, ...unknown) -> (),
    AddColorpicker: (Section, ...unknown) -> (),
    AddKeybind: (Section, ...unknown) -> (),
}
type Tab = { AddSection: (Tab, ...unknown) -> Section }
type Bindable = (number, unknown, string, string, unknown, unknown, unknown) -> unknown
type Bindings = {
    settings: unknown,
    stateDispatch: unknown,
    stateTransform: unknown,
    bindable: Bindable,
    callbacks: { [string]: unknown },
    options: { [string]: unknown },
    colors: { [string]: unknown },
    keybinds: { [string]: unknown },
    premiumEnabled: boolean,
    exclusiveEnabled: boolean,
    onFluxPingSlider: ((unknown) -> ())?,
    onFluxPresetControl: ((number, unknown) -> ())?,
    onRevertPingSlider: ((unknown) -> ())?,
    onRevertPresetControl: ((number, unknown) -> ())?,
}
local makeState = (createStateCallback :: unknown) :: (unknown) -> (number, string, unknown) -> unknown
local populateAimlock = (standaloneModules.populateCombatAimlockUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local populateSheriff = (standaloneModules.populateCombatSheriffUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local populateMurderer = (standaloneModules.populateCombatMurdererUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local populateRevert = (standaloneModules.populateCombatRevertUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local populateFlux = (standaloneModules.populateCombatFluxUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local populateHitbox = (standaloneModules.populateCombatHitboxUi :: unknown) :: (unknown, unknown, unknown) -> unknown

return function(tab: Tab, bindings: Bindings)
    local state = makeState({ settings = bindings.settings, dispatch = bindings.stateDispatch, transform = bindings.stateTransform })
    populateAimlock(tab, bindings, state)

    populateSheriff(tab, bindings, state)

    populateMurderer(tab, bindings, state)

    if bindings.exclusiveEnabled then populateRevert(tab, bindings, state) end
    if bindings.premiumEnabled then populateFlux(tab, bindings, state) end

    populateHitbox(tab, bindings, state)
end
end)()

local populateCombatFeature = (function()

type Values = { [string]: unknown }
type Bindings = { ui: Values, effects: Values }
local populateUi = (populateCombatUi :: unknown) :: (unknown, Values) -> ()
local makeAutoShoot = (createAutoShoot :: unknown) :: (Values) -> unknown
local makeGunTrigger = (createMm2Triggerbot :: unknown) :: (Values) -> unknown
local makeKnifeAura = (standaloneModules.createKnifeAura :: unknown) :: (Values) -> unknown
local makeHitboxExpander = (standaloneModules.createHitboxExpander :: unknown) :: (Values) -> unknown
local makeAutoKill = (standaloneModules.createAutoKill :: unknown) :: (Values) -> { [string]: unknown }
local makeControls = (standaloneModules.createCombatControls :: unknown) :: (Values) -> { [string]: unknown }
local makeKillPlayer = (standaloneModules.createKillPlayer :: unknown) :: (Values) -> unknown
local makeFlux = (standaloneModules.createCombatFlux :: unknown) :: (Values) -> { [string]: unknown }
local makePing = (standaloneModules.createCombatPing :: unknown) :: (Values, string?) -> unknown
local makeFluxLoad = (standaloneModules.createCombatFluxLoad :: unknown) :: (Values, string?) -> unknown
local makeFluxSave = (standaloneModules.createCombatFluxSave :: unknown) :: (Values, string?) -> unknown
local makeAimlock = (createAimlock :: unknown) :: (Values) -> unknown
local makeActions = (standaloneModules.createCombatActions :: unknown) :: (Values) -> { [string]: unknown }
local makeShootMurderer = (standaloneModules.createCombatShootMurderer :: unknown) :: (Values) -> unknown
local makeDual = (standaloneModules.createCombatDual :: unknown) :: (Values, boolean) -> unknown
local makeShootButton = (createCombatShootButton :: unknown) :: (Values) -> unknown
local makeRevert = (standaloneModules.createCombatRevert :: unknown) :: (Values) -> { [string]: unknown }

return function(tab: unknown, bindings: Bindings)
    local ui = table.clone(bindings.ui)
    local callbacks = table.clone(ui.callbacks :: Values)
    local effects = bindings.effects
    local settings = ui.settings
    local function configured(value: unknown): Values
        local result = table.clone(value :: Values)
        result.settings = settings
        return result
    end

    local autoShoot = makeAutoShoot(configured(effects.autoShoot))
    local gunTrigger = makeGunTrigger(configured(effects.gunTrigger))
    local knifeAura = makeKnifeAura(configured(effects.knifeAura))
    local hitboxExpander = makeHitboxExpander(configured(effects.hitboxExpander))
    local autoKill = makeAutoKill(configured(effects.autoKill))
    local controls = makeControls(configured(effects.controls))

    local revert = makeRevert(configured(effects.revert))
    local revertPing = configured(effects.revertPing)
    local revertSlider: { value: unknown } = { value = nil }
    revertPing.slider = revertSlider
    callbacks["REVERT CONFIG/Prioritize Your Ping"] = makePing(revertPing, "Revert")
    ui.onRevertPingSlider = function(slider: unknown) revertSlider.value = slider end
    local revertLoad = configured(effects.revertLoad)
    local revertControls: { unknown } = {}
    local revertState = effects.revert :: Values
    revertLoad.selected, revertLoad.controls, revertLoad.pingSlider = revertState.selectedPreset, revertControls, revertSlider
    callbacks["REVERT CONFIG/Load Preset"] = makeFluxLoad(revertLoad, "Revert")
    ui.onRevertPresetControl = function(index: number, control: unknown) revertControls[index] = control end
    local revertSave = configured(effects.revertSave)
    revertSave.name, revertSave.x, revertSave.y, revertSave.z = revertState.presetName, revertState.x, revertState.y, revertState.z
    callbacks["REVERT CONFIG/Save Preset"] = makeFluxSave(revertSave, "Revert")
    callbacks["REVERT CONFIG/Your Presets"] = revert.select
    callbacks["REVERT CONFIG/Preset Name"] = revert.name
    callbacks["REVERT CONFIG/Prediction Interval"] = revert.interval
    callbacks["REVERT CONFIG/X Position Offset (%)"] = revert.x
    callbacks["REVERT CONFIG/Y Position Offset (%)"] = revert.y
    callbacks["REVERT CONFIG/Z Position Offset (%)"] = revert.z
    callbacks["REVERT CONFIG/Prediction Horizontal Multiplier (%)"] = revert.horizontal
    callbacks["REVERT CONFIG/Prediction Vertical Multiplier (%)"] = revert.vertical

    local flux = makeFlux(configured(effects.flux))
    local fluxPing = configured(effects.fluxPing)
    local pingSlider: { value: unknown } = { value = nil }
    fluxPing.slider = pingSlider
    callbacks["FLUX CONFIG/Prioritize Your Ping\000"] = makePing(fluxPing)
    ui.onFluxPingSlider = function(slider: unknown) pingSlider.value = slider end
    local fluxLoad = configured(effects.fluxLoad)
    local presetControls: { unknown } = {}
    fluxLoad.selected = (effects.flux :: Values).selectedPreset
    fluxLoad.controls = presetControls
    fluxLoad.pingSlider = pingSlider
    callbacks["FLUX CONFIG/Load Preset"] = makeFluxLoad(fluxLoad)
    local fluxSave = configured(effects.fluxSave)
    local fluxState = effects.flux :: Values
    fluxSave.name, fluxSave.x, fluxSave.y, fluxSave.z = fluxState.presetName, fluxState.x, fluxState.y, fluxState.z
    callbacks["FLUX CONFIG/Save Preset"] = makeFluxSave(fluxSave)
    ui.onFluxPresetControl = function(index: number, control: unknown) presetControls[index] = control end
    callbacks["FLUX CONFIG/Your Presets\000"] = flux.select
    callbacks["FLUX CONFIG/Preset Name\000"] = flux.name
    callbacks["FLUX CONFIG/Prediction Interval\000"] = flux.interval
    callbacks["FLUX CONFIG/X Position Offset (%)\000"] = flux.x
    callbacks["FLUX CONFIG/Y Position Offset (%)\000"] = flux.y
    callbacks["FLUX CONFIG/Z Position Offset (%)\000"] = flux.z
    callbacks["FLUX CONFIG/Prediction Horizontal Multiplier (%)\000"] = flux.horizontal
    callbacks["FLUX CONFIG/Prediction Vertical Multiplier (%)\000"] = flux.vertical

    local actions = makeActions(configured(effects.actions))
    callbacks["AIMLOCK/Show Mouse FOV"] = actions.showFov
    callbacks["SHERIFF/Lock Shoot Murderer Button"] = actions.lockShoot
    callbacks["SHERIFF/Shoot Bind"] = actions.shootBind
    callbacks["MURDERER/Custom Perk"] = actions.customPerk
    callbacks["SHERIFF/Gun Silent Aim Prediction"] = actions.gunPrediction
    callbacks["MURDERER/Knife Silent Aim Prediction"] = actions.knifePrediction
    callbacks["SHERIFF/Tiāncái Prediction Offset"] = actions.tiancai
    callbacks["AIMLOCK/Enable Aimlock"] = makeAimlock(configured(effects.aimlock))
    callbacks["AIMLOCK/Mouse FOV Radius"] = controls.fovRadius
    callbacks["MURDERER/Fast Slash Speed (%)"] = controls.fastSlashSpeed
    callbacks["MURDERER/Kill Everyone"] = controls.killEveryone
    callbacks["MURDERER/Kill Sheriff"] = controls.killSheriff
    callbacks["MURDERER/Kill Player"] = makeKillPlayer(configured(effects.killPlayer))
    callbacks["HITBOX EXPANDER/Hitbox Color"] = controls.hitboxColor
    callbacks["HITBOX EXPANDER/Hitbox Size"] = controls.hitboxSize
    callbacks["HITBOX EXPANDER/Hitbox Transparency (%)"] = controls.hitboxTransparency
    callbacks["SHERIFF/Use Gun Dual Effect"] = makeDual(configured(effects.gunDual), false)
    callbacks["MURDERER/Use Knife Dual Effect"] = makeDual(configured(effects.knifeDual), true)
    callbacks["SHERIFF/Show Shoot Murderer Button"] = makeShootButton(effects.shootButton :: Values)
    callbacks["SHERIFF/Shoot Murderer"] = makeShootMurderer(configured(effects.shootMurderer))
    callbacks["SHERIFF/Auto Shoot Murderer"] = autoShoot
    callbacks["SHERIFF/Gun Trigger Bot"] = gunTrigger
    callbacks["MURDERER/Knife Aura"] = knifeAura
    callbacks["MURDERER/Auto Kill Everyone"] = autoKill.everyone
    callbacks["MURDERER/Auto Kill Sheriff"] = autoKill.sheriff
    callbacks["HITBOX EXPANDER/Enable Hitbox Expander"] = hitboxExpander
    ui.callbacks = callbacks
    populateUi(tab, ui)
end
end)()

