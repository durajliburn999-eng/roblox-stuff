return function(bindings: Bindings)
    return function()
        if bindings.busy.value then return end
        bindings.busy.value = true
        local character = bindings.character.value
        if not character then bindings.busy.value = nil; return end
        local root = bindings.root.value :: Values?
        if not root then bindings.busy.value = nil; return end
        local settings = bindings.settings
        local remote = settings.SheriffGun_REMOTE
        if not remote then bindings.busy.value = nil; return end
        local findGun = settings.find_gun :: (unknown) -> Values?
        local gun = findGun(bindings.gunOwner.value)
        if not gun then bindings.busy.value = nil; return end
        local roles = settings.roles :: Values
        local murderers = roles.Murderers :: { unknown }
        local murdererName = murderers[1]
        if not murdererName then bindings.busy.value = nil; return end
        local murderer = bindings.findPlayer(murdererName)
        if not murderer then bindings.busy.value = nil; return end
        local targetCharacter = murderer.Character
        if not targetCharacter then bindings.busy.value = nil; return end
        local targetRoot = bindings.findChild(targetCharacter, "HumanoidRootPart")
        if not targetRoot then bindings.busy.value = nil; return end
        local wait = bindings.getWait()
        local oldParent = gun.Parent
        if oldParent ~= character then gun.Parent = character else oldParent = nil end
        local oldFrame = root.CFrame
        local transfer = bindings.getInvoke()(bindings.transferContext, character, targetCharacter, root, targetRoot, wait)
        wait(0.5)
        local predict = bindings.getPredict()
        local found, position = predict(settings.predict_movement, murderer, settings.GunSilentAimPrediction or "Remi")
        if found and position then
            local origin: unknown
            if settings.PiercerBullet then
                origin = (targetRoot.CFrame :: Frame) * bindings.getFrame()(0, 0, 2.5)
            else
                origin = (gun.Handle :: Values).CFrame
            end
            bindings.getInvoke()(bindings.fireContext, remote, origin, bindings.getFrame()(position))
            wait(0.5)
        end
        bindings.getRestore()(transfer)
        root.CFrame = oldFrame
        if oldParent then gun.Parent = oldParent end
        bindings.busy.value = nil
    end
end
end)())

standaloneModules.createCombatDual = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    settings: Values, target: unknown, initialTrack: Cell, getConnect: () -> ((unknown, unknown) -> unknown), signal: unknown,
    connection: Cell, getPlay: () -> ((unknown, unknown) -> ()), getDisconnect: () -> ((unknown) -> ()),
    remove: (unknown) -> (), activeTrack: Cell, connection2: Cell, connection3: Cell, object1: Cell, object2: Cell,
}

return function(bindings: Bindings, knife: boolean)
    return function(value: unknown)
        if knife then bindings.settings.UseKnifeDualEffect = value end
        if value then
            local initialTrack = bindings.initialTrack.value
            bindings.connection.value = bindings.getConnect()(bindings.signal, bindings.target)
            if initialTrack then bindings.getPlay()(bindings.target, initialTrack) end
            return
        end
        local disconnect = bindings.getDisconnect()
        local track = bindings.activeTrack.value :: { Stop: (unknown) -> () }?
        disconnect(bindings.connection.value)
        disconnect(bindings.connection2.value)
        disconnect(bindings.connection3.value)
        bindings.remove(bindings.object1.value)
        bindings.remove(bindings.object2.value)
        if track then track:Stop() end
    end
end
end)())

standaloneModules.createAnimatedButton = ((function()
