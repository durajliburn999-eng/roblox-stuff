                end

                local name = sheriffs[1]

                if not name then
                    continue
                end

                local player = findPlayer(name)

                if not player or not player.Character then
                    continue
                end

                attack(player)
            end

            idle()
        end
    end

    return { everyone = everyone, sheriff = sheriff }
