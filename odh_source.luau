return function(bindings: Bindings)
    local settings = bindings.settings
    local world = bindings.world
    local getDescendants = bindings.getDescendants
    local remove = bindings.remove
    local coinSounds = bindings.coinSounds

    local function removeByName(setting: string, name: string, class: string?)
        return function(enabled: unknown)
            settings[setting] = enabled

            if not enabled then
                return
            end

            local objects = getDescendants(world.value)

            for index = 1, #objects do
                local object = objects[index]

                if object.Name ~= name then
                    continue
                end

                if class and object.ClassName ~= class then
                    continue
                end

                remove(object)
            end
        end
    end

    local function muteCoinSound(enabled: unknown)
        settings.MuteCoinSound = enabled

        if not enabled then
            return
        end

        local objects = getDescendants(world.value)

        for index = 1, #objects do
            local object = objects[index]

            if object.ClassName ~= "Sound" or not coinSounds[object.Name] then
                continue
            end

            object.Volume = 0
        end
    end

    return {
        chroma = removeByName("AutoRemoveChromaEffects", "Chroma", nil),
        pets = removeByName("AutoRemovePetsDisplay", "Pets", nil),
        traps = removeByName("AutoRemoveTraps", "Trap", "Model"),
        corpses = removeByName("AutoRemoveCorpses", "Raggy", nil),
        muteCoinSound = muteCoinSound,
    }
end
end)())

