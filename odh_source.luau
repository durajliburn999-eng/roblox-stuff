standaloneModules.createCombatFluxLoad = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Slider = { SetValue: (unknown, unknown) -> () }
type Bindings = {
    selected: Cell, getClock: () -> (() -> number), lastLoad: { value: number },
    getNotify: () -> ((string, number) -> ()), getFormat: () -> ((string, ...unknown) -> string),
    settings: Values, controls: { unknown }, pingSlider: Cell, presets: Values,
}

return function(bindings: Bindings, prefix: string?)
    local settingsPrefix = (prefix or "Flux") .. "Settings_"
    return function()
        local selected = bindings.selected.value :: string
        if selected == "None" then return end
        local now = bindings.getClock()()
        local elapsed = now - bindings.lastLoad.value
        if elapsed < 5 then
            bindings.getNotify()(bindings.getFormat()('Slow down! Try again in <font color="rgb(0, 0, 255)">%.2f</font>', 5 - elapsed), 2)
            return
        end
        bindings.lastLoad.value = now
        local slider = bindings.pingSlider.value :: Slider
        local preset = bindings.presets[selected] :: Values
        local setValue = slider.SetValue
        local controls = bindings.controls
        local settings = bindings.settings
        if preset.prioritize_your_ping ~= settings[settingsPrefix .. "PrioritizeYourPing"] then (controls[1] :: () -> ())() end
        setValue(slider, preset.prediction_ping)
        if preset.predict_jump ~= settings[settingsPrefix .. "PredictJump"] then (controls[2] :: () -> ())() end
        if preset.predict_lag ~= settings[settingsPrefix .. "PredictLag"] then (controls[3] :: () -> ())() end
        setValue(controls[4], preset.max_simulation_time)
        setValue(controls[5], (preset.interval :: number) * 10000)
        setValue(controls[6], (preset.x_pos_offset :: number) * 100)
        setValue(controls[7], (preset.y_pos_offset :: number) * 100)
        setValue(controls[8], (preset.z_pos_offset :: number) * 100)
        setValue(controls[9], (preset.horizontal_multiplier :: number) * 100)
        setValue(controls[10], (preset.vertical_multiplier :: number) * 100)
        bindings.getNotify()("Successfully loaded the preset.", 1)
    end
end
end)())

standaloneModules.createCombatFluxSave = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    name: Cell, getNotify: () -> ((string, number) -> ()), settings: Values, preset: Values,
    getByte: () -> ((string, number) -> number), x: Cell, y: Cell, z: Cell,
    encode: (unknown) -> string, getChar: () -> ((number) -> string),
    getWriteFile: () -> ((string, string) -> ()), getFormat: () -> ((string, unknown) -> string),
}

return function(bindings: Bindings, prefix: string?)
    local settingsPrefix = (prefix or "Flux") .. "Settings_"
    return function()
        local name = bindings.name.value :: string
        if #name < 5 then
            bindings.getNotify()('Put atleast <font color="rgb(0, 0, 255)">5</font> characters in the name.', 2)
            return
        end
        local getByte = bindings.getByte()
        local settings = bindings.settings
        local preset = bindings.preset
        local config = preset.cfg :: Values
        config.prioritize_your_ping = settings[settingsPrefix .. "PrioritizeYourPing"]
        config.prediction_ping = settings[settingsPrefix .. "Ping"]
        config.predict_jump = settings[settingsPrefix .. "PredictJump"]
        config.predict_lag = settings[settingsPrefix .. "PredictLag"]
        config.max_simulation_time = settings[settingsPrefix .. "MaxSimulationTime"]
        config.interval = settings[settingsPrefix .. "PredictionInterval"]
        config.horizontal_multiplier = settings[settingsPrefix .. "PredictionHorizontalMultiplier"]
        config.vertical_multiplier = settings[settingsPrefix .. "PredictionVerticalMultiplier"]
        config.x_pos_offset = bindings.x.value
        config.y_pos_offset = bindings.y.value
        config.z_pos_offset = bindings.z.value
        local encoded = bindings.encode(preset)
        local output = ""
        for index = 1, #encoded do
            local char = bindings.getChar()
            local byte = getByte(encoded, index)
            output ..= char(bit32.bxor(byte, 40))
        end
        bindings.getWriteFile()(bindings.getFormat()("Ixry Shizuka/presets/%*.preset", name), output)
        bindings.getNotify()("Success!", 1)
    end
end
end)())

standaloneModules.createKillPlayer = ((function()
type Node = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    isMode: (unknown, unknown) -> unknown,
    modeOwner: unknown,
    mode: Cell,
    settings: { MapMode: unknown },
    character: Cell,
    findKnife: (unknown) -> Node?,
    knifeOwner: Cell,
    findChild: (unknown, string) -> Node?,
    fire: (unknown, unknown) -> (),
}

return function(bindings: Bindings)
    local isMode = bindings.isMode
    local modeOwner = bindings.modeOwner
    local mode = bindings.mode
    local settings = bindings.settings
    local character = bindings.character
    local findKnife = bindings.findKnife
    local knifeOwner = bindings.knifeOwner
    local findChild = bindings.findChild
    local fire = bindings.fire

    return function(player: Node)
        if not isMode(modeOwner, mode.value) or settings.MapMode == "Assassin" then
            return
        end

        local current = character.value

        if not current then
            return
        end

        local target = player.Character

        if not target then
            return
        end

        local knife = findKnife(knifeOwner.value)

        if not knife then
            return
        end

        if knife.Parent ~= current then
            knife.Parent = current
        end

        local torso = findChild(target, "UpperTorso") or findChild(target, "LowerTorso")

        if not torso then
            return
        end

        local events = findChild(knife, "Events")

        if not events then
            return
        end

        local remote = findChild(events, "HandleTouched")

        if remote then
            fire(remote, torso)
        end
    end
end
end)())

