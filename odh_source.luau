local createIslandTravel = (function()
-- Record5642: preserve entrance requests, movement and collision updates.
type Direction = typeof(setmetatable({}, {
    __mul = function(value, _scale) return value end,
}))
type Offset = { Unit: Direction }
type Destination = typeof(setmetatable({}, {
    __sub = function(_left, _right) return (nil :: unknown) :: Offset end,
}))
type Character = { Parent: unknown }
type Root = { Position: unknown, AssemblyLinearVelocity: unknown, CFrame: unknown }
type Part = { Name: string, CanCollide: boolean }
type Bindings = {
    checkpoint: (() -> ())?,
    character: () -> Character?,
    root: () -> Root?,
    destinations: () -> { [unknown]: Destination? },
    settings: () -> { TP_SelectIsland: unknown },
    typeof: () -> ((Destination?) -> string),
    getInvoke: () -> ((unknown, string, Destination?) -> ()),
    remote: () -> unknown,
    clock: () -> (() -> number),
    squaredDistance: () -> ((Offset, Offset) -> number),
    descendants: (Character) -> { Part },
    isA: (Part, string) -> boolean,
    updatedAt: () -> number,
    setUpdatedAt: (number) -> (),
    makeVector: () -> ((number, number) -> unknown),
}

local function disableCollisions(bindings: Bindings, parts: { Part })
    local count = #parts

    for index = 1, count do
        local part = parts[index]

        if bindings.isA(part, "BasePart") then
            part.CanCollide = false
        end
    end
end

local function finishTravel(
    bindings: Bindings,
    character: Character,
    root: Root,
    parts: { Part },
    destination: Destination?,
    recentlyUpdated: boolean
)
    bindings.setUpdatedAt(0)

    if not character.Parent then
        return
    end

    local count = #parts

    for index = 1, count do
        local part = parts[index]

        if not bindings.isA(part, "BasePart") then
            continue
        end

        if part.Name ~= "HumanoidRootPart" then
            part.CanCollide = true
        end
    end

    local makeVector = bindings.makeVector()
    root.AssemblyLinearVelocity = makeVector(0, 0)

    if not recentlyUpdated then
        root.CFrame = destination
    end
end

return function(bindings: Bindings)
    local checkpoint = bindings.checkpoint

    return function()
        local character = bindings.character()

        if not character then
            return
        end

        local root = bindings.root()

        if not root then
            return
        end

        local destinations = bindings.destinations()
        local selected = bindings.settings().TP_SelectIsland
        local destination = destinations[selected]
        local valueType = bindings.typeof()

        if valueType(destination) == "Vector3" then
            local invoke = bindings.getInvoke()
            local remote = bindings.remote()
            invoke(remote, "requestEntrance", destination)
            return
        end

        local clock = bindings.clock()
        local squaredDistance = bindings.squaredDistance()
        local parts = bindings.descendants(character)

        while true do
            if checkpoint then (checkpoint :: () -> ())() end
            local position = root.Position
            local offset = (destination :: Destination) - position
            local distance = squaredDistance(offset, offset)

            if distance < 400 then
                finishTravel(bindings, character, root, parts, destination, false)
                return
            end

            root.AssemblyLinearVelocity = offset.Unit * 300
            disableCollisions(bindings, parts)

            local now = clock()
            local updatedAt = bindings.updatedAt()
            local recentlyUpdated = now - updatedAt <= 1

            if recentlyUpdated or distance < 400 then
                finishTravel(bindings, character, root, parts, destination, recentlyUpdated)
                return
            end

            if not character.Parent then
                finishTravel(bindings, character, root, parts, destination, false)
                return
            end
        end
    end
end
end)()

