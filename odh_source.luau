standaloneModules.finishApplicationLoad = ((function()
local createSandbox = standaloneModules.createPluginSandbox
local createProxy = standaloneModules.createPluginProxy
local createTab = standaloneModules.createPluginTab
local createLoader = standaloneModules.createPluginLoader

type Values = { [string]: any }
local makeSandbox = (createSandbox :: unknown) :: (Values) -> Values
local makeProxy = (createProxy :: unknown) :: (Values) -> unknown
local makeTab = (createTab :: unknown) :: (Values) -> (string, string) -> unknown
local makeLoader = (createLoader :: unknown) :: (Values) -> (unknown) -> ()

local pluginDirectory = "Ixry Shizuka/plugins"
local notificationKey = "\215\160Z\130\240Z\1791\175s'\163\173z\003\022\195Q>\204\196\223\0103[\2191A\184\205\016"
local pluginMessage = '<font color="rgb(0, 255, 0)">%*</font> plugin/s was found and have been successfully loaded!'
local loadedMessage = 'Script has been successfully loaded in the game, Took <font color="rgb(0, 255, 0)">%.2f</font> seconds to load.'

return function(bindings: Values)
    local environment, owner = bindings.environment, bindings.owner
    local paths = environment.listfiles(pluginDirectory)
    local count, typeOverrides, objects, shared = 0, {}, {}, {}
    for _, path in paths do
        if not environment.isfile(path) then continue end
        if environment.string.sub(path, -4) ~= ".lua" then continue end

        local compiled = environment.loadstring(environment.readfile(path))
        local script = environment.Instance.new("LocalScript")
        script.Name = environment.string.match(path, "([^/\\]+)$")
        local sandbox = makeSandbox({ environment = environment, state = bindings.state, script = script,
            typeOverrides = typeOverrides, shared = shared })
        environment.setfenv(compiled, sandbox)
        local api = {
            Name = "Ugc", ClassName = "Ugc", Parent = environment.game,
            version = owner.__Version, game_name = owner.__Game,
            is_premium_user = bindings.premiumEnabled, is_exclusive_user = bindings.exclusiveEnabled,
            real_username = bindings.player.Name, real_userid = bindings.player.UserId,
            Notify = owner.Notify, kick = bindings.report,
            CreateTab = makeTab({ string = environment.string, raise = environment.error, protect = environment.pcall,
                request = owner.REQ, writeFile = environment.writefile, createTab = owner.CreateTab, owner = owner }),
            load_from_github_url = makeLoader({ type = environment.type, raise = environment.error, string = environment.string,
                protect = environment.pcall, request = owner.REQ, warn = environment.warn,
                loadString = environment.loadstring, setEnvironment = environment.setfenv, sandbox = sandbox }),
        }
        local pluginApi = makeProxy({ objects = objects, typeOverrides = typeOverrides, newProxy = environment.newproxy,
            getMetatable = environment.getmetatable, freeze = environment.table.freeze, api = api, raise = environment.error,
            getNamecallMethod = environment.getnamecallmethod, notify = owner.Notify })
        sandbox.odh_shared_plugins = pluginApi
        environment.spawn(compiled)
        count += 1
    end

    owner.PrintDebug(environment.string.format(pluginMessage, count), 2)
    environment[notificationKey] = bindings.notify
    owner.ScriptLoaded = true
    local message = environment.string.format(loadedMessage, bindings.clock() - bindings.startedAt)
    bindings.notify(message, 1)
    owner.PrintDebug(message, 2)
end
end)())

