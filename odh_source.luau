standaloneModules.createCharacterState = ((function()
local createCharacterBinder = createCharacterBinder

type Values = { [string]: unknown }
type Bindings = {
    player: Values,
    backpack: unknown,
    find: (unknown, string) -> unknown,
    connect: (unknown, (...unknown) -> ()) -> unknown,
    disconnect: (unknown) -> (),
    protectedCall: ((unknown) -> (), unknown) -> (),
    wait: () -> (),
}

local makeBinder = (createCharacterBinder :: unknown) :: (Values) -> (unknown) -> ()

return function(bindings: Bindings): Values
    local player = bindings.player
    local character = player.Character
    if not character then
        local signal = player.CharacterAdded :: { Wait: (unknown) -> unknown }
        character = signal.Wait(signal)
    end

    local state: Values = { character = character, backpack = bindings.backpack }
    local deathConnection: unknown = nil
    local captureMethods = true
    local function onDeath()
        state.character, state.humanoid, state.root = nil, nil, nil
    end
    local binder = makeBinder({
        getWait = function() return bindings.wait end,
        findChild = bindings.find,
        getDisconnect = function()
            return function(connection: unknown)
                if connection then bindings.protectedCall(bindings.disconnect, connection) end
            end
        end,
        getDeathConnection = function() return deathConnection end,
        setDeathConnection = function(value: unknown) deathConnection = value end,
        getConnect = function() return bindings.connect end,
        getOnDeath = function() return onDeath end,
        shouldCaptureMethods = function() return captureMethods end,
        setShouldCaptureMethods = function(value: boolean) captureMethods = value end,
        setChangeState = function(value: unknown) state.changeState = value end,
        setGetState = function(value: unknown) state.getState = value end,
        getPlayer = function() return player end,
        setBackpack = function(value: unknown) state.backpack = value end,
        setCharacter = function(value: unknown) state.character = value end,
        setHumanoid = function(value: unknown) state.humanoid = value end,
        setRoot = function(value: unknown) state.root = value end,
    })
    bindings.connect(player.CharacterAdded, function(value: unknown) binder(value) end)
    if not character then return state end

    local humanoid = bindings.find(character, "Humanoid") :: Values?
    while not humanoid do
        bindings.wait()
        humanoid = bindings.find(character, "Humanoid") :: Values?
    end
    local root = bindings.find(character, "HumanoidRootPart")
    while not root do
        bindings.wait()
        root = bindings.find(character, "HumanoidRootPart")
    end
    local initialHumanoid = humanoid :: Values
    state.humanoid, state.root = initialHumanoid, root
    deathConnection = bindings.connect(initialHumanoid.Died, onDeath)
    state.changeState, state.getState = initialHumanoid.ChangeState, initialHumanoid.GetState
    captureMethods = false
    return state
end
end)() :: unknown)

