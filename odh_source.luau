    local previous: unknown = nil
    local width: number? = nil
    local height: number? = nil
    local columns: number? = nil
    local frameDelay: number? = nil
    local lastFrame: number? = nil

    while true do
        local current = context.state[context.stateKey]

        if current == context.specialState then
            width = 204.8
            height = 120.1418826739427

            if previous ~= current then
                context.setSpecial(context.image, context.specialAsset)
                write(context.image, context.sizeKey, context.vector(width :: number, height :: number))
                write(context.owner, context.ownerImageKey, context.image)
