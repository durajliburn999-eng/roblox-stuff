local findFarmSpawn = (function()
type Node = { Name: unknown }
type GetChildren = (unknown) -> { Node }

return function(map: unknown, getChildren: GetChildren): Node?
    if not map then
        return nil
    end

    local groups = getChildren(map)
    local spawnGroup: Node? = nil

    for index = 1, #groups do
        local group = groups[index]
        local name = group.Name

        if name == "Spawns" or name == "ZombieSpawns" then
            spawnGroup = group
            break
        end
    end

    if not spawnGroup then
        return nil
    end

    local children = getChildren(spawnGroup)
    local spawn: Node? = nil

    for index = 1, #children do
        local child = children[index]

        if child.Name == "Spawn" then
            spawn = child
        end
    end

    return spawn
end
end)()

