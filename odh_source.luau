    release({
        character = { value = character },
        humanoid = { value = capturedHumanoid },
        body = bindings.body,
        cleanup = bindings.cleanup,
        getDescendants = bindings.getDescendants,
        isA = bindings.isA,
    }, true)
    return true, capturedHumanoid
end

local function releaseSaved(bindings: Bindings): string
    local state = bindings.state

    if not releaseCharacter(bindings, state.savedCharacter.value, state.savedHumanoid) then
        return "wait"
    end

    state.savedCharacter.value = nil
    state.savedHumanoid.value = nil
    return "next"
end

local function preflight(bindings: Bindings): string
    if bindings.character.value ~= bindings.state.savedCharacter.value then
        return releaseSaved(bindings)
    end

    return "continue"
end

local function afterGate(bindings: Bindings): (string, unknown, unknown, unknown)
    local state = bindings.state

    if not bindings.isAlive(bindings.player) then
        local released, humanoid = releaseCharacter(bindings, bindings.character.value, bindings.humanoid)

        if released then
            local context = table.clone(bindings.transition :: { [string]: unknown })
            context.humanoid = humanoid
            transition(context)
        end

        return "wait", nil, nil, nil
    end

    local container = bindings.settings.CoinContainer

    if not container then
        state.active.value = nil
        state.previousCoin.value = nil
        state.previousMethod.value = nil
        return "wait", nil, nil, nil
    end

    local character = bindings.character.value

    if character ~= state.savedCharacter.value then
        return releaseSaved(bindings), nil, nil, nil
    end

    if not character then
        return releaseSaved(bindings), nil, nil, nil
    end

    state.savedCharacter.value = character

    if not state.savedHumanoid.value then
        state.savedHumanoid.value = bindings.humanoid.value
    end

    local root = bindings.root.value

    if not root then
        return releaseSaved(bindings), nil, nil, nil
    end

    return "ready", container, character, root
end

return { preflight = preflight, afterGate = afterGate }
end)()

local runFarmRoundGateFlow = (function()

type Cleanup = {
    character: { value: unknown },
    humanoid: unknown,
    body: unknown,
    cleanup: unknown,
    getDescendants: unknown,
    isA: unknown,
}
type Bindings = {
    active: { value: unknown },
    previousCoin: { value: unknown },
    previousMethod: { value: unknown },
    target: { value: unknown },
    savedCharacter: { value: unknown },
    savedHumanoid: { value: unknown },
    cleanup: Cleanup,
    transition: unknown,
}

local release = (releaseFarmPhysics :: unknown) :: (unknown, unknown) -> ()
local transition = (runFarmRoundTransition :: unknown) :: (unknown) -> ()

return function(gate: string, roundTime: unknown, bindings: Bindings): string
    bindings.previousCoin.value = nil
    local active = bindings.active.value
    bindings.active.value = nil

    if not active then
        return "wait"
    end

    local cleanup = bindings.cleanup
    local pending = gate == "round" and type(roundTime) ~= "number"
    local character = if pending then bindings.savedCharacter.value else cleanup.character.value
    bindings.target.value = nil
    bindings.previousMethod.value = nil

    if not character then
        return "wait"
    end

    local humanoidCell = if pending then bindings.savedHumanoid else cleanup.humanoid :: { value: unknown }
    local humanoid = humanoidCell.value
    release({
        character = { value = character },
        humanoid = { value = humanoid },
        body = cleanup.body,
        cleanup = cleanup.cleanup,
        getDescendants = cleanup.getDescendants,
        isA = cleanup.isA,
    }, true)

    if pending then
        bindings.savedCharacter.value = nil
        bindings.savedHumanoid.value = nil
        return "next"
    end

    local context = table.clone(bindings.transition :: { [string]: unknown })
    context.humanoid = humanoid
    transition(context)
    return "wait"
end
end)()

local runFarmOuterTick = (function()

type Cell = { value: unknown }
type State = {
    active: Cell,
    body: Cell,
    previousCoin: Cell,
    olderCoin: Cell,
    previousMethod: Cell,
    target: Cell,
    timer: Cell,
    savedCharacter: Cell,
    savedHumanoid: Cell,
}
type Bindings = {
    [string]: unknown,
    settings: unknown,
    state: State,
    player: unknown,
    isAlive: unknown,
    character: Cell,
    humanoid: Cell,
    root: Cell,
    cleanup: unknown,
    getDescendants: unknown,
    isA: unknown,
}

local checkGate = (evaluateRunningFarmGate :: unknown) :: (unknown) -> (string, unknown, unknown)
local preflight = (farmActiveContextFlow.preflight :: unknown) :: (unknown) -> string
local checkActive = (farmActiveContextFlow.afterGate :: unknown) :: (unknown) -> (string, unknown, unknown, unknown)
local checkInactive = (evaluateInactiveFarmContext :: unknown) :: (unknown) -> (string, unknown, unknown, unknown)
local handleRound = (runFarmRoundGateFlow :: unknown) :: (string, unknown, unknown) -> string
local runCoins = (runFarmCoinStep :: unknown) :: (unknown) -> ()
local release = (releaseFarmPhysics :: unknown) :: (unknown, unknown) -> ()

return function(bindings: Bindings): string
    local state = bindings.state
    local settings = bindings.settings
    local transition = {
        root = bindings.root,
        settings = settings,
        localName = bindings.localName,
        murderers = bindings.murderers,
        sheriffs = bindings.sheriffs,
        destination = bindings.destination,
        players = bindings.players,
        character = bindings.character,
        killAction = bindings.killAction,
        flingAction = bindings.flingAction,
        findPlayer = bindings.findPlayer,
        start = bindings.start,
        wait = bindings.wait,
    }
    local context = {
        state = state,
        player = bindings.player,
        isAlive = bindings.isAlive,
        settings = settings,
        character = bindings.character,
        humanoid = bindings.humanoid,
        root = bindings.root,
        body = state.body.value,
        cleanup = bindings.cleanup,
        getDescendants = bindings.getDescendants,
        isA = bindings.isA,
        transition = transition,
    }

    local farmSettings = settings :: { AutoFarm: unknown }
    local wait = bindings.wait :: () -> ()

    while true do
        if not farmSettings.AutoFarm then
            release({
                character = state.savedCharacter,
                humanoid = state.savedHumanoid,
                body = state.body.value,
                cleanup = bindings.cleanup,
                getDescendants = bindings.getDescendants,
                isA = bindings.isA,
            }, state.body.value ~= nil)

            state.body.value = nil
            state.active.value = nil
            state.savedCharacter.value = nil
            state.savedHumanoid.value = nil
            return "stop"
        end

        wait()

        if state.active.value then
            local result = preflight(context)

            if result ~= "continue" then
                return result
            end
        end

        if farmSettings.AutoFarm then
            break
        end
    end

    local result, roundTime, coinType = checkGate(settings)

    if result == "full" or result == "round" then
        return handleRound(result, roundTime, {
            active = state.active,
            previousCoin = state.previousCoin,
            previousMethod = state.previousMethod,
            target = state.target,
            savedCharacter = state.savedCharacter,
            savedHumanoid = state.savedHumanoid,
            cleanup = {
                character = bindings.character,
                humanoid = bindings.humanoid,
                body = state.body.value,
                cleanup = bindings.cleanup,
                getDescendants = bindings.getDescendants,
                isA = bindings.isA,
            },
            transition = transition,
        })
    end

    local contextResult, container, character, root

    if state.active.value then
        contextResult, container, character, root = checkActive(context)
    else
        contextResult, container, character, root = checkInactive(context)
    end

    if contextResult ~= "ready" then
        return contextResult
    end

    local coinBindings = (table.clone(bindings) :: unknown) :: { [string]: unknown }
    coinBindings.root = root
    coinBindings.character = character
    coinBindings.coinContainer = container
    coinBindings.coinType = coinType
    runCoins(coinBindings)
    return "wait"
end
end)()

local runFarmWorker = (function()

type Bindings = { settings: unknown }
local runTick = (runFarmOuterTick :: unknown) :: (Bindings) -> string
local stopWorker = (stopFarmWorker :: unknown) :: (unknown) -> ()

return function(bindings: Bindings)
    while true do
        if runTick(bindings) == "stop" then
            stopWorker(bindings.settings)
            return
        end
    end
end
end)()

