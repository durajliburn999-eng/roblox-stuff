}
local makeLifecycle = (createLifecycle :: unknown) :: (Values) -> Values
local makeMonitor = (createMonitor :: unknown) :: (Values) -> (Values) -> ()
local makeAccept = (createAccept :: unknown) :: (Values) -> (...unknown) -> ()

return function(bindings: Bindings): Values
    local trade = bindings.find(bindings.storage, "Trade") :: Values
    bindings.children(trade)
    local oldAccept = bindings.find(trade, "AcceptTrade") :: Values
    local decline = bindings.find(trade, "DeclineTrade") :: Values
    local newAccept = bindings.create("RemoteEvent")
    newAccept.Name = "AcceptTrade"
    newAccept.Parent = trade
    oldAccept.Parent = nil

    local active: Cell = { value = nil }
