standaloneModules.createGameFloatingControl = ((function()
type Values = { [string]: unknown }
type Bindings = {
    createInstance: (string) -> Values,
    makeName: () -> string,
    parent: unknown,
    fromRGB: (number, number, number) -> unknown,
    vector: (number, number) -> unknown,
    fromScale: (number, number) -> unknown,
    fromOffset: (number, number) -> unknown,
    dimension: (number, number) -> unknown,
    tweenInfo: (number, unknown) -> unknown,
    cubic: unknown,
    createTween: (unknown, unknown, unknown, Values) -> unknown,
    tweenService: unknown,
    font: unknown,
    textLeft: unknown,
    addAnimatedStroke: (unknown, Values, string) -> (),
    addDraggable: (...unknown) -> unknown,
    play: (unknown) -> (),
    afterTweens: ((Values, Values, unknown, unknown) -> ())?,
    beforeDrag: (() -> (() -> ()))?,
}
type Options = {
    className: string,
    text: string?,
    richText: boolean?,
    textSize: number,
    hoverTextSize: number,
    width: number,
    height: number,
    click: (() -> ())?,
    lockable: boolean?,
}
type Result = { node: Values, rotationState: Values, normal: unknown, hide: unknown, hover: unknown, lock: unknown }

return function(bindings: Bindings, options: Options): Result
    local info = bindings.tweenInfo(0.8, bindings.cubic)
    local node = bindings.createInstance(options.className)
    local corner = bindings.createInstance("UICorner")
    node.Name = bindings.makeName()
    node.Parent = bindings.parent
    node.ClipsDescendants = true
    node.BackgroundTransparency = 0.9
    node.BackgroundColor3 = bindings.fromRGB(255, 255, 255)
    node.AnchorPoint = bindings.vector(0.5, 0.5)
    node.Position = bindings.fromScale(0.5, 0.5)
    if options.richText then node.RichText = true end
    node.Font = bindings.font
    if options.text ~= nil then node.Text = options.text end
    node.TextSize = options.textSize
    node.TextColor3 = bindings.fromRGB(255, 255, 255)
    if options.className == "TextLabel" then node.TextXAlignment = bindings.textLeft end
    node.Active = true
    node.Visible = false
    corner.Name = "Corner"
    corner.Parent = node
    corner.CornerRadius = bindings.dimension(0, 5)

    local rotationState: Values = {}
    bindings.addAnimatedStroke(node, rotationState, "gay")
    local tween = bindings.createTween
    local service = bindings.tweenService
    local normal = tween(service, node, info, { Size = bindings.fromOffset(options.width, options.height), TextSize = options.textSize })
    local hide = tween(service, node, info, { Size = bindings.fromOffset(0, 0) })
    if bindings.afterTweens then bindings.afterTweens(node, rotationState, normal, hide) end
    local hover = tween(service, node, info, { Size = bindings.fromOffset(options.width + 15, options.height + 15), TextSize = options.hoverTextSize })
    local click = if bindings.beforeDrag then bindings.beforeDrag() else options.click
    local lock: unknown
    if options.lockable ~= nil then
        lock = bindings.addDraggable(node, normal, hover, bindings.play, click, options.lockable)
    elseif click then
        lock = bindings.addDraggable(node, normal, hover, bindings.play, click)
    else
        lock = bindings.addDraggable(node, normal, hover, bindings.play)
    end
    return { node = node, rotationState = rotationState, normal = normal, hide = hide, hover = hover, lock = lock }
end
end)() :: unknown)

standaloneModules.createFloatingShoot = ((function()
type Values = { [string]: any }
type Bindings = {
    settings: Values,
    getCharacter: () -> Values,
    player: Values,
    last: { value: number },
    clock: () -> number,
    validate: (unknown) -> Values?,
    find: (unknown, string) -> Values?,
    raycast: (unknown, unknown) -> Values?,
    frame: (...unknown) -> any,
    invoke: (...unknown) -> (),
    spawn: (...unknown) -> (),
    wait: (number) -> (),
    protect: (...any) -> ...any,
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local last = bindings.last

    local function reset()
        last.value = 0
    end

    local function shoot()
        if bindings.clock() - last.value < 0.8 then return end
        last.value = bindings.clock()
        local localCharacter = bindings.getCharacter()
        local remote = settings.SheriffGun_REMOTE
        if not remote then reset(); return end
        local gun = settings.find_gun(bindings.player)
        if not gun then reset(); return end

        local target: Values? = nil
        if settings.GunCustomTarget then
            target = settings.GunCustomTargetPlayer
            if target and not target.Character then target = nil end
        end
        if not target then
            local murderer = settings.roles.Murderers[1]
            if murderer then target = bindings.validate(murderer) end
        end
        if not target or not target.Character then reset(); return end
        local character = target.Character
        local mode = settings.GunSilentAimPrediction or "Remi"
        local piercer = settings.PiercerBullet

        if mode == "Ubuntu" and not piercer then
            local root = bindings.find(character, "HumanoidRootPart")
            if root then
                local hand = bindings.find(localCharacter, "RightHand")
                if hand then
                    local direction = (root.Position - hand.Position).Unit * 500
                    local hit = bindings.raycast(hand.Position, direction)
                    if hit then
                        local instance = hit.Instance
                        if instance and (instance == character or instance.Parent == character or instance.Parent.Parent == character) then
                            piercer = true
                        end
                    end
                end
            end
        end

        local ok, position = bindings.protect(settings.predict_movement, target, mode)
        if not ok or not position then reset(); return end
        local previousParent = gun.Parent
        if previousParent == localCharacter then previousParent = nil else gun.Parent = localCharacter end
        local origin
        if piercer then
            local root = bindings.find(character, "HumanoidRootPart")
            if root then origin = root.CFrame * bindings.frame(0, 0, 2.5) end
        end
        if not origin then origin = gun.Handle.CFrame end
        bindings.spawn(bindings.invoke, remote, origin, bindings.frame(position))
        if previousParent then
            bindings.wait(0.15)
            gun.Parent = previousParent
        end
        reset()
    end

    return shoot, function() return last.value end
end
end)() :: unknown)

