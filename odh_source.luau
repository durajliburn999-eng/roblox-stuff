end
end)()

local createCoinOptimizer = (function()
-- Prototype 3:6208. Missing attributes do not prove that a coin was collected.
type Frame = { X: number, Y: number, Z: number }
type Visual = { CFrame: Frame }
type Coin = { Name: string }
type Settings = { [string]: unknown, CoinContainer: unknown, OptimizeCoins: unknown, RoundTime: number? }
type Bindings = {
    settings: Settings,
    getChildren: (unknown) -> { Coin },
    destroy: (Coin) -> (),
    getAttribute: (Coin, string) -> unknown,
    findChild: (Coin, string) -> Visual?,
    isStopped: (() -> boolean)?,
    waitForTick: () -> ((number) -> ()),
    createFrame: () -> ((number, number, number) -> Frame),
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local getChildren = bindings.getChildren
    local destroy = bindings.destroy
    local getAttribute = bindings.getAttribute
    local findChild = bindings.findChild
    local isStopped = bindings.isStopped

    local function isCollected(coin: Coin): unknown
        if coin.Name == "CollectedCoin" or getAttribute(coin, "Collected") then
            return true
        end

        local coinId = getAttribute(coin, "CoinID")
        return coinId ~= nil and settings[(coinId :: string | number) .. "Full"]
    end

    return function()
        if isStopped and isStopped() then
            return
        end

        local waitForTick = bindings.waitForTick()
        local createFrame = bindings.createFrame()
        local container = settings.CoinContainer

        if container then
            for _, coin in getChildren(container) do
                if isCollected(coin) then
                    destroy(coin)
                    continue
                end

                local visual = findChild(coin, "CoinVisual")

                if not visual then
                    continue
                end

                local frame = visual.CFrame
                visual.CFrame = createFrame(frame.X, frame.Y, frame.Z)
            end
        end

        while settings.OptimizeCoins do
            if isStopped and isStopped() then
                return
            end

            waitForTick(0.25)

            if isStopped and isStopped() then
                return
            end

            container = settings.CoinContainer

            if not container then
                continue
            end

            local coins = getChildren(container)
            local roundTime = settings.RoundTime

            if roundTime == nil then
                continue
            end

            if roundTime > 0 then
                for _, coin in coins do
                    if isCollected(coin) then
                        destroy(coin)
                    end
                end

                continue
            end

            for _, coin in coins do
                destroy(coin)
            end
        end
    end
end
end)()

local createCoinRemoval = (function()
-- Prototype 3:5197. Both coin names are eligible; unrelated children stay intact.
type Coin = { Name: string }
type Settings = { AutoRemoveCoins: unknown, CoinContainer: unknown }
type Bindings = {
    settings: Settings,
    destroy: (Coin) -> (),
    getChildren: (unknown) -> { Coin },
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local destroy = bindings.destroy
    local getChildren = bindings.getChildren

    return function(enabled: unknown)
        settings.AutoRemoveCoins = enabled

        if not enabled then
            return
        end

        local container = settings.CoinContainer

        if not container then
            return
        end

        for _, child in getChildren(container) do
            local name = child.Name

            if name == "Coin_Server" or name == "CollectedCoin" then
                destroy(child)
            end
        end
    end
end
end)()

local createNoclip = (function()
-- Prototype 3:5564. Collision changes belong to one active run per settings table.
type Part = { CanCollide: unknown }
type Settings = { Noclip: unknown }
type Failure = { value: unknown }
type Bindings = {
    getChildren: (unknown) -> { Part },
    isA: (Part, string) -> boolean,
    settings: Settings,
    isStopped: (() -> boolean)?,
    waitForTick: () -> ((number) -> ()),
    character: () -> unknown,
}

local activeSettings: { [Settings]: boolean? } = {}

return function(bindings: Bindings)
    local getChildren = bindings.getChildren
    local isA = bindings.isA
    local settings = bindings.settings
    local isStopped = bindings.isStopped

    local function run()
        local originals: { [Part]: { value: unknown }? } = {}
        local waitForTick = bindings.waitForTick()

        local function restorePart(part: Part): Failure?
            local original = originals[part] :: { value: unknown }
            local ok, raised = pcall(function()
                part.CanCollide = original.value
            end)

            if ok then
                originals[part] = nil
                return nil
            end

            return { value = raised }
        end

        local function restoreMissing(present: { [Part]: boolean }): Failure?
            local failure: Failure? = nil

            for part in originals do
                if present[part] then
                    continue
                end

                local rejected = restorePart(part)
                failure = failure or rejected
            end

            return failure
        end

        local function applyToCharacter()
