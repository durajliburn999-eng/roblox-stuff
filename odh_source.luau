            worker({ parentKey = "Parent", defaultError = "An unexpected error had occurred.", firstGui = "TradeGUI",
                secondGui = "TradeGUI_Phone", enabledKey = "Enabled", fullNamePrefix = "Players." .. monitor.playerName .. ".PlayerGui.",
                classKey = "ClassName", guiClass = "ScreenGui", detectionMessage = '<font color="rgb(0, 255, 0)">%s</font> was caught stealing from you.',
                containerName = "Container", containerClass = "Frame", visibleKey = "Visible", transparencyKey = "BackgroundTransparency",
                sizeKey = "Size", size = "{1, 0}, {1, 0}", positionKey = "Position", position = "{0.5, 0}, {0.5, 0}",
                wait = monitor.wait, protected = oldAccept, cleanupFirst = monitor.fire, firstResource = decline,
                cleanupSecond = bindings.destroy, secondResource = trade, exit = bindings.report, clock = bindings.clock,
                format = monitor.format, fullName = monitor.fullName })
        end)
    end
    bindings.connect((trade.StartTrade :: Values).OnClientEvent, lifecycle.start :: (...unknown) -> ())
    bindings.connect(decline.OnClientEvent, lifecycle.decline :: (...unknown) -> ())
    local historyBindings = bindings.history
    local history
    if historyBindings then
        history = createHistory({ settings = bindings.state, items = bindings.state.ItemDatabase,
            playerName = historyBindings.playerName, getOwner = historyBindings.getOwner,
            remember = historyBindings.remember, notify = bindings.notify })
    end
