    local function getNotify() return notify.value end
    local function getFormat() return format.value end
    local gradients: Values = {}
    local groupElements: Values = { Secondary = owner.SecondaryElements, ["Secondary Variant"] = owner.SecondaryVariantElements, Surface = owner.SurfaceElements }
    for group, elements in groupElements do
        gradients[group] = { points = points[group], elements = elements,
