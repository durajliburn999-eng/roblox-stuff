type Tags = { string: number, number: number, byte: number }
local encode = (encodeNumber :: unknown) :: (number, number) -> buffer

return function(data: buffer, offset: number, name: string, value: string | number, tags: Tags, key: number): number
    local isString = type(value) == "string"
    local isByte = type(value) == "number" and value >= 0 and value <= 255 and value % 1 == 0
    local tag = if isString then tags.string elseif isByte then tags.byte else tags.number

    buffer.writeu8(data, offset, tag)
    buffer.writeu8(data, offset + 1, #name)
    buffer.writestring(data, offset + 2, name)
    offset += 2 + #name

    if isString then
        local text = value :: string
        local length = #text
        buffer.writeu8(data, offset, length // 256)
        buffer.writeu8(data, offset + 1, length % 256)
        buffer.writestring(data, offset + 2, text)
        return offset + 2 + length
    end
    if isByte then
        buffer.writeu8(data, offset, value :: number)
        return offset + 1
    end

    buffer.copy(data, offset, encode(value :: number, key))
    return offset + 8
end
end)() :: unknown)

standaloneModules.encodeLocalSimpleFrame = ((function()
local encodeByte = standaloneModules.encodeLocalFrameByte
local orderTags = standaloneModules.orderLocalFrameTags
