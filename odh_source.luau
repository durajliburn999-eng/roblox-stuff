local unboxedNotice = 'You unboxed <font color="rgb(0, 255, 0)">%*</font>.'

return function(bindings: Bindings)
    return function(_self: unknown, mysteryBoxId: unknown, currency: unknown, count: number): ...{ [number]: Reward }
