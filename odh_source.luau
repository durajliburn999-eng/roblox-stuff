local function manualTarget(state: State): Frame
    local bindings = state.bindings
    local locked = bindings.getLockedButton()

    if locked then
        local getProperty = bindings.getProperty
        locked = getProperty(bindings.getLockedButton(), "Enabled")
    end

    local ray: Ray? = nil

    if locked then
        local viewport = bindings.getCamera().ViewportSize
        local camera = bindings.getCamera()
        local x = viewport.X / 2
        local y = viewport.Y / 2 - 50
        local screenRay = bindings.screenRay
        ray = screenRay(camera, x, y)
    end

    if not locked then
        local mouse = bindings.getMouse()
        local camera = bindings.getCamera()
        local x, y = mouse.X, mouse.Y
        local screenRay = bindings.screenRay
        ray = screenRay(camera, x, y)
    end

    local selectedRay = ray :: Ray
    local origin = selectedRay.Origin
    local direction = selectedRay.Direction * 900
    local raycast = bindings.raycast
    local hit = raycast(origin, direction) :: Hit
    local position = hit.Position
    return (state.makeFrame(position))
end

local function offsetOrigin(state: State, position: Vector, rootPosition: Vector): Vector
    local hitX, hitZ = position.X, position.Z
    local rootX, rootZ = rootPosition.X, rootPosition.Z

    if hitX < rootX then
        position += state.makeVector(0.001, 0, 0)
    end

    if rootX < hitX then
        position -= state.makeVector(0.01, 0, 0)
    end

    if hitZ < rootZ then
        position += state.makeVector(0, 0, 0.001)
    end

    if rootZ < hitZ then
        position -= state.makeVector(0, 0, 0.001)
    end

    return position
end

local function instantOrigin(state: State, target: Frame): Vector?
