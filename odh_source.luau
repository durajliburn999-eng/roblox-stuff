local countdown = statusPrefix .. '0, 155, 255)">Sending... (%.2fs)</font>' .. statusNote
local invalidUrl = statusPrefix .. '255, 0, 0)">Invalid Webhook URL</font>' .. statusNote
local localSendDisabled = statusPrefix .. '104, 104, 104)">Sending disabled (offline)</font>'
local currencies = { "Candy", "Coin", "SnowToken", "Egg", "BeachBall", "Heart" }

local function setStatus(target: unknown, message: string)
    if type(target) == "table" then
        local paragraph = (target :: unknown) :: { SetValue: (unknown, string) -> () }
        paragraph:SetValue(message)
        return
    end

    local callback = target :: (string) -> ()
    callback(message)
end

local function splitDuration(elapsed: number): (number, number, number, number)
    local days, hours, minutes = 0, 0, 0

    while elapsed >= 60 do
        elapsed -= 60
        minutes += 1

        if minutes == 60 then
            hours += 1
            minutes = 0

            if hours == 24 then
                days += 1
                hours = 0
            end
        end
    end

    return days, hours, minutes, elapsed
end

local function writeStatistics(settings: Settings, payload: Payload, clock: () -> number)
    local fields = payload.embeds[1].fields
    local elapsed = clock() - (settings.AutoFarmStarttick :: number)
    local days, hours, minutes, seconds = splitDuration(elapsed)
    fields[1].value = ("Day(s)%* %*%*%*\nHour(s)%* %*%*%*\nMinute(s)%* %*%*%*\nSecond(s)%* %*%*%*"):format(
        ":", "`", days, "`", ":", "`", hours, "`", ":", "`", minutes, "`", ":", "`", seconds // 1, "`"
    )
    local summary = ""

    for _, currency in currencies do
        local earned = settings["Earned" .. currency]

        if not earned or earned == 0 then
            continue
        end

        local separator = ""

        if summary ~= "" then
            separator = "\n"
        end

        summary ..= separator

        local elapsedHours = days * 24 + hours
        elapsedHours += minutes / 60
        elapsedHours += seconds / 3600
        local rate = (earned :: number) // elapsedHours
        summary ..= ("%*(s)%* %*%*%* / %*%*%* Per Hour"):format(
            currency, ":", "`", earned, "`", "`", rate, "`"
        )
    end

    if summary == "" then
        summary = "**__No Data.__**"
    end

    fields[2].value = summary
end

return function(bindings: Bindings)
    local isStopped = bindings.isStopped

    return function()
        local settings = bindings.settings
        local wait = bindings.getWait()
        local clock = bindings.getClock()
        local format = bindings.getFormat()
        local payload = bindings.getPayload()
        local nextFrame = bindings.getNextFrame()
        local isPaused: boolean? = nil
        local lastInterval: number? = nil
        local startedAt: number? = nil
        clock()

        while not isStopped() do
            if not settings.FarmWebhook then
                setStatus(bindings.getStatus(), disabled)
                nextFrame()
                clock()
                isPaused, lastInterval, startedAt = nil, nil, nil
                continue
            end

            wait()

            if not settings.AutoFarm then
                if not isPaused then
                    setStatus(bindings.getStatus(), farmDisabled)
                    isPaused = true
                end

                continue
            end

            local interval = settings.FarmWebhook_SendInterval :: number

            if isPaused or interval ~= lastInterval then
                startedAt = clock()
            end

            local remaining = interval - (clock() - (startedAt :: number))

            if remaining > 0 then
                setStatus(bindings.getStatus(), format(countdown, remaining))
                isPaused, lastInterval = nil, interval
                continue
            end

            setStatus(bindings.getStatus(), sending)
            wait()
            local channel = settings.FarmWebhook_Channel
            local token = settings.FarmWebhook_Token

            if not channel or not token then
                setStatus(bindings.getStatus(), invalidUrl)
                wait(1)
                startedAt = clock()
                isPaused, lastInterval = nil, interval
                continue
            end

            writeStatistics(settings, payload, clock)
            local url = ("https%*//discord.com/api/webhooks/%*/%*"):format(":", channel, token)
            local encode = bindings.getEncode()
            local encoded = table.pack(encode(bindings.getPayload()))
            local request = bindings.getRequest()
            local response = request(url, "POST", nil, table.unpack(encoded, 1, encoded.n))
            local status = invalidUrl

            if #response < 2 then
                status = localSendDisabled
            end

            setStatus(bindings.getStatus(), status)
            wait(1)
            startedAt = clock()
            isPaused, lastInterval = nil, interval
        end
    end
end
end)()

local createTransferProgress = (function()
-- Record6223: format the captured transfer template and optional farm progress.
type Settings = { [string]: number | boolean | nil }
type Bindings = {
    isEnabled: () -> unknown,
    getSubmit: () -> ((string) -> ())?,
    settings: Settings,
    format: (string, ...unknown) -> string,
    clock: () -> number,
    sign: (string) -> string,
    getTemplate: () -> string,
    substring: (string, number, number) -> string,
}

return function(bindings: Bindings)
    return function()
        if not bindings.isEnabled() then
            return
        end

        if not bindings.getSubmit() then
            return
        end

        local settings = bindings.settings
        local format = bindings.format

        if not settings.FarmMisc_AutoLoadFarmProgress then
            local template = bindings.getTemplate()
            local script = format(template, "")
            local submit = bindings.getSubmit() :: (string) -> ()
            submit(script)
            return
        end

        local currencies = { "Coin", "Egg", "BeachBall", "SnowToken", "Candy", "Heart" }
        local timestamp = bindings.clock()
        local signature = bindings.sign("odh_signkey_asm|" .. (timestamp .. "|mm2"))
        local startedAt = settings.AutoFarmStarttick :: number
        local startSuffix = startedAt .. ","
        local signedSuffix = signature .. ('",start=' .. startSuffix)
        local timestampSuffix = timestamp .. (',sign="' .. signedSuffix)
        local progress = "odh_mm2_cfg_start={timestamp=" .. timestampSuffix

        for index = 1, 6 do
            local currency = currencies[index]
            local amount = settings["Earned" .. currency]
            progress ..= format("%*=%*,", currency, amount)
        end

        local payload = bindings.substring(progress, 1, #progress - 1) .. "}\n\t"
        local template = bindings.getTemplate()
        local script = format(template, payload)
        local submit = bindings.getSubmit() :: (string) -> ()
        submit(script)
    end
end
end)()

