local makeLoad = (createLoad :: any) :: (Values, string) -> unknown
local makeSave = (createSave :: any) :: (Values, string) -> unknown

return function(tab: unknown, bindings: Values, prefix: string): Values
    local isRevert = prefix == "Revert"
    local populate = (if isRevert then populateRevert else populateFlux) :: any
    local makeControls = (if isRevert then createRevert else createFlux) :: any
    local owner, ownerUi, environment, settings = bindings.owner, bindings.ownerUi, bindings.environment, bindings.settings
    local coroutineApi = bindings.coroutineApi
    local category = if isRevert then "gun" else "knife"
    local keyPrefix = if isRevert then "REVERT CONFIG/" else "FLUX CONFIG/"
    local suffix = if isRevert then "" else "\0"
    local callbacks: Values = {}
    local lists: Values = {}
    local selected, presetName = { value = "None" }, { value = "" }
    local x, y, z = { value = 0 }, { value = 0 }, { value = 0 }
    local pingSlider: Values = { value = nil }
    local controls: { any } = {}
    local lastLoad = { value = 0 }
    local preset
    local function prepare()
        local presets = owner.presets[category] or {}
        local names = {}
        for name in presets do table.insert(names, name) end
        if #names == 0 then table.insert(names, "None") end
        lists[keyPrefix .. "Your Presets" .. suffix] = names
        local actions = makeControls({ settings = settings, selectedPreset = selected, presetName = presetName,
            x = x, y = y, z = z, getVector = function() return environment.Vector3.new end })
        callbacks[keyPrefix .. "Your Presets" .. suffix] = actions.select
        callbacks[keyPrefix .. "Preset Name" .. suffix] = actions.name
        callbacks[keyPrefix .. "Prediction Interval" .. suffix] = actions.interval
        callbacks[keyPrefix .. "X Position Offset (%)" .. suffix] = actions.x
        callbacks[keyPrefix .. "Y Position Offset (%)" .. suffix] = actions.y
        callbacks[keyPrefix .. "Z Position Offset (%)" .. suffix] = actions.z
        callbacks[keyPrefix .. "Prediction Horizontal Multiplier (%)" .. suffix] = actions.horizontal
        callbacks[keyPrefix .. "Prediction Vertical Multiplier (%)" .. suffix] = actions.vertical
        callbacks[keyPrefix .. "Load Preset"] = makeLoad({ selected = selected, getClock = bindings.getClock,
            lastLoad = lastLoad, getNotify = bindings.getNotify, getFormat = function() return environment.string.format end,
            settings = settings, controls = controls, pingSlider = pingSlider, presets = presets }, prefix)
    end
    local function prepareSave()
        preset = { author = owner.Discord_Name, game = owner.__Game, category = category, cfg = {} }
        callbacks[keyPrefix .. "Save Preset"] = makeSave({ name = presetName, getNotify = bindings.getNotify,
            settings = settings, preset = preset, getByte = function() return environment.string.byte end,
            x = x, y = y, z = z, encode = owner.json_encode, getChar = function() return environment.string.char end,
            getWriteFile = function() return environment.writefile end, getFormat = function() return environment.string.format end }, prefix)
    end
    local function preparePing()
        callbacks[keyPrefix .. "Prioritize Your Ping" .. suffix] = makePing({ settings = settings,
            getWait = function() return ownerUi.wait end, stats = owner, getIdle = function() return coroutineApi.yield end,
            slider = pingSlider }, prefix)
    end
    local ui: Values = { callbacks = callbacks, options = lists }
    ui[`prepare{prefix}`] = prepare
    ui[`prepare{prefix}Save`] = prepareSave
    ui[`prepare{prefix}Ping`] = preparePing
    ui[`on{prefix}PingSlider`] = function(slider: unknown) pingSlider.value = slider end
    ui[`on{prefix}PresetControl`] = function(index: number, control: unknown) controls[index] = control end
    local state = makeState({ settings = settings, dispatch = coroutineApi.resume, transform = coroutineApi.create })
    local section = populate(tab, ui, state)
    settings[if isRevert then "MM2_GPL" else "MM2_KPL"] = controls
    return { section = section, callbacks = callbacks, selected = selected, presetName = presetName,
        x = x, y = y, z = z, controls = controls, pingSlider = pingSlider, lastLoad = lastLoad, preset = preset, options = lists }
end
end)() :: unknown)

