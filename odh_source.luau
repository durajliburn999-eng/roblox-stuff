standaloneModules.createPluginFiles = ((function()
type Values = { [string]: any }

local workspace = "Ixry Shizuka/plugins/Workspace/"
local pathPrefix = "^[^/\\]+[/\\][^/\\]+[/\\][^/\\]+[/\\]?"
local operations: { string } = { "readfile", "writefile", "appendfile", "delfile", "delfolder", "isfile", "isfolder", "makefolder", "listfiles" }

return function(environment: Values): Values
    local wrappers = {}
    for _, name in operations do
        local operation = environment[name]
        wrappers[name] = function(path: unknown, content: unknown)
            local pathType = type(path)
            if pathType ~= "string" then
                local suffix = if name == "listfiles" then " " else ""
                error(("invalid argument #1 to '%s' (string expected, got %s)%s"):format(name, pathType, suffix), 0)
            end
            local checkedPath = path :: string
            if name == "writefile" or name == "appendfile" then
                local contentType: string = type(content)
                if contentType ~= "string" then
                    error(("invalid argument #2 to '%s' (string expected, got %s)"):format(name, contentType), 0)
                end
                return operation(workspace .. checkedPath, content)
            end
            if name == "listfiles" then
                local files = operation(workspace .. checkedPath)
                for index = 1, #files do
                    files[index] = string.gsub(files[index], pathPrefix, "", 1)
                end
                return files
            end
            if name == "makefolder" then
                operation(workspace .. checkedPath)
                return
            end
            return operation(workspace .. checkedPath)
        end
    end
    return wrappers
end
end)())

standaloneModules.createPluginSandbox = ((function()
type Values = { [string]: any }
type Proxy = { [number]: { [unknown]: unknown } }

local createFiles = (standaloneModules.createPluginFiles :: unknown) :: (Values) -> Values

local blocked = {
    "_G", "appendfile", "delfile", "delfolder", "dofile", "game", "get_hidden_gui", "getfenv", "getgenv", "gethui",
    "getrenv", "isfile", "isfolder", "listfiles", "loadfile", "loadstring", "makefolder", "odh_internal_shared",
    "odh_shared_plugins", "readfile", "run_on_actor", "runonactor", "script", "shared", "string", "table", "typeof", "writefile",
}

return function(bindings: Values): Values
    local environment, state, script = bindings.environment, bindings.state, bindings.script
    local denied, shared = {}, bindings.shared or {}
    for _, name in blocked do denied[name] = true end
    local allowed = createFiles(environment)
    allowed._G, allowed.shared = shared, shared
    allowed.game, allowed.script = environment.game, script
    allowed.string, allowed.table = environment.string, environment.table
    allowed.odh_internal_shared = state
    allowed.getgenv = function() return shared end
    allowed.getrenv = function() return shared end
    local getfenv = environment.getfenv
    allowed.getfenv = function(value: unknown)
        if type(value) == "number" then
            if value == 0 then return getfenv(2) end
            if value > 0 then
                local result = getfenv(value + 1)
                if result == environment then return getfenv(2) end
                return result
            end
        end
        local result = getfenv(value)
        if result == environment then return getfenv(2) end
        return result
    end
    local function hiddenGui() return "hidden lol. - Axioria" end
    allowed.gethui, allowed.get_hidden_gui = hiddenGui, hiddenGui
    allowed.loadstring = function()
        error("`loadstring` function is disabled inside addons environment due to security purposes.", 0)
    end
    local typeOverrides = bindings.typeOverrides or {}
    allowed.typeof = function(value: unknown)
        local override = typeOverrides[value]
        if override then return override.__type end
        return environment.typeof(value)
    end
    return environment.setmetatable({ denied, environment, allowed }, {
        __index = function(proxy: Proxy, key: unknown)
            if not proxy[1][key] then return proxy[2][key] end
            return proxy[3][key]
        end,
        __newindex = function(proxy: Proxy, key: unknown, value: unknown)
            proxy[1][key], proxy[3][key] = true, value
        end,
        __metatable = "The metatable is locked",
    })
end
end)())

standaloneModules.createPluginProxy = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local objects = (bindings.objects or {}) :: { [unknown]: any }
    local overrides = bindings.typeOverrides
    local value = bindings.newProxy(true)
    local metadata = bindings.getMetatable(value)
    local suffix = ' is not a valid member of DataModel "Ugc"'
    metadata.__type = "Instance"
    metadata.__metatable = "The metatable is locked"
    metadata.__index = function(object: unknown, key: string): ...unknown
        local record = objects[object]
        local result = record[1][key]
        if result ~= nil then return result end
        record[2](key .. record[4], 0)
    end
    metadata.__newindex = function(object: unknown, key: string)
        local record = objects[object]
        if record[1][key] ~= nil then
            record[5](record[6], 2)
            return
        end
        record[2](key .. record[4], 0)
    end
    metadata.__tostring = function(object: unknown) return objects[object][7] end
    metadata.__namecall = function(object: unknown, ...: unknown): ...unknown
        local record = objects[object]
        local method = record[1][bindings.namecallKey] :: ((unknown, ...unknown) -> ...unknown)?
        if method ~= nil then return method(object, ...) end
        record[2](record[3]() .. record[4], 0)
    end
    bindings.freeze(metadata)
    overrides[value] = metadata
    objects[value] = { bindings.api, bindings.raise, bindings.getNamecallMethod, suffix,
        bindings.notify, "shared variables cannot be overwritten.", "Ugc" }
    return value
end
end)())

