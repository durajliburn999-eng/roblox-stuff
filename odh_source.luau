standaloneModules.convertExclusiveCatalog = ((function()
type Values = { [unknown]: unknown }
local tiers: { [string]: number } = { Common = 1, Commons = 1, Uncommon = 3, Uncommons = 3,
    Rare = 6, Rares = 6, Legendary = 12, Legendaries = 12 }
local adjustments: { [number]: number } = { [1] = 2, [2] = -1, [4] = 2, [5] = 4 }
local rarities = { "Sets", "Uniques", "Ancients", "Vintages", "Chromas", "Godlies", "Legendaries", "Rares", "Uncommons", "Commons" }

return function(categories: Values): Values
    for _, rarity in rarities do
        local items = categories[rarity]
        for _, details in items :: Values do
            local entry = details :: Values
            local value = entry.x or 0
            if type(value) == "string" then
                local count, tier = string.match(value, "x(%d+) T1 (%w+)")
                local base = tiers[tier :: string]
                local amount = (tonumber(count) :: number) * base
                value = math.max(1, amount + (adjustments[entry.f :: number] or 0))
            end
            entry.Contains, entry.d = entry.d, nil
            entry.Value, entry.x = value, nil
            entry["Ranged Value"], entry.r = entry.r, nil
            entry.Stability, entry.e = entry.e, nil
            entry.Demand, entry.f = entry.f, nil
            entry.Rarity, entry.b = entry.b, nil
            entry.Origin, entry.z = entry.z, nil
            entry["Last Change in Value"], entry.o = entry.o, nil
        end
    end
    return categories
end
end)() :: unknown)

standaloneModules.setupExclusiveTrade = ((function()
local createWorker = standaloneModules.createTradeValues
local createToggle = standaloneModules.createTradeValueToggle

type Values = { [any]: any }
local makeWorker = (createWorker :: any) :: (Values) -> () -> ()
local makeToggle = (createToggle :: any) :: (Values) -> (unknown) -> ()

return function(bindings: Values): Values?
    local find = bindings.find
    local gui = find(bindings.playerGui, "TradeGUI")
    if not gui then return nil end
    local container = find(gui, "Container")
    if not container then return nil end
    local trade = find(container, "Trade")
    if not trade then return nil end
    local yours = find(trade, "YourOffer")
    if not yours then return nil end
    local yoursContainer = find(yours, "Container")
    if not yoursContainer then return nil end
    local theirs = find(trade, "TheirOffer")
    if not theirs then return nil end
    local theirsContainer = find(theirs, "Container")
    if not theirsContainer then return nil end

    local function totalLabel(parent: unknown, index: number): Values
        local label = bindings.create("TextLabel")
        label.Name = "bitch stop skidding"
        label.Parent = parent
        label.BackgroundColor3 = bindings.white
        label.BackgroundTransparency = 1
        label.AnchorPoint = bindings.anchor
        label.Position = bindings.fromScale(0.365, 0.085)
        label.Size = bindings.fromOffset(50, 50)
        if index == 1 then label.Font = bindings.font end
        label.Text = 'Total Value: <font color="rgb(0, 0, 255)">0</font> (Tie)'
        if index == 2 then label.Font = bindings.font end
        label.TextColor3 = bindings.white
        label.TextSize = 15
        label.RichText = true
        label.Visible = false
        return label
    end
    local totalsLabels = { totalLabel(yours, 1), totalLabel(theirs, 2) }
    local containers = { yoursContainer, theirsContainer }
    local labels: { Values } = { {}, {} }
    local panels: { Values } = { {}, {} }
    local totals, cache = { 0, 0 }, {}
    local items = bindings.items
    for side = 1, 2 do
        local currentPanels = panels[side]
        local total = totalsLabels[side]
        local worker = makeWorker({ getItems = function() return items end, getNumber = function() return bindings.number end,
            getPanels = function() return currentPanels end, cache = cache, getStripBust = function() return bindings.stripBust end,
            getValues = function() return bindings.values end, getMatch = function() return bindings.match end,
            totals = totals, getSide = function() return side end, getTotalLabel = function() return total end })
        for index = 1, 4 do
            local slot = find(containers[side], `NewItem{index}`)
            if not slot then return nil end
            local itemName = find(slot, "ItemName")
            if not itemName then return nil end
            local itemContainer = find(slot, "Container")
            if not itemContainer then return nil end
            local icon = find(itemContainer, "Icon")
            if not icon then return nil end
            local amount = find(itemContainer, "Amount")
            if not amount then return nil end
            local label = bindings.create("TextLabel")
            label.Name = "ODH"
            label.Parent = itemName
            label.BackgroundColor3 = bindings.white
            label.BackgroundTransparency = 1
            label.AnchorPoint = bindings.anchor
            label.Position = bindings.fromScale(0.5, -2.55)
            label.Size = bindings.fromOffset(50, 50)
            label.Font = bindings.font
            label.TextColor3 = bindings.white
            label.TextSize = 13
            label.RichText = true
            label.Visible = false
            labels[side][index] = label
            currentPanels[index] = { slot, itemName, itemContainer, icon, amount, label }
            bindings.connect(bindings.getSignal(slot, "Visible"), worker)
            bindings.connect(bindings.getSignal(amount, "Text"), worker)
        end
    end
    return { toggle = makeToggle({ panels = labels, firstTotal = totalsLabels[1], secondTotal = totalsLabels[2] }),
        labels = labels, panels = panels, totals = totals, cache = cache, totalLabels = totalsLabels }
end
end)() :: unknown)

