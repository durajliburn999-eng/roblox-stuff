    gradientSource: () -> { Color: unknown },
    template: () -> Template,
    makeName: () -> unknown,
    fromRGB: () -> ((number, number, number) -> unknown),
    owner: () -> Owner,
    parent: () -> unknown,
    wait: () -> (() -> ()),
    counter: () -> number,
    setCounter: (number) -> (),
    pending: () -> Pending,
    makeSize: () -> ((number, number, number, number) -> unknown),
    sizeTarget: () -> Target?,
    enterInfo: () -> unknown,
    fillInfo: () -> unknown,
    fillGoal: () -> unknown,
    register: () -> ((Notification, Pending, number) -> ()),
    play: (Tween) -> (),
    waitCompleted: (unknown) -> (),
    destroy: (unknown) -> (),
    exitGoal: () -> unknown,
}

local function notificationColor(fromRGB: (number, number, number) -> unknown, severity: unknown): (unknown, string)
    if severity == 1 then
        return fromRGB(34, 197, 94), "check"
    end

    if severity == 2 then
        return fromRGB(239, 68, 68), "warn"
    end

    if severity == 3 then
        return fromRGB(245, 158, 11), "error"
    end

    return fromRGB(59, 130, 246), "info"
end

return function(bindings: Bindings)
    local writeProperty = bindings.writeProperty

    return function(action: unknown, message: unknown, severity: unknown)
        if action ~= 1 then
            return
        end

        local createTween = bindings.createTween()
        local tweenService = bindings.tweenService()
        local gradientColor = bindings.gradientSource().Color
        local template = bindings.template()
        local notification = template:Clone()
        local gradient = notification.Gradient
        local icon = notification.Icon
        local _title = notification.Title
        local textLabel = notification.Message
        local fill = notification.Bar.Fill
        notification.Name = bindings.makeName()
        gradient.Color = gradientColor
        textLabel.Text = message

        local fromRGB = bindings.fromRGB()
        local color, assetName = notificationColor(fromRGB, severity)
        fill.BackgroundColor3 = color
        local getAsset = bindings.owner().getLoadedAsset
        writeProperty(icon, "Image", getAsset(assetName))
        notification.Parent = bindings.parent()
        local gradients = bindings.owner().SecondaryVariantElements
        gradients[#gradients + 1] = gradient

        bindings.wait()()
        local height = textLabel.TextBounds.Y / 55
        local notificationId = bindings.counter() + 1
        bindings.setCounter(notificationId)
        bindings.pending()[notificationId] = true

        local makeSize = bindings.makeSize()
        textLabel.Size = makeSize(1, -20, 0.25, 10 + height)
        local sizeTarget = bindings.sizeTarget() :: Target
        makeSize = bindings.makeSize()
        sizeTarget.Size = makeSize(0.25, 180, 0.25, 55 + height)

        local currentTarget = bindings.sizeTarget()

        if not currentTarget then
            -- Original fault: target removal reaches a call of the previous size scale.
            local staleSizeScale = 0.25
            local invalidCall = (staleSizeScale :: unknown) :: (number, number, number, number) -> ()
            invalidCall(180, 0.25, 55 + height, height)
        end

        local enterInfo = bindings.enterInfo()
        local enterGoal = bindings.sizeTarget()
        local enterTween = createTween(tweenService, notification, enterInfo, enterGoal)
        local fillInfo = bindings.fillInfo()
        local fillGoal = bindings.fillGoal()
        local fillTween = createTween(tweenService, fill, fillInfo, fillGoal)
        local register = bindings.register()
        local pending = bindings.pending()
        register(notification, pending, notificationId)
        bindings.play(enterTween)
        bindings.play(fillTween)

        local completed = fillTween.Completed
        bindings.waitCompleted(completed)
        bindings.destroy(enterTween)
        bindings.destroy(fillTween)

        local exitInfo = bindings.enterInfo()
        local exitGoal = bindings.exitGoal()
        local exitTween = createTween(tweenService, notification, exitInfo, exitGoal)
        bindings.play(exitTween)
        completed = exitTween.Completed
        bindings.waitCompleted(completed)
        bindings.destroy(exitTween)
        bindings.destroy(notification)
        bindings.pending()[notificationId] = nil
    end
end
end)()

