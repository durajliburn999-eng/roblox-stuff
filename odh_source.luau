local createStorage = (function()
local function normalize(path)
    assert(type(path) == "string", "Expected a path string")

    local segments = {}

    for segment in path:gsub("\\", "/"):gmatch("[^/]+") do
        assert(segment ~= "..", "Parent traversal is not supported")

        if segment ~= "." then
            segments[#segments + 1] = segment
        end
    end

    return table.concat(segments, "/")
end

return function()
    local files = {}
    local folders = { [""] = true }
    local storage = {}

    function storage.makefolder(path)
        local parent = ""

        for segment in normalize(path):gmatch("[^/]+") do
            parent = parent == "" and segment or parent .. "/" .. segment
            assert(files[parent] == nil, "A file occupies this path")
            folders[parent] = true
        end
    end

    function storage.isfolder(path)
        return folders[normalize(path)] == true
    end

    function storage.isfile(path)
        return files[normalize(path)] ~= nil
    end

    function storage.writefile(path, content)
        assert(type(content) == "string", "Expected file content as a string")

        local normalized = normalize(path)
        local parent = normalized:match("^(.*)/") or ""

        assert(not folders[normalized], "A folder occupies this path")
        assert(folders[parent], "Parent folder does not exist")
        files[normalized] = content
    end

    function storage.readfile(path)
        local content = files[normalize(path)]
        assert(content ~= nil, "Local resource does not exist")
        return content
    end

    function storage.appendfile(path, content)
        assert(type(content) == "string", "Expected file content as a string")
        storage.writefile(path, (files[normalize(path)] or "") .. content)
    end

    function storage.listfiles(path)
        local normalized = normalize(path)
        assert(folders[normalized], "Folder does not exist")

        local prefix = normalized == "" and "" or normalized .. "/"
        local entries = {}

        local function collect<T>(collection: { [string]: T })
            for candidate in collection do
                if candidate:sub(1, #prefix) ~= prefix then
                    continue
                end

                local suffix = candidate:sub(#prefix + 1)

                if suffix ~= "" and not suffix:find("/", 1, true) then
                    entries[#entries + 1] = candidate
                end
            end
        end

        collect(files)
        collect(folders)
        table.sort(entries)
        return entries
    end

    function storage.delfile(path)
        files[normalize(path)] = nil
    end

    function storage.delfolder(path)
        local normalized = normalize(path)
        assert(normalized ~= "", "Cannot delete the memory root")

        local prefix = normalized .. "/"

        local function remove<T>(collection: { [string]: T })
            for candidate in collection do
                if candidate == normalized or candidate:sub(1, #prefix) == prefix then
                    collection[candidate] = nil
                end
            end
        end

        remove(files)
        remove(folders)
    end

    return storage
end
end)()

local createLocalRequest = (function()
type Request = { [string]: unknown }
type Webhook = { id: string, method: string }
type Dependencies = {
    webhookStub: ((Request, Webhook) -> unknown)?,
    itemSource: string,
    catalogs: { values: string, emotes: { [string]: string? } },
    decodeJSON: (unknown) -> unknown,
    wait: (number) -> (),
    readfile: (string) -> string,
    assetPaths: { [string]: string? },
    observeMissing: ((string) -> ())?,
}

local WEBHOOK_HOSTS = {
    ["discord.com"] = true,
    ["discordapp.com"] = true,
    ["canary.discord.com"] = true,
    ["ptb.discord.com"] = true,
}

local function webhookId(url: string): string?
    local host, path = url:lower():match("^https?://([^/?#]+)(/[^?#]*)")

    if not host or not WEBHOOK_HOSTS[host] then
        return nil
    end

    return (path :: string):match("^/api/webhooks/(%d+)/[^/]+")
        or (path :: string):match("^/api/v%d+/webhooks/(%d+)/[^/]+")
end

local function response(body: string, contentType: string)
    return {
        Success = true,
        StatusCode = 200,
        Headers = { ["Content-Type"] = contentType },
        Body = body,
    }
end

local function describeRequest(method: string, url: string): string
    local address = url:match("^[^?#]*") or ""
    address = address:gsub("^(%w+://)[^/@]+@", "%1[redacted]@")
    address = address:gsub("(/api/webhooks/).*", "%1[redacted]")
    address = address:gsub("(/api/v%d+/webhooks/).*", "%1[redacted]")
    address = address:gsub("[%c]", "?"):sub(1, 240)
    return method .. " " .. address
end

return function(dependencies: Dependencies)
    return function(request: Request)
        assert(type(request) == "table", "Local request expects a table")

        local url = request.Url or request.URL or request.url
        local method = request.Method or request.method or "GET"
        assert(type(url) == "string" and type(method) == "string", "Local request requires a URL and method")
        method = method:upper()

        local webhook = webhookId(url)

        if webhook then
            assert(type(dependencies.webhookStub) == "function", "Local webhook stub missing")
            dependencies.wait(0)
            return (dependencies.webhookStub :: (Request, Webhook) -> unknown)(request, { id = webhook, method = method })
        end

        if url == "https://cdn.overdrivehub.xyz/mm2_db_sync.lua" and method == "GET" then
            return response(dependencies.itemSource, "text/plain")
        end

        if url == "https://api.overdrivehub.xyz/v1/proxy/mm2_values" and method == "POST" then
            return response(dependencies.catalogs.values, "application/json")
        end

        if url == "https://api.overdrivehub.xyz/v1/proxy/roblox_emotes" and method == "POST" then
            local fields = dependencies.decodeJSON(request.Body or "{}") :: { [string]: unknown }
            assert(type(fields) == "table", "Local emote request must be an object")

            local cursor = fields.cursor or ""
            assert(type(cursor) == "string", "Local emote cursor must be a string")

            local body = dependencies.catalogs.emotes[cursor]
            assert(body, "Unrecorded local emote cursor")
            return response(body, "application/json")
        end

        local assetPath = dependencies.assetPaths[url]

        if assetPath and method == "GET" then
            return response(dependencies.readfile(assetPath), "image/png")
        end

        local description = describeRequest(method, url)

        if dependencies.observeMissing then
            dependencies.observeMissing(description)
        end

        error("Unbundled local resource requested: " .. description, 0)
    end
end
end)()

local localWebhook = (function()
-- Edit this function to change local webhook handling. It performs no network IO.
type Request = { Url: string?, URL: string?, url: string? }
type Webhook = { id: string, method: string }

return function(request: Request, webhook: Webhook)
    local method = webhook.method
    local url = (request.Url or request.URL or request.url) :: string
    local waitForMessage = (url .. "&"):find("[?&]wait=true[&#]") ~= nil
    local messagePath = url:find("/messages/", 1, true) ~= nil
    local status = 204
    local body = ""

    if method == "GET" or method == "PATCH" or method == "PUT" or method == "POST" and waitForMessage then
        status = 200
        body = '{"id":"0","channel_id":"0","content":"","embeds":[],"attachments":[],"local_stub":true}'

        if not messagePath and (method == "GET" or method == "PATCH") then
            body = '{"id":"' .. webhook.id .. '","type":1,"name":"Local webhook","channel_id":"0","guild_id":"0","avatar":null,"local_stub":true}'
        end
    end

    if method == "HEAD" then
        status = 200
    end

    return {
        Success = true,
        StatusCode = status,
        StatusMessage = status == 204 and "No Content" or "OK",
        Headers = { ["Content-Type"] = "application/json", ["X-Overdrive-Local-Stub"] = "webhook" },
        Body = body,
        LocalOnly = true,
        Skipped = true,
    }
end
end)()

local createEnvironment = (function()
-- Local dependency adapter, not a security sandbox for arbitrary Lua.
-- Engine services remain real Instances; network and storage entry points are explicit.
local GLOBAL_NAMES = {
    "assert", "error", "ipairs", "next", "pairs", "pcall", "xpcall", "select",
    "tonumber", "tostring", "type", "typeof", "unpack", "rawget", "rawset",
    "rawequal", "rawlen", "getmetatable", "setmetatable", "setfenv", "table", "string",
    "math", "bit32", "buffer", "vector", "coroutine", "utf8", "os", "debug",
    "Instance", "Enum", "Vector2", "Vector3", "CFrame", "UDim", "UDim2",
    "Color3", "Rect", "Ray", "Region3", "RaycastParams", "OverlapParams",
    "TweenInfo", "Font", "NumberSequence", "NumberSequenceKeypoint",
    "ColorSequence", "ColorSequenceKeypoint", "NumberRange", "Random",
    "DateTime", "PhysicalProperties", "BrickColor", "Axes", "Faces",
    "Drawing", "gethui", "getconnections", "firesignal", "firetouchinterest",
    "fireproximityprompt", "mouse1click", "mouse1press", "mouse1release",
    "mouse2click", "mouse2press", "mouse2release", "mousemoveabs",
    "mousemoverel", "keypress", "keyrelease", "setclipboard",
    "getthreadidentity", "setthreadidentity", "identifyexecutor", "getexecutorname",
}

type Game = { [string]: unknown, GetService: (Game, string) -> unknown }
type Host = {
    [string]: unknown,
    task: { wait: unknown, spawn: unknown, delay: unknown },
    game: Game,
    pcall: (unknown, ...unknown) -> ...unknown,
}
type Response = { Success: unknown, Body: unknown }
type Resources = {
    observeFailure: ((unknown) -> ())?,
    filesystem: { [string]: unknown },
    request: (unknown) -> ...unknown,
    websocket: unknown,
    resolveCode: unknown,
    asset: unknown,
    requireModule: unknown,
    onTeleportQueueSuppressed: () -> (),
    onKickSuppressed: ((unknown) -> ())?,
}

return function(host: Host, resources: Resources)
    local environment: { [string]: unknown } = {}

    for _, name in GLOBAL_NAMES do
        environment[name] = host[name]
    end

    environment.task = host.task
    environment.wait = host.task.wait
    environment.spawn = host.task.spawn
    environment.delay = host.task.delay
    environment.tick = host.tick
    environment.time = host.time
    environment.elapsedTime = host.elapsedTime
    environment.print = host.print
    environment.warn = host.warn
    environment.workspace = host.workspace
    environment.shared = {}
    environment._G = environment

    if resources.observeFailure then
        environment.pcall = function(callback, ...)
            local results = table.pack(host.pcall(callback, ...))

            if not results[1] then
                host.pcall(resources.observeFailure, results[2])
            end

            return table.unpack(results, 1, results.n)
        end
    end

    local function getEnvironment()
        return environment
    end

    environment.getgenv = getEnvironment
    environment.getrenv = getEnvironment
    environment.getfenv = getEnvironment
    environment.cloneref = function(value) return value end
    environment.clonereference = environment.cloneref

    for name, operation in resources.filesystem do
        environment[name] = operation
    end

    local function request(options: unknown): ...unknown
        assert(type(options) == "table", "Local request expects a table")
        return resources.request(options)
    end

    local function getBody(_: unknown, url: unknown): unknown
        local result = request({ Url = url, Method = "GET" }) :: Response
        assert(result.Success, "Local resource is unavailable")
        return result.Body
    end

    local function postBody(_: unknown, url: unknown, body: unknown): unknown
        local result = request({ Url = url, Method = "POST", Body = body }) :: Response
        assert(result.Success, "Local resource rejected the request")
        return result.Body
    end

    environment.request = request
    environment.http_request = request
    environment.http = { request = request }
    local syn: { [string]: unknown } = { request = request }
    environment.syn = syn
    environment.WebSocket = resources.websocket
    environment.websocket = resources.websocket
    syn.websocket = resources.websocket
    environment.loadstring = resources.resolveCode
    environment.getcustomasset = resources.asset
    environment.getsynasset = resources.asset
    environment.require = resources.requireModule or function()
        error("Unbundled module requested by local build")
    end
    environment.queue_on_teleport = function()
        resources.onTeleportQueueSuppressed()
    end
    environment.queueonteleport = environment.queue_on_teleport
    syn.queue_on_teleport = environment.queue_on_teleport

    local nativeHttp = host.game:GetService("HttpService") :: { [string]: unknown }
    local http: { [string]: unknown } = {
        RequestAsync = function(_, options) return request(options) end,
        GetAsync = getBody,
        PostAsync = postBody,
    }

    for _, name in { "JSONEncode", "JSONDecode", "GenerateGUID", "UrlEncode" } do
        local operation = nativeHttp[name]
        http[name] = function(_, ...)
            local call = operation :: (unknown, ...unknown) -> ...unknown
            return call(nativeHttp, ...)
        end
    end

    local gameProxy: { [string]: unknown }? = nil
    local players = host.game:GetService("Players") :: { LocalPlayer: { Kick: unknown }? }
    local player = players.LocalPlayer
    local nativeKick = player and player.Kick

    local function localKick(_: unknown, message: unknown)
        if resources.onKickSuppressed then
            resources.onKickSuppressed(message)
        end
    end

    environment.__adaptCallTarget = function(value: unknown): unknown
        if type(value) ~= "function" then
            return value
        end

        if rawequal(value, nativeKick) then
            return localKick
        end

        return value
    end

    local function adaptService(value: unknown): unknown
        if type(nativeKick) == "function" and rawequal(value, nativeKick) then
            return localKick
        end

        if rawequal(value, host.game) then
            return gameProxy
        end

        if rawequal(value, nativeHttp) then
            return http
        end

        return value
    end

    local proxy: { [string]: unknown } = {
        HttpGet = getBody,
        HttpGetAsync = getBody,
        HttpPost = postBody,
        HttpPostAsync = postBody,
        GetObjects = function() error("Remote object loading is unavailable in local build") end,
    }
    gameProxy = proxy
    setmetatable(proxy, {
        __index = function(_: unknown, key: string): unknown
            local value = host.game[key]

            if type(value) == "function" then
                local operation = value :: (unknown, ...unknown) -> ...unknown
                return function(_: unknown, ...: unknown): unknown
                    return adaptService(operation(host.game, ...))
                end
            end

            return adaptService(value)
        end,
    })

    environment.game = gameProxy
    environment.__adaptEngineValue = adaptService
    environment.Game = gameProxy
    environment.Workspace = environment.workspace
    return environment
end
end)()

standaloneModules.createReplaySocket = ((function()
type ListenerCallback = (...unknown) -> ()
type Connection = { Connected: boolean, Disconnect: (Connection) -> () }
type Listener = { callback: ListenerCallback, connection: Connection }
type Signal = {
    __fixtureType: string,
    Connect: (Signal, ListenerCallback) -> Connection,
    Fire: (Signal, ...unknown) -> (),
}
type TaskApi = {
    spawn: (ListenerCallback, ...unknown) -> (),
    wait: (number) -> unknown,
    delay: (number, () -> ()) -> (),
}
type Socket = {
    OnMessage: Signal,
    OnClose: Signal,
    closed: boolean,
    sent: number,
    Send: (Socket, unknown) -> (),
    Close: (Socket) -> (),
}

local function createSignal(taskApi: TaskApi): Signal
    local listeners: { Listener } = {}
    local signal = { __fixtureType = "RBXScriptSignal" } :: Signal

    function signal.Connect(_self: Signal, callback: ListenerCallback): Connection
        assert(type(callback) == "function", "REPLAY_LISTENER_REQUIRED")
        local connection = { Connected = true } :: Connection

        function connection.Disconnect(self: Connection)
            self.Connected = false
        end

        listeners[#listeners + 1] = { callback = callback, connection = connection }
        return connection
    end

    function signal.Fire(_self: Signal, ...: unknown)
        for _, listener in listeners do
            if listener.connection.Connected then
                taskApi.spawn(listener.callback, ...)
            end
        end
    end

    return (setmetatable(signal, { __index = function() return nil end }) :: unknown) :: Signal
end

return function(taskApi: TaskApi, transcript: { [number]: unknown }, observe: ((string?) -> ())?, _functionOrigins: unknown)
    local function connect(url: unknown): Socket
        assert(url == "wss://api.overdrivehub.xyz/v1/xhuangshi", "UNRECORDED_SOCKET_URL")

        if observe then
            observe()
        end

        taskApi.wait(0.05)
        local socket = { OnMessage = createSignal(taskApi), OnClose = createSignal(taskApi), closed = false, sent = 0 } :: Socket

        function socket.Send(self: Socket, payload: unknown)
            assert(not self.closed and type(payload) == "string", "REPLAY_SOCKET_SEND_INVALID")

            if observe then
                observe(payload)
            end

            self.sent += 1
            local request = transcript[(self.sent - 1) * 2 + 1]
            local response = transcript[(self.sent - 1) * 2 + 2]
            assert(request and response, "UNRECORDED_SOCKET_EXCHANGE")
            taskApi.delay(0.05, function()
                if self.closed then
                    return
                end

                self.OnMessage:Fire(response)
            end)
        end

        function socket.Close(self: Socket)
            if self.closed then
                return
            end

            self.closed = true
            self.OnClose:Fire()
        end

        return (setmetatable(socket, { __index = function() return nil end }) :: unknown) :: Socket
    end

    return { connect = connect, Connect = connect }
end
end)())

standaloneModules.createRequestChannel = ((function()
type Slots = { [number]: unknown }
type Bindings = {
    responses: () -> Slots,
    pending: () -> Slots,
    random: () -> ((number, number) -> number),
    wait: () -> (() -> ()),
    outgoing: () -> Slots,
    completed: () -> Slots,
}
type Limits = {
    clock: () -> number,
    timeoutSeconds: number,
    maximumWaits: number,
    isCancelled: (() -> boolean)?,
}

-- Successful responses retain the recovered behavior; failures now have bounded waits.
local UINT32_RANGE = 4294967296
local CHALLENGE_MASK = 7273484

local function transformChallenge(challenge: number): number
    local remaining = challenge % UINT32_RANGE

    if remaining % 1 == 0 then
        return bit32.bxor(remaining, CHALLENGE_MASK)
    end

    -- Preserve the original arithmetic for fractional and non-finite inputs.
    local mask = CHALLENGE_MASK
    local weight = 1
    local result = 0

    for _ = 1, 32 do
        if remaining % 2 ~= mask % 2 then
            result += weight
        end

        remaining //= 2
        mask //= 2
        weight *= 2
    end

    return result
end

local function selectRequestId(pending: Slots, random: (number, number) -> number): number
    for _ = 1, 256 do
        local id = random(0, 255)

        if not pending[id] then
            return id
        end
    end

    for id = 0, 255 do
        if not pending[id] then
            return id
        end
    end

    error("REQUEST_SLOTS_EXHAUSTED", 0)
end

return function(bindings: Bindings, suppliedLimits: Limits?)
    local limits: Limits = suppliedLimits or {
        clock = os.clock,
        timeoutSeconds = 15,
        maximumWaits = 4096,
    }
    assert(limits.timeoutSeconds > 0 and limits.timeoutSeconds < math.huge, "Invalid request timeout")
    assert(limits.maximumWaits >= 1 and limits.maximumWaits < math.huge, "Invalid wait limit")
    assert(limits.maximumWaits % 1 == 0, "Wait limit must be an integer")

    local closed = false
    local closeReason: unknown = nil

    return function(payload: unknown, challenge: number)
        if closed then
            error(closeReason, 0)
        end

        if limits.isCancelled and limits.isCancelled() then
            error("REQUEST_CANCELLED", 0)
        end

        local responses = bindings.responses()
        local pending = bindings.pending()
        local random = bindings.random()
        local waitForResponse = bindings.wait()
        local requestId = selectRequestId(pending, random)
        local outgoing: Slots? = nil
        pending[requestId] = true

        local ok, response = pcall(function()
            local deadline = limits.clock() + limits.timeoutSeconds
            local queue = bindings.outgoing()
            outgoing = queue
            queue[requestId] = payload
            local value = responses[requestId]
            local waits = 0

            while not value do
                if closed then
                    error(closeReason, 0)
                end

                if limits.isCancelled and limits.isCancelled() then
                    error("REQUEST_CANCELLED", 0)
                end

                if limits.clock() >= deadline or waits >= limits.maximumWaits then
                    error("REQUEST_TIMEOUT", 0)
                end

                waits += 1
                waitForResponse()

                if closed then
                    error(closeReason, 0)
                end

                if limits.isCancelled and limits.isCancelled() then
                    error("REQUEST_CANCELLED", 0)
                end

                if limits.clock() >= deadline then
                    error("REQUEST_TIMEOUT", 0)
                end

                value = responses[requestId]
            end

            return value
        end)

        if not ok then
            closed = true
            closeReason = response
            responses[requestId] = nil

            if outgoing and rawequal(outgoing[requestId], payload) then
                outgoing[requestId] = nil
            end

            -- Keep the ID reserved: a delayed reply must not match a later request.
            error(response, 0)
        end

        responses[requestId] = nil
        bindings.completed()[requestId] = true
        return response, transformChallenge(challenge), challenge * 143 / 2
    end
end
end)())

standaloneModules.acceptLocalDecodedResponse = ((function()
local xor = bit32.bxor

type Dictionary = { [unknown]: unknown }
type Request = { fields: Dictionary }
type Bindings = {
    getRequest: () -> Request?,
    getPending: () -> Dictionary,
    getResponses: () -> Dictionary,
    getTiming: () -> Dictionary,
    clock: () -> unknown,
}

return function(bindings: Bindings, decoded: Dictionary, afterClear: ((Dictionary, unknown, Dictionary) -> ())?)
    local request = assert(bindings.getRequest())
    local pending = bindings.getPending()
    local id = next(pending)
    assert(id and next(pending, id) == nil, "LOCAL_MULTIPLE_PENDING_REQUESTS")
    local response = table.clone(decoded)
    -- A replayed local response is emitted now, not at the recording's timestamp.
    if response[64] ~= nil then
        response[64] = xor((bindings.clock() :: number) // 35, 243246)
    end
    local fields = request.fields
    response[95] = fields._
    if fields.e == 0 then
        response[114] = fields.x
    end
    local timing = bindings.getTiming()
    bindings.getPending()[id] = nil
    if afterClear then
        afterClear(response, id, timing)
        return
    end
    local now = bindings.clock()
    bindings.getResponses()[id] = response
    timing[2] = now
    timing[3] = now
end
end)())

