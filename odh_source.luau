standaloneModules.initializeRuntimeDiagnostics = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local control, main, module = bindings.control, bindings.main, bindings.module
    control.snapshot = function()
        return { phase = control.phase, steps = bindings.getSteps(), factory = bindings.getFactory(), pc = main.pc,
            variant = main.variant, modulePc = module.pc,
            moduleBytes = if module.metadata then bindings.bufferLength(module.metadata[6]) else nil,
            instances = control.instances, screenGuis = control.screenGuis }
    end
    control.captureFailure = function(message: unknown)
        local failure = control.snapshot()
        failure.message = bindings.toString(message)
        failure.operands = {}
        for _, field in { "g", "q", "m", "T" } do
            local array = main[field .. "Array"]
            local slot = if array then array[main.pc] else nil
            if not slot then continue end
            local value = main.registers[slot]
            local operand: Values = { slot = slot, kind = bindings.typeof(value) }
            if type(value) == "string" then operand.text = string.sub(value, 1, 200) end
            if type(value) == "number" then operand.number = value end
            failure.operands[field] = operand
        end
        control.failure = failure
        control.phase = "failed"
    end
end
end)())

