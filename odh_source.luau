local modulus = 4294967296
local band = bit32.band
local bxor = bit32.bxor
local rrotate = bit32.rrotate
local rshift = bit32.rshift

return function(message: string): string
    local bytes: { number } = table.create(#message, 0)
    for index = 1, #message do
        bytes[index] = string.byte(message, index)
    end
    local bitLength = #bytes * 8
    table.insert(bytes, 128)
    while #bytes % 64 ~= 56 do
        table.insert(bytes, 0)
    end

    local high = math.floor(bitLength / modulus)
    local low = bitLength % modulus
    for _, word in { high, low } do
        for shift = 24, 0, -8 do
            table.insert(bytes, band(rshift(word, shift), 255))
        end
    end

    local state = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
    local schedule = table.create(64, 0)
    for offset = 1, #bytes, 64 do
        for index = 1, 16 do
            local position = offset + (index - 1) * 4
            schedule[index] = bytes[position] * 16777216 + bytes[position + 1] * 65536 + bytes[position + 2] * 256 + bytes[position + 3]
        end
        for index = 17, 64 do
            local a = schedule[index - 15]
            local b = schedule[index - 2]
            local s0 = bxor(rrotate(a, 7), rrotate(a, 18), rshift(a, 3))
            local s1 = bxor(rrotate(b, 17), rrotate(b, 19), rshift(b, 10))
            schedule[index] = (schedule[index - 16] + s0 + schedule[index - 7] + s1) % modulus
        end

        local a, b, c, d, e, f, g, h = table.unpack(state)
        for index = 1, 64 do
            local s1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
            local choose = bxor(band(e, f), band(bit32.bnot(e), g))
            local first = (h + s1 + choose + constants[index] + schedule[index]) % modulus
            local s0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
            local majority = bxor(band(a, b), band(a, c), band(b, c))
            local second = (s0 + majority) % modulus
            h, g, f, e, d, c, b, a = g, f, e, (d + first) % modulus, c, b, a, (first + second) % modulus
        end
        for index, value in { a, b, c, d, e, f, g, h } do
            state[index] = (state[index] + value) % modulus
        end
    end

    local digest = table.create(8, "")
    for index, value in state do
        digest[index] = string.format("%08x", value)
    end
    return table.concat(digest)
end
end)())

