        local shark = section("SHARK HUNTER CRAFTS")
        for _, label in { "Craft Terror Jaw", "Craft Tooth Necklace", "Craft Monster Magnet" } do shark:AddButton(label, callbacks[label]) end
    end
    local raid = section("RAID")
    raid:AddDropdown("Select Chips", chips, state(1, "Raid_SelectChips", nil))
    raid:AddButton("Buy Selected Raid Chip", callbacks["Buy Selected Raid Chip"])
    return raid
end
end)())

standaloneModules.createBloxRaidActions = ((function()
type Values = { [string]: any }

return function(bindings: Values): Values
    local settings, owner = bindings.settings, bindings.owner
    local invoke, remote = bindings.invoke, bindings.remote
    local find, click = bindings.find, bindings.click
    local callbacks: Values = {}

    local function incompatible()
        bindings.getNotify()("Your exploit is incompatible for this feature.", 2)
    end

    local function raidDetector(islandName: string, summonName: string): unknown
        local map = find(bindings.getWorkspace(), "Map")
        if not map then return nil end
        local island = find(map, islandName)
        if not island then return nil end
        local summon = find(island, summonName)
        if not summon then return nil end
        local button = find(summon, "Button")
        if not button then return nil end
        local main = find(button, "Main")
        if not main then return nil end

        return find(main, "ClickDetector")
    end

    callbacks["Auto Buy Selected Raid Chip"] = function()
        local idle = bindings.getIdle()
        while true do
            while settings.AutoBuySelectedRaid do
                bindings.getWait()(1)
                invoke(remote, "RaidsNpc", "Select", settings.Raid_SelectChips)
            end
            idle()
        end
    end

    local secondSea, thirdSea = owner.__BFSecondSea, owner.__BFThirdSea
    callbacks["Start Raid"] = function()
        if not secondSea and not thirdSea then return end
