local createUiSection = (function()
type Container = { Parent: unknown, GetPropertyChangedSignal: (Container, string) -> unknown }
type Label = { Text: unknown, Subtitle: { Text: unknown }, Gradient: unknown }
type SectionNode = { Title: Label, Stroke: { Gradient: unknown }, Parent: unknown }
type Owner = { SecondaryVariantElements: { unknown } }
type Widget = {
    _self: Owner,
    TabContainer: Container,
    GridA: unknown,
    Container1: unknown,
    Container2: unknown,
    HiddenFrame: Container,
    SearchTabShared: { [SectionNode]: { unknown } },
    Section_API: unknown,
    Clone: (unknown) -> SectionNode,
    addAnimatedStroke: (SectionNode, unknown, unknown, boolean) -> (),
    setmetatable: ({ SectionContainer: SectionNode, SearchSectionShared: { unknown } }, unknown) -> unknown,
}
type Bindings = {
    connect: (unknown, () -> ()) -> (),
    createTween: (unknown, string, unknown, unknown) -> unknown,
    tweenInfo: unknown,
    cancelTween: (unknown) -> (),
    template: unknown,
    format: (string, unknown) -> unknown,
    duration: { value: unknown },
}

return function(bindings: Bindings)
    local tweenInfo = bindings.tweenInfo
    local template = bindings.template
    local duration = bindings.duration

    return function(widget: Widget, title: unknown, subtitle: unknown): unknown
        local connect = bindings.connect
        local createTween = bindings.createTween
        local currentTween: unknown = nil
        local cancelTween = bindings.cancelTween
        local owner = widget._self
        local tab = widget.TabContainer
        local section = widget.Clone(template)
        local titleLabel = section.Title
        titleLabel.Text = bindings.format("\n  %*\n", title)
        titleLabel.Subtitle.Text = subtitle or "UNIVERSAL"
        widget.addAnimatedStroke(section, nil, nil, true)
        local secondary = owner.SecondaryVariantElements
        secondary[#secondary + 1] = titleLabel.Gradient

        if widget.GridA then
            section.Parent = widget.Container2
            widget.GridA = nil
        else
            section.Parent = widget.Container1
            widget.GridA = true
        end

        local gradient = section.Stroke.Gradient
        local hidden = widget.HiddenFrame
        local getSignal = tab.GetPropertyChangedSignal
        local function update()
            if tab.Parent and hidden.Parent then
                currentTween = createTween(tweenInfo, "Rotation", gradient, duration.value)
                return
            end

            local tween = currentTween

            if not tween then
                return
            end

            cancelTween(tween)
            currentTween = nil
        end

        connect(getSignal(tab, "Parent"), update)
        connect(getSignal(hidden, "Parent"), update)
        local shared = {}
        widget.SearchTabShared[section] = shared
        local api = { SectionContainer = section, SearchSectionShared = shared }
        return widget.setmetatable(api, widget.Section_API)
    end
end
end)()

standaloneModules.createUiAnimatedStroke = ((function()
type Stroke = { Gradient: unknown, Parent: unknown }
type Template = { Clone: (Template) -> Stroke }
type Bindings = {
    template: Template,
    elements: { unknown },
    getSpawn: () -> ((unknown, string, unknown, unknown, unknown) -> ()),
    worker: unknown,
}

return function(bindings: Bindings)
    local template = bindings.template
    local elements = bindings.elements
    local worker = bindings.worker

    return function(parent: unknown, duration: unknown, easing: unknown, skipAnimation: unknown)
        local stroke = template:Clone()
        local gradient = stroke.Gradient
        stroke.Parent = parent
        elements[#elements + 1] = gradient

        if not skipAnimation then
            bindings.getSpawn()(worker, "Rotation", gradient, duration, easing)
        end
    end
end
end)() :: unknown)

