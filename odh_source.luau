standaloneModules.createMainInvisible = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    character: Cell, root: Cell, seatName: unknown, findChild: (unknown, unknown) -> unknown,
    getCreate: () -> ((string) -> Values), getWait: () -> ((number) -> ()), getFrame: () -> ((number, number, number) -> unknown),
    getDescendants: (unknown) -> { unknown }, isA: (unknown, string) -> unknown, seat: Cell, weld: Cell, remove: (unknown) -> (),
}

return function(bindings: Bindings)
    return function(value: unknown)
        local character = bindings.character.value
        if not character then return end
        local root = bindings.root.value :: Values?
        if not root then return end
        if value then
            if bindings.findChild(character, bindings.seatName) then return end
            local create = bindings.getCreate()
            local wait = bindings.getWait()
            local offset = bindings.getFrame()(-5000, 5000, 5500)
            local oldFrame = root.CFrame
            local seat, weld = create("Seat"), create("Weld")
            seat.Name = bindings.seatName
            seat.Parent = character
            seat.Transparency = 1
            seat.CanCollide = false
            seat.CFrame = offset
            weld.Name = "\000"
            weld.Parent = seat
            weld.Part0 = seat
            weld.Part1 = root
            root.CFrame = offset
            wait(0.4)
            root.CFrame = oldFrame
            local descendants = bindings.getDescendants(character)
            for index = 1, #descendants do
                local part = descendants[index]
                if part == root or part == seat or not bindings.isA(part, "BasePart") then continue end
                (part :: Values).Transparency = 0.75
            end
            bindings.seat.value, bindings.weld.value = seat, weld
            return
        end
        local seat = bindings.seat.value
        if seat then bindings.remove(seat) end
        local weld = bindings.weld.value
        if weld then bindings.remove(bindings.weld.value) end
        local descendants = bindings.getDescendants(character)
        for index = 1, #descendants do
            local part = descendants[index]
            if part == root or not bindings.isA(part, "BasePart") then continue end
            (part :: Values).Transparency = 0
        end
    end
end
end)())

