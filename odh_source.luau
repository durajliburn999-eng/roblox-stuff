        local originalPrint = environment.print
        local gunEnvironment = (environment.getfenv :: (unknown) -> Values)(constructor)
        local taskProxy = setmetatable({}, { __index = function(_, key: string)
            if key == "wait" and settings.NoGunCooldown then return originalPrint end
            return originalTask[key]
        end })
        gunEnvironment.task = taskProxy
        gunEnvironment.print = originalPrint
