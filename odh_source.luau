local createClashNotifier = (function()
-- Recovered descriptor730. The supplied wait controls the worker's lifetime.
type Bindings = {
    waitToken: unknown,
    wait: (unknown) -> (),
    settings: { AutoSpam: unknown, OnClash: number, AutoNotifyUponClashing: unknown },
    clock: () -> number,
    notify: (string) -> (),
    format: (string, ...unknown) -> string,
}

local startedMessage = "Clash Detected! Spamming..."
local endedMessage = 'Clash Ended, took <font color="rgb(0, 255, 0)">%.2f</font>s!'

return function(bindings: Bindings)
    return function()
        local waitToken, wait, settings, clock, notify, format = bindings.waitToken, bindings.wait, bindings.settings, bindings.clock, bindings.notify, bindings.format
        local active: boolean? = nil
        local startedAt = 0

        while true do
            wait(waitToken)

            if not settings.AutoSpam then
                continue
            end

            local lastClash = settings.OnClash
            local elapsed = clock() - lastClash

            if active then
                if not (elapsed > 0.55) then
                    continue
                end

                local notificationsEnabled = settings.AutoNotifyUponClashing
                active = nil

                if notificationsEnabled then
                    local duration = clock() - startedAt
                    local message = format(endedMessage, duration)
                    notify(message)
                end

                continue
            end

            if not (elapsed <= 0.55) then
                continue
            end

            local notificationsEnabled = settings.AutoNotifyUponClashing
            active = true

            if notificationsEnabled then
                startedAt = clock()
                notify(startedMessage)
            end
        end
    end
end
end)()

local createAutoParry = (function()
-- Record1891 recovery candidate. Not integrated until original/native comparison passes.
type Vector = typeof(setmetatable({ Unit = (nil :: unknown) :: unknown, Magnitude = 0 }, {
    __sub = function(left, _right) return left end,
    __mul = function(left, _right) return left end,
}))
type Root = { Position: Vector, Velocity: Vector }
type Ball = { Position: Vector, AssemblyLinearVelocity: Vector }
type Signal = { Wait: (Signal) -> number }
type AbilitySignal = { Fire: (AbilitySignal) -> () }
type Debris = { AddItem: (Debris, unknown, number) -> () }
type Gradient = { Offset: { Y: number } }
type Visualizer = { [string]: unknown }
type Settings = {
    [string]: unknown,
    AbilityGradient: Gradient, BlockGradient: Gradient,
    AutoParry: unknown, ShowRangeVisualizer: unknown, OnClash: number,
    ParryAccuracy: number, RandomizedParryAccuracy: unknown, PingBased: unknown,
    AntiCurve: unknown, NoRangeLimit: unknown, RangeLimiter: number, EquippedAbility: string,
}
type Bindings = {
    settings: Settings,
    getSignal: () -> Signal,
    getAttribute: (unknown, string) -> unknown,
    getWorld: () -> { DeprecatedFolder: unknown },
    getVector: () -> ((number, number, number?) -> Vector),
    getClock: () -> (() -> number),
    getBallContainer: () -> unknown,
    getLocalTarget: () -> unknown,
    getWait: () -> ((number) -> ()),
    findChild: (unknown, string) -> unknown,
    parry: () -> (),
    getPingObject: () -> unknown,
    getPing: (unknown) -> number,
    getRandom: () -> ((number, number) -> number),
    getColor: () -> ((number, number, number) -> unknown),
    abilitySignal: AbilitySignal,
    debris: Debris,
    getMath: () -> { min: (number, number) -> number, max: (number, number) -> number },
    getDot: () -> ((Vector, Vector) -> number),
    getInstance: () -> ((string) -> Visualizer),
    isActive: () -> unknown,
    getRoot: () -> Root?,
}
type State = {
    settings: Settings, signal: Signal, makeVector: (number, number, number?) -> Vector, clock: () -> number,
    localTarget: unknown, wait: (number) -> (), initialParry: () -> (), pingObject: unknown,
    random: (number, number) -> number, addItem: (Debris, unknown, number) -> (),
    minimum: (number, number) -> number, maximum: (number, number) -> number,
    dot: (Vector, Vector) -> number, nextFrame: (Signal) -> number,
    hiddenPosition: Vector, defaultSize: Vector, abilityGradient: Gradient, blockGradient: Gradient,
    fireAbility: (AbilitySignal) -> (), debounceKey: string, warpKey: string,
    red: unknown, green: unknown, blue: unknown, visualizer: Visualizer, lastRemovedEffect: number,
}

local function createState(bindings: Bindings, settingName: string, shape: unknown): State
    local settings = bindings.settings
    local signal = bindings.getSignal()
    local world = bindings.getWorld()
    local makeVector = bindings.getVector()
    local clock = bindings.getClock()
    local localTarget = bindings.getLocalTarget()
    local wait = bindings.getWait()
    local parry = bindings.parry
    local pingObject = bindings.getPingObject()
    local random = bindings.getRandom()
    local makeColor = bindings.getColor()
    local abilitySignal = bindings.abilitySignal
    local debris = bindings.debris
    local mathApi = bindings.getMath()
    local dot = bindings.getDot()
    local addItem = debris.AddItem
    local minimum, maximum = mathApi.min, mathApi.max
    local nextFrame = signal.Wait
    local initialSize = makeVector(0, 0)
    local hiddenPosition = makeVector(0, -9999, 0)
    local defaultSize = makeVector(13.5, 13.5, 13.5)
    local abilityGradient = settings.AbilityGradient
    local blockGradient = settings.BlockGradient
    local fireAbility = abilitySignal.Fire
    local debounceKey = settingName .. "_debounce"
    local warpKey = settingName .. "_warp"
    local red, green, blue = makeColor(255, 0, 0), makeColor(0, 255, 0), makeColor(0, 0, 255)
    local newInstance = bindings.getInstance()
    local visualizer = newInstance("Part")
    visualizer.Name = "visualizer..."
    visualizer.Parent = world.DeprecatedFolder
    visualizer.Transparency = 0.8
    visualizer.Material = "ForceField"
    visualizer.Shape = shape
    visualizer.CastShadow = false
    visualizer.CanCollide = false
    visualizer.Anchored = true
    visualizer.Size = initialSize
    settings[debounceKey] = 0
    settings[warpKey] = 0

    return {
        settings = settings, signal = signal, makeVector = makeVector, clock = clock,
        localTarget = localTarget, wait = wait, initialParry = parry,
        pingObject = pingObject, random = random, addItem = addItem,
        minimum = minimum, maximum = maximum, dot = dot, nextFrame = nextFrame,
        hiddenPosition = hiddenPosition, defaultSize = defaultSize,
        abilityGradient = abilityGradient, blockGradient = blockGradient,
        fireAbility = fireAbility, debounceKey = debounceKey, warpKey = warpKey,
        red = red, green = green, blue = blue, visualizer = visualizer, lastRemovedEffect = 0,
    }
end

local function hideVisualizer(state: State)
    state.visualizer.Color = state.blue
    state.visualizer.Position = state.hiddenPosition
    state.visualizer.Size = state.defaultSize
end

local function showClashStatus(state: State)
    local elapsed = state.clock() - state.settings.OnClash
    state.visualizer.Color = elapsed <= 0.55 and state.red or state.blue
    state.visualizer.Size = state.defaultSize
end

local function readAccuracy(state: State): number
    local accuracy = state.settings.ParryAccuracy

    if state.settings.RandomizedParryAccuracy then
        return 0.7 + (state.random(1, 100) - 1) * 0.003535353535353535
    end

    return accuracy
end

local function curveIsRejected(state: State, delta: Vector, velocity: Vector, distance: number, speed: number, latency: number): boolean
    local velocityUnit = velocity.Unit :: Vector
    local deltaUnit = delta.Unit :: Vector
    local alignment = state.dot(deltaUnit, velocityUnit)
    local tolerance = state.minimum(speed / 100, 40)
    local adjusted = (velocityUnit - velocity).Unit :: Vector
    local change = alignment - state.dot(deltaUnit, adjusted)
    local threshold = 0.45 - latency / 1000
    local arrival = distance / speed - latency / 1000
    local padding = state.minimum(distance / 1000, 15)
    tolerance = 15 - padding + tolerance

    if speed > 100 and latency / 10 < arrival then
        tolerance = state.maximum(tolerance - 15, 15)
    end

    return distance > 20 and distance >= tolerance and (change < threshold or alignment < threshold)
end

local function hasBlockingEffect(state: State, bindings: Bindings, ball: Ball, root: Root): boolean
    local effect = bindings.findChild(ball, "AeroDynamicSlashVFX")

    if effect then
        state.addItem(bindings.debris, effect, 0)
        state.lastRemovedEffect = state.clock()
    end

    local tornado = bindings.findChild(bindings.getBallContainer(), "Tornado")

    if tornado then
        local elapsed = state.clock() - state.lastRemovedEffect
        local duration = bindings.getAttribute(tornado, "TornadoTime") or 1

        if elapsed < (duration :: number) + 0.314159 then
            return true
        end
    end

    if bindings.findChild(ball, "ComboCounter") then
        return true
    end

    return not not bindings.findChild(root, "SingularityCape")
end

local fireOnly = {
    ["Raging Deflection"] = true,
    ["Calming Deflection"] = true,
    Rapture = true,
    Telekinesis = true,
    ["Flash Counter"] = true,
    Singularity = true,
    Fracture = true,
    ["Aerodynamic Slash"] = true,
}

local function activateAbility(state: State, bindings: Bindings, range: number, speed: number)
    if state.abilityGradient.Offset.Y ~= 0.5 then
        bindings.parry()
        return
    end

    local ability = state.settings.EquippedAbility

    if fireOnly[ability] then
        if state.settings["AutoAbilities_" .. ability] and 60 < range then
            state.fireAbility(bindings.abilitySignal)
            return
        end

        bindings.parry()
        return
    end

    if ability == "Swap" or ability == "Absolute Confidence" then
        if state.settings["AutoAbilities_" .. ability] and 55 < range then
            bindings.parry()
            state.fireAbility(bindings.abilitySignal)
            return
        end

        bindings.parry()
        return
    end

    if ability ~= "Pull" then
        bindings.parry()
        return
    end

    if not state.settings["AutoAbilities_" .. ability] or not (35 < range) then
        bindings.parry()
        return
    end

    bindings.parry()
    local delay = 0.35 - speed / 100 / 2

    -- This negative-delay condition is present in the captured original.
    if delay < 0 then
        state.wait(delay)
    end

    state.fireAbility(bindings.abilitySignal)
    bindings.parry()
end

local function attemptParry(state: State, bindings: Bindings, ball: Ball, root: Root, distance: number, range: number)
    state.visualizer.Color = state.green

    if state.clock() - (state.settings[state.warpKey] :: number) < 1.5 then
        return
    end

    if not (distance <= range) then
        return
    end

    if state.blockGradient.Offset.Y ~= 0.5 then
        return
    end

    if not (1.5 < state.clock() - (state.settings[state.debounceKey] :: number)) then
        return
    end

    local speed = ball.AssemblyLinearVelocity.Magnitude
    local rootPosition = root.Position
    local ballPosition = ball.Position
    local delta = rootPosition - ballPosition
    local now = state.clock()
    state.settings[state.debounceKey] = now
    state.settings[state.warpKey] = now
    local distanceSquared = state.dot(delta, delta)
    local delay = distanceSquared / (speed * speed) - range / speed

    if 0 < delay then
        state.wait(delay / 2)
    end

    activateAbility(state, bindings, range, speed)
end

local function runFrame(state: State, bindings: Bindings, settingName: string)
    local frameTime = state.nextFrame(state.signal) * 1.5

    if not state.settings.AutoParry then
        hideVisualizer(state)
        return
    end

    local ball = state.settings[settingName] :: Ball?

    if not ball then
        hideVisualizer(state)
        return
    end

    local active = bindings.isActive()
    local root = bindings.getRoot()

    if not active or not root then
        hideVisualizer(state)
        return
    end

    local position = root.Position
    local showRange = state.settings.ShowRangeVisualizer

    if showRange then
        state.visualizer.Position = position
    end

    if not showRange then
        state.visualizer.Position = state.hiddenPosition
    end

    local _rootSpeed = root.Velocity.Magnitude / 38
    local velocity = ball.AssemblyLinearVelocity
    local ballPosition = ball.Position
    local delta = position - ballPosition
    local distance = delta.Magnitude
    local latency = bindings.getPing(state.pingObject) + frameTime
    local range = latency / 10

    if range < 5 then
        range = 5
    end

    if 17 < range then
        range = 17
    end

    local speed = velocity.Magnitude + frameTime
    -- The original reads/calculates accuracy, then overwrites that register.
    readAccuracy(state)
    range = range + speed / 2.5 + frameTime

    if state.settings.PingBased then
        range += latency / 20
    end

    if state.settings.AntiCurve and curveIsRejected(state, delta, velocity, distance, speed, latency) then
        showClashStatus(state)
        return
    end

    if range < 13.5 then
        range = 13.5
    end

    if hasBlockingEffect(state, bindings, ball, root) then
        showClashStatus(state)
        return
    end

    if not state.settings.NoRangeLimit then
        local limit = state.settings.RangeLimiter * 2

        if limit < range then
            range = limit
        end
    end

    state.visualizer.Size = state.makeVector(range, range, range)

    if bindings.getAttribute(ball, "target") ~= state.localTarget then
        state.visualizer.Color = state.clock() - state.settings.OnClash <= 0.55 and state.red or state.blue
        return
    end

    attemptParry(state, bindings, ball, root, distance, range)
end

return function(bindings: Bindings)
    return function(settingName: string, shape: unknown)
        local state = createState(bindings, settingName, shape)

        while true do
            runFrame(state, bindings, settingName)
        end
    end
end
end)()

local createSearchFilter = (function()
-- Recovered from record 3185, factory 5382, variant 131, entry 21.
type Visible = { Visible: boolean }
type Label = { Text: string }
type Bindings = {
    getTab: () -> string?,
    getMatch: () -> ((string, string) -> unknown),
    sections: { [string]: { [Visible]: { unknown } } },
    getQuery: () -> string,
    getLower: () -> ((string) -> string),
}

local function filterControls(controls: { unknown }, match: (string, string) -> unknown, lower: (string) -> string, query: string): boolean
    local anyVisible = false

    for index = 1, #controls, 3 do
        local label = controls[index + 1]
        local matches

        if label ~= 0 then
            matches = match(lower((label :: Label).Text), query)
        end

        if not matches then
            label = controls[index + 2]

            if label ~= 0 then
                matches = match(lower((label :: Label).Text), query)
            end
        end

        local control = controls[index] :: Visible
        control.Visible = not not matches

        if matches then
            anyVisible = true
        end
    end

    return anyVisible
end

return function(bindings: Bindings)
    return function()
        local tabName = bindings.getTab()

        if not tabName then
            return
        end

        local match = bindings.getMatch()
        local sections = bindings.sections[tabName]
        local query = bindings.getQuery()

        if query == "" then
            for section, controls in sections do
                for index = 1, #controls, 3 do
                    local control = controls[index] :: Visible
                    control.Visible = true
                end

                section.Visible = true
            end

            return
        end

        local lowerLabel = bindings.getLower()
        local lowerQuery = bindings.getLower()
        query = lowerQuery(query)

        if tabName == "Roblox Emotes (R15)" then
            for section, controls in sections do
                local anyVisible = false

                for index = 1, #controls, 2 do
                    local matches = match(lowerLabel(controls[index + 1] :: string), query)
                    local control = controls[index] :: Visible
                    control.Visible = not not matches

                    if matches then
                        anyVisible = true
                    end
                end

                section.Visible = anyVisible
            end

            return
        end

        for section, controls in sections do
            section.Visible = filterControls(controls, match, lowerLabel, query)
        end
    end
end
end)()

local tabCallbacks = (function()
type Element = { Parent: unknown, Text: unknown, Position: unknown }
type Owner = { CanHover: unknown, NoTabAnimations: unknown, NoAnimWidgetInit: () -> (), ThisTab: unknown, CurrentContainer: unknown, CanNavigate: unknown }
type Completion = { Wait: (Completion) -> () }
type Navigation = {
    owner: Owner,
    play: (unknown) -> (),
    touchSound: unknown,
    container: Element,
    parent: unknown,
    name: unknown,
    heading: Element,
    mode: unknown,
    indicator: Element,
    title: Element,
    fromScale: (number, number) -> unknown,
    wait: (number) -> (),
    enterAnimation: unknown,
    selectTween: unknown,
    containerTween: unknown,
    overview: unknown,
    fps: unknown,
    ping: unknown,
    tabFrame: unknown,
    tabNavigate: unknown,
    tabIndicator: unknown,
    searchBar: unknown,
    whitelistBar: unknown,
    scrollIndicator: { Completed: Completion },
    leaveAnimation: unknown,
    leaveTween: unknown,
}

local function hover(owner: Owner, play: (unknown) -> (), animation: unknown, tween: unknown)
    return function()
        if not owner.CanHover then
            return
        end

        play(animation)
        play(tween)
    end
end

local function activate(navigation: Navigation)
    local owner, play = navigation.owner, navigation.play
    local container = navigation.container

    return function()
        play(navigation.touchSound)

        if not owner.CanHover then
            return
        end

        container.Parent = navigation.parent
        owner.CanHover = false
        owner.ThisTab = navigation.name
        navigation.heading.Text = navigation.name

        if navigation.mode ~= true then
            navigation.indicator.Parent = navigation.parent
            navigation.title.Text = ""
        end

        local noAnimations = owner.NoTabAnimations

        if noAnimations then
            container.Position = navigation.fromScale(0.5, 0.625)
            owner.NoAnimWidgetInit()
        end

        if not noAnimations then
            play(navigation.enterAnimation)
            play(navigation.selectTween)
            navigation.wait(0.25)
            play(navigation.containerTween)
            play(navigation.overview)
            play(navigation.fps)
            play(navigation.ping)
            play(navigation.tabFrame)
            play(navigation.tabNavigate)
            play(navigation.tabIndicator)
            play(navigation.searchBar)
            play(navigation.whitelistBar)
            play(navigation.scrollIndicator)
            local completed = navigation.scrollIndicator.Completed
            completed.Wait(completed)
        end

        play(navigation.leaveAnimation)
        play(navigation.leaveTween)
        owner.CurrentContainer = container
        owner.CanNavigate = true
    end
end

return { hover = hover, activate = activate }
end)()

