standaloneModules.createUiConsoleMessage = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local state = bindings.state

    return function(row: Values)
        if state.busy then return end

        local message = bindings.findChild(row, "msg", 1.5)
        local image = bindings.findChild(row, "image", 1.5)
        if not message or message.TextColor3 ~= bindings.warningColor then return end
