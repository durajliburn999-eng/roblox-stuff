standaloneModules.initializeUiConfig = ((function()
type Values = { [string]: unknown }
type Bindings = {
    owner: Values,
    path: string,
    gameName: string,
    signature: string,
    isfile: (string) -> unknown,
    readfile: (string) -> unknown,
    decode: (unknown) -> unknown,
    printDebug: (string, number) -> (),
}

return function(bindings: Bindings)
    local config: Values? = nil

    if bindings.isfile(bindings.path) then
        config = bindings.decode(bindings.readfile(bindings.path)) :: Values?
    end

    if not config or not config.Toggle or not config.Slider or not config.Colorpicker or not config.Dropdown
        or not config.TextBox or not config.Keybind or config.Game ~= bindings.gameName
        or config.configSign ~= bindings.signature or config.Note ~= "SEX :3" then
        bindings.printDebug("Failed to load the configuration file or does not exist, overriding with default settings!", 3)
        config = ({
            Toggle = {}, Slider = {}, Colorpicker = {}, Dropdown = {}, TextBox = {}, Keybind = {},
            Game = bindings.gameName, configSign = bindings.signature, Note = "SEX :3",
        } :: Values)
    end

    local owner = bindings.owner
    local selected = config :: Values
    owner.Dropdown_Settings = selected.Dropdown
    owner.Toggle_Settings = selected.Toggle
    owner.Slider_Settings = selected.Slider
    owner.Colorpicker_Settings = selected.Colorpicker
    owner.TextBox_Settings = selected.TextBox
    owner.Keybind_Settings = selected.Keybind
    owner.__configs = selected
end
end)() :: unknown)

