standaloneModules.bloxWorldWorkers = ((function()
type Values = { [string]: any }

local function autoTradeBone(bindings: Values)
    return function()
        local wait, idle = bindings.getWait(), bindings.getIdle()
        while true do
            while bindings.settings.AutoTradeBone do
                wait(1)
                bindings.invoke(bindings.remote, "Bones", "Buy", 1, 1)
            end
            idle()
        end
    end
end

local function autoBuyRandomFruit(bindings: Values)
    return function()
        local idle = bindings.getIdle()
        while true do
            while bindings.settings.AutoBuyRandomFruit do
                bindings.getWait()(1)
                bindings.invoke(bindings.remote, "Cousin", "Buy")
            end
            idle()
        end
    end
end

local function autoSeaPurchase(bindings: Values, key: string, command: string, argument: string)
    return function()
        local idle = bindings.getIdle()
        while true do
            while bindings.settings[key] do
                bindings.getWait()(1)
                bindings.invoke(bindings.remote, command, argument)
            end
            idle()
        end
    end
end

local function autoLegendarySword(bindings: Values)
    return function()
        local toString, idle = bindings.getString(), bindings.getIdle()
        while true do
            while bindings.settings.AutoBuyLegendarySword do
                bindings.getWait()(1)
                bindings.invoke(bindings.remote, "LegendarySwordDealer", toString(bindings.getRandom()(1, 3)))
            end
            idle()
        end
    end
end

local function autoCraft(bindings: Values, key: string, item: string)
    return function()
        local wait, idle = bindings.getWait(), bindings.getIdle()
        while true do
            while bindings.settings[key] do
                wait(0.5)
                bindings.invoke(bindings.remote, "CraftItem", "Craft", item)
            end
            idle()
        end
    end
end

return { autoTradeBone = autoTradeBone, autoBuyRandomFruit = autoBuyRandomFruit,
    autoSeaPurchase = autoSeaPurchase, autoLegendarySword = autoLegendarySword, autoCraft = autoCraft }
end)())

standaloneModules.populateBloxWorldBeforeRaid = ((function()
local purchases = standaloneModules.bloxWorldPurchasesData

type Values = { [string]: any }
type Purchase = { label: string, calls: { { unknown } } }
local purchaseList = (purchases :: unknown) :: { Purchase }
local chips = { "Flame", "Ice", "Quake", "Light", "Dark", "Spider", "Rumble", "Magma", "Buddha", "Sand", "Phoenix", "Dough" }

return function(tab: Values, bindings: Values, state: (number, string, unknown) -> unknown)
    local callbacks = bindings.callbacks
    local function section(title: string): Values
        return tab:AddSection(title, "BLOX FRUITS")
    end
    local function addPurchases(target: Values, first: number, last: number)
        for index = first, last do
            local label = purchaseList[index].label
            target:AddButton(label, callbacks[label])
        end
    end

    local bones = section("BONES")
    addPurchases(bones, 1, 1)
    bones:AddToggle("Auto Trade Bone", state(2, "AutoTradeBone", callbacks["Auto Trade Bone"]))
    if bindings.owner.__BFSecondSea then
        local legendary = section("LEGENDARY SWORD")
        legendary:AddButton("Buy Legendary Sword", callbacks["Buy Legendary Sword"])
        legendary:AddToggle("Auto Buy Legendary Sword", state(2, "AutoBuyLegendarySword", callbacks["Auto Buy Legendary Sword"]))
    end
    if bindings.owner.__BFThirdSea then
        local gear = section("GEAR")
        gear:AddButton("Buy Gear", callbacks["Buy Gear"])
        gear:AddToggle("Auto Buy Gear", state(2, "AutoBuyGear", callbacks["Auto Buy Gear"]))
    end
    if bindings.owner.__BFSecondSea or bindings.owner.__BFThirdSea then
        local haki = section("HAKI COLOR")
        haki:AddButton("Buy Haki Color", callbacks["Buy Haki Color"])
        haki:AddToggle("Auto Buy Haki Color", state(2, "AutoBuyHakiColor", callbacks["Auto Buy Haki Color"]))
    end
    local fruit = section("FRUIT")
    addPurchases(fruit, 2, 2)
    fruit:AddToggle("Auto Buy Random Fruit", state(2, "AutoBuyRandomFruit", callbacks["Auto Buy Random Fruit"]))
    local fighting = section("FIGHTING STYLE")
    addPurchases(fighting, 3, 13)
    local sword = section("SWORD")
    addPurchases(sword, 14, 23)
    local gun = section("GUN")
    addPurchases(sword, 24, 29)
    addPurchases(gun, 30, 31)
    local stats = section("STATS")
    addPurchases(stats, 32, 33)
    section("ACCESSORIES")
    addPurchases(sword, 34, 36)
    local abilities = section("ABILITIES")
    addPurchases(abilities, 37, 40)
    if bindings.owner.__BFSecondSea or bindings.owner.__BFThirdSea then
        local scrolls = section("SCROLL CRAFTS")
        for _, option in { { "Common", "AutoCraftCommon" }, { "Rare", "AutoCraftRare" },
            { "Legendary", "AutoCraftLegendary" }, { "Mythical", "AutoCraftMythical" } } do
            local label = "Craft " .. option[1] .. " Scroll"
            scrolls:AddButton(label, callbacks[label])
            scrolls:AddToggle("Auto " .. label, state(2, option[2], callbacks["Auto " .. label]))
        end
        local beast = section("BEAST HUNTER CRAFTS")
