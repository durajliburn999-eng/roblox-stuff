                local imageHeight = metadata[context.heightKey] :: number
                columns = metadata[context.columnsKey] :: number
                local rows = metadata[context.rowsKey] :: number
                frameDelay = 1 / (metadata[context.rateKey] :: number)
                lastFrame = (metadata[context.countKey] :: number) - 1

