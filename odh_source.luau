standaloneModules.createBindableControls = ((function()
type Callback = (unknown) -> ()
type Button = { [number]: unknown }
type Section = {
    AddSection: (Section, unknown) -> Section,
    AddToggle: (Section, string, Callback) -> unknown,
    AddButton: (Section, string, unknown) -> (),
    AddSlider: (Section, string, number, number, number, Callback) -> (),
    AddDropdown: (Section, string, { unknown }, Callback) -> (),
    AddKeybind: (Section, string, unknown, unknown) -> (),
}
type Bindings = {
    createButton: (string, string, unknown, unknown, unknown) -> Button,
    removeButton: (string) -> (),
    shapes: { unknown },
    activeColor: unknown,
    inactiveColor: unknown,
    dispatch: (unknown, unknown) -> (),
    settings: { [string]: unknown },
    play: (unknown) -> (),
    sectionTitle: (string) -> unknown,
    wait: (number?) -> (),
}

return function(bindings: Bindings)
    local createButton = bindings.createButton
    local removeButton = bindings.removeButton
    local shapes = bindings.shapes
    local activeColor = bindings.activeColor
    local inactiveColor = bindings.inactiveColor
    local settings = bindings.settings
    local play = bindings.play
    local sectionTitle = bindings.sectionTitle

    return function(kind: number, originalSection: Section, title: string, bindableName: string, keybind: unknown, settingKey: string, callback: unknown): Section
        local dispatch = bindings.dispatch
        local selected = shapes[1]
        local button: Button? = nil
        local enabled: unknown = nil
        local control: unknown = nil
        local section = originalSection

        if kind == 1 or kind == 7 then
            section = originalSection:AddSection(sectionTitle(title))
        end

        local function updateButton(value: unknown)
            enabled = value

            if kind == 1 or kind == 5 then
                settings[settingKey] = value

                if value then
                    dispatch(callback, value)
                end
            else
                dispatch(callback, value)
            end

            local current = button

            if not current or not current[8] then
                return
            end

            local color = if value then activeColor else inactiveColor
            play(current[5])
            bindings.wait(0.5)
            local surface = current[7] :: { Color: unknown }
            surface.Color = color
            play(current[6])
        end

        if kind == 1 or kind == 5 or kind == 7 or kind == 3 then
            control = section:AddToggle(title, updateButton)
        else
            if kind ~= 6 then
                section:AddButton(title, callback)
            end
        end

        local action = control or callback
        section:AddToggle("Enable " .. bindableName .. " Bindable Button", function(value: unknown)
            if value then
                local color = if enabled then activeColor else inactiveColor
                button = createButton(title, bindableName, color, selected, action)
                return
            end

            button = nil
            removeButton(title)
        end)
        bindings.wait()

        local function updateSize(index: number): Callback
            return function(value: unknown)
                local current = button

                if not current then
                    return
                end

                (current[4] :: (number, unknown) -> ())(index, value)
            end
        end
        section:AddSlider(title .. " Bind Text Size", 8, 25, 10, updateSize(0))
        section:AddSlider(title .. " Bind Size X", 38, 200, 38, updateSize(1))
        section:AddSlider(title .. " Bind Size Y", 38, 200, 38, updateSize(2))
        section:AddDropdown(title .. " Bindable Shape Type", shapes, function(value: unknown)
            local current = button
            selected = value

            if current then
                (current[4] :: (number, unknown) -> ())(3, value)
            end
        end)

        if keybind then
            section:AddKeybind(title, keybind, action)
        end

        return section
    end
end
end)())

local uiElements = (function()
type Node = { [string]: unknown }
type Owner = {
    Clone: (unknown) -> Node,
    SectionContainer: unknown,
    SearchSectionShared: { unknown },
    ParagraphUIElements: { unknown },
    ButtonUIElements: { unknown },
    setmetatable: ({ unknown }, unknown) -> unknown,
    label_api: unknown,
    play: (unknown) -> (),
    TouchSFX: unknown,
}

local function label(template: unknown)
    return function(owner: Owner, text: unknown, returnHandle: unknown): unknown
        local item = owner.Clone(template)
        item.Text = text
        item.Parent = owner.SectionContainer
        local shared = owner.SearchSectionShared
        local index = #shared + 1
        shared[index] = item
        shared[index + 1] = item
        shared[index + 2] = 0

        if returnHandle then
            return owner.setmetatable({ item }, owner.label_api)
        end

        return nil
    end
end

local function paragraph(template: unknown)
    return function(owner: Owner, title: unknown, description: unknown, returnHandle: unknown): unknown
        local item = owner.Clone(template)
        local titleLabel = item.Title :: Node
        local descriptionLabel = item.Description :: Node
        titleLabel.Text = title
        descriptionLabel.Text = description
        item.Parent = owner.SectionContainer
        local elements = owner.ParagraphUIElements
        elements[#elements + 1] = item
        local shared = owner.SearchSectionShared
        local index = #shared + 1
        shared[index] = item
        shared[index + 1] = titleLabel
        shared[index + 2] = descriptionLabel

        if returnHandle then
            return owner.setmetatable({ descriptionLabel }, owner.label_api)
        end

        return nil
    end
end

local function button(template: unknown, connect: { value: (unknown, () -> ()) -> () })
    return function(owner: Owner, text: unknown, callback: () -> ())
        local play = owner.play
        local sound = owner.TouchSFX
        local item = owner.Clone(template)
        item.Text = text
        item.Parent = owner.SectionContainer
        local elements = owner.ButtonUIElements
        elements[#elements + 1] = item
        local shared = owner.SearchSectionShared
        local index = #shared + 1
        shared[index] = item
        shared[index + 1] = item
        shared[index + 2] = 0
        connect.value(item.Activated, function()
            play(sound)
            callback()
        end)
    end
end

local function setLabelValue(handle: { Node }, value: unknown)
    handle[1].Text = value
end

return { label = label, paragraph = paragraph, button = button, setLabelValue = setLabelValue }
end)()

