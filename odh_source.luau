        active = active, partner = partner, other = other, last = last, timestamp = timestamp,
        getString = function() return bindings.stringify end, getClock = function() return bindings.clock end,
        getPlayer = function() return bindings.player end, decline = decline, fire = bindings.fire,
        destroy = bindings.destroy, report = bindings.report })

    local monitor = bindings.monitor
    if monitor then
        local worker = makeMonitor({ startedAt = timestamp, checking = last, enabled = active, ready = partner,
            findChild = (bindings.find :: unknown) :: (unknown, string) -> Values?, playerGui = monitor.playerGui,
            stringify = bindings.stringify })
