return function(bindings: Bindings)
    return function(property: unknown, target: Node, condition: Node?, key: unknown)
        local wait = bindings.getWait()

        if condition and key then
            while condition[key] do
                target[property] = (target[property] :: number) + 2
                wait()
            end

            return
        end

        repeat
            target[property] = (target[property] :: number) + 2
            wait()
        until false
    end
end
end)() :: unknown)

