    getCamera: () -> unknown,
    getProject: () -> unknown,
    atan2: unknown,
    getScale: () -> unknown,
    getVector: () -> unknown,
    getFrame: () -> unknown,
    gameName: unknown,
    getFormat: () -> ((string, ...unknown) -> string),
    getWait: () -> unknown,
    basicRig: unknown,
    enemyColor: unknown,
    neutralColor: unknown,
    contains: ({ unknown }, unknown) -> unknown,
    friendlyColor: unknown,
    teamColors: { [unknown]: unknown },
}
type Context = { [string]: unknown }

local function murderMysteryRole(bindings: Bindings, settings: Settings, playerName: string): unknown

    if not settings.is_alive(playerName) then
        return "Dead"
    end

    local mode = settings.MapMode

    if mode == "Assassin" then
        return "Assassin"
    end

    if mode == "Infection" or mode == "FreezeTag" then
        local data = settings.roles_data[playerName]

        if data then
            return data.Role
        end

        return "Dead"
    end

    local roles = settings.roles
    local murderers = roles.Murderers
    local contains = bindings.contains

    if contains(murderers, playerName) then
        return "Murderer"
    end

    local sheriffs = roles.Sheriffs
    contains = bindings.contains

    if not contains(sheriffs, playerName) then
        return "Innocent"
    end

    if roles.Hero then
        return "Hero"
    end

    return "Sheriff"
end

local function universalColor(bindings: Bindings, findChild: (unknown, string) -> unknown, player: Player, character: unknown): unknown
    local backpack = player.Backpack

    for _, name in { "Knife", "Knives" } do
        if findChild(backpack, name) then
            return bindings.enemyColor
        end

        if findChild(character, name) then
            return bindings.enemyColor
        end
    end

    for _, name in { "Gun", "Revolver" } do
        if findChild(backpack, name) then
            return bindings.friendlyColor
        end

        if findChild(character, name) then
            return bindings.friendlyColor
        end
    end

    return bindings.neutralColor
end

local function chooseRole(bindings: Bindings, settings: Settings, findChild: (unknown, string) -> unknown, player: Player, character: unknown, playerName: string, isUniversal: unknown, gameName: unknown): (unknown, unknown)
    if gameName == "Flee The Facility" then
        if findChild(character, "Hammer") then
            return "Beast", bindings.enemyColor
        end

        if findChild(player.Backpack, "Hammer") then
            return "Beast", bindings.enemyColor
        end

        return "Survivor", bindings.neutralColor
    end

    if gameName == "Murder Mystery 2" or gameName == "Murder Mystery Modded" then
        local role = murderMysteryRole(bindings, settings, playerName)

        if role then
            return role, settings.role_colors[role]
        end

        return role, nil
    end

    if isUniversal then
        return nil, universalColor(bindings, findChild, player, character)
    end

    local team = player.Team

    if not team then
        return nil, bindings.neutralColor
    end

    local role = team.Name
    local color = bindings.teamColors[team]

    if not color then
        color = bindings.neutralColor
    end

    return role, color
end

local features = {
    { "cham", "Cham" }, { "label", "ESP" }, { "outline", "Outline" },
    { "highlight", "Highlight" }, { "tracer", "Tracer" }, { "flatBox", "ESP Box" },
    { "cubeBox", "ESP Cube" }, { "fire", "ESP Fire" }, { "avatar", "ESP Avatar" },
}

return function(bindings: Bindings)
    return function(player: Player, character: unknown): ...Context
        local findChild = bindings.findChild
        local root = findChild(character, "HumanoidRootPart")

        if not root then
            return
        end

        local humanoid = findChild(character, "Humanoid") :: { RigType: unknown }?

        if not humanoid then
            return
        end

        local context: Context = { findChild = findChild, player = player, character = character, root = root }
        local settings = bindings.settings
        local isUniversal = bindings.isUniversal
        context.settings = settings
        context.isUniversal = isUniversal
        context.makeInstance = bindings.getInstance()
        context.metadata = bindings.metadata
        context.state = bindings.state
        context.camera = bindings.getCamera()
        context.project = bindings.getProject()
        context.atan2 = bindings.atan2
        context.makeScale = bindings.getScale()
        context.makeVector = bindings.getVector()
        context.makeFrame = bindings.getFrame()
        local gameName = bindings.gameName
        local formatText = bindings.getFormat()
        context.formatText = formatText
        context.wait = bindings.getWait()
        local playerName = player.Name
        context.playerName = playerName
        context.rigKey = playerName .. "_rigType"
        local rigType = humanoid.RigType
        local basicRig = bindings.basicRig
        local rigIndex = 1

        if rigType == basicRig then
            rigIndex = 0
        end

        context.rigIndex = rigIndex
        local basicParts, otherParts = bindings.basicParts, bindings.otherParts
        local parts = otherParts

        if rigIndex == 0 then
            parts = basicParts
        end

        context.parts = parts
        for _, feature in features do
            local value = settings[feature[2] .. "Everyone"]

            if not value then
                local key = formatText(feature[2] .. "Player%*Only", playerName)
                value = settings[key]
            end

            context[feature[1]] = value
        end

        local role, color = chooseRole(bindings, settings, findChild, player, character, playerName, isUniversal, gameName)
        context.role, context.color = role, color

        if isUniversal then
            return context
        end

        for _, feature in features do
            if not context[feature[1]] then
                local key = formatText(feature[2] .. "%*Only", role)
                context[feature[1]] = settings[key]
            end
        end

        return context
    end
end
