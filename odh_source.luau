    local function prepare(): ((number) -> unknown)?
        local lobby = find(bindings.workspace, "Lobby")
        if not lobby then return nil end
        local pads = find(lobby, "VotePads")
        if not pads then return nil end
        local getSignal = lobby.GetPropertyChangedSignal :: (unknown, string) -> unknown
        local getPivot = lobby.GetPivot
