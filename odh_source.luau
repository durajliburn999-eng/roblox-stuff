standaloneModules.createHitboxExpander = ((function()
type Root = { Transparency: unknown, Material: unknown, Color: unknown, Size: unknown, CanCollide: unknown }
type Player = { Character: unknown }
type Settings = {
    HitboxExpander: unknown,
    HitboxExpanderSize: unknown,
    HitboxExpanderMaterial: unknown,
    HitboxExpanderColor: unknown,
    HitboxExpanderTransparency: unknown,
}
type Bindings = {
    originalColor: unknown,
    originalSize: unknown,
    settings: Settings,
    wait: (number) -> (),
    findChild: (unknown, string) -> Root?,
    players: { Player? },
    onStopped: () -> (),
}

return function(bindings: Bindings)
    local originalColor = bindings.originalColor
    local originalSize = bindings.originalSize
    local settings = bindings.settings
    local findChild = bindings.findChild

    return function()
        local wait = bindings.wait
        local players = bindings.players
        local onStopped = bindings.onStopped

        while true do
            while settings.HitboxExpander do
                local size = settings.HitboxExpanderSize
                local material = settings.HitboxExpanderMaterial
                local color = settings.HitboxExpanderColor
                local transparency = settings.HitboxExpanderTransparency

                for index = 2, #players do
                    local player = players[index]

                    if not player or not player.Character then
                        continue
                    end

                    local root = findChild(player.Character, "HumanoidRootPart")

                    if not root then
                        continue
                    end

                    root.Transparency = transparency
                    root.Material = material
                    root.Color = color
                    root.Size = size
                    root.CanCollide = false
                end

                wait(0.25)
            end

            for index = 2, #players do
                local player = players[index]

                if not player or not player.Character then
                    continue
                end

                local root = findChild(player.Character, "HumanoidRootPart")

                if not root then
                    continue
                end

                root.Transparency = 1
                root.Material = "Plastic"
                root.Color = originalColor
                root.Size = originalSize
                root.CanCollide = true
            end

            onStopped()
        end
    end
end
end)())

local createStateCallback = (function()
type Bindings = {
    settings: { [string]: unknown },
    dispatch: (unknown) -> (),
    transform: (unknown) -> unknown,
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local dispatch = bindings.dispatch
    local transform = bindings.transform

    return function(kind: number, key: string, input: unknown): ((unknown) -> ())?
        if kind > 2 then
            return nil
        end

        if kind == 1 then
            return function(value: unknown)
                settings[key] = value
            end
        end

        if kind == 2 then
            local transformed = transform(input)

            return function(value: unknown)
                settings[key] = value

                if value then
                    dispatch(transformed)
                end
            end
        end

        return nil
    end
end
end)()

standaloneModules.createFirePrompt = ((function()
type Prompt = {
    HoldDuration: number,
    MaxActivationDistance: number,
    Enabled: boolean,
    RequiresLineOfSight: boolean,
    InputHoldEnd: (Prompt) -> (),
}

return function(wait: () -> ())
    return function(prompt: Prompt)
        local duration = prompt.HoldDuration
        local distance = prompt.MaxActivationDistance
        local enabled = prompt.Enabled
        local lineOfSight = prompt.RequiresLineOfSight

        prompt.MaxActivationDistance = math.huge
        prompt.HoldDuration = 0
        prompt.Enabled = true
        prompt.RequiresLineOfSight = false
        wait()
        prompt:InputHoldEnd()
        prompt.HoldDuration = duration
        prompt.MaxActivationDistance = distance
        prompt.Enabled = enabled
        prompt.RequiresLineOfSight = lineOfSight
    end
end
end)())

