    activate: () -> (),
    connect: Cell,
    signal: unknown,
    connection: Cell,
    isReady: Cell,
    disconnect: Cell,
    otherConnection: Cell,
    target: Cell,
}

return function(bindings: Bindings)
    local activate = bindings.activate
    local connect = bindings.connect
    local signal = bindings.signal
    local connection = bindings.connection
    local isReady = bindings.isReady
    local disconnect = bindings.disconnect
    local otherConnection = bindings.otherConnection
    local target = bindings.target

    return function(enabled: unknown)
