type Tab = { AddSection: (Tab, string, string?) -> Section }
type Bindable = (number, unknown, string, string, unknown, unknown, unknown) -> Section
type Bindings = {
    settings: unknown,
    stateDispatch: unknown,
    stateTransform: unknown,
    bindable: Bindable,
    callbacks: { [string]: unknown },
    initializeFloat: (() -> ())?,
    initializeLay: (() -> ())?,
    initializeSwim: (() -> ())?,
    initializeAutoClick: (() -> ())?,
    initializeXray: (() -> ())?,
    initializeAppearance: (() -> ())?,
    initializeRolesNotify: (() -> ())?,
    initializeInvisible: (() -> ())?,
    initializeAntiFling: (() -> ())?,
    initializeAntiVoid: (() -> ())?,
    initializeInfiniteJump: (() -> ())?,
    initializeRoundTimer: (() -> ())?,
    initializeCurrency: (() -> ())?,
    initializePrestige: (() -> ())?,
    initializeSecondLifeWorker: (() -> ())?,
    initializeSecondLife: (() -> ())?,
    initializeRadio: (() -> ())?,
    initializeFly: (() -> ())?,
    initializeDeploy: (() -> ())?,
    initializeBladeServer: (() -> ())?,
    initializeBlox: ((Tab, (number, string, unknown) -> unknown) -> ())?,
    gameSpecific: boolean?,
    gameName: unknown,
}
local makeState = (createStateCallback :: unknown) :: (unknown) -> (number, string, unknown) -> unknown

return function(tab: Tab, bindings: Bindings)
    local callbacks = bindings.callbacks
    local bindable = bindings.bindable
    local state = makeState({ settings = bindings.settings, dispatch = bindings.stateDispatch, transform = bindings.stateTransform })

    if bindings.initializeSecondLifeWorker then bindings.initializeSecondLifeWorker() end
    local selfMods = tab:AddSection("SELF MODS")
    selfMods:AddToggle("Enable WalkSpeed", state(2, "EnableWalkSpeed", callbacks["Enable WalkSpeed"]))
    selfMods:AddSlider("WalkSpeed", 1, 255, 16, state(1, "WalkSpeed", nil))
    selfMods:AddToggle("Enable JumpPower", state(2, "EnableJumpPower", callbacks["Enable JumpPower"]))
    selfMods:AddSlider("JumpPower", 1, 255, 50, state(1, "JumpPower", nil))
    if bindings.initializeInfiniteJump then bindings.initializeInfiniteJump() end
    selfMods:AddToggle("Infinite Jump", callbacks["Infinite Jump"])
    if bindings.initializeSecondLife then bindings.initializeSecondLife() end
    selfMods:AddToggle("Second Life", callbacks["Second Life"])

    if bindings.gameSpecific ~= false then
        local server = tab:AddSection("SERVER", "MM2 / MMV")
        if bindings.initializeRoundTimer then bindings.initializeRoundTimer() end
        server:AddToggle("Show Round Timer", state(2, "ShowRoundTimer", callbacks["Show Round Timer"]))
        server:AddToggle("Instant Role Notify", state(1, "InstantRoleNotify", nil))
        server:AddToggle("^^ Show Murderer Chance", state(1, "ShowMurdererChance", nil))
        server:AddToggle("Auto Notify Roles", state(1, "AutoNotifyRoles", nil))
        server:AddToggle("Assassin Auto Notify Objective", state(1, "AssassinAutoNotifyObject", nil))
        if bindings.initializeRolesNotify then bindings.initializeRolesNotify() end
        server:AddButton("Notify Roles", callbacks["Notify Roles"])
        server:AddToggle("Auto Notify Murderer's Perk", state(1, "AutoNotifyMurdererPerk", nil))
        server:AddButton("Notify Murderer's Perk", callbacks["Notify Murderer's Perk"])
    end
    if bindings.gameName == "[FPS] Flick" then
        local server = tab:AddSection("SERVER", "[FPS] FLICK")
        if bindings.initializeDeploy then bindings.initializeDeploy() end
        server:AddButton("Deploy Character", callbacks["Deploy Character"])
        server:AddToggle("Auto Deploy Character", state(1, "AutoDeployCharacter", nil))
    end
    if bindings.gameName == "Blade Ball" then
        local server = tab:AddSection("SERVER", "BLADE BALL")
        server:AddToggle("Show Range Visualizer", state(1, "ShowRangeVisualizer", nil))
        if bindings.initializeBladeServer then bindings.initializeBladeServer() end
        server:AddToggle("Improve FPS", callbacks["Improve FPS"])
    end

    if bindings.gameName == "Blox Fruits" and bindings.initializeBlox then bindings.initializeBlox(tab, state) end

    if bindings.initializeSwim then bindings.initializeSwim() end
    bindable(7, tab, "Swim", "Swim", nil, nil, callbacks.Swim)
    bindable(7, tab, "Camera Noclip", "Cam Noclip", nil, nil, callbacks["Camera Noclip"])
    if bindings.initializeFloat then bindings.initializeFloat() end
    local float = bindable(7, tab, "Float", "Float", "L", nil, callbacks.Float)
    float:AddLabel("Configurations:")
    float:AddSlider("Float Offset (%)", 0, 500, 310, callbacks["Float Offset (%)"])

    local sit = tab:AddSection("SIT")
    bindable(2, sit, "Sit", "Sit", nil, nil, callbacks.Sit)
    if bindings.initializeLay then bindings.initializeLay() end
    local lay = tab:AddSection("LAY")
    bindable(2, lay, "Lay", "Lay", nil, nil, callbacks.Lay)
    bindable(1, tab, "Freeze Character", "Freeze", nil, "FreezeCharacter", callbacks["Freeze Character"])
    bindable(1, tab, "Auto Jump", "Auto Jump", nil, "AutoJump", callbacks["Auto Jump"])
    if bindings.gameName ~= "[FPS] Flick" and bindings.gameName ~= "Blade Ball" then
        if bindings.initializeAutoClick then bindings.initializeAutoClick() end
        bindable(1, tab, "Auto Click", "Auto Click", nil, "AutoClick", callbacks["Auto Click"])
    end
    bindable(1, tab, "Noclip", "Noclip", "J", "Noclip", callbacks.Noclip)
    if bindings.initializeInvisible then bindings.initializeInvisible() end
    bindable(7, tab, "Invisible", "Invisible", "C", nil, callbacks.Invisible)

    if bindings.initializeXray then bindings.initializeXray() end
    local xray = tab:AddSection("XRAY")
    bindable(3, xray, "Enable X-Ray", "X-Ray", nil, nil, callbacks["Enable X-Ray"])
    xray:AddSlider("X-Ray Transparency", 1, 100, 75, callbacks["X-Ray Transparency"])

    local tools = tab:AddSection("TOOLS")
    tools:AddToggle("Anti AFK", state(1, "AntiAFK", nil))
    if bindings.initializeAntiFling then bindings.initializeAntiFling() end
    tools:AddToggle("Anti Fling", state(2, "AntiFling", callbacks["Anti Fling"]))
    if bindings.initializeAntiVoid then bindings.initializeAntiVoid() end
    tools:AddToggle("Anti Void", state(2, "AntiVoid", callbacks["Anti Void"]))

    local camera = tab:AddSection("CAMERA")
    camera:AddSlider("Min Distance Zoom", 0, 1000, 0.5, callbacks["Min Distance Zoom"])
    camera:AddSlider("Max Distance Zoom", 0, 1000, 128, callbacks["Max Distance Zoom"])
    camera:AddToggle("Loop To First Person Camera", state(2, "LoopToFirstPersonCamera", callbacks["Loop To First Person Camera"]))
    camera:AddButton("To First Person Camera", callbacks["To First Person Camera"])
    camera:AddButton("To Third Person Camera", callbacks["To Third Person Camera"])

    if bindings.initializeFly then bindings.initializeFly() end
    local fly = bindable(1, tab, "Fly", "Fly", "F", "Fly", callbacks.Fly)
    fly:AddLabel("Configurations:")
    fly:AddSlider("Fly Speed", 1, 50, 15, state(1, "FlySpeed", nil))
    local cframeFly = bindable(1, tab, "CFrame Fly", "CFly", nil, "CFrameFly", callbacks["CFrame Fly"])
    cframeFly:AddLabel("Configurations:")
    cframeFly:AddSlider("CFrame Fly Speed", 1, 75, 15, state(1, "CFrameFlySpeed", nil))

    if bindings.gameSpecific ~= false then
        if bindings.initializeRadio then bindings.initializeRadio() end
        local radio = tab:AddSection("RADIO", "MM2 / MMV")
        radio:AddTextBox("Song ID to Play", state(1, "Radio_SongIDtoPlay", nil))
        radio:AddButton("Play Song", callbacks["Play Song"])
        radio:AddToggle("Auto Play Song", state(1, "Radio_AutoPlaySong", nil))

        local other = tab:AddSection("OTHER", "MM2 / MMV")
        if bindings.initializeCurrency then bindings.initializeCurrency() end
        other:AddPlayerDropdown("Check Player Coins", callbacks["Check Player Coins"])
        other:AddPlayerDropdown("Check Player Gems", callbacks["Check Player Gems"])

        if bindings.initializePrestige then bindings.initializePrestige() end
        local prestige = tab:AddSection("PRESTIGE", "MM2 / MMV")
        prestige:AddButton("Prestige", callbacks.Prestige)
        prestige:AddToggle("Auto Prestige", state(2, "AutoPrestige", callbacks["Auto Prestige"]))
    end

    if bindings.initializeAppearance then bindings.initializeAppearance() end
    local fun = tab:AddSection("FUN CLIENT")
    fun:AddButton("Korblox (R15)", callbacks["Korblox (R15)"])
    fun:AddToggle("Permanent Korblox (R15)", callbacks["Permanent Korblox (R15)"])
    fun:AddButton("Headless", callbacks.Headless)
    fun:AddToggle("Permanent Headless", callbacks["Permanent Headless"])
end
end)()

local populateMainFeature = (function()

type Values = { [string]: unknown }
type Bindings = {
    ui: Values,
    makeFrame: unknown,
    floatOffset: unknown,
    humanoid: unknown,
    root: unknown,
    player: unknown,
    effects: Values,
}
local populateUi = (populateMainUi :: unknown) :: (unknown, Values) -> ()
local floatOffset = ((standaloneModules.movementActions :: { [string]: unknown }).floatOffset :: unknown) :: (unknown, unknown) -> unknown
local sit = ((standaloneModules.movementActions :: { [string]: unknown }).sit :: unknown) :: (unknown) -> unknown
local lay = ((standaloneModules.movementActions :: { [string]: unknown }).lay :: unknown) :: (unknown, unknown, unknown) -> unknown
local makeCamera = (standaloneModules.createCameraActions :: unknown) :: (unknown) -> { [string]: unknown }
local makeWalkSpeed = (createWalkSpeed :: unknown) :: (Values) -> unknown
local makeJumpPower = (createJumpPower :: unknown) :: (Values) -> unknown
local makeNoclip = (createNoclip :: unknown) :: (Values) -> unknown
local makeFlight = (createFlight :: unknown) :: (Values) -> unknown
local makeControlledFlight = (createControlledFlight :: unknown) :: (Values) -> unknown
local makeFlyStart = (standaloneModules.createFlyStart :: unknown) :: (Values) -> unknown
local makeMainLoops = (standaloneModules.createMainLoops :: unknown) :: (Values) -> { [string]: unknown }
local makeSubscription = (standaloneModules.createToggleSubscription :: unknown) :: (Values) -> unknown
local makeSecondLife = (standaloneModules.createSecondLife :: unknown) :: (Values) -> unknown
local makeActions = (standaloneModules.createMainActions :: unknown) :: (Values) -> { [string]: unknown }
local makeTransparency = ((standaloneModules.featureValues :: { [string]: unknown }).transparency :: unknown) :: (unknown) -> unknown
local makeSong = ((standaloneModules.featureValues :: { [string]: unknown }).playSong :: unknown) :: (unknown, unknown, unknown) -> unknown
local makeRolesNotify = (standaloneModules.createRolesNotifier :: unknown) :: (Values) -> unknown
local makeCurrencyNotify = (standaloneModules.createCurrencyNotifier :: unknown) :: (Values) -> unknown
local makeServerLoops = (standaloneModules.createMainServerLoops :: unknown) :: (Values) -> { [string]: unknown }
local makeAntiVoid = (standaloneModules.createMainAntiVoid :: unknown) :: (Values) -> unknown
local makeAntiFling = (standaloneModules.createMainAntiFling :: unknown) :: (Values) -> unknown
local makeAppearance = (standaloneModules.createMainAppearance :: unknown) :: (Values) -> { [string]: unknown }
local makePhysics = (standaloneModules.createMainPhysics :: unknown) :: (Values) -> { [string]: unknown }
local makeFloatStep = (createMainFloatStep :: unknown) :: (unknown, unknown, unknown) -> unknown
local makeInvisible = (standaloneModules.createMainInvisible :: unknown) :: (Values) -> unknown
local makePerkNotify = (standaloneModules.createMainPerkNotify :: unknown) :: (Values) -> unknown

return function(tab: unknown, bindings: Bindings)
    local ui = table.clone(bindings.ui)
    local callbacks = table.clone(ui.callbacks :: Values)
    local camera = makeCamera(bindings.player)
    local effects = bindings.effects
    local function configured(value: unknown): Values
        local result = table.clone(value :: Values)
        result.settings = ui.settings
        return result
    end

    local rolesNotify: Values = if effects.makeRolesNotify then {} else table.clone(effects.rolesNotify :: Values)
    rolesNotify.state = ui.settings
    callbacks["Notify Roles"] = makeRolesNotify(rolesNotify)
    callbacks["Notify Murderer's Perk"] = makePerkNotify({ settings = ui.settings, getNotify = function()
        local dependencies = if effects.makeRolesNotify then effects.makeRolesNotify() else rolesNotify
        return dependencies.notify.value
    end })
    if not effects.makeCurrency then
        callbacks["Check Player Coins"] = makeCurrencyNotify(effects.coinNotify :: Values)
        callbacks["Check Player Gems"] = makeCurrencyNotify(effects.gemNotify :: Values)
    end

    local serverBindings = configured(effects.serverLoops)
    local serverLoops = makeServerLoops(serverBindings)
    callbacks["Show Round Timer"] = serverLoops.timer
    callbacks["Auto Prestige"] = serverLoops.prestige
    callbacks.Prestige = serverLoops.manualPrestige
    callbacks["Loop To First Person Camera"] = serverLoops.firstPerson

    local physicsBindings = table.clone(effects.physics :: Values)
    local floatBindings = table.clone(physicsBindings.float :: Values)
    floatBindings.callback = makeFloatStep(bindings.root, floatBindings.part, bindings.floatOffset)
    physicsBindings.float = floatBindings
    local physics = makePhysics(physicsBindings)
    callbacks.Invisible = makeInvisible(effects.invisible :: Values)
    callbacks.Float = physics.float
    callbacks.Swim = physics.swim

    local appearance = makeAppearance(effects.appearance :: Values)
    callbacks["Korblox (R15)"] = appearance.korblox
    callbacks["Permanent Korblox (R15)"] = appearance.permanentKorblox
    callbacks.Headless = appearance.headless
    callbacks["Permanent Headless"] = appearance.permanentHeadless

    local actionBindings = table.clone(effects.actions :: Values)
    local actions = makeActions(actionBindings)
    local loopBindings = configured(effects.loops)
    local loops = makeMainLoops(loopBindings)
    callbacks["Camera Noclip"] = actions.cameraNoclip
    callbacks["Enable X-Ray"] = actions.xray
    callbacks["X-Ray Transparency"] = makeTransparency(actionBindings.xrayTransparency)
    if not effects.makeRadio then
        local radio = effects.radio :: Values
        callbacks["Play Song"] = makeSong(radio.fire, radio.remote, ui.settings)
    end
    callbacks["Anti Fling"] = makeAntiFling(configured(effects.antiFling))
    callbacks["Anti Void"] = makeAntiVoid(configured(effects.antiVoid))
    callbacks["Auto Jump"] = loops.autoJump
    callbacks["Auto Click"] = loops.autoClick
    callbacks["Freeze Character"] = loops.freeze
    if not effects.makeFly then
        local flyStart = table.clone(effects.flyStart :: Values)
        flyStart.worker = makeControlledFlight(configured(effects.flyControl))
        callbacks.Fly = makeFlyStart(flyStart)
    end
    callbacks["Infinite Jump"] = makeSubscription(effects.infiniteJump :: Values)
    if not effects.makeSecondLife then callbacks["Second Life"] = makeSecondLife(effects.secondLife :: Values) end
    callbacks["Enable WalkSpeed"] = makeWalkSpeed(configured(effects.walkSpeed))
    callbacks["Enable JumpPower"] = makeJumpPower(configured(effects.jumpPower))
    callbacks.Noclip = makeNoclip(configured(effects.noclip))
    callbacks["CFrame Fly"] = makeFlight(configured(effects.flight))

    callbacks["Float Offset (%)"] = floatOffset(bindings.makeFrame, bindings.floatOffset)
    callbacks.Sit = sit(bindings.humanoid)
    callbacks["Min Distance Zoom"] = camera.minZoom
    callbacks["Max Distance Zoom"] = camera.maxZoom
    callbacks["To First Person Camera"] = camera.firstPerson
    callbacks["To Third Person Camera"] = camera.thirdPerson
    ui.initializeFloat = function()
        local makeFrame = (bindings.makeFrame :: { value: (number, number, number) -> unknown }).value
        local offset = bindings.floatOffset :: { value: unknown }
        offset.value = makeFrame(0, -3.1, 0)
    end
    if effects.makeSwim then
        ui.initializeSwim = function()
            local makeSwim = effects.makeSwim :: () -> unknown
            physicsBindings.swim = makeSwim()
            callbacks.Swim = makePhysics(physicsBindings).swim
        end
    end
    if effects.makeAutoClick then
        ui.initializeAutoClick = function()
            local makeAutoClick = effects.makeAutoClick :: () -> Values
            for key, value in makeAutoClick() do loopBindings[key] = value end
            callbacks["Auto Click"] = makeMainLoops(loopBindings).autoClick
        end
    end
    if effects.makeXray then
        ui.initializeXray = function()
            local makeXray = effects.makeXray :: () -> Values
            for key, value in makeXray() do actionBindings[key] = value end
            callbacks["Enable X-Ray"] = makeActions(actionBindings).xray
            callbacks["X-Ray Transparency"] = makeTransparency(actionBindings.xrayTransparency)
        end
    end
    if effects.makeFly then
        ui.initializeFly = function()
            local makeBindings = effects.makeFly :: () -> Values
            local current = makeBindings()
            local flyStart = current.start :: Values
            flyStart.worker = makeControlledFlight(configured(current.control))
            callbacks.Fly = makeFlyStart(flyStart)
        end
    end
    if effects.makeRadio then
        ui.initializeRadio = function()
            local makeBindings = effects.makeRadio :: () -> Values
            local radio = makeBindings()
            callbacks["Play Song"] = makeSong(radio.fire, radio.remote, ui.settings)
        end
    end
    if effects.makeDeploy then
        ui.initializeDeploy = function()
            local makeBindings = effects.makeDeploy :: () -> Values
            callbacks["Deploy Character"] = makeBindings().manual
        end
    end
    if effects.makeBladeServer then
        ui.initializeBladeServer = function()
            local makeBindings = effects.makeBladeServer :: () -> Values
            callbacks["Improve FPS"] = makeBindings().improveFps
        end
    end
    if effects.makeSecondLife then
        local finish: (() -> Values)? = nil
        ui.initializeSecondLifeWorker = function()
            local makeBindings = effects.makeSecondLife :: () -> (() -> Values)
            finish = makeBindings()
        end
        ui.initializeSecondLife = function()
            callbacks["Second Life"] = makeSecondLife((finish :: () -> Values)())
        end
    end
    if effects.makeCurrency then
        ui.initializeCurrency = function()
            local makeBindings = effects.makeCurrency :: () -> Values
            local current = makeBindings()
            callbacks["Check Player Coins"] = makeCurrencyNotify(current.coinNotify :: Values)
            callbacks["Check Player Gems"] = makeCurrencyNotify(current.gemNotify :: Values)
        end
    end
    if effects.makePrestige then
        ui.initializePrestige = function()
            local makeBindings = effects.makePrestige :: () -> Values
            for key, value in makeBindings() do serverBindings[key] = value end
            local current = makeServerLoops(serverBindings)
            callbacks.Prestige, callbacks["Auto Prestige"] = current.manualPrestige, current.prestige
        end
    end
    if effects.makeRoundTimer then
        ui.initializeRoundTimer = function()
            local makeBindings = effects.makeRoundTimer :: () -> Values
            for key, value in makeBindings() do serverBindings[key] = value end
            callbacks["Show Round Timer"] = makeServerLoops(serverBindings).timer
        end
    end
    if effects.makeInfiniteJump then
        ui.initializeInfiniteJump = function()
            local makeBindings = effects.makeInfiniteJump :: () -> Values
            callbacks["Infinite Jump"] = makeSubscription(makeBindings())
        end
    end
    if effects.makeAntiVoid then
        ui.initializeAntiVoid = function()
            local makeBindings = effects.makeAntiVoid :: () -> Values
            callbacks["Anti Void"] = makeAntiVoid(configured(makeBindings()))
        end
    end
    if effects.makeAntiFling then
        ui.initializeAntiFling = function()
            local makeBindings = effects.makeAntiFling :: () -> Values
            callbacks["Anti Fling"] = makeAntiFling(configured(makeBindings()))
        end
    end
    if effects.makeInvisible then
        ui.initializeInvisible = function()
            local makeBindings = effects.makeInvisible :: () -> Values
            callbacks.Invisible = makeInvisible(makeBindings())
        end
    end
    if effects.makeRolesNotify then
        ui.initializeRolesNotify = function()
            local makeBindings = effects.makeRolesNotify :: () -> Values
            local current = makeBindings()
            current.state = ui.settings
            callbacks["Notify Roles"] = makeRolesNotify(current)
        end
    end
    if effects.makeAppearance then
        ui.initializeAppearance = function()
            local makeBindings = effects.makeAppearance :: () -> Values
            local current = makeAppearance(makeBindings())
            callbacks["Korblox (R15)"] = current.korblox
            callbacks["Permanent Korblox (R15)"] = current.permanentKorblox
            callbacks.Headless = current.headless
            callbacks["Permanent Headless"] = current.permanentHeadless
        end
    end
    ui.initializeLay = function()
        local makeFrame = (bindings.makeFrame :: { value: (number, number, number) -> unknown }).value
        local frame = makeFrame(math.pi / 2, 0, 0)
        callbacks.Lay = lay(bindings.humanoid, bindings.root, frame)
    end
    ui.callbacks = callbacks

    populateUi(tab, ui)
end
end)()

