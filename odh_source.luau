local createPluginImport = (function()
-- Recovered record785. Retrieval uses the caller's existing local resource boundary.
type Bindings = {
    getPath: () -> string?,
    getSubstring: () -> ((string, number, number) -> string),
    getNotify: () -> ((unknown, number) -> ()),
    getMatch: () -> ((string, string) -> (string?, string?, string?, string?)),
    getProtectedCall: () -> (((string) -> unknown, string) -> (boolean, unknown)),
    readSource: (string) -> unknown,
    getCompile: () -> ((unknown) -> (unknown, unknown)),
    getFormat: () -> ((string, ...unknown) -> string),
    sign: (string) -> string,
    getWrite: () -> ((string, string) -> ()),
}

local invalidRepository = "Not a valid GitHub repository."
local pluginWrapper = '--[==[\n\tAuthor: %*\n\tRepository: %*\n\tBranch: %*\n\tSign ID: %*\n]==]\n\nodh_shared_plugins.load_from_github_url("%*")'

return function(bindings: Bindings)
    local function notify(message: unknown, level: number)
        local send = bindings.getNotify()
        send(message, level)
    end

    return function()
        local path = bindings.getPath()

        if not path then
            notify(invalidRepository, 2)
            return
        end

        local substring = bindings.getSubstring()

        if substring(path, 1, 1) ~= "/" then
            notify(invalidRepository, 2)
            return
        end

        local match = bindings.getMatch()
        local author, repository, branch, filename = match(path, "/(.+)/(.+)/refs/heads/(.+)/(.+)")

        if not author or not repository or not branch or not filename then
            notify(invalidRepository, 2)
            return
        end

        local protectedCall = bindings.getProtectedCall()
        local url = "https://raw.githubusercontent.com" .. path
        local readSource = bindings.readSource
        local ok, body = protectedCall(readSource, url)

        if not ok or not body then
            notify(invalidRepository, 2)
            return
        end

        local compile = bindings.getCompile()
        local compiled, raised = compile(body)

        if not compiled and raised then
            notify(raised, 2)
            return
        end

        local format = bindings.getFormat()
        local signature = bindings.sign(path .. "|odh")
        local write = bindings.getWrite()
        local outputPath = format("Ixry Shizuka/plugins/%*.lua", signature)
        local wrapper = format(pluginWrapper, author, repository, branch, signature, path)
        write(outputPath, wrapper)
        notify("Restart the script to apply changes!", 1)
    end
end
end)()

