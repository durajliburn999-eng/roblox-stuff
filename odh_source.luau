standaloneModules.createBootstrapScript = ((function()
type Values = { [string]: unknown }

return function(environment: Values): unknown
    local instance = environment.Instance :: Values
    local random = (environment.math :: Values).random :: (number, number) -> number
    local buffers = environment.buffer :: Values
    local create = instance.new :: (string) -> Values
    local createBuffer = buffers.create :: (number) -> buffer
    local write = buffers.writeu16 :: (buffer, number, number) -> ()
    local toString = buffers.tostring :: (buffer) -> string
    local script = create("LocalScript")
    local bytes = createBuffer(6)

    local function letter(): number
        if random(0, 1) == 0 then
            return random(65, 90)
        end
        return random(97, 122)
    end

    for offset = 0, 4, 2 do
        local first = letter()
        local second = letter()
        write(bytes, offset, first * 256 + second)
    end

    script.Name = "ODH-INTERNAL-" .. toString(bytes)
    script.Parent = nil
    environment.script = script
    return script
end
end)())

standaloneModules.captureBootstrapRemoteProbes = ((function()
type Values = { [string]: unknown }

return function(environment: Values, player: Values, capturedGetChildren: unknown?): Values
    local create = (environment.Instance :: Values).new :: (string) -> Values
    local getChildren = (capturedGetChildren or player.GetChildren) :: (unknown) -> { unknown }
    local event = create("RemoteEvent")
    local remoteFunction = create("RemoteFunction")
    local destroy = event.Destroy :: (unknown) -> ()
    local fireServer = event.FireServer
    local invokeServer = remoteFunction.InvokeServer

    for _, object in { event, remoteFunction } do
        for _, child in getChildren(object) do
            destroy(child)
        end
        destroy(object)
    end

    return { getChildren = getChildren, destroy = destroy, fireServer = fireServer, invokeServer = invokeServer }
end
end)())

