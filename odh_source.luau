        searchBar = bindings.searchBar, colorElements = colorElements, gradients = gradients,
        toggles = { elements = owner.ToggleUIElements, getTransition = function() return playback.createTween end,
            getContext = function() return playback.tweenService end, getProperties = function() return owner end } }) do
        callbacks[title] = callback
    end
    local selection = makeSelection({ selectedPreset = selected, presetName = name })
    callbacks["Your Presets"] = selection.select
    callbacks["Preset Name"] = selection.name
    local save: Values = { name = name, getNotify = getNotify, output = output,
        primaryKeys = handles.Primary, secondaryKeys = handles.Secondary, secondaryVariantKeys = handles["Secondary Variant"], surfaceKeys = handles.Surface,
        primaryColors = primary, secondaryColors = secondary, secondaryVariantColors = variant, surfaceColors = surface,
        format = environment.string.upper, getWriteFile = function() return environment.writefile end, encode = owner.json_encode }
    callbacks["Save Preset"] = makeSave(save)
    callbacks["Load Preset"] = makeLoad({ isEmpty = empty, presets = presets, selectedPreset = selected,
        getClock = function() return clock end, lastLoad = lastLoad, getNotify = getNotify, getFormat = getFormat,
        getType = function() return environment.type end, apply = owner._colorpicker_SetHexValue,
        primary = handles.Primary, secondary = handles.Secondary, secondaryVariant = handles["Secondary Variant"], surface = handles.Surface })
    callbacks["Refresh Presets"] = makeRefresh({ getClock = function() return clock end,
        getLastRefresh = function() return lastRefresh end, setLastRefresh = function(value: number) lastRefresh = value end,
        getNotify = getNotify, getFormat = getFormat, getNames = function() return names end, getPresets = function() return presets end,
