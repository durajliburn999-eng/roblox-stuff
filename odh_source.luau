standaloneModules.createWorldCleanup = ((function()
type Node = { Name: unknown, ClassName: unknown, Volume: unknown }
type Bindings = {
    settings: { [string]: unknown },
    world: { value: unknown },
    getDescendants: (unknown) -> { Node },
    remove: (Node) -> (),
    coinSounds: { [unknown]: unknown },
