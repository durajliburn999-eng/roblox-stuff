end
end)()

local populateExclusiveFeature = (function()

type Values = { [string]: unknown }
type Bindings = { ui: Values, effects: Values }
local populateUi = (populateExclusiveUi :: unknown) :: (unknown, Values) -> ()
local makeItemDetails = (standaloneModules.createItemDetails :: unknown) :: (Values) -> unknown
local makeSearch = (standaloneModules.createExclusiveSearch :: unknown) :: (Values) -> unknown
local makeWebhookInput = (standaloneModules.createTradeWebhookInput :: unknown) :: (Values) -> unknown
local makeTradeValueToggle = (standaloneModules.createTradeValueToggle :: unknown) :: (Values) -> unknown
local makeSpeedGlitch = (createSpeedGlitch :: unknown) :: (Values) -> unknown
local makeJump = (standaloneModules.createExclusiveJump :: unknown) :: (Values) -> unknown

return function(tab: unknown, bindings: Bindings)
    local ui = table.clone(bindings.ui)
    local callbacks = table.clone(ui.callbacks :: Values)
    local effects = bindings.effects
    local settings = ui.settings :: Values
    local getSpawn = effects.getSpawn
    local details = table.clone(effects.itemDetails :: Values)
    details.getRarity = function() return settings.WeaponValues_Rarity end
    local webhook = table.clone(effects.tradeWebhook :: Values)
    webhook.settings = settings
    callbacks["Webhook URL"] = makeWebhookInput(webhook)
    callbacks["Trade Value Checker"] = makeTradeValueToggle(effects.tradeValue :: Values)
    local speedGlitch = table.clone(effects.speedGlitch :: Values)
    speedGlitch.settings = settings
    callbacks["Auto Speed Glitch"] = makeSpeedGlitch(speedGlitch)
    local jump = table.clone(effects.jump :: Values)
    jump.settings = settings
    callbacks["Jump Boost"] = makeJump(jump)

    ui.onWeaponInfo = function(handle: unknown)
        local current = table.clone(details)
        current.show = handle
        local worker = makeItemDetails(current)
        callbacks["Search Weapon"] = makeSearch({ getSpawn = getSpawn, worker = worker })
    end
    ui.callbacks = callbacks
    populateUi(tab, ui)
end
end)()

