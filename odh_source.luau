        getProductInfo = bindings.getProductInfo,
        marketplace = bindings.marketplace,
    }
    local pending = {}
    for index, option in options do
        local targets = pending[option.placeId] or {}
        table.insert(targets, items[index])
        pending[option.placeId] = targets
    end

    for placeId, targets in pending do
        common.defer(function()
            local product = loadProduct(productBindings, placeId)
            if not product then return end
            local assetId = product.IconImageAssetId
            if type(assetId) ~= "number" and type(assetId) ~= "string" then return end
            local iconAsset = "rbxassetid://" .. tostring(assetId)

            for _, item in targets do
