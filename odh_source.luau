    getChangedSignal: (NamedObject, string) -> unknown,
    getPlayerName: () -> string,
    getPlayersContainer: () -> unknown,
    getWait: () -> ((number) -> ()),
}

return function(bindings: Bindings)
    return function()
        if bindings.isUpdating() then
            return
        end

        bindings.setUpdating(true)
        local connect = bindings.getConnect()
        local state = bindings.state
        local normalizeName = bindings.getNormalizeName()
        state.Ball1 = nil
        state.Ball1_debounce = 0
        state.Ball1_warp = 0
        state.Ball1_lastattack = 0
        state.Ball1_lasttick = 0
        state.Ball2 = nil
        state.Ball2_debounce = 0
        state.Ball2_warp = 0
        state.Ball2_lastattack = 0
        state.Ball2_lasttick = 0

        local getAttribute = bindings.getAttribute
        local player = bindings.getPlayer()
        state.EquippedAbility = getAttribute(player, "EquippedAbility")
        local format = bindings.getFormat()
        local balls = bindings.getChildren(bindings.getBallsContainer())
        local previous: NamedObject? = nil
        local slot = 1

        for index = 1, #balls do
            local ball = balls[index]

            if not bindings.getAttribute(ball, "realBall") then
                continue
            end

            if previous then
                local name = normalizeName(ball.Name)
                local previousName = normalizeName(previous.Name)

                if name == previousName then
                    break
                end
