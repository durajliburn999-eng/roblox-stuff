standaloneModules.createUiResourceRequest = ((function()
type Values = { [string]: unknown }
type Bindings = {
    getHttpGet: () -> unknown,
    getGame: () -> unknown,
    getCall: () -> unknown,
    request: unknown,
    defaultHeaders: unknown,
}

return function(bindings: Bindings)
    return function(url: unknown, method: unknown, headers: unknown, body: unknown): unknown
        local httpGet = bindings.getHttpGet()
        if not method then
            if httpGet then
                return (httpGet :: (unknown, unknown) -> unknown)(bindings.getGame(), url)
            end
            method = "GET"
        end
        if httpGet and method == "GET" then
            return (httpGet :: (unknown, unknown) -> unknown)(bindings.getGame(), url)
        end
        local call = bindings.getCall() :: (unknown, Values) -> (boolean, Values)
        local success, response = call(bindings.request, {
            Url = url, Method = method, Headers = headers or bindings.defaultHeaders, Body = body or "",
        })
        if not success then
            return nil
        end
        return response.Body
    end
end
end)())

