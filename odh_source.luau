standaloneModules.createWorldTeleports = ((function()
type Cell = { value: unknown }
type Node = { [string]: unknown }
type Vector = typeof(setmetatable({ X = 0, Y = 0, Z = 0 }, { __sub = function(left, _right) return left end }))
type Bindings = {
    root: Cell,
    settings: { Map: unknown },
    getChildren: (unknown) -> { Node },
    getDescendants: (unknown) -> { Node },
    isA: (Node, string) -> unknown,
    getDot: () -> ((Vector, Vector) -> number),
    getVector: () -> ((number, number, number) -> Vector),
    getFrame: () -> ((number, number, number) -> unknown),
    getCreatePart: () -> ((string) -> Node),
    findChild: (unknown, string) -> Node?,
    workspace: Cell,
    votingFrame: unknown,
    lobbyFrame: unknown,
    murderers: { unknown },
    sheriffs: { unknown },
    localName: Cell,
    findPlayer: (unknown) -> Node?,
}

local function findSpawn(map: unknown, getChildren: (unknown) -> { Node }): Node?
    local group: Node? = nil
    local groups = getChildren(map)

    for index = 1, #groups do
        local candidate = groups[index]
        local name = candidate.Name

        if name == "Spawns" or name == "ZombieSpawns" then
            group = candidate
            break
        end
    end

    if not group then
        return nil
    end

    local spawn: Node? = nil
    local children = getChildren(group)

    for index = 1, #children do
        local child = children[index]
        local name = child.Name

        if name == "Spawn" or name == "PlayerSpawn" or name == "SpawnLocation" or name == "ZombieSpawn" then
            spawn = child
        end
    end

    return spawn
end

return function(bindings: Bindings)
    local root = bindings.root
    local settings = bindings.settings
    local getChildren = bindings.getChildren
    local getDescendants = bindings.getDescendants
    local isA = bindings.isA
    local findChild = bindings.findChild
    local workspace = bindings.workspace
    local findPlayer = bindings.findPlayer
    local getDot = bindings.getDot
    local getVector = bindings.getVector
    local getFrame = bindings.getFrame
    local getCreatePart = bindings.getCreatePart
    local localName = bindings.localName
    local votingFrame = bindings.votingFrame
    local lobbyFrame = bindings.lobbyFrame

    local function map()
        local current = root.value :: Node?

        if not current then
            return
        end

        local mapValue = settings.Map

        if not mapValue then
            return
        end

        local spawn = findSpawn(mapValue, getChildren)

        if not spawn then
            return
        end

        local frame = spawn.CFrame :: Vector
        local makeFrame = getFrame()
        current.CFrame = makeFrame(frame.X, frame.Y + 5, frame.Z)
    end

    local function aboveMap()
        local current = root.value :: Node?

        if not current then
            return
        end

        local mapValue = settings.Map

        if not mapValue then
            return
        end

        local spawn = findSpawn(mapValue, getChildren)

        if not spawn then
            return
        end

        local dot = getDot()
        local objects = getDescendants(mapValue)
        local position = spawn.Position :: Vector
        local makeVector = getVector()
        local probe = makeVector(position.X, position.Y + 999, position.Z)
        local distance = math.huge
        local nearest: Node? = nil

        for index = 1, #objects do
            local object = objects[index]

            if not isA(object, "BasePart") or object.Transparency == 0 then
                continue
            end

            local displacement = probe - (object.Position :: Vector)
            local nextDistance = dot(displacement, displacement)

            if nextDistance >= distance then
                continue
            end

            distance = nextDistance
            nearest = object
        end

        if not nearest then
            return
        end

        local frame = nearest.CFrame :: Vector
        local makeFrame = getFrame()
        current.CFrame = makeFrame(frame.X, frame.Y + 5, frame.Z)
    end

    local function stored(frame: unknown)
        return function()
            local current = root.value :: Node?

            if current then
                current.CFrame = frame
            end
        end
    end

    local function void()
        local current = root.value :: Node?

        if not current then
            return
        end

        local world = workspace.value
        local makeFrame = getFrame()
        local name = "safevoidpath_- am gonna kill you"

        if not findChild(world, name) then
            local createPart = getCreatePart()
            local part = createPart("Part")
            part.Name = name
            part.Parent = world
            part.Transparency = 0.5
            part.Anchored = true
            local makeVector = getVector()
            part.Size = makeVector(300, 0.1, 300)
            part.CFrame = makeFrame(99999, 99995, 99999)
        end

        current.CFrame = makeFrame(99999, 99999, 99999)
    end

    local function role(roles: { unknown })
        return function()
            local current = root.value :: Node?

            if not current then
                return
            end

            local name = roles[1]

            if not name or name == localName.value then
                return
            end

            local player = findPlayer(name)

            if not player then
                return
            end

            local character = player.Character

            if not character then
                return
            end

            local target = findChild(character, "HumanoidRootPart")

            if target then
                current.CFrame = target.CFrame
            end
        end
    end

    return {
        map = map,
        aboveMap = aboveMap,
        votingMap = stored(votingFrame),
        void = void,
        lobby = stored(lobbyFrame),
        murderer = role(bindings.murderers),
        sheriff = role(bindings.sheriffs),
    }
end
end)())

standaloneModules.createWorldSkybox = ((function()
type Values = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    selected: Cell, useCustom: Cell, skyboxes: Values, sky: Values, original: Values,
    top: Cell, bottom: Cell, front: Cell, back: Cell, left: Cell, right: Cell,
}
local names = { "Top", "Bottom", "Front", "Back", "Left", "Right" }
local properties = { "SkyboxUp", "SkyboxDn", "SkyboxFt", "SkyboxBk", "SkyboxLf", "SkyboxRt" }

return function(bindings: Bindings)
    local handlers: { [string]: unknown } = {}
    local faces = { bindings.top, bindings.bottom, bindings.front, bindings.back, bindings.left, bindings.right }
    for index, name in names do
        local face = faces[index]
        handlers[name] = function(value: string) face.value = "rbxassetid://" .. value end
    end
    handlers.select = function(value: unknown) bindings.selected.value = value end
    handlers.useCustom = function(value: unknown) bindings.useCustom.value = value end
    handlers.reset = function()
        for key, value in bindings.original do
            bindings.sky[key] = value
        end
    end
    handlers.apply = function()
        local values: { unknown }
        if bindings.useCustom.value then
            local skybox = bindings.skyboxes[bindings.selected.value :: string] :: Values?
            if not skybox then return end
            values = { skybox.Top, skybox.Bottom, skybox.Front, skybox.Back, skybox.Left, skybox.Right }
        else
            values = { bindings.top.value, bindings.bottom.value, bindings.front.value, bindings.back.value, bindings.left.value, bindings.right.value }
        end
        for index, property in properties do
            bindings.sky[property] = values[index]
        end
    end
    return handlers
end
end)())

