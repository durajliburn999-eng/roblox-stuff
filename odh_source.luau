        local ok, parsed = bindings.getProtectedCall()(bindings.parseColor, input)

        if not ok or not parsed then
            picker[fields.hexInput][fields.text] = picker[fields.originalValues][fields.unit]
            return
        end

        local color = parsed :: Color
        local position = bindings.getPositionConstructor()
        local hue, saturation, brightness = (color[fields.toHSV] :: (Color) -> (number, number, number))(color)
        local hex = fields.hexPrefix .. bindings.uppercase(((color[fields.toHex] :: (Color) -> string)(color)))
        local rgb = bindings.getFormat()(
            fields.rgbFormat,
            bindings.round((color[fields.red] :: number) * fields.channelScale),
            bindings.round((color[fields.green] :: number) * fields.channelScale),
            (bindings.round((color[fields.blue] :: number) * fields.channelScale))
        )
        local originalValues = picker[fields.originalValues]

        picker[fields.canvas][fields.backgroundColor] = bindings.fromHSV(hue, fields.unit, fields.unit)
        picker[fields.preview][fields.backgroundColor] = color
        picker[fields.cursor][fields.position] = position(saturation, fields.unit - brightness)
        picker[fields.hueCursor][fields.position] = position(fields.hueCursorX, hue)
        picker[fields.previewHex][fields.text] = hex
        picker[fields.hexInput][fields.text] = hex
        picker[fields.rgbInput][fields.text] = rgb
        originalValues[fields.unit] = hex
        originalValues[fields.rgbIndex] = rgb
        picker[fields.settings][picker[fields.featureName]] = hex
        picker[fields.save]()
        picker[fields.callback](color)
    end
end
end)()

standaloneModules.createColorRgbInput = ((function()
type Color = { ToHSV: (Color) -> (number, number, number), ToHex: (Color) -> string }
