local setupKnifeTouch = (function()

type Text = { Text: unknown }
type Button = { Name: string, Activated: unknown, ControlText: Text }
type Action = { TouchBinding: unknown, Pressed: unknown, Released: unknown }
type Gui = { InputContext: { GameplayContext: { [string]: Action } } }
type Remote = { Fire: unknown }
type Bindings = {
    playerGui: Gui,
    settings: { CustomPerk: unknown },
    knife: unknown,
    character: unknown,
    remote: Remote,
    getOriginalParent: () -> unknown,
    getMakeFrame: () -> unknown,
    getRoot: () -> unknown,
    getHumanoid: () -> unknown,
    isActive: () -> unknown,
    find: (unknown, string) -> unknown,
    waitFor: (unknown, string) -> unknown,
    write: (unknown, string, unknown) -> (),
    connect: (unknown, unknown) -> unknown,
    throw: unknown,
    color: (number, number, number) -> unknown,
    setEquipped: (unknown) -> (),
    setPerkButton: (unknown) -> (),
    setEquipButton: (unknown) -> (),
    setThrowButton: (unknown) -> (),
}
type Buttons = { perk: Button?, equip: Button?, throw: Button? }
local makePerk = (knifeControls.perk :: unknown) :: (unknown) -> (() -> ())
local makeToggle = (knifeControls.toggleParent :: unknown) :: (unknown) -> (() -> ())
local makeConditionalColor = (knifeControls.conditionalColor :: unknown) :: (unknown) -> (() -> ())
local makeColor = (knifeControls.color :: unknown) :: (unknown) -> (() -> ())

local function bindAction(bindings: Bindings, action: Action, button: Button, index: number, pressedColor: unknown, releasedColor: unknown)
    bindings.write(action.TouchBinding, "UIButton", button)
    local pressed = action.Pressed
    local onPressed = makeConditionalColor({ getInput = function() return index end, isActive = bindings.isActive, getImage = function() return button end, color = pressedColor, write = bindings.write })
    bindings.connect(pressed, onPressed)
    local released = action.Released
    local onReleased = makeColor({ getImage = function() return button end, color = releasedColor })
    bindings.connect(released, onReleased)
end

local function findButtons(bindings: Bindings, controls: unknown, buttons: Buttons)
    local remote = bindings.remote
    local makeFrame = bindings.getMakeFrame()
    local right = bindings.find(controls, "RightBar")
    local bottom = bindings.find(controls, "BottomBar")
    local perk = bindings.find(bottom, "Perk") :: Button
    local equip = bindings.find(right, "EquipWeapon") :: Button
    local throw = bindings.find(right, "Throw") :: Button
    local equipped = bindings.find(equip, "Equipped")
    buttons.perk, buttons.equip, buttons.throw = perk, equip, throw
    bindings.setEquipped(equipped)
    bindings.setPerkButton(perk)
    bindings.setEquipButton(equip)
    bindings.setThrowButton(throw)

    local text = perk.ControlText
    local _originalText = text.Text
    local fire = remote.Fire
    local activated = perk.Activated
    local usePerk = makePerk({ settings = bindings.settings, getRoot = bindings.getRoot, getHumanoid = bindings.getHumanoid, makeFrame = makeFrame, usePerk = fire, perk = remote, write = bindings.write })
    bindings.connect(activated, usePerk)
    bindings.connect(throw.Activated, bindings.throw)

    if bindings.settings.CustomPerk ~= "Default" then
        bindings.write(text, "Text", bindings.settings.CustomPerk)
    end

    bindings.write(bindings.settings, "HDDU", text)
end

return function(bindings: Bindings)
    local originalParent = bindings.getOriginalParent()
    local controls = bindings.waitFor(bindings.playerGui, "GameplayControlsUI")
    local buttons: Buttons = { perk = nil, equip = nil, throw = nil }

    if controls then
        local controlsScript = bindings.find(controls, "GameplayControlsScript")

        if controlsScript then
            bindings.write(controlsScript, "Disabled", true)
        end

        local touch = bindings.waitFor(controls, "TouchControls")

        if touch then
            findButtons(bindings, touch, buttons)
        end
    end

    local actions = bindings.playerGui.InputContext.GameplayContext
    local ordered = { buttons.throw, buttons.equip, buttons.perk }
    local pressedColor = bindings.color(170, 170, 170)
    local releasedColor = bindings.color(0, 0, 0)

    for index = 1, 3 do
        local button = ordered[index] :: Button
        local action = actions[button.Name]
        bindAction(bindings, action, button, index, pressedColor, releasedColor)
    end

    local equip = buttons.equip :: Button
    local activated = equip.Activated
    local knife = bindings.knife
    local toggle = makeToggle({ originalParent = originalParent, getTool = function() return knife end, character = bindings.character, write = bindings.write })
    bindings.connect(activated, toggle)
end
end)()

local finishKnifeSetup = (function()

type Handle = { Touched: unknown }
type Knife = { Activated: unknown, TextureId: unknown }
type Button = { ControlIcon: unknown }
type Bindings = {
    knife: Knife,
    isTouch: boolean,
    perkButton: unknown,
    equipButton: Button,
    throwButton: unknown,
    find: (unknown, string) -> unknown,
    waitFor: (unknown, string) -> unknown,
    write: (unknown, string, unknown) -> (),
    connect: (unknown, unknown) -> unknown,
    wrap: (unknown) -> unknown,
    connections: { [number]: unknown },
    setStabbed: (unknown) -> (),
    setThrown: (unknown) -> (),
    setHandleTouched: (unknown) -> (),
    setDualEffect: (unknown) -> (),
    setKnife: (unknown) -> (),
    onTouched: unknown,
    touchUpdater: unknown,
    onActivated: unknown,
    appearance: (Handle) -> unknown,
    input: unknown,
    sounds: (Handle) -> unknown,
    wait: (number) -> (),
    resumeAfterSetup: unknown,
    resume: () -> (),
}
local saveAppearance = (saveKnifeAppearance :: unknown) :: (unknown) -> ()
local connectInput = (connectKnifeInput :: unknown) :: (unknown) -> ()
local setupSounds = (setupKnifeSounds :: unknown) :: (unknown) -> ()

return function(bindings: Bindings)
    local handle = bindings.waitFor(bindings.knife, "Handle") :: Handle
    local events = bindings.find(bindings.knife, "Events")

    if not events then
        events = bindings.find(bindings.knife, "KnifeServer")
    end

    local stabbed = bindings.find(events, "KnifeStabbed")

    if not stabbed then
        stabbed = bindings.find(events, "SlashStart")
    end

    bindings.setStabbed(stabbed)
    local thrown = bindings.find(events, "KnifeThrown")

    if not thrown then
        thrown = bindings.find(events, "FlingKnifeEvent")
    end

    bindings.setThrown(thrown)
    bindings.setHandleTouched(bindings.find(events, "HandleTouched"))
    bindings.setDualEffect(bindings.find(bindings.knife, "DualEffect"))
    bindings.connect(handle.Touched, bindings.onTouched)

    if bindings.isTouch then
        bindings.connections[7] = bindings.wrap(bindings.touchUpdater)
    end

    bindings.connections[8] = bindings.connect(bindings.knife.Activated, bindings.onActivated)
    bindings.setKnife(bindings.knife)
    saveAppearance(bindings.appearance(handle))
    connectInput(bindings.input)

    if bindings.isTouch then
        bindings.write(bindings.equipButton.ControlIcon, "Image", bindings.knife.TextureId)
        bindings.write(bindings.equipButton, "Visible", true)
        bindings.write(bindings.perkButton, "Visible", true)
        bindings.write(bindings.throwButton, "Visible", true)
    end

    bindings.wait(0.25)
    setupSounds(bindings.sounds(handle))

    if bindings.resumeAfterSetup then
        bindings.resume()
    end
end
end)()

local createKnifeSetup = (function()

