standaloneModules.decodeLocalFramePayload = ((function()
local decodeByte = (standaloneModules.decodeLocalFrameStringByte :: unknown) :: (buffer, number, number) -> number
local readHeader = (standaloneModules.decodeLocalFrameHeader :: unknown) :: (buffer) -> { key: number, stringTag: number, byteTag: number, numberTag: number, marker: number }

type Dictionary = { [unknown]: unknown }

return function(frame: string): (Dictionary?, number?)
    if #frame < 20 or #frame % 2 ~= 0 then
        return nil, nil
    end
    local data = buffer.fromstring(frame)
    local header = readHeader(data)
    local key = header.key
    local high = decodeByte(data, 18, key)
    local low = decodeByte(data, 16, key)
    local endOffset = 20 + (low + high * 256) * 2
    local offset = 20
    local function read(): number
        local value = decodeByte(data, offset, key)
        offset += 2
        return value
    end
    local function readString(length: number): string
        local value = buffer.create(length)
        for index = 0, length - 1 do
            buffer.writeu8(value, index, read())
        end
        return buffer.tostring(value)
    end
    local result: Dictionary = {}
    repeat
        local tag = read()
        local nameLength = read()
        local name: unknown
        if nameLength == 1 then
            name = read()
        elseif nameLength == 2 then
            name = read() * 256 + read()
        else
            name = readString(nameLength)
        end
        local value: unknown
        if tag == header.stringTag then
            local length = read() + read() * 256
            value = readString(length)
        elseif tag == header.byteTag then
            value = read()
        elseif tag == header.numberTag then
            local number = 0
            for _ = 1, 4 do
                local word = read() + read() * 256
                number = number * 65536 + word
            end
            value = number
        else
            return nil, nil
        end
        result[name] = value
    until offset >= endOffset
    return table.freeze(result), header.marker
end
end)() :: unknown)

