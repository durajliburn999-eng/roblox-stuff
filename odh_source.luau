local shootAfterGunPickup = (function()
type Vector = typeof(setmetatable({ Unit = (nil :: unknown) :: unknown, Magnitude = 0 }, {
    __sub = function(left, _right) return left end,
    __mul = function(left, _right) return left end,
}))
type Frame = typeof(setmetatable({}, { __mul = function(left, _right) return left end }))
type Part = { Parent: Part?, Position: Vector, CFrame: Frame }
type Player = { Character: Part? }
type Gun = { Parent: unknown, Handle: { CFrame: Frame } }
type Hit = { Instance: Part? }
type Settings = {
    AutoEquipGunUponPickUp_OnMurdererRange: unknown,
    AutoEquipGunUponPickUp_MurdererRange: number,
    AutoEquipGunUponPickUp_ShootMurdererAfter: unknown,
    AutoEquipGunUponPickUp_ShootMurdererAfter_WallCheck: unknown,
    GunSilentAimPrediction: unknown,
    PiercerBullet: unknown,
    predict_movement: unknown,
}
type Bindings = {
    settings: Settings,
    roles: { Murderers: { unknown } },
    gun: Gun,
    remote: unknown,
    getCharacter: () -> Part?,
    findPlayer: (unknown) -> Player?,
    getRoot: () -> Part?,
    find: (unknown, string) -> unknown,
    raycast: (Vector, Vector) -> Hit?,
    getProtect: () -> ((unknown, ...unknown) -> (boolean, unknown)),
    getFrame: () -> ((unknown, unknown?, unknown?) -> Frame),
    getInvoke: () -> ((unknown, unknown, Frame, Frame) -> ()),
    invokeContext: unknown,
}

local function acceptsWallHit(hit: Hit?, character: Part): boolean
    if not hit then
        return false
    end

    local instance = hit.Instance

    if instance ~= character then
        return true
    end

    local parent = (instance :: Part).Parent :: Part

    if parent == character then
        return true
    end

    return parent.Parent == character
end

local function intersectsCharacter(hit: Hit?, character: Part): boolean
    if not hit or not hit.Instance then
        return false
    end

    local instance = hit.Instance

    if instance == character then
        return true
    end

    local parent = instance.Parent :: Part

    if parent == character then
        return true
    end

    return parent.Parent == character
end

local function needsPiercing(bindings: Bindings, mode: unknown, localCharacter: Part?, targetRoot: Part, targetCharacter: Part): unknown
    local isPiercing = bindings.settings.PiercerBullet

    if isPiercing or mode ~= "Ubuntu" then
        return isPiercing
    end

    local hand = bindings.find(localCharacter, "RightHand") :: Part?

    if not hand then
        return isPiercing
    end

    local origin = hand.Position
    local displacement = targetRoot.Position - origin
    local direction = (displacement.Unit :: Vector) * 500
    local hit = bindings.raycast(origin, direction)

    if intersectsCharacter(hit, targetCharacter) then
        return true
    end

    return isPiercing
end

local function sendShot(bindings: Bindings, targetCharacter: Part, position: unknown, isPiercing: unknown)
    local origin: Frame? = nil

    if isPiercing then
        local root = bindings.find(targetCharacter, "HumanoidRootPart") :: Part?

        if root then
            local frame = root.CFrame
            local makeFrame = bindings.getFrame()
            local offset = makeFrame(0, 0, 2.5)
            origin = frame * offset
        end
    end

    if not origin then
        origin = bindings.gun.Handle.CFrame
    end

    local invoke = bindings.getInvoke()
    local makeFrame = bindings.getFrame()
    local target = makeFrame(position)
    local context = bindings.invokeContext
    invoke(context, bindings.remote, origin :: Frame, target)
end

return function(bindings: Bindings)
    local settings, gun = bindings.settings, bindings.gun
    local localCharacter = bindings.getCharacter()
    local murderer = bindings.roles.Murderers[1]

    if not murderer then
        return
    end

    local player = bindings.findPlayer(murderer)

    if not player then
        return
    end

    local targetCharacter = player.Character

    if not targetCharacter then
        return
    end

    local localRoot = bindings.getRoot()

    if not localRoot then
        return
    end

    local targetRoot = bindings.find(targetCharacter, "HumanoidRootPart") :: Part?

    if not targetRoot then
        return
    end

    gun.Parent = localCharacter
    local origin = localRoot.Position
    local displacement = origin - targetRoot.Position

    if not settings.AutoEquipGunUponPickUp_OnMurdererRange then
        return
    end

    if settings.AutoEquipGunUponPickUp_MurdererRange < displacement.Magnitude then
        return
    end

    if not settings.AutoEquipGunUponPickUp_ShootMurdererAfter then
        return
    end

    if settings.AutoEquipGunUponPickUp_ShootMurdererAfter_WallCheck then
        local direction = (displacement.Unit :: Vector) * 500
        local hit = bindings.raycast(origin, direction)

        if not acceptsWallHit(hit, targetCharacter) then
            return
        end
    end

    local mode = settings.GunSilentAimPrediction or "Remi"
    local isPiercing = needsPiercing(bindings, mode, localCharacter, targetRoot, targetCharacter)
    local protect = bindings.getProtect()
    local predict = settings.predict_movement
    local ok, predicted = protect(predict, player, mode)

    if not ok or not predicted then
        return
    end

    sendShot(bindings, targetCharacter, predicted, isPiercing)
end
end)()

