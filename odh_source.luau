standaloneModules.createUiGameItemActions = ((function()
type Bindings = {
    name: unknown,
    code: unknown,
    hoverTween: unknown,
    leaveTween: unknown,
    selectedTween: unknown,
    enableTween: unknown,
    play: (unknown) -> (),
    getSelectedName: () -> unknown,
    getPreviousTween: () -> unknown,
    setSelectedName: (unknown) -> (),
    setSelectedCode: (unknown) -> (),
    setPreviousTween: (unknown) -> (),
}

return function(bindings: Bindings)
    local name, code = bindings.name, bindings.code
    local hoverTween, leaveTween, selectedTween, enableTween = bindings.hoverTween, bindings.leaveTween, bindings.selectedTween, bindings.enableTween
    local play = bindings.play
    local function hover(tween: unknown)
        return function()
            if bindings.getSelectedName() ~= name then
                play(tween)
            end
        end
    end
    local function selectGame()
        local previous = bindings.getPreviousTween()
        if previous then
            play(previous)
        end
        bindings.setSelectedName(name)
        bindings.setSelectedCode(code)
        bindings.setPreviousTween(leaveTween)
        play(selectedTween)
        play(enableTween)
    end
    return { select = selectGame, enter = hover(hoverTween), leave = hover(leaveTween) }
end
end)() :: unknown)

