local evaluateFarmContext = (function()
type Bindings = {
    isAlive: (unknown) -> unknown,
    player: unknown,
    settings: { CoinContainer: unknown },
    character: { value: unknown },
    root: { value: unknown },
}

return function(bindings: Bindings): string
    if not bindings.isAlive(bindings.player) then
        return "dead"
    end

    if not bindings.settings.CoinContainer then
        return "container"
    end

    if not bindings.character.value then
        return "character"
    end

    if not bindings.root.value then
        return "root"
    end

    return "ready"
end
end)()

local evaluateInactiveFarmContext = (function()
type Cell = { value: unknown }
type State = {
    active: Cell,
    previousCoin: Cell,
    previousMethod: Cell,
    savedCharacter: Cell,
    savedHumanoid: Cell,
}
type Bindings = {
    state: State,
    player: unknown,
    isAlive: (unknown) -> unknown,
    settings: { CoinContainer: unknown },
    character: Cell,
    humanoid: Cell,
    root: Cell,
}

return function(bindings: Bindings): (string, unknown, unknown, unknown)
    local state = bindings.state

    if not bindings.isAlive(bindings.player) then
        state.previousCoin.value = nil
        state.active.value = nil
        return "wait", nil, nil, nil
    end

    local container = bindings.settings.CoinContainer

    if not container then
        state.active.value = nil
        state.previousCoin.value = nil
        state.previousMethod.value = nil
        return "wait", nil, nil, nil
    end

    local character = bindings.character.value

    if character then
        state.savedCharacter.value = character
        state.savedHumanoid.value = bindings.humanoid.value
    end

    if not character then
        state.active.value = nil
        state.previousCoin.value = nil
        state.previousMethod.value = nil
        return "wait", nil, nil, nil
    end

    local root = bindings.root.value

    if not root then
        state.active.value = nil
        state.previousCoin.value = nil
        state.previousMethod.value = nil
        return "wait", nil, nil, nil
    end

    return "ready", container, character, root
end
end)()

local releaseFarmPhysics = (function()
type Part = { CanCollide: unknown }
type Humanoid = { PlatformStand: unknown }
type Bindings = {
    character: { value: unknown },
    humanoid: { value: Humanoid? },
    body: unknown,
    cleanup: (unknown) -> (),
    getDescendants: (unknown) -> { Part },
    isA: (Part, string) -> unknown,
}

return function(bindings: Bindings, active: unknown)
    if not active then
        return
    end

    local character = bindings.character.value

    if not character then
        return
    end

    local humanoid = bindings.humanoid.value

    if humanoid then
        humanoid.PlatformStand = false
    end

    bindings.cleanup(bindings.body)
    local objects = bindings.getDescendants(character)

    for index = 1, #objects do
        local object = objects[index]

        if bindings.isA(object, "BasePart") then
            object.CanCollide = true
        end
    end
end
end)()

local farmPhysicsSetup = (function()
type Body = { Name: unknown, Parent: unknown, MaxForce: unknown, Velocity: unknown }
type Part = { CanCollide: unknown }
type Humanoid = { PlatformStand: unknown }
type BodyBindings = {
    root: unknown,
    body: { value: Body? },
    find: (unknown, string) -> unknown,
    create: (string) -> Body,
    maxForce: unknown,
    zero: unknown,
}

local function ensureBody(bindings: BodyBindings)
    if bindings.find(bindings.root, "IaoKfl") then
        return
    end

    local body = bindings.create("BodyVelocity")
    bindings.body.value = body
    body.Name = "IaoKfl"
    body.Parent = bindings.root
    body.MaxForce = bindings.maxForce
    body.Velocity = bindings.zero
end

local function setPlatform(humanoid: Humanoid?, method: unknown)
    if not humanoid then
        return
    end

    humanoid.PlatformStand = method == "Safe" or method == "Lay"
end

local function disableCollisions(character: unknown, getChildren: (unknown) -> { Part }, isA: (Part, string) -> unknown)
    local parts = getChildren(character)

    for index = 1, #parts do
        local part = parts[index]

        if isA(part, "BasePart") then
            part.CanCollide = false
        end
    end
end

return { ensureBody = ensureBody, setPlatform = setPlatform, disableCollisions = disableCollisions }
end)()

