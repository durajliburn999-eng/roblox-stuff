local discoverProtocol = (function()
type Dictionary = { [unknown]: unknown }
type Entry = { value: Dictionary, depth: number }
local protocolFields = { "REQ", "AES", "json_encode", "json_decode", "requestFromWS", "EB64", "DB64" }

return function(registers: Dictionary, runtime: Dictionary): Dictionary?
    local queue: { Entry } = { { value = registers, depth = 0 } }
    local seen: { [unknown]: boolean } = { [runtime] = true }
    local cursor, inspected = 1, 0

    while cursor <= #queue and inspected < 50000 do
        local item = queue[cursor]
        cursor += 1
        local candidate = item.value

        if seen[candidate] then
            continue
        end

        seen[candidate] = true
        local hits = 0

        for _, name in protocolFields do
            if rawget(candidate, name) ~= nil then
                hits += 1
            end
        end

        if hits >= 4 then
            local names: { string } = {}

            for name, value in next, candidate do
                if type(name) == "string" then
                    names[#names + 1] = name .. ":" .. type(value)
                end
            end

            table.sort(names)
            return candidate
        end

        for _, member in next, candidate do
            inspected += 1

            if inspected >= 50000 then
                break
            end

            if type(member) == "table" and not seen[member] and item.depth < 4 and #queue < 2000 then
                queue[#queue + 1] = { value = member :: Dictionary, depth = item.depth + 1 }
            end
        end
    end

    return nil
end
end)()

standaloneModules.createHeartbeat = ((function()
-- Record5415: captured two-table heartbeat state and response waiting.
type Slots = { [number]: unknown }
type Bindings = {
    seed: () -> number,
    getClock: () -> (() -> number),
    getWait: () -> (() -> ()),
    getCoroutine: () -> { resume: unknown },
    setStarted: (number) -> (),
    checkpoint: (() -> ())?,
}

return function(bindings: Bindings)
    local checkpoint = bindings.checkpoint

    return function(packet: { Slots })
        local seed = bindings.seed()
        local clock = bindings.getClock()
        local waitForResponse = bindings.getWait()
        local coroutineLibrary = bindings.getCoroutine()
        local _resume = coroutineLibrary.resume
        local daySeed = seed // 86400
        local outgoing = packet[1]
        local incoming = packet[2]
        local state = bindings.seed()
        local sequence = 0

        while true do
            local check = checkpoint
            if check then check() end
            local started = clock()
            local response, responseSequence

            while true do
                local responseCheck = checkpoint
                if responseCheck then responseCheck() end
                response = incoming[1]
                responseSequence = incoming[2]

                if response and responseSequence then
                    break
                end

                waitForResponse()
            end

            incoming[1] = nil
            incoming[2] = nil

            if clock() - started > 60 then
                return
            end

            if response ~= state // daySeed then
                return
            end

            if responseSequence ~= sequence then
                return
            end

            outgoing[1] = state // 256
            outgoing[2] = sequence
            sequence += 1
            state = (state + daySeed * 2) % 4294967296
            bindings.setStarted(started)
        end
    end
end
end)())

standaloneModules.createCountdown = ((function()
type Bindings = {
