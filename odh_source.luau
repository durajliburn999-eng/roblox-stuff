        local mode = getMode()
        local players = getPlayers()
        local idle = getIdle()

        while true do
            while settings.AutoKillEveryone do
                wait(0.5)

                if not isMode(modeOwner, mode) or settings.RoundTime < 1 then
                    continue
                end

                for index = 2, #players do
                    attack(players[index])
                end
            end

            idle()
        end
    end

    local function sheriff()
        local wait = getWait()
        local mode = getMode()
        local idle = getIdle()

        while true do
            while settings.AutoKillSheriff do
                wait(0.5)

                if not isMode(modeOwner, mode) or settings.RoundTime < 1 then
