type FollowPart = { CFrame: unknown }

return function(body: Body, root: Root, velocity: unknown, zero: unknown, target: unknown, teleport: boolean, followPart: FollowPart?, touch: ((Root, FollowPart, number) -> ())?)
    if teleport then
        body.Velocity = zero
        root.Velocity = zero
        root.CFrame = target

        if followPart then
