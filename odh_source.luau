local populateVisualsUi = (function()

type Section = {
    AddLabel: (Section, string) -> (),
    AddToggle: (Section, string, unknown) -> (),
    AddButton: (Section, string, unknown) -> (),
    AddDropdown: (Section, string, unknown, unknown) -> (),
    AddPlayerDropdown: (Section, string, unknown) -> (),
    AddColorpicker: (Section, string, unknown, unknown) -> (),
}
type Tab = { AddSection: (Tab, string, string?) -> Section }
type Bindings = {
    settings: unknown,
    stateDispatch: unknown,
    stateTransform: unknown,
    callbacks: { [string]: unknown },
    colors: { [string]: unknown },
    tracerLocations: unknown,
    gameSpecific: boolean?,
    gameName: unknown,
}
local makeState = (createStateCallback :: unknown) :: (unknown) -> (number, string, unknown) -> unknown
type Object = { name: string, id: string, class: string, global: boolean }
type Profile = { roles: { string }, objects: { Object }, roleColors: boolean }
local getProfile = (selectVisualProfile :: unknown) :: (unknown, unknown) -> Profile

local function addVisualSection(tab: Tab, bindings: Bindings, name: string, prefix: string, showObjects: boolean, showCoins: boolean): Section
    local callbacks = bindings.callbacks
    local section = tab:AddSection(name)
    section:AddLabel('<b><font size="18">BY TEAM</font></b>')
    local everyone = prefix .. " Everyone"
    section:AddToggle(everyone, callbacks[name .. "/" .. everyone])

    local profile = getProfile(bindings.gameName, bindings.gameSpecific)
    for _, role in profile.roles do
        local title = prefix .. " " .. role .. " Only"
        section:AddToggle(title, callbacks[name .. "/" .. title])
    end

    if showObjects and #profile.objects > 0 then
        section:AddLabel('<b><font size="18">BY OBJECT</font></b>')
        for _, object in profile.objects do
            if object.name == "Coins" and not showCoins then continue end
            local title = prefix .. " " .. object.name
            section:AddToggle(title, callbacks[name .. "/" .. title])
        end
    end

    section:AddLabel('<b><font size="18">BY PLAYER</font></b>')
    section:AddPlayerDropdown("Select Player", callbacks[name .. "/Select Player"])
    section:AddButton("Apply", callbacks[name .. "/Apply"])
    section:AddButton("Remove", callbacks[name .. "/Remove"])
    return section
end

return function(tab: Tab, bindings: Bindings)
    local state = makeState({ settings = bindings.settings, dispatch = bindings.stateDispatch, transform = bindings.stateTransform })
    addVisualSection(tab, bindings, "CHAM", "Cham", true, true)
    local esp = addVisualSection(tab, bindings, "ESP", "ESP", true, true)
    esp:AddLabel('<b><font size="18">CONFIGURATIONS</font></b>')
    esp:AddToggle("ESP Display Distance", state(1, "ESPDisplayDistance", nil))
    addVisualSection(tab, bindings, "OUTLINE", "Outline", true, false)
    addVisualSection(tab, bindings, "HIGHLIGHT", "Highlight", true, false)
    local tracer = addVisualSection(tab, bindings, "TRACER", "Tracer", true, true)
    tracer:AddLabel('<b><font size="18">CONFIGURATIONS</font></b>')
    tracer:AddDropdown("Tracer Location", bindings.tracerLocations, state(1, "TracerLocation", nil))
    addVisualSection(tab, bindings, "ESP BOX", "ESP Box", true, true)
    addVisualSection(tab, bindings, "ESP CUBE", "ESP Cube", false, false)
    addVisualSection(tab, bindings, "ESP AVATAR", "ESP Avatar", false, false)
    addVisualSection(tab, bindings, "ESP FIRE", "ESP Fire", false, false)

    local profile = getProfile(bindings.gameName, bindings.gameSpecific)
    if profile.roleColors then
        local configuration = tab:AddSection("CONFIGURATION", "MM2 / MMV")
        for _, role in profile.roles do
            local title = role .. " Color"
            configuration:AddColorpicker(title, bindings.colors[title], bindings.callbacks["CONFIGURATION/" .. title])
        end
    end
end
end)()

local createVisualsCallbacks = (function()

type Refresh = { [unknown]: () -> () }
type Bindings = {
    listeners: { value: { string } },
    refresh: Refresh,
    enabled: { [string]: unknown },
    colors: { [string]: unknown },
    getFormat: () -> ((string, ...unknown) -> string),
    applyObjects: (string, string, string, string, boolean, unknown) -> (),
    gameName: unknown,
    gameSpecific: unknown,
}
local makeBroadcast = (standaloneModules.createStateBroadcast :: unknown) :: (unknown) -> (unknown) -> ()
type Object = { name: string, id: string, class: string, global: boolean }
type Profile = { roles: { string }, objects: { Object }, roleColors: boolean }
local getProfile = (selectVisualProfile :: unknown) :: (unknown, unknown) -> Profile
local styles: { { unknown } } = {
    { "CHAM", "Cham", true, true },
    { "ESP", "ESP", true, true },
    { "OUTLINE", "Outline", true, false },
    { "HIGHLIGHT", "Highlight", true, false },
    { "TRACER", "Tracer", true, true },
    { "ESP BOX", "ESP Box", true, true },
    { "ESP CUBE", "ESP Cube", false, false },
    { "ESP AVATAR", "ESP Avatar", false, false },
    { "ESP FIRE", "ESP Fire", false, false },
}
return function(bindings: Bindings)
    local handlers: { [string]: unknown } = {}
    local enabled = bindings.enabled
    local refresh = bindings.refresh
    local listeners = bindings.listeners
    local getFormat = bindings.getFormat
    local applyObjects = bindings.applyObjects
    local profile = getProfile(bindings.gameName, bindings.gameSpecific)

    for _, style in styles do
        local section = style[1] :: string
        local name = style[2] :: string
        local showObjects = style[3]
        local showCoins = style[4]
        local selected: unknown = nil
        local allTitle = name .. " Everyone"
        handlers[section .. "/" .. allTitle] = makeBroadcast({ listeners = listeners, callbacks = refresh, target = enabled, key = name .. "Everyone" })

        for _, role in profile.roles do
            local title = name .. " " .. role .. " Only"
            handlers[section .. "/" .. title] = makeBroadcast({ listeners = listeners, callbacks = refresh, target = enabled, key = name .. role .. "Only" })
        end

        if showObjects then
            for _, object in profile.objects do
                local objectName = object.name

                if objectName == "Coins" and not showCoins then
                    continue
                end

                local title = name .. " " .. objectName
                local objectId, objectClass, global = object.id, object.class, object.global
                handlers[section .. "/" .. title] = function(value: unknown)
                    applyObjects(name, objectName, objectId, objectClass, global, value)
                end
            end
        end

        handlers[section .. "/Select Player"] = function(value: unknown)
            selected = value
        end
        local function changePlayer(value: unknown)
            local player = selected

            if not player then
                return
            end

            local update = refresh[player]

            if not update then
                return
            end

            local format = getFormat()
            local playerName = (player :: { Name: unknown }).Name
            enabled[format("%*Player%*Only", name, playerName)] = value
            update()
        end
        handlers[section .. "/Apply"] = function() changePlayer(true) end
        handlers[section .. "/Remove"] = function() changePlayer(nil) end
    end

    for _, role in profile.roles do
        handlers["CONFIGURATION/" .. role .. " Color"] = makeBroadcast({ listeners = listeners, callbacks = refresh, target = bindings.colors, key = role })
    end

    return handlers
end
end)()

local populateVisualsFeature = (function()

