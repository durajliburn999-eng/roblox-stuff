local selectEspObject = (function()
-- Record508 object selection. Original property-read order is intentional.
type Object = { Name: string, ClassName: string, Parent: Object }
type Context = {
    isBladeBall: boolean,
    isBloxFruits: boolean,
    objectName: string,
    className: string,
    workspace: unknown,
    coinColors: { [unknown]: unknown }?,
    color: unknown,
    displayTitle: unknown,
    title: unknown,
    getAttribute: (Object, string) -> unknown,
}

local function isChest(object: Object, workspace: unknown): boolean
    if object.ClassName ~= "Model" then
        return false
    end

    local parent = object.Parent

    if parent.Name ~= "ChestModels" then
        return false
    end

    return parent.Parent == workspace
end

local function isIsland(object: Object, workspace: unknown): boolean
    if object.ClassName ~= "Part" then
        return false
    end

    local parent = object.Parent

    if parent.Name ~= "Locations" then
        return false
    end

    parent = parent.Parent

    if (parent.Name :: unknown) ~= "_WorldOrigin" then
        return false
    end

    return parent.Parent == workspace
end

local function matches(context: Context, object: Object): boolean
    if context.isBladeBall and context.objectName == "%bladeball_ball%" then
        local getAttribute = context.getAttribute

        if getAttribute(object, "realBall") then
            return true
        end
    end

    if context.isBloxFruits then
        if context.objectName == "%bloxfruits_chest%" then
            return isChest(object, context.workspace)
        end

        if context.objectName == "%bloxfruits_islands%" then
            return isIsland(object, context.workspace)
        end

        return true
    end

    if object.Name ~= context.objectName then
        return false
    end

    return object.ClassName == context.className
end

return function(context: Context, object: Object): boolean
    if not matches(context, object) then
        return false
    end

    if context.objectName == "Coin_Server" and context.coinColors then
        local getAttribute = context.getAttribute
        local coinId = getAttribute(object, "CoinID")
        context.color = context.coinColors[coinId]
        context.displayTitle = coinId
        return true
    end

    context.displayTitle = context.title
    return true
end
end)()

