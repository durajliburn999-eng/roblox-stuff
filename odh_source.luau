    local swim = bindings.swim
    return {
        float = function(value: unknown)
            if not float.character.value then return end
            if value then
                local part = float.getCreate()("Part")
                part.Name = "ppfpfo"
                part.Parent = float.parent
                part.Transparency = 1
                part.Size = float.getVector()(2, 0.2, 1.5)
                part.Anchored = true
                part.CanCollide = true
                float.part.value = part
                float.connection.value = float.getConnect()(float.signal.value, float.callback)
                return
            end
            float.getDisconnect()(float.connection.value)
            float.remove(float.part.value)
        end,
        swim = function(value: unknown)
            local humanoid = swim.humanoid.value :: Humanoid?
            if not humanoid then return end
            for index = 1, #swim.states do
                humanoid:SetStateEnabled(swim.states[index], not value)
            end
            if value then
                swim.savedGravity.value = (swim.world.value :: Values).Gravity
                swim.deathConnection.value = swim.getConnect()(humanoid.Died, swim.cleanup)
                swim.otherConnection.value = swim.getConnect()(swim.signal.value, swim.onSignal)
                humanoid:ChangeState(swim.swimState)
                local world = swim.world.value :: Values
                world.Gravity = 0
                return
            end
            swim.cleanup()
        end,
    }
end
end)())

