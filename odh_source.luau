    local originalColor, originalSize
    local function prepareHitbox()
        originalColor = environment.Color3.fromRGB(250, 250, 250)
        originalSize = environment.Vector3.new(2, 1, 1)
        callbacks["HITBOX EXPANDER/Enable Hitbox Expander"] = makeHitbox({ originalColor = originalColor, originalSize = originalSize,
            settings = settings, wait = ownerUi.wait, findChild = ownerUi.playerMethods.findFirstChild,
            players = ownerUi.players, onStopped = coroutineApi.yield })
        local controls = makeControls({ settings = settings, getVector3 = function() return environment.Vector3.new end })
        callbacks["HITBOX EXPANDER/Hitbox Color"] = controls.hitboxColor
        callbacks["HITBOX EXPANDER/Hitbox Size"] = controls.hitboxSize
        callbacks["HITBOX EXPANDER/Hitbox Transparency (%)"] = controls.hitboxTransparency
    end
    local function prepareColor() colors["HITBOX EXPANDER/Hitbox Color"] = environment.Color3.fromRGB(250, 250, 250) end
    local state = makeState({ settings = settings, dispatch = coroutineApi.resume, transform = coroutineApi.create })
    local section = populate(tab, { callbacks = callbacks, colors = colors, options = { ["HITBOX EXPANDER/Hitbox Shape Type"] = materials },
        prepareHitbox = prepareHitbox, prepareHitboxColor = prepareColor }, state)
    return { section = section, callbacks = callbacks, originalColor = originalColor, originalSize = originalSize, colors = colors }
end
end)() :: unknown)

