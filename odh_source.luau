end)()

local planFarmMotion = (function()
type Vector = typeof(setmetatable({ Magnitude = 0, Unit = (nil :: unknown) :: unknown }, { __mul = function(left, _right) return left end }))

return function(displacement: Vector, speed: number): (string, Vector?)
    local distance = displacement.Magnitude

    if distance <= 0.5 then
        return "teleport", nil
    end

    local duration = distance / speed

    if 15 < duration then
        return "teleport", nil
    end

    local direction = displacement.Unit :: Vector
    return "move", direction * speed
end
end)()

local applyFarmMotionEffects = (function()
type Body = { Velocity: unknown }
