        write(tracer, "Name", name)
        write(tracer, "BorderSizePixel", 0)
        write(tracer, "AnchorPoint", bindings.anchor)
        write(tracer, "BackgroundColor3", context.color)
        write(tracer, "Parent", parent)
        bindings.tracers[context.object] = tracer
    end

    if not context.isEnabled then
        return
    end

    bindings.active[context.object] = true
    local spawn = bindings.getSpawn()
    local update = bindings.updateTracer
    spawn(update, tracer, context.object, context.title, context.className, context.isGlobal, context.key)
end

local function boxEdge(context: Context, folder: unknown, name: string): Object
    local bindings, write = context.bindings, context.write
    local edge = bindings.find(folder, name)

    if edge then
        return edge
    end

    local created = create(context, "Frame")
    write(created, "Name", name)
    write(created, "BackgroundColor3", context.color)
    write(created, "BorderSizePixel", 0)
    write(created, "AnchorPoint", bindings.anchor)
    write(created, "Parent", folder)
    return created
end

local function renderBox(context: Context)
    local bindings, write = context.bindings, context.write
    local parent = bindings.boxParent
    local name = context.title .. "_ESP_BOX"
    local folder: unknown = nil

    if context.isGlobal then
        folder = bindings.find(bindings.boxParent, name)
    end

    if not context.isGlobal then
        folder = bindings.boxes[context.object]
    end

    if not folder then
        folder = create(context, "Folder")
        write(folder, "Name", name)
        write(folder, "Parent", parent)
        bindings.boxes[context.object] = folder
    end

    local top = boxEdge(context, folder, "1")
    local right = boxEdge(context, folder, "2")
    local bottom = boxEdge(context, folder, "3")
    local left = boxEdge(context, folder, "4")

    if not context.isEnabled then
        return
    end

    local frame = bindings.getFrame()
    local size = objectSize(context) :: { X: number, Y: number }
    local x, y = size.X, size.Y
    bindings.active[context.object] = true
    local spawn = bindings.getSpawn()
    local first = frame(x, y, 0).Position
    local second = frame(-x, y, 0).Position
    local third = frame(x, -y, 0).Position
    local fourth = frame(-x, -y, 0).Position
    local update = bindings.updateBox
    spawn(update, folder, top, right, bottom, left, context.object,
        first, second, third, fourth, context.title, context.className, context.isGlobal, context.key)
end

local renderers = {
    Cham = renderCham,
