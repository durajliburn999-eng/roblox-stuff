local separator = '</font>, <font color="rgb(0, 255, 0)">'
local murderersText = '<font color="rgb(0, 255, 0)">%*</font> are the <font color="rgb(255, 0, 0)">Murderers</font>'
local murdererText = '<font color="rgb(0, 255, 0)">%*</font> is the <font color="rgb(255, 0, 0)">Murderer</font>'
local sheriffsText = '<font color="rgb(0, 255, 0)">%*</font> are the <font color="rgb(0, 0, 255)">Sheriffs</font>'
