local createUiToggle = (function()
type Title = { Text: unknown }
type Activator = { Placeholder: unknown, Activated: unknown }
type Toggle = { Title: Title, Activator: Activator, Parent: unknown }
type Owner = {
    toggle_prop_1: unknown, toggle_prop_2: unknown, toggle_prop_3: unknown,
    toggle_prop_4: unknown, toggle_prop_5: unknown,
    ToggleUIElements: { unknown }, Toggle_Settings: { [string]: unknown },
    SaveConfigs: () -> (), play: (unknown) -> (), TouchSFX: unknown,
    remove_rich_text: (string) -> string, Clone: (unknown) -> Toggle,
    SectionContainer: unknown, SearchSectionShared: { unknown }, WAGURI: { unknown },
}
type Bindings = {
    dispatch: (unknown, unknown) -> (),
    createTween: (unknown, unknown, unknown, unknown) -> unknown,
    tweenInfo: unknown,
    template: unknown,
    wait: { value: (number) -> () },
    connect: { value: (unknown, unknown) -> () },
}

return function(bindings: Bindings)
    local template = bindings.template
    local waitCell = bindings.wait
    local connectCell = bindings.connect

    return function(owner: Owner, title: string, callback: unknown, access: unknown): unknown
        local dispatch = bindings.dispatch
        local createTween = bindings.createTween
        local tweenInfo = bindings.tweenInfo
        local properties = owner.toggle_prop_1
        local elements = owner.ToggleUIElements
        local settings = owner.Toggle_Settings
        local save = owner.SaveConfigs
        local play = owner.play
        local sound = owner.TouchSFX
        local settingKey = owner.remove_rich_text(title)
        local index = #elements + 1
        local toggle = owner.Clone(template)
        local titleLabel = toggle.Title
        local activator = toggle.Activator
        local placeholder = activator.Placeholder
        toggle.Parent = owner.SectionContainer
        local search = owner.SearchSectionShared
        local searchIndex = #search + 1
        search[searchIndex] = toggle
        search[searchIndex + 1] = titleLabel
        search[searchIndex + 2] = 0

        local enableKnob = createTween(tweenInfo, placeholder, properties, owner.toggle_prop_2)
        local enableBackground = createTween(tweenInfo, activator, properties, owner.toggle_prop_3)
        local disableKnob = createTween(tweenInfo, placeholder, properties, owner.toggle_prop_4)
        local disableBackground = createTween(tweenInfo, activator, properties, owner.toggle_prop_5)
        local accessState = owner.WAGURI
        local allowed = true
        local handler: unknown = nil
        local active: unknown = nil
        elements[index] = activator
        elements[index + 1] = enableBackground
        elements[index + 2] = disableBackground

        if access == "Premium" then
            titleLabel.Text = title .. ' <font color="rgb(0, 0, 255)">(Premium)</font>'

            if not accessState[1] then
                handler = accessState[3]
                allowed = false
            end
        else
            if access == "Exclusive" then
                titleLabel.Text = title .. ' <font color="rgb(0, 255, 0)">(Exclusive)</font>'

                if not accessState[2] then
                    handler = accessState[4]
                    allowed = false
                end
            else
                titleLabel.Text = title
            end
        end

        if allowed then
            local wait = waitCell.value
            local busy: unknown = nil
            handler = function()
                if busy then
                    return
                end

                busy = true
                local previous = active
                local value = not previous
                play(sound)
                active = value

                if previous then
                    play(elements[index + 2])
                    play(disableKnob)
                else
                    play(elements[index + 1])
                    play(enableKnob)
                end

                elements[index + 3] = value
                settings[settingKey] = value
                save()
                dispatch(callback, value)
                wait(1.5)
                busy = false
            end
        end

        connectCell.value(activator.Activated, handler)

        if allowed and settings[settingKey] then
            active = true
            elements[index + 3] = true
            play(enableKnob)
            play(enableBackground)
            dispatch(callback, true)
            return handler
        end

        settings[settingKey] = false
        elements[index + 3] = false
        return handler
    end
end
end)()

local createUiTextBox = (function()
type Input = { Text: unknown, FocusLost: unknown }
type TextBox = { Title: { Text: unknown }, Input: Input, Parent: unknown }
type Owner = {
    TextBox_Settings: { [string]: unknown },
    SaveConfigs: () -> (),
    remove_rich_text: (string) -> string,
    Clone: (unknown) -> TextBox,
    SectionContainer: unknown,
    TextBoxUIElements: { unknown },
    SearchSectionShared: { unknown },
}
type Bindings = { template: unknown, connect: { value: (unknown, () -> ()) -> () } }

return function(bindings: Bindings)
    local template = bindings.template
    local connect = bindings.connect

    return function(owner: Owner, title: string, callback: (unknown) -> ())
        local settings = owner.TextBox_Settings
        local save = owner.SaveConfigs
        local key = owner.remove_rich_text(title)
        local textBox = owner.Clone(template)
        local titleLabel = textBox.Title
        local input = textBox.Input
        titleLabel.Text = title
        textBox.Parent = owner.SectionContainer
        connect.value(input.FocusLost, function()
            local text = input.Text
            settings[key] = text
            save()
            callback(text)
        end)
        local elements = owner.TextBoxUIElements
        elements[#elements + 1] = input
        local search = owner.SearchSectionShared
        local index = #search + 1
        search[index] = textBox
        search[index + 1] = titleLabel
        search[index + 2] = 0
        local saved = settings[key]

        if saved and saved ~= "" then
            input.Text = saved
            callback(saved)
            return
        end

        settings[key] = ""
    end
end
end)()

