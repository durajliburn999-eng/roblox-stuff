        local waitFrame = bindings.getWaitFrame()
        local activationState = bindings.activationState
        local resetState = bindings.resetState
        local getState = bindings.getState()
        local dot = bindings.getDot()
        local zeroVelocity = bindings.zeroVelocity
        local isApplied: boolean? = nil
        local previousState: unknown = nil

        while settings.AutoSpeedGlitch do
            waitFrame()
            local humanoid = bindings.getHumanoid()

            if not humanoid then
                continue
            end

            local root = bindings.getRoot()

            if not root then
                continue
            end

            local direction = humanoid.MoveDirection

            if direction.Magnitude <= 0.15 then
                if isApplied or previousState == activationState or previousState == resetState then
                    root.AssemblyLinearVelocity = zeroVelocity
                    previousState = nil
                    isApplied = nil
                end

                continue
