    local callbacks: Values = {}
    local additional = {
        { "Buy Legendary Sword", "LegendarySwordDealer", "3" },
        { "Buy Gear", "UpgradeRace", "Buy" },
        { "Buy Haki Color", "ColorsDealer", "1" },
        { "Craft Common Scroll", "CraftItem", "Craft", "CommonScroll" },
        { "Craft Rare Scroll", "CraftItem", "Craft", "RareScroll" },
        { "Craft Legendary Scroll", "CraftItem", "Craft", "LegendaryScroll" },
