standaloneModules.createCoinAura = ((function()
-- Prototype 3:1044. Reservations prevent overlapping workers moving one coin.
type Vector = typeof(setmetatable({ X = 0, Y = 0, Z = 0 }, {} :: { __sub: (Vector, Vector) -> Vector }))
type Coin = { Name: string, Parent: unknown, CFrame: unknown, Position: Vector }
type Root = { Position: Vector, CFrame: unknown }
type Settings = { CoinAura: unknown, CoinContainer: unknown }
type Bindings = {
    settings: Settings,
    getAttribute: (Coin, string) -> unknown,
    getChildren: (unknown) -> { Coin },
    isStopped: (() -> boolean)?,
    waitForTick: () -> ((number) -> ()),
    dot: () -> ((Vector, Vector) -> number),
    idle: () -> (() -> ()),
    root: () -> Root?,
}

local movingCoins = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [Coin]: boolean? }

return function(bindings: Bindings)
    local settings = bindings.settings
    local getAttribute = bindings.getAttribute
    local getChildren = bindings.getChildren
    local isStopped = bindings.isStopped

    local function stopped()
        return isStopped and isStopped()
    end

    local function moveAndRestore(coin: Coin, frame: unknown, waitForTick: (number) -> ())
        if movingCoins[coin] then
            return
        end

        local originalFrame = coin.CFrame
        movingCoins[coin] = true
        local ok, raised = pcall(function()
            coin.CFrame = frame
            waitForTick(0.1)
        end)
        local restored, restoreRaised = pcall(function()
            if coin.Parent then
                coin.CFrame = originalFrame
            end
        end)
        movingCoins[coin] = nil

        if not ok then
            error(raised, 0)
        end

        if not restored then
            error(restoreRaised, 0)
        end
    end

    return function()
        local waitForTick = bindings.waitForTick()
        local dot = bindings.dot()
        local idle = bindings.idle()

        while not stopped() do
            if not settings.CoinAura then
                idle()
                continue
            end

            waitForTick(0.05)

            if stopped() then
                return
            end

            if not settings.CoinAura then
                continue
            end

            local root = bindings.root()
            local container = settings.CoinContainer

            if not root or not container then
                continue
            end

            local position, frame = root.Position, root.CFrame

            for _, coin in getChildren(container) do
                if stopped() then
                    return
                end

                if not settings.CoinAura or bindings.root() ~= root then
                    break
                end

                if settings.CoinContainer ~= container then
                    break
                end

                if coin.Name ~= "Coin_Server" or coin.Parent ~= container then
                    continue
                end

                if getAttribute(coin, "Collected") then
                    continue
                end

                local difference = coin.Position - position

                if dot(difference, difference) > 25 then
                    continue
                end

                moveAndRestore(coin, frame, waitForTick)
            end
        end
    end
end
end)())

standaloneModules.createAutoSlash = ((function()
type Vector = typeof(setmetatable({}, { __sub = function(left, _right) return left end }))
type Root = { Position: Vector }
type Player = { Character: unknown }
type Cell = { value: unknown }
type Bindings = {
    settings: { AutoSlash: unknown },
    wait: () -> (),
    players: { Player? },
    findChild: (unknown, string) -> Root?,
    attack: () -> (),
    dot: (Vector, Vector) -> number,
    disabled: unknown,
    busy: Cell,
    blocked: Cell,
    cancelled: Cell,
    ready: Cell,
    root: Cell,
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local findChild = bindings.findChild
    local attack = bindings.attack
    local disabled = bindings.disabled
    local busy = bindings.busy
    local blocked = bindings.blocked
    local cancelled = bindings.cancelled
    local ready = bindings.ready
    local rootCell = bindings.root

    return function()
        local wait = bindings.wait
        local players = bindings.players
        local dot = bindings.dot

        if disabled then
            return
        end

        while true do
            wait()

            if busy.value then
                continue
            end

            if blocked.value then
                continue
            end

            if cancelled.value then
                continue
            end

            if not ready.value or settings.AutoSlash then
                continue
            end

            local root = rootCell.value :: Root?

            if not root then
                continue
            end

            local position = root.Position
            local lastPlayer = #players

            for index = 2, lastPlayer do
                local player = players[index]

                if not player or cancelled.value then
                    continue
                end

                local character = player.Character

                if not character then
                    continue
                end

                local target = findChild(character, "HumanoidRootPart")

                if not target then
                    continue
                end

                local distance = target.Position - position

                if dot(distance, distance) > 49 or cancelled.value then
                    continue
                end

                attack()
            end
        end
    end
end
end)())

standaloneModules.createKnifeAura = ((function()
type Vector = typeof(setmetatable({}, { __sub = function(left, _right) return left end }))
type Root = { Position: Vector }
type Player = { Character: unknown }
type Cell = { value: unknown }
type Settings = { KnifeAura: unknown, MapMode: unknown, RoundTime: number, KnifeRange: number }
type Bindings = {
    settings: Settings,
    wait: (number) -> (),
    isMode: (unknown, unknown) -> unknown,
    modeOwner: unknown,
    mode: unknown,
    players: { Player? },
    findChild: (unknown, string) -> Root?,
    attack: (Player) -> (),
    dot: (Vector, Vector) -> number,
    onStopped: () -> (),
    root: Cell,
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local isMode = bindings.isMode
    local modeOwner = bindings.modeOwner
    local mode = bindings.mode
    local findChild = bindings.findChild
    local attack = bindings.attack
    local rootCell = bindings.root

    return function()
        local wait = bindings.wait
        local players = bindings.players
        local dot = bindings.dot
        local onStopped = bindings.onStopped

        while true do
            while settings.KnifeAura do
                wait(0.5)

                if isMode(modeOwner, mode) then
                    if settings.RoundTime < 1 then
                        continue
                    end
                else
                    if settings.MapMode ~= "Assassin" then
                        continue
                    end

                    if settings.RoundTime < 1 then
                        continue
                    end
                end

                local root = rootCell.value :: Root?

                if not root then
                    continue
                end

                local range = settings.KnifeRange
                local position = root.Position
                local rangeSquared = range * range
                local lastPlayer = #players

                for index = 2, lastPlayer do
                    local player = players[index]

                    if not player or not player.Character then
                        continue
                    end

                    local target = findChild(player.Character, "HumanoidRootPart")

                    if not target then
                        continue
                    end

                    local distance = target.Position - position

                    if dot(distance, distance) > rangeSquared then
                        continue
                    end

                    attack(player)
                end
            end

            onStopped()
        end
    end
end
end)())

