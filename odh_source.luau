    for name, callback in raidCallbacks do callbacks[name] = callback end
    raid:AddToggle("Auto Buy Selected Raid Chip", state(2, "AutoBuySelectedRaid", callbacks["Auto Buy Selected Raid Chip"]))
    raid:AddButton("Start Raid", callbacks["Start Raid"])
