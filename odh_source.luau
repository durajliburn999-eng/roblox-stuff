    local find = bindings.findChild
    local character = bindings.getCharacter()
    local hand = find(character, "RightHand") :: { Position: Vector }?

    if not hand then
        return nil
    end

    local root = bindings.getRoot()

    if not root then
        return nil
    end

    local origin = hand.Position
    local destination = target.Position
    local difference = destination - origin
    local unit = difference.Unit :: Vector
    local length = difference.Magnitude * 1.05
    local direction = unit * length
    local raycast = bindings.raycast
    local hit = raycast(origin, direction)

    if not hit or not hit.Instance then
        return nil
    end

    local position = hit.Position
    local rootPosition = root.Position
    return offsetOrigin(state, position, rootPosition)
end

return function(state: State, target: Frame?)
    local bindings = state.bindings

    if not target then
        target = manualTarget(state)
    end

    local position = nil

    if state.settings.InstantThrow then
        position = instantOrigin(state, target :: Frame)
    end

    local remote = bindings.getRemote()
    local origin: Frame? = nil

    if position then
        origin = state.makeFrame(position)
    end

    if not position then
        origin = bindings.getKnife().CFrame
    end

    local fire = bindings.fire
    fire(remote, origin :: Frame, target :: Frame)
    local previousAnimation = bindings.getPreviousAnimation()
    local wait = bindings.getWait()
    local stop = previousAnimation.Stop
    stop(previousAnimation)

    if state.playAnimation then
        local animation = bindings.getAnimation()
        local play = animation.Play
        play(animation)

        if state.settings.FastThrow then
            wait(0.5)
        end
    end

    wait(1)
end
end)()

