local waitingCursor = "rbxasset://textures\\GunWaitCursor.png"

return function(bindings: Values)
    local current, state = bindings.current, bindings.state

    local function activate()
        if not current.ready then return end
        local mouse, track = bindings.mouse, current.track
        state.FireFlyDebounce = nil
        mouse.Icon = waitingCursor
        current.ready = nil
        bindings.fire(current.remote, "Button1Down")
