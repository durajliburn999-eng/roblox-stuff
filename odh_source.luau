local createCompactWindow = (function()
-- Compact window creation and transitions.
type Bindings = {
    getBusy: () -> unknown,
    setBusy: (unknown) -> (),
    getPanel: () -> unknown,
    setPanel: (unknown) -> (),
    getOpen: () -> unknown,
    setOpen: (boolean) -> (),
    toggleButton: unknown,
    getCreate: () -> ((string) -> unknown),
    backgroundColor: unknown,
    parent: unknown,
    anchor: unknown,
    position: unknown,
    image: unknown,
    cornerRadius: unknown,
    createTween: (unknown, unknown, unknown, unknown) -> unknown,
    tweenService: unknown,
    tweenInfo: unknown,
    openingProperties: unknown,
    getOpeningTween: () -> unknown,
    setOpeningTween: (unknown) -> (),
    closingProperties: unknown,
    getClosingTween: () -> unknown,
    setClosingTween: (unknown) -> (),
    installInteractions: (unknown, unknown, unknown, unknown, unknown) -> (),
    hoverProperties: unknown,
    playTween: (unknown) -> (),
    input: unknown,
    initialize: (unknown) -> (),
    wait: (number) -> (),
    write: (unknown, string, unknown) -> (),
}

return function(bindings: Bindings)
    local toggleButton = bindings.toggleButton
    local backgroundColor = bindings.backgroundColor
    local parent = bindings.parent
    local anchor = bindings.anchor
    local position = bindings.position
    local image = bindings.image
    local cornerRadius = bindings.cornerRadius
    local createTween = bindings.createTween
    local tweenService = bindings.tweenService
    local tweenInfo = bindings.tweenInfo
    local openingProperties = bindings.openingProperties
    local closingProperties = bindings.closingProperties
    local installInteractions = bindings.installInteractions
    local hoverProperties = bindings.hoverProperties
    local playTween = bindings.playTween
    local input = bindings.input
    local initialize = bindings.initialize
    local wait = bindings.wait
    local write = bindings.write

    return function()
        if bindings.getBusy() then
            return
        end

        bindings.setBusy(true)
        local panel = bindings.getPanel()
        local wasOpen = bindings.getOpen()
        bindings.setOpen(not wasOpen)

        if wasOpen then
            write(toggleButton, "BackgroundTransparency", 0.999)
            local closingTween = bindings.getClosingTween()

            if closingTween then
                playTween(closingTween)
            end

            wait(0.5)
            write(panel, "Visible", false)
            bindings.setBusy(nil)
            return
        end

        write(toggleButton, "BackgroundTransparency", 0)

        if not panel then
            local createInstance = bindings.getCreate()
            local newPanel, corner = createInstance("ImageButton"), createInstance("UICorner")
            write(newPanel, "Name", "eXuB")
            write(newPanel, "Parent", parent)
            write(newPanel, "ClipsDescendants", true)
            write(newPanel, "BackgroundTransparency", 0.9)
            write(newPanel, "BackgroundColor3", backgroundColor)
            write(newPanel, "AnchorPoint", anchor)
            write(newPanel, "Position", position)
            write(newPanel, "Image", image)
            write(newPanel, "Active", true)
            write(newPanel, "Visible", false)
            write(corner, "Name", "Corner")
            write(corner, "Parent", newPanel)
            write(corner, "CornerRadius", cornerRadius)
            local openingTween = createTween(tweenService, newPanel, tweenInfo, openingProperties)
            bindings.setOpeningTween(openingTween)
            local closingTween = createTween(tweenService, newPanel, tweenInfo, closingProperties)
            bindings.setClosingTween(closingTween)
            installInteractions(newPanel, openingTween, createTween(tweenService, newPanel, tweenInfo, hoverProperties), playTween, input)
            initialize(newPanel)
            bindings.setPanel(newPanel)
            panel = newPanel
        end

        write(panel, "Visible", true)
        local openingTween = bindings.getOpeningTween()

        if openingTween then
            playTween(openingTween)
        end

        wait(0.5)
        bindings.setBusy(nil)
    end
end
end)()

local createEarningsDisplay = (function()
-- Record2245: local elapsed-time and earnings display.
type Settings = { [string]: number | boolean | nil }
type Paragraph = { SetValue: (Paragraph, string) -> () }
type Bindings = {
    settings: Settings,
    wait: () -> (),
    paragraph: Paragraph,
    format: (string, ...unknown) -> string,
    clock: () -> number,
    currencies: { string },
}

local emptyStatus = '<b>Elapsed</b>:\n\tDay(s): <font color="rgb(0, 255, 0)">0</font>\n\tHour(s): <font color="rgb(0, 255, 0)">0</font>\n\tMinute(s): <font color="rgb(0, 255, 0)">0</font>\n\tSecond(s): <font color="rgb(0, 255, 0)">0</font>\n<b>Earned</b>:\n\t<b><u>No Data.</u></b>'
local statusFormat = '<b>Elapsed</b>:\n\tDay(s): <font color="rgb(0, 255, 0)">%*</font>\n\tHour(s): <font color="rgb(0, 255, 0)">%*</font>\n\tMinute(s): <font color="rgb(0, 255, 0)">%*</font>\n\tSecond(s): <font color="rgb(0, 255, 0)">%*</font>\n<b>Earned</b>:%*'
local earningsFormat = '\n\t%*(s): <font color="rgb(0, 255, 0)">%*</font> l <font color="rgb(0, 255, 0)">%*</font> Per Hour'

return function(bindings: Bindings)
    return function()
        local settings = bindings.settings
        local wait = bindings.wait
        local paragraph = bindings.paragraph
        local format = bindings.format
        local clock = bindings.clock
        local currencies = bindings.currencies
        local started = clock()
        local setValue = paragraph.SetValue
        local previousStart = settings.AutoFarmStarttick

        if previousStart then
            started = previousStart :: number
        end

        if not previousStart then
            settings.AutoFarmStarttick = started
        end

        while settings.AutoFarm do
            local elapsed = clock() - started
            local days = elapsed // 86400
            local hours = (elapsed % 86400) // 3600
            local minutes = (elapsed % 3600) // 60
            local seconds = elapsed % 60
            local earned = ""

            for index = 1, 6 do
                local name = currencies[index]
                local amount = settings["Earned" .. name] or 0

                if amount ~= 0 then
                    local elapsedHours = days * 24 + hours + minutes / 60 + seconds / 3600
                    local perHour = (amount :: number) // elapsedHours
                    earned ..= format(earningsFormat, name, amount, perHour)
                end
            end

            if earned == "" then
                earned = "\n\t<b><u>No Data.</u></b>"
            end

            local text = format(statusFormat, days, hours, minutes, seconds // 1, earned)
            setValue(bindings.paragraph, text)
            wait()
        end

        setValue(bindings.paragraph, emptyStatus)
        settings.AutoFarmStarttick = nil
    end
end
end)()

