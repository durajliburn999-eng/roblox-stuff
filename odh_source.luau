local createUiSlider = (function()
type ValueLabel = { Text: unknown, FocusLost: unknown }
type Knob = { InputBegan: unknown }
type Filler = { Knob: Knob }
type Placeholder = { Filler: Filler }
type SliderNode = { Title: { Text: unknown }, Value: ValueLabel, Placeholder: Placeholder, Parent: unknown }
type Slider = { Filler: Filler, Value: ValueLabel, Min: number, Max: number, Callback: unknown, feature_name: string, SetValue: (Slider, unknown) -> () }
type DragOwner = { GuiCanDrag: unknown, _dragCore: unknown, _dragCoreProperties: unknown }
type Owner = {
    slider_prop_1: unknown, slider_prop_2: unknown, slider_prop_3: unknown,
    Slider_Settings: { [string]: unknown }, play: (unknown) -> (),
    remove_rich_text: (string) -> string, Clone: (unknown) -> SliderNode,
    SectionContainer: unknown, slider_api: unknown, _self: DragOwner,
    setmetatable: (unknown, unknown) -> Slider,
    SliderFillUIElements: { unknown }, SliderPlaceholderUIElements: { unknown },
    SliderKnobUIElements: { unknown }, SliderInputUIElements: { unknown },
    SearchSectionShared: { unknown },
}
type InputTypes = { Touch: unknown, MouseButton1: unknown }
type Bindings = {
    connect: (unknown, unknown) -> (),
    inputTypes: InputTypes,
    createTween: (unknown, unknown, unknown, unknown) -> unknown,
    tweenInfo: unknown,
    wait: (number, number) -> (),
    template: unknown,
}

return function(bindings: Bindings)
    local template = bindings.template

    return function(owner: Owner, title: string, minimum: number, maximum: number, default: number, callback: unknown): Slider
        local connect = bindings.connect
        local inputTypes = bindings.inputTypes
        local createTween = bindings.createTween
        local tweenInfo = bindings.tweenInfo
        local properties = owner.slider_prop_1
        local settings = owner.Slider_Settings
        local play = owner.play
        local featureName = owner.remove_rich_text(title)
        bindings.wait(0, 2.5)
        local value = if minimum > default then minimum else if maximum < default then maximum else default
        local node = owner.Clone(template)
        local titleLabel = node.Title
        local valueLabel = node.Value
        local placeholder = node.Placeholder
        local filler = placeholder.Filler
        local knob = filler.Knob
        titleLabel.Text = title
        valueLabel.Text = value
        node.Parent = owner.SectionContainer
        local slider = owner.setmetatable({
            Filler = filler, Value = valueLabel, Min = minimum, Max = maximum,
            Callback = callback, feature_name = featureName,
        }, owner.slider_api)
        local setValue = slider.SetValue
        connect(valueLabel.FocusLost, function()
            setValue(slider, valueLabel.Text)
        end)
        local fillers = owner.SliderFillUIElements
        fillers[#fillers + 1] = filler
        local placeholders = owner.SliderPlaceholderUIElements
        placeholders[#placeholders + 1] = placeholder
        local knobs = owner.SliderKnobUIElements
        knobs[#knobs + 1] = knob
        local inputs = owner.SliderInputUIElements
        inputs[#inputs + 1] = valueLabel
        local search = owner.SearchSectionShared
        local index = #search + 1
        search[index] = node
        search[index + 1] = titleLabel
        search[index + 2] = 0
        local startTween = createTween(tweenInfo, knob, properties, owner.slider_prop_2)
        local dragProperties: { unknown } = { placeholder, minimum, maximum, filler, valueLabel, callback, featureName,
            createTween(tweenInfo, knob, properties, owner.slider_prop_3) }
        local dragOwner = owner._self
        connect(knob.InputBegan, function(input: { UserInputType: unknown })
            if not dragOwner.GuiCanDrag then
                return
            end

            local inputType = input.UserInputType

            if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then
                return
            end

            dragOwner._dragCore = 0
            dragOwner._dragCoreProperties = dragProperties
            dragOwner.GuiCanDrag = nil
            play(startTween)
        end)
        local saved = settings[featureName]

        if saved then
            setValue(slider, saved)
            return slider
        end

        setValue(slider, value)
        return slider
    end
end
end)()

local createUiDropdowns = (function()
type DropdownNode = {
    Title: { Text: unknown }, Value: unknown, Icon: unknown, Content: unknown,
    Parent: unknown, Activated: unknown,
}
type Dropdown = {
    Content: unknown, Selected: unknown, Items: { unknown }, Callback: unknown,
    animation3: unknown, animation4: unknown, feature_name: string?, IsPlayers: boolean?,
    active: unknown, ChangeItems: (Dropdown, unknown) -> (), Select: (Dropdown, unknown) -> (),
}
type Owner = {
    createInstance: unknown, toggle_prop_1: unknown, Dropdown_Settings: { [string]: unknown },
    play: (unknown) -> (), TouchSFX: unknown, remove_rich_text: (string) -> string,
    Clone: (unknown) -> DropdownNode, SectionContainer: unknown,
    colorpicker_prop_1: unknown, colorpicker_prop_3: unknown,
    dropdown_prop_1: unknown, dropdown_prop_2: unknown, dropdown_api: unknown,
    setmetatable: (unknown, unknown) -> Dropdown, DropdownUIElements: { unknown },
    SearchSectionShared: { unknown }, PlayerDropdowns: { unknown },
}
type Bindings = {
    createTween: (unknown, unknown, unknown, unknown) -> unknown,
    tweenInfo: unknown, template: unknown,
    connect: { value: (unknown, () -> ()) -> () },
    players: { value: unknown },
}

return function(bindings: Bindings)
    local template = bindings.template
    local connect = bindings.connect
    local players = bindings.players

    local function setup(owner: Owner, title: string, callback: unknown, playerMode: boolean): (Dropdown, string?, { [string]: unknown }?)
        local createTween = bindings.createTween
        local tweenInfo = bindings.tweenInfo
        local _createInstance = owner.createInstance
        local properties = owner.toggle_prop_1
        local settings = if playerMode then nil else owner.Dropdown_Settings
        local play = owner.play
        local sound = owner.TouchSFX
        local featureName = if playerMode then nil else owner.remove_rich_text(title)
        local node = owner.Clone(template)
        local titleLabel = node.Title
        local selectedLabel = node.Value
        local icon = node.Icon
        local content = node.Content
        titleLabel.Text = title
        node.Parent = owner.SectionContainer
        local openIcon = createTween(tweenInfo, icon, properties, owner.colorpicker_prop_1)
        local openContent = createTween(tweenInfo, content, properties, owner.dropdown_prop_1)
        local closeIcon = createTween(tweenInfo, icon, properties, owner.colorpicker_prop_3)
        local closeContent = createTween(tweenInfo, content, properties, owner.dropdown_prop_2)
        local fields = {
            Content = content, Selected = selectedLabel, Items = {}, Callback = callback,
            animation3 = closeIcon, animation4 = closeContent,
            feature_name = featureName, IsPlayers = if playerMode then true else nil,
        }
        local dropdown = owner.setmetatable(fields, owner.dropdown_api)
        connect.value(node.Activated, function()
            local active = dropdown.active
            local nextActive = not active
            play(sound)
            dropdown.active = nextActive

            if not active then
                play(openIcon)
                play(openContent)
                return
            end

            play(closeIcon)
            play(closeContent)
        end)
        local elements = owner.DropdownUIElements
        elements[#elements + 1] = node
        local search = owner.SearchSectionShared
        local index = #search + 1
        search[index] = node
        search[index + 1] = titleLabel
        search[index + 2] = 0
        return dropdown, featureName, settings
    end

    return {
        normal = function(owner: Owner, title: string, options: { unknown }, callback: unknown): Dropdown
            local dropdown, featureName, optionalSettings = setup(owner, title, callback, false)
            local settings = optionalSettings :: { [string]: unknown }
            local key = featureName :: string
            dropdown:ChangeItems(options)
            local saved = settings[key]

            if saved then
                dropdown:Select(options[saved :: number])
                return dropdown
            end

            settings[key] = 1
            dropdown:Select(options[1])
            return dropdown
        end,
        players = function(owner: Owner, title: string, callback: unknown): Dropdown
            local dropdown = setup(owner, title, callback, true)
            local dropdowns = owner.PlayerDropdowns
            dropdown:ChangeItems(players.value)
            dropdowns[#dropdowns + 1] = dropdown
            return dropdown
        end,
    }
end
end)()

local createDropdownApi = (function()
type Item = { TextColor3: unknown, Name: unknown, BackgroundTransparency: unknown, Size: unknown, Font: unknown, Text: unknown, TextSize: unknown, RichText: unknown, Parent: unknown, Activated: unknown }
type Dropdown = {
    Items: { [string]: { unknown } }, LastItem: Item?, Selected: { Text: unknown }, SelectedItem: unknown,
    Dropdown_Settings: { [string]: unknown }, feature_name: string, SaveConfigs: () -> (), Callback: (unknown) -> (),
    Content: unknown, animation3: unknown, animation4: unknown, IsPlayers: unknown, active: unknown,
}
type Bindings = {
    normalColor: unknown, selectedColor: unknown,
    destroy: (unknown) -> (), createInstance: (string) -> Item, font: unknown,
    connect: (unknown, () -> ()) -> (), play: (unknown) -> (), touchSound: unknown,
    makeSize: (number, number, number, number) -> unknown,
}

return function(bindings: Bindings)
    local normalColor = bindings.normalColor
    local selectedColor = bindings.selectedColor
    local destroy = bindings.destroy
    local play = bindings.play
    local sound = bindings.touchSound

    local function select(dropdown: Dropdown, value: string)
        local entry = dropdown.Items[value]

        if not entry then
            return
        end

        local item = entry[1] :: Item
        local last = dropdown.LastItem

        if last then
            last.TextColor3 = normalColor
        end

        item.TextColor3 = selectedColor
        dropdown.Selected.Text = value
        dropdown.SelectedItem = value
        dropdown.Dropdown_Settings[dropdown.feature_name] = entry[2]
        dropdown.LastItem = item
        dropdown.SaveConfigs()
        dropdown.Callback(value)
    end

    local function changeItems(dropdown: Dropdown, options: { unknown })
        local createInstance = bindings.createInstance
        local font = bindings.font
        local connect = bindings.connect
        local settings = dropdown.Dropdown_Settings
        local save = dropdown.SaveConfigs
        local items = dropdown.Items
        local content = dropdown.Content
        local callback = dropdown.Callback
        local selected = dropdown.SelectedItem
        local selectedLabel = dropdown.Selected
        local closeIcon = dropdown.animation3
        local closeContent = dropdown.animation4
        local isPlayers = dropdown.IsPlayers
        local featureName = dropdown.feature_name

        for key, entry in items do
            destroy(entry[1])
            items[key] = nil
        end

        for index = 1, #options do
            local option = options[index]
            local item = createInstance("TextButton")
            local player: unknown = nil
            local text = option

            if isPlayers then
                player = option
                text = (option :: { Name: unknown }).Name
            end

            item.Name = "\t"
            item.BackgroundTransparency = 1
            item.Size = bindings.makeSize(0.85, 0, 0, 20)
            item.Font = font
            item.Text = text
            item.TextSize = 14
            item.RichText = true

            if selected == text then
                item.TextColor3 = selectedColor
                dropdown.LastItem = item
            else
                item.TextColor3 = normalColor
            end

            item.Parent = content
            connect(item.Activated, function()
                play(sound)
                selectedLabel.Text = text
                local last = dropdown.LastItem

                if last then
                    last.TextColor3 = normalColor
                end

                item.TextColor3 = selectedColor
                dropdown.LastItem = item
                dropdown.SelectedItem = text
                dropdown.active = nil
                play(closeIcon)
                play(closeContent)

                if isPlayers then
                    callback(player)
                    return
                end

                settings[featureName] = index
                save()
                callback(text)
            end)
            items[text :: string] = { item, index, featureName }
        end
    end

    return { select = select, changeItems = changeItems }
end
end)()

local filterFarmCoin = (function()
type Coin = { Name: unknown }
type Settings = { [string]: unknown, CoinType: string, RareEggTopPriority: unknown }
type Bindings = {
    settings: Settings,
    find: (Coin, string) -> unknown,
}

return function(bindings: Bindings, coin: Coin, selectedType: string?): (string?, string?)
    if coin.Name ~= "Coin_Server" then
        return nil, nil
    end

    if bindings.find(coin, "Collected") then
        return nil, nil
    end

    local coinId = bindings.find(coin, "CoinID") :: string
    local settings = bindings.settings
    local selected = selectedType or settings.CoinType
    local matches = coinId == selected

    if selected == "Coin and Egg" then
        matches = matches or coinId == "Coin" or coinId == "Egg"
    end

    if selected == "Coin and BeachBall" then
        matches = matches or coinId == "Coin" or coinId == "BeachBall"
    end

    if matches and not settings[coinId .. "Full"] then
        return "normal", coinId
    end

    if coinId == "RareEgg" and settings.RareEggTopPriority then
        return "priority", coinId
    end

    return nil, nil
end
end)()

local evaluateFarmGate = (function()
type Settings = { [string]: unknown, AutoFarm: unknown, CoinType: string, RoundTime: unknown }

return function(settings: Settings): (string, unknown)
    if not settings.AutoFarm then
        return "stop", nil
    end

    if settings[settings.CoinType .. "Full"] then
        return "full", nil
    end

    local remaining = settings.RoundTime

    if type(remaining) ~= "number" or not (0 < remaining) then
        return "round", remaining
    end

    return "ready", remaining
end
end)()

local evaluateRunningFarmGate = (function()
type Settings = { [string]: unknown, CoinType: string, RoundTime: unknown }

return function(settings: Settings): (string, unknown, string)
    local coinType = settings.CoinType

    if settings[coinType .. "Full"] then
        return "full", nil, coinType
    end

    local remaining = settings.RoundTime

    if type(remaining) ~= "number" or not (0 < remaining) then
        return "round", remaining, coinType
    end

    return "ready", remaining, coinType
end
end)()

