local runFarmKillLoop = (function()
type Player = { Character: unknown }
type Bindings = {
    players: { Player? },
    action: unknown,
    start: (unknown, Player) -> (),
    wait: (number) -> (),
}

return function(bindings: Bindings)
    local players = bindings.players
    local action = bindings.action
    local start = bindings.start
    local wait = bindings.wait

    for _ = 1, 2 do
        local started = false

        for index = 2, #players do
            local player = players[index]

            if player and player.Character then
                start(action, player)
                started = true
            end
        end

        if started then
            wait(0.5)
        end
    end
