local applyFarmRoleReset = (function()
type Settings = {
    AutoResetAsMurderer: unknown,
    AutoResetAsSheriff: unknown,
    AutoResetAsInnocent: unknown,
}
type Humanoid = { Health: number }

return function(settings: Settings, player: unknown, murderers: { unknown }, sheriffs: { unknown }, humanoid: Humanoid): string
    local murderer = murderers[1]
    local sheriff = sheriffs[1]

    if settings.AutoResetAsMurderer and murderer == player then
        humanoid.Health = 0
        return "wait"
    end

    if settings.AutoResetAsSheriff and sheriff == player then
        humanoid.Health = 0
        return "wait"
    end

    if settings.AutoResetAsInnocent and murderer ~= player and sheriff ~= player then
        humanoid.Health = 0
        return "wait"
    end

    return "continue"
end
end)()

local runFarmShootLoop = (function()
type Settings = { ShootMurderer_THREAD: unknown, AutoShootMurdererAsSheriff: unknown, AutoFarm: unknown, RoundTime: number }
type Bindings = {
    settings: Settings,
    target: { Character: unknown },
    character: { value: unknown },
    start: (unknown) -> (),
    wait: (number) -> (),
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local target = bindings.target
    local character = bindings.character
    local start = bindings.start
    local wait = bindings.wait

    repeat
        start(settings.ShootMurderer_THREAD)
        wait(3)
    until not target.Character
        or not settings.AutoShootMurdererAsSheriff
        or not settings.AutoFarm
        or not character.value
        or settings.RoundTime < 1
end
end)()

