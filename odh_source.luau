standaloneModules.createSettingsLoad = ((function()
type Values = { [unknown]: unknown }
type Cell = { value: unknown }
type Bindings = {
    isEmpty: Cell, presets: Values, selectedPreset: Cell,
    getClock: () -> (() -> number), lastLoad: { value: number },
    getNotify: () -> ((string, number) -> ()), getFormat: () -> ((string, ...unknown) -> string),
    getType: () -> ((unknown) -> string), apply: (unknown, string) -> (),
    primary: Values, secondary: Values, secondaryVariant: Values, surface: Values,
}

return function(bindings: Bindings)
    return function()
        if bindings.isEmpty.value then return end
        local preset = bindings.presets[bindings.selectedPreset.value] :: Values?
        if not preset then return end

        local now = bindings.getClock()()
        local elapsed = now - bindings.lastLoad.value
        if elapsed < 5 then
            bindings.getNotify()(bindings.getFormat()('Slow down! Try again in <font color="rgb(0, 0, 255)">%.2f</font>', 5 - elapsed), 2)
            return
        end
        bindings.lastLoad.value = now
        local getType = bindings.getType()
        local groups: { { unknown } } = {
            { "Primary", bindings.primary, '<font color="rgb(0, 0, 255)">%s</font> is not a valid primary element.' },
            { "Secondary", bindings.secondary, '<font color="rgb(0, 0, 255)">%s</font> is not a valid secondary element.' },
            { "Secondary Variant", bindings.secondaryVariant, '<font color="rgb(0, 0, 255)">%s</font> is not a valid secondary variant element.' },
            { "Surface", bindings.surface, '<font color="rgb(0, 0, 255)">%s</font> is not a valid surface element.' },
        }
        for index, group in groups do
            local colors = preset[group[1]]
            if not colors or getType(colors) ~= "table" then continue end
            for key, value in colors :: Values do
                local element = (group[2] :: Values)[key]
                if not element then
                    bindings.getNotify()(bindings.getFormat()(group[3] :: string, key), 2)
                    return
                end
                if getType(value) ~= "string" then
                    local argument = if index == 1 then 10 - elapsed else key
                    bindings.getNotify()(bindings.getFormat()('<font color="rgb(0, 0, 255)">%s</font> must be a string.', argument), 2)
                    return
                end
                bindings.apply(element, value :: string)
            end
        end
    end
end
end)())

