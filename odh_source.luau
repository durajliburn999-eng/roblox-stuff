        if not settings then return end

        local createTween = bindings.getCreateTween()
        local service = bindings.getTweenService()
        local play = bindings.getOwner().play
        local button = settings[1]
        local position = button.Position
        local x, y = position.X, position.Y
        bindings.setIndex(bindings.getIndex() - 1)
        bindings.write(settings, 8, nil)
        local goal = {
            Position = bindings.getSize()(x.Scale, x.Offset, y.Scale - settings[3], y.Offset),
