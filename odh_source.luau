standaloneModules.createUiAssetWorker = ((function()
type Worker = (unknown, string) -> ()
type Bindings = {
    cache: { [string]: unknown },
    getWait: () -> (() -> ()),
    getIsfile: () -> ((string) -> unknown),
    getAssetLoader: () -> ((string) -> unknown),
    getSpawn: () -> ((Worker, unknown, string) -> unknown),
    writeProperty: (unknown, string, unknown) -> (),
}

return function(bindings: Bindings)
    local cache = bindings.cache
    local writeProperty = bindings.writeProperty

    local function worker(object: unknown, name: string)
        local wait = bindings.getWait()
        local path = "Ixry Shizuka/assets/" .. name .. ".png"
        local asset = cache[path]

        if asset then
            writeProperty(object, "Image", asset)
            return
        end

        local isfile = bindings.getIsfile()
        repeat
            if not isfile(path) then
                wait()
                continue
            end

            break
        until false

        asset = bindings.getAssetLoader()(path)
        cache[path] = asset
        writeProperty(object, "Image", asset)
    end

    return function(object: unknown, name: string)
        bindings.getSpawn()(worker, object, name)
    end
end
end)() :: unknown)

