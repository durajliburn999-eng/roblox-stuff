        local nextElement = #secondaryElements + 1
        secondaryElements[nextElement] = button.Gradient
        secondaryElements[nextElement + 1] = icon.Gradient

        local context = {
            owner = owner, name = name, iconName = iconName, mode = mode, widget = widget,
            fromScale = fromScale, fromOffset = fromOffset, fromRGB = fromRGB,
            canvasSizing = canvasSizing, font = font, tweenService = tweenService,
