local createFarmWebhookInput = (function()
type Cell = { value: unknown }
type Settings = { FarmWebhook_Channel: unknown, FarmWebhook_Token: unknown }
type Bindings = {
    settings: Settings,
    channel: Cell,
    token: Cell,
    toNumber: (string) -> unknown,
    substitute: (string, string, (string, string) -> ()) -> ...unknown,
    match: (string, string) -> unknown,
    notify: (string, number) -> (),
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local channel = bindings.channel
    local token = bindings.token

    return function(value: string)
        settings.FarmWebhook_Channel = nil
        settings.FarmWebhook_Token = nil
        channel.value = nil
        token.value = nil
        bindings.substitute(value, "https://discord.com/api/webhooks/(%d+)/(.+)", function(id, secret)
            if not bindings.toNumber(id) then
                return
            end

            channel.value = id
            token.value = secret
        end)

        local id = channel.value
        local secret = token.value

        if not id or not secret or bindings.match(secret :: string, " ") then
            bindings.notify("Invalid webhook url.", 2)
            return
        end

        settings.FarmWebhook_Channel = id
        settings.FarmWebhook_Token = secret
    end
end
end)()

