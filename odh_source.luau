        { "Craft Beast Hunter", "CraftItem", "Craft", "BeastHunter" },
        { "Craft Leviathan Shield", "CraftItem", "Craft", "LeviathanShield" },
        { "Craft Leviathan Crown", "CraftItem", "Craft", "LeviathanCrown" },
        { "Craft Terror Jaw", "CraftItem", "Craft", "TerrorJaw" },
        { "Craft Tooth Necklace", "CraftItem", "Craft", "ToothNecklace" },
        { "Craft Monster Magnet", "CraftItem", "Craft", "MonsterMagnet" },
    }
    for _, purchase in additional do
        callbacks[purchase[1]] = function()
            bindings.invoke(bindings.remote, table.unpack(purchase, 2))
