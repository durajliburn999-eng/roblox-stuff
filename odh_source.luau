        notify = bindings.notify, destroy = bindings.destroy, report = bindings.report })
    bindings.connect(oldAccept.OnClientEvent, accept)
    bindings.connect((trade.UpdateTrade :: Values).OnClientEvent, lifecycle.update :: (...unknown) -> ())

    return { trade = trade, oldAccept = oldAccept, newAccept = newAccept, active = active,
        partner = partner, other = other, last = last, timestamp = timestamp, lifecycle = lifecycle }
