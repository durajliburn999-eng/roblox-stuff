local findFarmAbovePart = (function()
type Vector = typeof(setmetatable({ X = 0, Y = 0, Z = 0 }, { __sub = function(left, _right) return left end }))
type Part = { Transparency: unknown, Position: Vector }
type Spawn = { Position: Vector }
type Bindings = {
    makeVector: (number, number, number) -> Vector,
    getDescendants: (unknown) -> { Part },
    isA: (Part, string) -> unknown,
    dot: (Vector, Vector) -> number,
}

return function(map: unknown, spawn: Spawn, bindings: Bindings): Part?
    local position = spawn.Position
    local probe = bindings.makeVector(position.X, position.Y + 999, position.Z)
    local objects = bindings.getDescendants(map)
    local nearestDistance = math.huge
    local nearest: Part? = nil

    for index = 1, #objects do
        local object = objects[index]

        if not bindings.isA(object, "BasePart") or object.Transparency == 0 then
            continue
        end

        local displacement = probe - object.Position
        local distance = bindings.dot(displacement, displacement)

        if nearestDistance <= distance then
            continue
        end

        nearestDistance = distance
        nearest = object
    end

    return nearest
end
end)()

