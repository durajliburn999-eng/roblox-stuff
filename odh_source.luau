local createSettingsColors = (function()

type Values = { [unknown]: unknown }
type Gradient = {
    points: Values,
    elements: Values,
    getKeypoint: () -> ((number, unknown) -> unknown),
    getSequence: () -> ((Values) -> unknown),
}
type Bindings = {
    theme: { [string]: unknown },
    groupThemes: { [string]: { [string]: unknown } }?,
    searchBar: { BackgroundColor3: unknown },
    colorElements: { [string]: Values },
    gradients: { [string]: Gradient },
    toggles: {
        elements: Values,
        getTransition: () -> ((unknown, unknown, unknown, unknown) -> unknown),
        getContext: () -> unknown,
        getProperties: () -> { [string]: { BackgroundColor3: unknown } },
    },
}
local makeBackground = (standaloneModules.createUiBackgroundUpdater :: unknown) :: (unknown) -> unknown
local backgrounds = {
    "TextBox Element Color", "Slider Fill Element Color", "Slider Placeholder Element Color", "Slider Knob Element Color",
    "Slider Input Element Color", "Button Element Color", "Paragraph Element Color", "Keybind Element Color",
    "Dropdown Element Color", "Colorpicker Element Color",
}
local gradients: { { unknown } } = {
    { "#1. Secondary Color", "Secondary", 1, 0 }, { "#2. Secondary Color", "Secondary", 2, 0.75 }, { "#3. Secondary Color", "Secondary", 3, 1 },
    { "#1. Secondary Variant Color", "Secondary Variant", 1, 0 }, { "#2. Secondary Variant Color", "Secondary Variant", 2, 0.6 }, { "#3. Secondary Variant Color", "Secondary Variant", 3, 1 },
    { "#1. Surface Color", "Surface", 1, 0 }, { "#2. Surface Color", "Surface", 2, 0.7 }, { "#3. Surface Color", "Surface", 3, 1 },
}

return function(bindings: Bindings)
    local handlers: { [string]: unknown } = {}
    local theme = bindings.theme
    local searchBar = bindings.searchBar
    handlers["Search Bar Element Color"] = function(color: unknown)
        searchBar.BackgroundColor3 = color
        theme["Search Bar Element Color"] = color
    end

    for _, title in backgrounds do
        handlers[title] = makeBackground({ elements = bindings.colorElements[title], settings = theme, key = title })
    end

    local toggles = bindings.toggles
    local function toggleColor(title: string, property: string, offset: number, active: boolean)
        handlers[title] = function(color: unknown)
            local transition = toggles.getTransition()
            local context = toggles.getContext()
            local properties = toggles.getProperties()
            local base = properties.toggle_prop_1
            local selected = properties[property]
            selected.BackgroundColor3 = color

            for index = 1, #toggles.elements, 4 do
                local element = toggles.elements[index] :: { BackgroundColor3: unknown }
                toggles.elements[index + offset] = transition(context, element, base, selected)
                if not toggles.elements[index + 3] == not active then
                    element.BackgroundColor3 = color
                end
            end

            theme[title] = color
        end
    end
    toggleColor("Toggle On Element Color", "toggle_prop_3", 1, true)
    toggleColor("Toggle Off Element Color", "toggle_prop_5", 2, false)

    for _, entry in gradients do
        local title, group = entry[1] :: string, entry[2] :: string
        local index, time = entry[3] :: number, entry[4] :: number
        local gradient = bindings.gradients[group]
        local points = gradient.points
        local elements = gradient.elements
        local getKeypoint = gradient.getKeypoint
        local getSequence = gradient.getSequence
        local groupTheme = if bindings.groupThemes then bindings.groupThemes[group] else theme
        handlers[title] = function(color: unknown)
            points[index] = getKeypoint()(time, color)
            local sequence = getSequence()(points)

            for _, element in elements do
                (element :: { Color: unknown }).Color = sequence
            end

            groupTheme[title] = color
        end
    end

    return handlers
end
end)()

standaloneModules.scanSettingsPresets = ((function()
type Values = { [string]: unknown }
type Bindings = {
    listFiles: (string) -> { string },
    readFile: (string) -> string,
    decode: (string) -> unknown,
    substring: (string, number, number) -> string,
}

return function(bindings: Bindings): ({ string }, Values)
    local names, presets = {}, {}
    local substring = bindings.substring
    local files = bindings.listFiles("Ixry Shizuka/customs/ui_customizations")

    for _, path in files do
        if substring(path, #path - 4, #path) ~= ".json" then
            continue
        end

        local content = bindings.readFile(path)
        if #content < 5 then continue end
        local decoded = bindings.decode(content)
        if not decoded then continue end

        local prefix = substring(path, 1, #path - 5)
        local index, name = #prefix, ""
        while true do
            local character = substring(prefix, index, index)
            if character == "" or character == "/" or character == "\\" then break end
            name = character .. name
            index -= 1
        end
        table.insert(names, name)
        presets[name] = decoded
    end

    return names, presets
end
end)() :: unknown)

standaloneModules.scanSettingsBackgrounds = ((function()
type Values = { [string]: unknown }
type Bindings = {
    listFiles: (string) -> { string },
    isFile: (string) -> boolean,
    readFile: (string) -> string,
    substring: (string, number, number) -> string,
    toNumber: (unknown) -> number?,
    decode: (string) -> unknown,
    asset: (string) -> unknown,
}
local fields = { "sizeX", "sizeY", "frameSizeX", "frameSizeY", "columns", "rows", "totalFrames", "frameRate" }

return function(bindings: Bindings)
    local catalog: { [string]: { unknown } } = {}
    local files = bindings.listFiles("Ixry Shizuka/customs/animated_bgs")
    local substring = bindings.substring

    for _, path in files do
        local length = #path
        if length < 35 or not bindings.isFile(path) then continue end
        if substring(path, length - 4, length) ~= ".json" then continue end

        local prefix = substring(path, 1, length - 5)
        local image = prefix .. ".png"
        if not bindings.isFile(image) then continue end

        local content = bindings.readFile(path)
        if #content < 10 then continue end
        local imageData = bindings.readFile(image)
        if #imageData < 200 then continue end

        local metadata = bindings.decode(content) :: Values?
        if not metadata then continue end
        local valid = true
        for _, field in fields do
            if not bindings.toNumber(metadata[field]) then
                valid = false
                break
            end
        end
        if not valid then continue end

        local name = substring(prefix, 35, #prefix)
        catalog[name] = { bindings.asset(image), metadata }
    end

    local names = { "Default" }
    for name in catalog do table.insert(names, name) end
    return { names = names, catalog = catalog }
end
end)() :: unknown)

