local runFarmMovement = (function()

type Vector = typeof(setmetatable({ Magnitude = 0, Unit = (nil :: unknown) :: unknown }, { __mul = function(left, _right) return left end }))
type Body = { Velocity: unknown }
type Root = { Velocity: unknown, CFrame: unknown, AssemblyAngularVelocity: unknown }
type Coin = { CFrame: unknown }
type Bindings = {
    displacement: Vector,
    speed: number,
    coin: unknown,
    previousCoin: unknown,
    method: unknown,
    body: Body,
    root: Root,
    target: unknown,
    zero: unknown,
    makeFrame: unknown,
    settings: { AutoFarm_SyncMode: unknown },
    touch: ((Root, Coin, number) -> ())?,
}

local orientTarget = (orientFarmTarget :: unknown) :: (unknown, unknown, unknown, unknown, unknown, unknown) -> ()
local apply = (applyFarmMotionEffects :: unknown) :: (unknown, unknown, unknown, unknown, unknown, boolean, unknown, unknown) -> ()

return function(bindings: Bindings)
    local displacement = bindings.displacement
    local speed = bindings.speed
    local method = bindings.method
    local coin = bindings.coin
    local touch = bindings.touch
    local settings = bindings.settings
    local distance = displacement.Magnitude
    local teleport = distance <= 0.5

    if not teleport then
        teleport = 15 < distance / speed
    end

    if teleport then
        local body = bindings.body
        local root = bindings.root
        local zero = bindings.zero
        local target = bindings.target
        body.Velocity = zero
        root.Velocity = zero
        root.CFrame = target

        if method == "Safe" then
            local currentCoin = coin :: Coin

            if touch and settings.AutoFarm_SyncMode then
                touch(root, currentCoin, 0)
                touch(root, currentCoin, 1)
            end

            currentCoin.CFrame = target
        end

        root.AssemblyAngularVelocity = zero
        return
    end

    orientTarget(coin, bindings.previousCoin, method, bindings.root, bindings.target, bindings.makeFrame)
    local velocity = (displacement.Unit :: Vector) * speed
    apply(bindings.body, bindings.root, velocity, bindings.zero, bindings.target, false, nil, nil)
end
end)()

