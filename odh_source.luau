end)())

local createImages = (function()
type Vector = { X: number, Y: number }
type Rect = { Min: Vector, Max: Vector }
type Entry = { width: number, height: number, originalWidth: number, originalHeight: number, pixels: unknown }
type Connection = { Disconnect: (Connection) -> () }
type Signal = { Connect: (Signal, () -> ()) -> Connection }
type ImageObject = { [string]: unknown, ImageRectOffset: Vector, ImageRectSize: Vector, SliceCenter: Rect, Destroying: Signal }
type EditableImage = { WritePixelsBuffer: (EditableImage, Vector, Vector, unknown) -> (), Destroy: (EditableImage) -> () }
type AssetService = { CreateEditableImage: (AssetService, { Size: Vector }) -> EditableImage? }
type Host = {
    game: { GetService: (unknown, string) -> AssetService },
    Vector2: { new: (number, number) -> Vector, zero: Vector },
    Rect: { new: (Vector, Vector) -> Rect },
    Content: { fromObject: (EditableImage) -> unknown },
    pcall: (() -> ...unknown) -> (boolean, unknown),
    typeof: (unknown) -> string,
}
type Retained = { image: EditableImage, content: unknown, users: number }
type State = { offset: Vector, size: Vector, slice: Rect, path: string?, connection: Connection?, entry: Entry?, isDestroyed: boolean? }

local PREFIX = "overdrive-local-image:"

return function(host: Host, entries: { [string]: Entry }, decodePixels: (unknown, number) -> unknown)
    local cache: { [string]: Retained? } = {}
    local objects = (setmetatable({}, { __mode = "k" }) :: unknown) :: { [ImageObject]: State }
    local assets: AssetService? = nil

    local function getImage(path: string): Retained
        local cached = cache[path]

        if cached then
            return cached
        end

        local entry = assert(entries[path], "Missing embedded image")
        assets = assets or host.game:GetService("AssetService")

        local size = host.Vector2.new(entry.width, entry.height)
        local service = assets :: AssetService
        local image = assert(service:CreateEditableImage({ Size = size }), "Image memory budget exhausted")
        local ok, content = host.pcall(function()
            image:WritePixelsBuffer(host.Vector2.zero, size, decodePixels(entry.pixels, entry.width * entry.height * 4))
            return host.Content.fromObject(image)
        end)

        if not ok then
            image:Destroy()
            error(content, 0)
        end

        local retained: Retained = { image = image, content = content, users = 0 }
        cache[path] = retained
        return retained
    end

    local function discardUnused(path: string, retained: Retained)
        if retained.users ~= 0 or cache[path] ~= retained then
            return
        end

        cache[path] = nil
        retained.image:Destroy()
    end

    local function release(path: string?)
        local retained = path and cache[path]

        if not retained then
            return
        end

        retained.users -= 1
        discardUnused(path :: string, retained)
    end

    local function detach(state: State)
        local path, connection = state.path, state.connection
        state.path, state.connection = nil, nil

        if connection then
            connection:Disconnect()
        end

        release(path)
    end

    local function scaledVector(value: Vector, entry: Entry): Vector
        return host.Vector2.new(
            value.X * entry.width / entry.originalWidth,
            value.Y * entry.height / entry.originalHeight
        )
    end

    local function scaledRect(value: Rect, entry: Entry): Rect
        return host.Rect.new(scaledVector(value.Min, entry), scaledVector(value.Max, entry))
    end

    local function applyImage(object: ImageObject, path: string)
        local previous = objects[object]
        local state: State = previous or {
            offset = object.ImageRectOffset,
            size = object.ImageRectSize,
            slice = object.SliceCenter,
        }
        local entry = assert(entries[path], "Missing embedded image")
        local offset = scaledVector(state.offset, entry)
        local size = scaledVector(state.size, entry)
        local slice = scaledRect(state.slice, entry)
        local retained = getImage(path)
        local ok, raised = host.pcall(function()
            if not state.connection then
                state.connection = object.Destroying:Connect(function()
                    state.isDestroyed = true

                    if objects[object] == state then
                        objects[object] = nil
                    end

                    detach(state)
                end)
            end

            object.ImageContent = retained.content
        end)

        if not ok then
            if not previous then
                detach(state)
            end

            discardUnused(path, retained)
            error(raised, 0)
        end

        if state.isDestroyed then
            discardUnused(path, retained)
            return
        end

        if state.path ~= path then
            local oldPath = state.path
            retained.users += 1
            state.path = path
            release(oldPath)
        end

        state.entry = entry
        objects[object] = state
        object.ImageRectOffset = offset
        object.ImageRectSize = size
        object.SliceCenter = slice
    end

    local function writeProperty(object: ImageObject, key: string, value: unknown)
        if key == "Image" and type(value) == "string" and string.sub(value, 1, #PREFIX) == PREFIX then
            if host.typeof(object) ~= "Instance" then
                object[key] = value
                return
            end

            applyImage(object, string.sub(value, #PREFIX + 1))
            return
        end

        if key ~= "Image" and key ~= "ImageRectOffset" and key ~= "ImageRectSize" and key ~= "SliceCenter" then
            object[key] = value
            return
        end

        local state = objects[object]

        if not state then
            object[key] = value
            return
        end

        if key == "ImageRectOffset" then
            object[key] = scaledVector(value :: Vector, state.entry :: Entry)
            state.offset = value :: Vector
            return
        end

        if key == "ImageRectSize" then
            object[key] = scaledVector(value :: Vector, state.entry :: Entry)
            state.size = value :: Vector
            return
        end

        if key == "SliceCenter" then
            object[key] = scaledRect(value :: Rect, state.entry :: Entry)
            state.slice = value :: Rect
            return
        end

        object[key] = value
        object.ImageRectOffset = state.offset
        object.ImageRectSize = state.size
        object.SliceCenter = state.slice
        objects[object] = nil
        detach(state)
    end

    return {
        asset = function(path: string)
            assert(entries[path], "Unbundled image")
            return PREFIX .. path
        end,
        writeProperty = writeProperty,
        destroy = function()
            local failures: { unknown } = {}

            for object, state in objects do
                local ok, raised = host.pcall(function()
                    object.Image = ""
                    object.ImageRectOffset = state.offset
                    object.ImageRectSize = state.size
                    object.SliceCenter = state.slice
                end)
                objects[object] = nil
                detach(state)

                if not ok then
                    failures[#failures + 1] = raised
                end
            end

            for path, retained in cache do
                cache[path] = nil
                (retained :: Retained).image:Destroy()
            end

            return failures
        end,
    }
end
end)()

standaloneModules.appendSoundPresets = ((function()
type Values = { [unknown]: unknown }
type Bindings = { files: { string }, names: Values, assets: Values,
    substring: (string, number, number) -> string, getAsset: (string) -> unknown }

local function filenameWithoutExtension(substring: (string, number, number) -> string, path: string, length: number): string
    -- The original performs this discarded call before walking the basename.
    substring(path, 1, length - 3)
    local position = length - 4
    local name = ""

    while true do
        local character = substring(path, position, position)

        if character == "" or character == "/" or character == "\\" then
            return name
        end

        name = character .. name
        position -= 1
    end
end


return function(bindings: Bindings)
    local files, names, assets = bindings.files, bindings.names, bindings.assets
    local substring, getAsset = bindings.substring, bindings.getAsset
    for index = 1, #files do
        local path = files[index]
        local length = #path
        local extension = substring(path, length - 3, length)

        if extension ~= ".mp3" and extension ~= ".ogg" and extension ~= ".wav" then
            continue
        end

        local name = filenameWithoutExtension(substring, path, length)
        names[#names + 1] = name
        assets[name] = getAsset(path)
    end
end
end)())

standaloneModules.createSoundRefresh = ((function()
type Values = { [unknown]: unknown }
type Dropdown = { ChangeItems: (Dropdown, Values) -> () }
type Bindings = {
    folder: string,
    clearNames: boolean,
    names: Values,
    assets: Values,
    dropdown: Dropdown,
    clock: () -> (() -> number),
    timestamp: () -> number,
    setTimestamp: (number) -> (),
    notify: () -> ((string, number) -> ()),
    format: () -> ((string, number) -> string),
    substring: () -> ((string, number, number) -> string),
    getAsset: () -> ((string) -> unknown),
    listFiles: () -> ((string) -> { string }),
}

local appendSounds = (standaloneModules.appendSoundPresets :: unknown) :: (unknown) -> ()

return function(bindings: Bindings)
    return function()
        local now = bindings.clock()()
        local elapsed = now - bindings.timestamp()

        if elapsed < 5 then
            local notify = bindings.notify()
            local format = bindings.format()
            local message = format('Slow down! Try again in <font color="rgb(0, 0, 255)">%.2f</font>', 5 - elapsed)
            notify(message, 2)
            return
        end

        bindings.setTimestamp(now)
        local names = bindings.names
        local assets = bindings.assets
        local substring = bindings.substring()
        local getAsset = bindings.getAsset()

        for index = 2, #names do
            names[index] = nil
        end

        -- Reload sounds originally clear names by asset keys; retain that distinction.
        local clearTarget = if bindings.clearNames then names else assets

        for key in assets do
            clearTarget[key] = nil
        end

        local listFiles = bindings.listFiles()
        local files = listFiles(bindings.folder)

        appendSounds({ files = files, names = names, assets = assets, substring = substring, getAsset = getAsset })

        local dropdown = bindings.dropdown
        local changeItems = dropdown.ChangeItems
        changeItems(dropdown, names)
    end
end
end)())

standaloneModules.loadSkybox = ((function()
type Faces = { Left: unknown, Right: unknown, Top: unknown, Bottom: unknown, Front: unknown, Back: unknown }
type Context = {
    names: { string }, skyboxes: { [string]: Faces }, isFolder: (string) -> unknown,
    isFile: (string) -> unknown, substring: (string, number, number) -> string, getAsset: (string) -> unknown,
}

local function skyboxName(path: string, substring: (string, number, number) -> string): string
    local index = #path
    substring(path, 1, index)
    local name = ""
    local character = substring(path, index, index)

    while character ~= "" and character ~= "/" and character ~= "\\" do
        name = character .. name
        index -= 1
        character = substring(path, index, index)
    end

    return name
end

local function loadSkybox(path: string, context: Context)
    if not context.isFolder(path) then
        return
    end

    local left = path .. "/left.png"
    local right = path .. "/right.png"
    local top = path .. "/top.png"
    local bottom = path .. "/bottom.png"
    local front = path .. "/front.png"
    local back = path .. "/back.png"

    if not context.isFile(left) or not context.isFile(right) or not context.isFile(top)
        or not context.isFile(bottom) or not context.isFile(front) or not context.isFile(back) then
        return
    end

    local name = skyboxName(path, context.substring)
    context.names[#context.names + 1] = name
    local faces = {
        Left = context.getAsset(left),
        Right = context.getAsset(right),
        Top = context.getAsset(top),
        Bottom = context.getAsset(bottom),
        Front = context.getAsset(front),
        Back = context.getAsset(back),
    }
    context.skyboxes[name] = faces
end


return loadSkybox
end)())

