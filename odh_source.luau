                break
            end

            slot += 1
            previous = ball
        end

        state.IsAlive = nil
        local playerName = bindings.getPlayerName()
        local players = bindings.getChildren(bindings.getPlayersContainer())

        for index = 1, #players do
            if players[index].Name == playerName then
                state.IsAlive = true
                break
            end
        end

        state.Alives = #players
        local wait = bindings.getWait()
        wait(0.1)
        bindings.setUpdating(nil)
    end
end
end)()

local createBladeParryEvent = (function()
type Values = { [string]: unknown }
type Vector = typeof(setmetatable({}, { __sub = function(left, _right) return left end }))
type Root = { Position: Vector }
type Bindings = {
    settings: Values,
    getString: () -> ((unknown) -> string),
    getPlayer: () -> unknown,
    getClock: () -> (() -> number),
    parry: () -> (),
    getCharacter: () -> unknown,
    getChildren: (unknown) -> { unknown },
    alive: unknown,
    findChild: (unknown, string) -> Root?,
    getRoot: () -> Root?,
    getDot: () -> ((Vector, Vector) -> number),
}

return function(bindings: Bindings)
    return function(_first: unknown, _second: unknown, _third: unknown, player: unknown, ball: unknown)
        local settings = bindings.settings
        local selected: Root? = nil

        if player then
            local stringify = bindings.getString()
            local key = if stringify(ball) ~= stringify(settings.Ball1) then "Ball2" else "Ball1"
            selected = settings[key] :: Root?

            if player == bindings.getPlayer() then
                local clock = bindings.getClock()
                local tickKey = key .. "_lasttick"
                local attackKey = key .. "_lastattack"
                local now = clock()
                local previous = settings[tickKey] :: number
                settings[key .. "_debounce"] = 0
                settings[tickKey] = now

                if settings.AutoSpam then
                    if now - previous < 0.5 then
                        local hits = (settings[attackKey] :: number) + 1
                        settings[attackKey] = hits
                        if hits >= (settings.HitsBeforeClashing :: number) + 1 then
                            settings.OnClash = clock()
                        end
                    else
                        settings[attackKey] = 0
                        settings.OnClash = 0
                    end
                end
            end
        end

        if not selected then return end
        if bindings.getClock()() - (settings.OnClash :: number) <= 0.55 then
            bindings.parry()
            return
        end
        if not settings.AutoParry or not settings.IsAlive or (settings.Alives :: number) > 2 then return end
        local character = bindings.getCharacter()
        if not character then return end
        local players = bindings.getChildren(bindings.alive)
        local opponent: Root? = nil
        for _, candidate in players do
            if candidate == character then continue end
            opponent = bindings.findChild(candidate, "HumanoidRootPart")
            break
        end
        if not opponent then return end
        local root = bindings.getRoot()
        if not root then return end
        local dot = bindings.getDot()
        local first = selected.Position - opponent.Position
        if dot(first, first) > 256 then return end
        local second = selected.Position - root.Position
        if dot(second, second) > 256 then return end
        bindings.parry()
    end
end
end)()

