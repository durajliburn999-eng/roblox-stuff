standaloneModules.loadUiPresets = ((function()
type Values = { [any]: any }
type Bindings = {
    listfiles: (string) -> { string },
    isfile: (string) -> unknown,
    readfile: (string) -> string,
    decode: (string) -> unknown,
    gameName: string,
}

return function(bindings: Bindings): (Values, number)
    local presets: Values = {}
    local count = 0
    for _, path in bindings.listfiles("Ixry Shizuka/presets") do
        if not bindings.isfile(path) or path:sub(-7) ~= ".preset" then
            continue
        end
        local encoded = bindings.readfile(path)
        local chars = table.create(#encoded)
        for index = 1, #encoded do
            chars[index] = string.char(bit32.bxor(encoded:byte(index), 40))
        end
        local text = table.concat(chars)
        if text:sub(1, 1) ~= "{" or text:sub(-1) ~= "}" or not text:find("author") then
            continue
        end
        local data = bindings.decode(text) :: Values?
        if not data or data.game ~= bindings.gameName then
            continue
        end
        local category = data.category
        if not presets[category] then
            presets[category] = {}
        end
        local name = path:sub(1, #path - 7):match("([^/\\]+)$") or ""
        if name == "" then
            continue
        end
        presets[category][string.format("%* (%*)", name, data.author)] = data.cfg
        count += 1
    end
    return presets, count
end
end)())

standaloneModules.createUiDebugLog = ((function()
