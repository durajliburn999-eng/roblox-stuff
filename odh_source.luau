local populateExclusiveUi = (function()

type Section = {
    AddLabel: (Section, string) -> (),
    AddParagraph: (Section, string, string, boolean?) -> unknown,
    AddToggle: (Section, string, unknown) -> (),
    AddSlider: (Section, string, number, number, number, unknown) -> (),
    AddDropdown: (Section, string, unknown, unknown) -> (),
    AddTextBox: (Section, string, unknown) -> (),
}
type Tab = { AddSection: (Tab, string, string?) -> Section }
type Bindable = (number, unknown, string, string, unknown, unknown, unknown) -> Section
type Bindings = {
    settings: unknown,
    stateDispatch: unknown,
    stateTransform: unknown,
    bindable: Bindable,
    callbacks: { [string]: unknown },
    rarities: unknown,
    weaponInfo: { value: unknown },
    onWeaponInfo: ((unknown) -> ())?,
}
local makeState = (createStateCallback :: unknown) :: (unknown) -> (number, string, unknown) -> unknown
local valuesUi = (standaloneModules.populateExclusiveValuesUi :: unknown) :: (unknown, unknown, unknown) -> { complete: boolean }
local otherUi = (standaloneModules.populateExclusiveOtherUi :: unknown) :: (unknown, unknown, unknown) -> ()

return function(tab: Tab, bindings: Bindings)
