local createFoundation = (function()

type Host = {
    [string]: unknown,
    game: { GetService: (unknown, string) -> unknown },
    task: { wait: unknown, delay: (number, () -> ()) -> () },
    os: { clock: () -> number },
    getgenv: (() -> { [string]: unknown })?,
}
type Control = {
    phase: string,
    instances: number,
    screenGuis: number,
    stopped: boolean,
    snapshot: (() -> unknown)?,
    destroyImages: unknown,
    protectionFailure: unknown,
    missingResource: unknown,
}
type Images = { asset: (string) -> string, destroy: () -> { unknown } }
type InstanceFactory = { new: (...unknown) -> { ClassName: string } }

local makeImages = (createImages :: unknown) :: (unknown, unknown, unknown) -> Images
local makeRequest = (createLocalRequest :: unknown) :: (unknown) -> unknown
local makeEnvironment = (createEnvironment :: unknown) :: (unknown, unknown) -> { [string]: unknown }
local imageData = (imageResources.png :: unknown) :: { [string]: string }

return function(host: Host)
    local storage = createStorage()
    storage.makefolder("Ixry Shizuka/assets")
    local images = makeImages(host, imageResources.entries, decodePixels)
    local requestAssetPaths: { [string]: string } = {}

    for _, path in assetPaths do
        local name = path:match("([^/]+)$") :: string
        requestAssetPaths["https://cdn.overdrivehub.xyz/assets/" .. name] = path
        storage.writefile(path, decodeAsset(imageData[path]))
    end

    local failures: { [string]: boolean } = {}
    local failureCount = 0
    local disconnects: { [string]: boolean } = {}
    local control: Control = (nil :: unknown) :: Control
    local resources = {
        filesystem = storage,
        resolveCode = resolveCode,
        websocket = { connect = function() error("Local protocol not initialized") end },
        asset = images.asset,
        onTeleportQueueSuppressed = function() end,
        onKickSuppressed = function(message: unknown)
            if control then
                control.protectionFailure = { message = tostring(message), state = control.snapshot and (control.snapshot :: () -> unknown)() }
            end

            if disconnects[tostring(message)] then
                return
            end

            disconnects[tostring(message)] = true
        end,
        observeFailure = function(message: unknown)
            local summary = tostring(message):sub(1, 500)

            if failures[summary] or failureCount >= 10 then
                return
            end

            failures[summary] = true
            failureCount += 1
        end,
        request = makeRequest({
            webhookStub = localWebhook,
            itemSource = itemSource,
            catalogs = catalogs,
            decodeJSON = function(body: string): ...unknown
                local http = host.game:GetService("HttpService") :: { JSONDecode: (unknown, string) -> ...unknown }
                return http:JSONDecode(body)
            end,
            wait = host.task.wait,
            readfile = storage.readfile,
            assetPaths = requestAssetPaths,
            observeMissing = function(description: unknown)
                if control then
                    control.missingResource = description
                end
            end,
        }),
    }
    local environment = makeEnvironment(host, resources)
    control = ({ phase = "assembly", instances = 0, screenGuis = 0, stopped = false } :: unknown) :: Control
    control.destroyImages = images.destroy
    local hostGlobals = (host.getgenv and host.getgenv() or host) :: { [string]: unknown }
    hostGlobals.__overdrive_local_control = control

    local nativeInstance = environment.Instance :: InstanceFactory
    environment.Instance = setmetatable({
        new = function(...: unknown)
            local instance = nativeInstance.new(...)
            control.instances += 1

            if instance.ClassName == "ScreenGui" then
                control.screenGuis += 1
            end

            return instance
        end,
    }, { __index = nativeInstance })

    for _, seconds in { 2, 8, 20 } do
        host.task.delay(seconds, function()
            if control.stopped or control.phase == "returned" then
                return
            end

            local _state = control.snapshot and (control.snapshot :: () -> unknown)() or control
        end)
    end

    local clockStarted = host.os.clock()
    environment.__inertClock = setmetatable({}, {
        __index = function(_, key)
            assert(key == "now")
            return 1793463500.9143 + host.os.clock() - clockStarted
        end,
    })
    environment.__bootstrapClockOffset = 0

    for _, path in runtimeDependencies do
        local root, member = path:match("^([^.]+)%.?(.*)$")
        local value = environment[root :: string]

        if member ~= "" then
            value = value and (value :: { [string]: unknown })[member :: string]
        end

        assert(type(value) == "function", "Missing runtime dependency: " .. path)
    end

    -- Feature selection for this local derivative, not a server entitlement response.
    -- These values are read before the UI captures its feature callbacks.
    local features = table.freeze({ isPremiumEnabled = true, isExclusiveEnabled = true })
    -- Display name observed in the running original; editable local presentation data.
    local profile = { discordName = "mrkix" }

    return {
        storage = storage, images = images, resources = resources,
        environment = environment, control = control, features = features, profile = profile,
    }
end
end)()

local updateFarmTargetState = (function()

type Frame = typeof(setmetatable({ X = 0, Y = 0, Z = 0 }, { __mul = function(left, _right) return left end }))
type Bindings = {
    coin: unknown,
    coinFrame: Frame,
    previousCoin: unknown,
    method: unknown,
    previousMethod: unknown,
    root: { CFrame: Frame },
    target: { value: Frame },
    makeFrame: (number, number, number) -> Frame,
    rotation: Frame,
}

return function(bindings: Bindings)
    local root = bindings.root
    local rootFrame = root.CFrame
    local method = bindings.method
    local makeFrame = bindings.makeFrame
    local rotation = bindings.rotation
    local coinFrame = bindings.coinFrame

    local function makeTarget(): Frame
        if method == "Standard" then
            return farmTargetFrames.standard(coinFrame, makeFrame)
        end

        if method == "Safe" then
            return farmTargetFrames.safe(coinFrame, makeFrame, rotation)
        end

        return farmTargetFrames.lay(coinFrame, makeFrame, rotation)
    end

    if method ~= "Standard" and method ~= "Safe" and method ~= "Lay" then
        return
    end

    if bindings.previousCoin ~= bindings.coin then
        bindings.target.value = makeTarget()
    end

    if method == bindings.previousMethod then
        return
    end

    bindings.target.value = makeTarget()
    local frame = makeFrame(rootFrame.X, rootFrame.Y, rootFrame.Z)

    if method ~= "Standard" then
        frame *= rotation
    end

    root.CFrame = frame
end
end)()

