    if settings.AutoKillEveryoneAsMurderer and murderer == localName then
        kill({ players = bindings.players, action = bindings.killAction, start = bindings.start, wait = bindings.wait })
        return
    end

    local target = bindings.findPlayer(murderer)

    if not target then
