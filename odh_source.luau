local setupKnifeAnimations = (function()
type Animation = { AnimationId: string }
type Humanoid = { LoadAnimation: (Humanoid, Animation) -> unknown }
type Bindings = {
    knife: unknown,
    knifeClient: unknown,
    getHumanoid: () -> Humanoid?,
    find: (unknown, string) -> unknown,
    matches: (string, string) -> unknown,
    overrides: { [string]: unknown }?,
    write: (unknown, string, unknown) -> (),
    wait: () -> (),
    setNamedTrack: (string, unknown) -> (),
    attackTracks: { [number]: unknown },
    fallbackAnimations: { unknown },
    fallbackTracks: { [number]: unknown },
    extraAnimations: { unknown },
    extraTracks: { [number]: unknown },
    resumeAfterSetup: unknown,
}

local function prepare(bindings: Bindings, animation: Animation, name: string)
    if bindings.overrides then
        bindings.write(animation, "AnimationId", bindings.overrides[name])
        return
    end

    while not bindings.matches(animation.AnimationId, "%:%/%/") do
        bindings.wait()
    end
end

local function load(bindings: Bindings, humanoid: Humanoid, loadTrack: (Humanoid, Animation) -> unknown, parent: unknown, name: string, override: string)
    local animation = bindings.find(parent, name) :: Animation?

    if not animation then
        return
    end

    prepare(bindings, animation, override)
    bindings.setNamedTrack(override, loadTrack(humanoid, animation))
end

return function(bindings: Bindings)
    local animations = bindings.find(bindings.knife, "Animations")

    if not animations then
        animations = bindings.knifeClient
    end

    local humanoid = bindings.getHumanoid()

    if not animations or not humanoid then
        return
    end

    local loadTrack = humanoid.LoadAnimation

    for _, item in { { "ThrowKnife", "Throw" }, { "ThrowHold", "ThrowHold" }, { "ThrowCharge", "ThrowCharge" } } do
        load(bindings, humanoid, loadTrack, animations, item[1], item[2])
    end

    local slash = bindings.find(animations, "Slash") :: Animation?

    if slash then
        prepare(bindings, slash, "Slash")
        bindings.attackTracks[1] = loadTrack(humanoid, slash)
    end

    local down = bindings.find(animations, "Down") :: Animation?

    if not down then
        down = bindings.find(animations, "Downstab") :: Animation?
    end

    if down then
        prepare(bindings, down, "Down")
        bindings.attackTracks[2] = loadTrack(humanoid, down)
    end

    local dual = bindings.find(animations, "Dual")

    if dual then
        local dualSlash = bindings.find(dual, "DualSlash") :: Animation?

        if dualSlash then
            prepare(bindings, dualSlash, "DualSlash")
            bindings.attackTracks[3] = loadTrack(humanoid, dualSlash)
        end

        local dualStab = bindings.find(dual, "DualStab") :: Animation?

        if dualStab then
            prepare(bindings, dualStab, "DualStab")
            bindings.attackTracks[4] = loadTrack(humanoid, dualStab)
        end
    end

    if not bindings.resumeAfterSetup then
        return
    end

    bindings.setNamedTrack("Fallback", loadTrack(humanoid, bindings.fallbackAnimations[1] :: Animation))

    for index = 1, 3 do
        bindings.fallbackTracks[index] = loadTrack(humanoid, bindings.fallbackAnimations[index + 1] :: Animation)
    end

    for index = 1, 2 do
        bindings.extraTracks[index] = loadTrack(humanoid, bindings.extraAnimations[index] :: Animation)
    end
end
end)()

local setupKnifePerk = (function()
type Trail = { Clone: (Trail) -> Trail }
