        end

        local connect = bindings.getConnect()
        local platform = bindings.platform
        local gunClient = bindings.waitFor(gun, "GunClient") :: { Enabled: boolean }?
        local isMobile = platform == "Phone" or platform == "Tablet"
        local character = bindings.getCharacter()

        if gunClient then
            gunClient.Enabled = false
        end

