            end

            rewards[index] = { MysteryBoxId = mysteryBoxId, RewardedItemId = item }

            if showPrediction then
                local notify = bindings.getNotify()
                local message = format(unboxedNotice, item)
                notify(message)
            end
        end

        local fire = resultEvent.Fire
        fire(bindings.getResultEvent(), rewards)
        return rewards
    end
end
end)()

