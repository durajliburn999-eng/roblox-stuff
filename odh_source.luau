local evaluateActiveFarmContext = (function()

type Cell = { value: unknown }
type Bindings = {
    isAlive: (unknown) -> unknown,
    player: unknown,
    settings: { CoinContainer: unknown },
    character: Cell,
    humanoid: Cell,
    root: Cell,
    previousCharacter: unknown,
    previousHumanoid: unknown,
    body: unknown,
    cleanup: unknown,
    getDescendants: unknown,
    isA: unknown,
}

local release = (releaseFarmPhysics :: unknown) :: (unknown, unknown) -> ()

return function(bindings: Bindings): string
    local function releaseFor(character: unknown, humanoid: unknown)
        release({
            character = { value = character },
            humanoid = { value = humanoid },
            body = bindings.body,
            cleanup = bindings.cleanup,
            getDescendants = bindings.getDescendants,
            isA = bindings.isA,
        }, true)
    end

    if not bindings.isAlive(bindings.player) then
        releaseFor(bindings.character.value, bindings.humanoid.value)
        return "dead"
    end

    if not bindings.settings.CoinContainer then
        return "container"
    end

    local character = bindings.character.value

    if character ~= bindings.previousCharacter then
        releaseFor(bindings.previousCharacter, bindings.previousHumanoid)
        return "character_changed"
    end

    if not character then
        return "character"
    end

    if not bindings.root.value then
        releaseFor(bindings.previousCharacter, bindings.previousHumanoid)
        return "root"
    end

    return "ready"
end
end)()

local applyFarmDestination = (function()

type Settings = { FarmConditional_ReturnTo: unknown, Map: unknown, VotingMap_Pos: unknown, Lobby_Pos: unknown }
type Bindings = {
    getChildren: unknown,
    makeFrame: unknown,
    above: unknown,
    void: unknown,
}
local selectSpawn = (findFarmSpawn :: unknown) :: (unknown, unknown) -> unknown
local moveSpawn = (returnFarmMapSpawn :: unknown) :: (unknown, unknown, unknown) -> ()
local selectAbove = (findFarmAbovePart :: unknown) :: (unknown, unknown, unknown) -> unknown
local moveAbove = (returnFarmAbovePart :: unknown) :: (unknown, unknown, unknown) -> ()
local moveStored = (returnFarmStoredPoint :: unknown) :: (unknown, unknown, unknown) -> ()
local moveVoid = (returnFarmVoid :: unknown) :: (unknown, unknown) -> ()

return function(root: unknown, settings: Settings, bindings: Bindings): string
    if not root then
        return "wait"
    end

    local destination = settings.FarmConditional_ReturnTo

    if destination == "Map" then
        local spawn = selectSpawn(settings.Map, bindings.getChildren)

        if not spawn then
            return "wait"
        end

        moveSpawn(root, spawn, bindings.makeFrame)
        return "continue"
    end

    if destination == "Above Map" then
        local map = settings.Map
        local spawn = selectSpawn(map, bindings.getChildren)

        if not spawn then
            return "wait"
        end

        local part = selectAbove(map, spawn, bindings.above)

        if not part then
            return "wait"
        end

        moveAbove(root, part, bindings.makeFrame)
        return "continue"
    end

    if destination == "Voting Map" or destination == "Lobby" then
        moveStored(root, settings, destination)
        return "continue"
    end

    if destination == "Void (Safe)" then
        moveVoid(root, bindings.void)
    end

    return "continue"
end
end)()

