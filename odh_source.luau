    getRoot: () -> Values?, getHumanoid: () -> Values?, getChangeState: () -> (unknown, unknown) -> (), jumping: unknown }

return function(name: string, object: Object, bindings: Bindings)
    if object.Parent ~= bindings.workspace then return end

    local state = bindings.state
    if name == "Handle" then
        if not state.FakeBombClutch then return end
        if not bindings.wait(0.175) then return end
        if not bindings.find(object, "Fuse") then return end
        local creator = bindings.find(object, "creator")
        if not creator or creator.ClassName ~= "ObjectValue" or creator.Value ~= bindings.player then return end
    else
        if not state.FirefliesClutch then return end
        local handle = state.FireFlyHandle2
        if not handle then return end
        if handle.Transparency == 0 or state.FireFlyDebounce then return end
        state.FireFlyDebounce = true
    end

    if state.AutoTeleportOnThrow then
        local root = bindings.getRoot()
        if not root then return end
        root.CFrame = object.CFrame * bindings.offset
    end

    if state.AutoJumpWhenTeleported then
        local humanoid = bindings.getHumanoid()
        if humanoid then bindings.getChangeState()(humanoid, bindings.jumping) end
    end
end
end)() :: unknown)

standaloneModules.processWorldThrowingKnife = ((function()
type Values = { [string]: any }
type Bindings = {
    settings: Values,
    murderers: { string },
    playerName: string,
    players: { Values },
    sound: Values,
    find: (Values, string) -> Values?,
    dot: (any, any) -> number,
    kill: (Values) -> (),
    wait: () -> (),
}

return function(object: Values, bindings: Bindings)
    local settings = bindings.settings
    if object.ClassName ~= "Model" or not settings.ThrowingKnifeAura or settings.MapMode == "Assassin" then return end
    if #bindings.murderers ~= 1 or bindings.murderers[1] ~= bindings.playerName then return end

    if settings.CustomKnifeThrowEnabled then
        local soundId = if settings.UseKnifeThrowSoundPreset then settings.CustomKnifeThrowId1 else settings.CustomKnifeThrowId2
        bindings.sound.SoundId = soundId or ""
        bindings.sound:Play()
    end

    local originalParent = object.Parent
    local getPivot = object.GetPivot
    local distance = settings.ThrowingKnifeRange
    local range = distance * distance

    while object.Parent == originalParent and settings.ThrowingKnifeAura do
        local position = getPivot(object).Position

        for index = 2, #bindings.players do
            local player = bindings.players[index]
            local character = player.Character
            if not character then continue end

            local root = bindings.find(character, "HumanoidRootPart")
            if not root then continue end

            local delta = root.Position - position
            if bindings.dot(delta, delta) <= range then
                bindings.kill(player)
                return
            end
        end

        bindings.wait()
    end
end
end)() :: unknown)

