    getReload: () -> unknown,
}

local function gunshotSoundId(settings: Settings): unknown
    if settings.UseGunshotSoundPreset then
        return settings.CustomGunshotId1
    end

    return settings.CustomGunshotId2
end

local function reloadSoundId(settings: Settings): unknown
    if settings.UseGunReloadSoundPreset then
        return settings.CustomGunReloadId1
    end

    return settings.CustomGunReloadId2
end

return function(bindings: Bindings): (unknown, Sound)
