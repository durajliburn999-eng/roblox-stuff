standaloneModules.createMainLoops = ((function()
type Cell = { value: unknown }
type Bindings = {
    settings: { AutoJump: unknown, AutoClick: unknown, FreezeCharacter: unknown },
    getWait: () -> (() -> ()),
    humanoid: Cell,
    jumping: unknown,
    freefall: unknown,
    getState: () -> ((unknown) -> unknown),
    getChangeState: () -> ((unknown, unknown) -> ()),
    virtualUser: Cell,
    captureController: (unknown) -> (),
    buttonDown: (unknown, unknown) -> (),
    clickPosition: unknown,
    character: Cell,
    getChildren: (unknown) -> { { ClassName: unknown, Anchored: unknown } },
}

return function(bindings: Bindings)
    local settings = bindings.settings
    local getWait = bindings.getWait
    local humanoid = bindings.humanoid
    local jumping = bindings.jumping
    local freefall = bindings.freefall
    local getState = bindings.getState
    local getChangeState = bindings.getChangeState
    local virtualUser = bindings.virtualUser
    local captureController = bindings.captureController
    local buttonDown = bindings.buttonDown
    local clickPosition = bindings.clickPosition
    local character = bindings.character
    local getChildren = bindings.getChildren

    local function autoJump()
        local wait = getWait()
        local state = getState()
        local changeState = getChangeState()

        while settings.AutoJump do
            wait()
            local current = humanoid.value

            if not current then
                continue
            end

            local currentState = state(current)

            if currentState == jumping or currentState == freefall then
                continue
            end

            changeState(current, jumping)
        end
    end

    local function autoClick()
        local wait = getWait()

        while settings.AutoClick do
            wait()
            captureController(virtualUser.value)
            buttonDown(virtualUser.value, clickPosition)
        end
    end

    local function freeze()
        while true do
            getWait()()
            local current = character.value

            if not current then
                continue
            end

            local enabled = settings.FreezeCharacter
            local objects = getChildren(current)

            for index = 1, #objects do
                local object = objects[index]
                local class = object.ClassName

                if class == "Part" or class == "MeshPart" then
                    object.Anchored = enabled
                end
            end

            if not enabled then
                return
            end
        end
    end

    return { autoJump = autoJump, autoClick = autoClick, freeze = freeze }
end
end)())

standaloneModules.createMainServerLoops = ((function()
type Values = { [string]: unknown }
type Bindings = {
    settings: Values, getWait: () -> ((number?) -> ()), getIdle: () -> (() -> ()),
    getPlayer: () -> Values, prestige: (unknown) -> (), prestigeTarget: unknown, manualPrestige: (unknown) -> (), manualPrestigeTarget: unknown,
    timer: Values, getColor: () -> ((number, number, number) -> unknown), getFormat: () -> ((string, ...unknown) -> string),
}

return function(bindings: Bindings)
    local settings = bindings.settings
    return {
        manualPrestige = function() bindings.manualPrestige(bindings.manualPrestigeTarget) end,
        firstPerson = function()
            local wait, player, idle = bindings.getWait(), bindings.getPlayer(), bindings.getIdle()
            repeat
                while settings.LoopToFirstPersonCamera do
                    wait()
                    if player.CameraMode ~= "LockFirstPerson" then player.CameraMode = "LockFirstPerson" end
                end
                idle()
            until false
        end,
        prestige = function()
            local wait, idle = bindings.getWait(), bindings.getIdle()
            repeat
                while settings.AutoPrestige do
                    bindings.prestige(bindings.prestigeTarget)
                    wait(1)
                end
                idle()
            until false
        end,
        timer = function()
            local wait = bindings.getWait()
            local color = bindings.getColor()
            local idle = bindings.getIdle()
            local format = bindings.getFormat()
            local red, white = color(255, 0, 0), color(255, 255, 255)
            repeat
                while settings.ShowRoundTimer do
                    wait(0.25)
                    local seconds = settings.RoundTime :: number
                    if seconds < 1 then bindings.timer.Visible = false; continue end
                    local minutes, remainder = seconds % 3600 // 60, seconds % 60
                    if minutes > 0 then
                        bindings.timer.Text = format("%*m %*s", minutes, remainder)
                        bindings.timer.TextColor3 = white
                    else
                        bindings.timer.Text = tostring(remainder) .. "s"
                        bindings.timer.TextColor3 = red
                    end
                    bindings.timer.Visible = true
                end
                bindings.timer.Visible = false
                idle()
            until false
        end,
    }
