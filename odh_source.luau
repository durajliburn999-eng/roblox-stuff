local populatePremiumUi = (function()

type Section = {
    AddLabel: (Section, string) -> (),
    AddParagraph: (Section, string, string) -> (),
    AddToggle: (Section, string, unknown) -> (),
    AddButton: (Section, string, unknown) -> (),
    AddSlider: (Section, string, number, number, number, unknown) -> (),
    AddDropdown: (Section, string, unknown, unknown) -> unknown,
    AddTextBox: (Section, string, unknown) -> (),
    AddColorpicker: (Section, string, unknown, unknown) -> (),
}
type Tab = { AddSection: (Tab, string, string?) -> Section }
type Bindable = (number, unknown, string, string, unknown, unknown, unknown) -> Section
type Bindings = {
    settings: unknown,
    stateDispatch: unknown,
    stateTransform: unknown,
    bindable: Bindable,
    callbacks: { [string]: unknown },
    options: { [string]: unknown },
    shootColor: unknown,
    desyncKeybind: unknown,
    onSoundDropdown: ((string, unknown) -> ())?,
}
local makeState = (createStateCallback :: unknown) :: (unknown) -> (number, string, unknown) -> unknown
local desyncUi = (standaloneModules.populatePremiumDesyncUi :: unknown) :: (unknown, unknown) -> unknown
local serverUi = (standaloneModules.populatePremiumServerUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local cosmeticsUi = (standaloneModules.populatePremiumCosmeticsUi :: unknown) :: (unknown, unknown, unknown) -> unknown
local soundsUi = (standaloneModules.populatePremiumSoundsUi :: unknown) :: (unknown, unknown, unknown) -> ()
local cursorUi = (standaloneModules.populatePremiumCursorUi :: unknown) :: (unknown, unknown, unknown) -> unknown

return function(tab: Tab, bindings: Bindings)
    local state = makeState({ settings = bindings.settings, dispatch = bindings.stateDispatch, transform = bindings.stateTransform })
    desyncUi(tab, bindings)
    serverUi(tab, bindings, state)

    cosmeticsUi(tab, bindings, state)

    soundsUi(tab, bindings, state)

    cursorUi(tab, bindings, state)
end
end)()

local populatePremiumFeature = (function()

type Values = { [string]: unknown }
type Bindings = { ui: Values, effects: Values }
local populateUi = (populatePremiumUi :: unknown) :: (unknown, Values) -> ()
local makeControls = (standaloneModules.createPremiumControls :: unknown) :: (Values) -> { [string]: unknown }
local makeSoundRefresh = (standaloneModules.createSoundRefresh :: unknown) :: (Values) -> unknown
local makeTrade = (standaloneModules.createPremiumTrade :: unknown) :: (Values) -> { [string]: unknown }
local makeCursor = (standaloneModules.createPremiumCursor :: unknown) :: (Values) -> { [string]: unknown }
local makeDesync = (standaloneModules.createPremiumDesync :: unknown) :: (Values) -> unknown

return function(tab: unknown, bindings: Bindings)
    local ui = table.clone(bindings.ui)
    local callbacks = table.clone(ui.callbacks :: Values)
    local effects = table.clone(bindings.effects)
    effects.settings = ui.settings

    for key, callback in makeControls(effects) do
        callbacks[key] = callback
    end

    local tradeOptions = table.clone(effects.trade :: Values)
    tradeOptions.settings = ui.settings
    local trade = makeTrade(tradeOptions)
    callbacks["Break Trade"] = trade.breakTrade
    callbacks["Reset Trade Cooldown"] = trade.reset
    callbacks["Loop Reset Trade Cooldown"] = trade.loopReset
    callbacks["Custom Shoot Color Effect"] = trade.shootColor

    local cursorOptions = table.clone(effects.cursor :: Values)
    cursorOptions.settings = ui.settings
    local cursor = makeCursor(cursorOptions)
    callbacks["Enable Custom Cursor"] = cursor.custom
    callbacks["Animate Cursor"] = cursor.animate
    callbacks.Desync = makeDesync(effects.desync :: Values)

    local refreshOptions = effects.refresh :: { [string]: Values }
    local refreshBindings: { [string]: Values } = {}

    for _, name in { "Knife Throw", "Knife Kill", "Gunshot", "Gun Reload" } do
        local config = table.clone(refreshOptions[name])
        refreshBindings[name] = config
        callbacks["Refresh " .. name .. " Sound Presets"] = makeSoundRefresh(config)
    end

    ui.onSoundDropdown = function(name: string, dropdown: unknown)
        refreshBindings[name].dropdown = dropdown
    end
    ui.callbacks = callbacks
    populateUi(tab, ui)
end
end)()

