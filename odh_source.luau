standaloneModules.createUiScrollIndicator = ((function()
type Values = { [string]: unknown }
type Bindings = {
    owner: Values, createInstance: (string) -> Values, parent: unknown,
    navigate: unknown, indicator: unknown, search: unknown,
    fromScale: (number, number) -> unknown, vector: (number, number) -> unknown,
    fromRGB: (number, number, number) -> unknown, font: unknown,
    tweenInfo: (number, unknown) -> unknown, cubic: unknown, transitionInfo: unknown,
    createTween: (unknown, unknown, unknown, Values) -> unknown, tweenService: unknown,
}

return function(bindings: Bindings): Values
    local tween = bindings.createTween
    local service, info = bindings.tweenService, bindings.transitionInfo
    local hideNavigate = tween(service, bindings.navigate, info, { ImageTransparency = 1 })
    local hideIndicator = tween(service, bindings.indicator, info, { TextTransparency = 1 })
    local hideSearch = tween(service, bindings.search, info, { GroupTransparency = 1 })
    local containerGoal = { Position = bindings.fromScale(0.5, 1.35) }
    local instruction = bindings.createInstance("TextLabel")
    instruction.Name = "Instruction"
    instruction.Parent = bindings.parent
    instruction.BackgroundTransparency = 1
    instruction.AnchorPoint = bindings.vector(0.5, 0.5)
    instruction.Position = bindings.fromScale(0.5, 0.965)
    instruction.Font = bindings.font
    instruction.Text = "> Scroll to the right to show other tabs."
    instruction.TextSize = 12
    instruction.TextColor3 = bindings.fromRGB(255, 255, 255)
    instruction.TextTransparency = 1
    local instructionInfo = bindings.tweenInfo(1, bindings.cubic)
    local reveal = tween(service, instruction, instructionInfo, { TextTransparency = 0 })
    local hide = tween(service, instruction, instructionInfo, { TextTransparency = 1 })
    local scroll = tween(service, instruction, instructionInfo, { Position = bindings.fromScale(0.5, 1.2) })
    bindings.owner.scrollindicator_animation = scroll
    local restore = tween(service, instruction, instructionInfo, { Position = bindings.fromScale(0.5, 0.965) })
