        target.value = nil
    end
end
end)())

standaloneModules.createMainActions = ((function()
type Entry = { [number]: unknown }
type Node = { Parent: Node?, LocalTransparencyModifier: unknown }
type Bindings = {
    cameraFirst: { Entry },
    cameraSecond: { Entry },
    setCameraValue: (unknown, unknown, number) -> (),
    xrayTransparency: { value: unknown },
    world: { value: unknown },
    getDescendants: (unknown) -> { Node },
    isA: (Node, string) -> unknown,
    findChild: (unknown, string) -> unknown,
}

return function(bindings: Bindings)
    local cameraFirst = bindings.cameraFirst
    local cameraSecond = bindings.cameraSecond
    local setCameraValue = bindings.setCameraValue
    local transparency = bindings.xrayTransparency
    local world = bindings.world
    local getDescendants = bindings.getDescendants
    local isA = bindings.isA
    local findChild = bindings.findChild

    local function cameraNoclip(enabled: unknown)
        local first = if enabled then 0 else 0.25
        local second = if enabled then 0.25 else 0

        for index = 1, #cameraFirst do
            local entry = cameraFirst[index]
            setCameraValue(entry[1], entry[2], first)
        end

        for index = 1, #cameraSecond do
            local entry = cameraSecond[index]
            setCameraValue(entry[1], entry[2], second)
        end
    end

    local function xray(enabled: unknown)
        local value = if enabled then transparency.value else 0
        local objects = getDescendants(world.value)

        for index = 1, #objects do
            local object = objects[index]

            if not isA(object, "BasePart") then
