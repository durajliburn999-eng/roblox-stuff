    local bulletOk, bulletResult = protect(loadModule, bulletModule)
    local frameworkOk, frameworkResult = protect(loadModule, frameworkModule)
    local bullet = if bulletOk then bulletResult else nil
    local framework = if frameworkOk then frameworkResult else nil
    local fire = if bullet then (bullet :: Values).Fire else nil
    local constructor = if framework then (framework :: Values).new else nil
    local camera = ownerUi.camera :: { ViewportSize: vector }
