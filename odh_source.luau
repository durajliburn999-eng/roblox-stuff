        local state = bindings.getState
        local expiry = state[bindings.expiryKey] :: number

        repeat
            if state[bindings.updateKey] then
                expiry = state[bindings.expiryKey] :: number
            end

            local remaining = expiry - bindings.clock()
            local progress = remaining / 86400

            if progress < 0 then
                bindings.onExpired(bindings.expiredArgument)
                return
            end

            if progress > 1 then
                progress = 1
            end

            bindings.write(bindings.progressObject, bindings.progressKey, bindings.makeProgress(progress, 1))
            local days = remaining // 86400
            local hours = remaining % 86400 // 3600
            local minutes = remaining % 3600 // 60
            local seconds = remaining % 60
            local message = bindings.format(bindings.messageTemplate, days, hours, minutes, seconds)
            bindings.write(bindings.labelObject, bindings.labelKey, message)
            bindings.wait(0.35)
        until false
    end
end
end)())

local decodeAsset = (function()
local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local digits: { [number]: number } = {}

for index = 1, #ALPHABET do
    digits[string.byte(ALPHABET, index)] = index - 1
end

return function(encoded: string): string
    assert(#encoded % 4 == 0, "Invalid asset encoding length")

    local padding = string.sub(encoded, -2) == "==" and 2 or string.sub(encoded, -1) == "=" and 1 or 0
    local byteCount = #encoded / 4 * 3 - padding
    local decoded = buffer.create(byteCount)
    local destination = 0

    for offset = 1, #encoded, 4 do
        local first, second, third, fourth = string.byte(encoded, offset, offset + 3)
        local isLast = offset + 3 == #encoded
        assert(third ~= 61 or (isLast and fourth == 61), "Invalid asset padding")
        assert(fourth ~= 61 or isLast, "Invalid asset padding")

        local word = assert(digits[first], "Invalid asset digit") * 262144
        word += assert(digits[second], "Invalid asset digit") * 4096
        word += (third == 61 and 0 or assert(digits[third], "Invalid asset digit")) * 64
        word += fourth == 61 and 0 or assert(digits[fourth], "Invalid asset digit")

        buffer.writeu8(decoded, destination, bit32.rshift(word, 16))

        if destination + 1 < byteCount then
            buffer.writeu8(decoded, destination + 1, bit32.band(bit32.rshift(word, 8), 255))
        end

        if destination + 2 < byteCount then
            buffer.writeu8(decoded, destination + 2, bit32.band(word, 255))
        end

        destination += 3
    end

    return buffer.tostring(decoded)
end
end)()

local decodePixels = (function()
local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local digits: { [number]: number } = {}

for index = 1, #ALPHABET do
    digits[string.byte(ALPHABET, index)] = index - 1
end

local function decodeBase64(text: string): buffer
    assert(#text % 4 == 0, "Invalid image encoding length")

    local padding = string.sub(text, -2) == "==" and 2 or string.sub(text, -1) == "=" and 1 or 0
    local output = buffer.create(#text / 4 * 3 - padding)
    local destination = 0

    for offset = 1, #text, 4 do
        local first, second, third, fourth = string.byte(text, offset, offset + 3)
        local high = bit32.lshift(assert(digits[first]), 18)
        local middle = bit32.lshift(assert(digits[second]), 12)
        local low = bit32.lshift(digits[third] or 0, 6)
        local word = high + middle + low + (digits[fourth] or 0)

        for shift = 16, 0, -8 do
            if destination < buffer.len(output) then
                buffer.writeu8(output, destination, bit32.band(bit32.rshift(word, shift), 255))
                destination += 1
            end
        end
    end

    return output
end

return function(text: string, pixelBytes: number): buffer
    local packed = decodeBase64(text)
    local pixels = buffer.create(pixelBytes)
    local source = 0
    local destination = 0

    local function readLength(length: number): number
        if length ~= 15 then
            return length
        end

        while source < buffer.len(packed) do
            local extra = buffer.readu8(packed, source)
            source += 1
            length += extra

            if extra ~= 255 then
                return length
            end
        end

        error("Truncated image length")
    end

    while source < buffer.len(packed) do
        local token = buffer.readu8(packed, source)
        source += 1
        local literals = readLength(bit32.rshift(token, 4))
        buffer.copy(pixels, destination, packed, source, literals)
        source += literals
        destination += literals

        if source == buffer.len(packed) then
            break
        end

        local distance = buffer.readu16(packed, source)
        source += 2
        local remaining = readLength(bit32.band(token, 15)) + 4
        assert(distance > 0 and distance <= destination, "Invalid image back reference")
        local origin = destination - distance

        while remaining > 0 do
            local count = math.min(remaining, destination - origin)
            buffer.copy(pixels, destination, pixels, origin, count)
            destination += count
            remaining -= count
        end
    end

    assert(destination == pixelBytes, "Invalid decoded image length")
    return pixels
end
end)()

standaloneModules.animateSprite = ((function()
type Node = { [string]: unknown }
