standaloneModules.createUiConsoleObserver = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    local state = bindings.state
    local findChild, waitForChild, getChildren = bindings.findChild, bindings.waitForChild, bindings.getChildren
    local connect, disconnect = bindings.connect, bindings.disconnect
    local onMessage = bindings.onMessage

    local function onViewAdded(view: Values)
        if view.Name ~= "MainView" then return end

        state.view = view
        local log = waitForChild(view, "ClientLog", 1.5)
        if not log then return end

        local children = getChildren(log)
        state.log = log
        state.connection = connect(log.ChildAdded, onMessage)
        for _, child in children do onMessage(child) end
    end

    local function onViewRemoved(view: Values)
        if view ~= state.view then return end
        state.view = nil
        disconnect(state.connection)
    end

    local function onConsoleAdded(master: Values)
        if master.Name ~= "DevConsoleMaster" then return end

        local window = findChild(master, "DevConsoleWindow")
        if not window then return end
        local screen = findChild(window, "DevConsoleUI")
        if not screen then return end

        local children = getChildren(screen)
        connect(screen.ChildAdded, onViewAdded)
        connect(screen.ChildRemoved, onViewRemoved)
        state.screen = screen
        for _, child in children do
            if child.Name ~= "MainView" then continue end
            onViewAdded(child)
            break
        end
    end

    return { onViewAdded = onViewAdded, onViewRemoved = onViewRemoved, onConsoleAdded = onConsoleAdded }
end
end)())

