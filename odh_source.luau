standaloneModules.createUiPlayback = ((function()
type Playable = { ClassName: unknown }
type Bindings = {
    playTween: (Playable) -> (),
    getSpawn: () -> (((Playable) -> (), Playable) -> ()),
    awaitCompletion: (Playable) -> (),
    playSound: (Playable) -> (),
}

return function(bindings: Bindings)
    local playTween = bindings.playTween
    local awaitCompletion = bindings.awaitCompletion
    local playSound = bindings.playSound

    return function(item: Playable?, waitForCompletion: unknown)
        if not item then
            return
        end

        local className = item.ClassName

        if className == "Tween" then
            playTween(item)

            if waitForCompletion then
                bindings.getSpawn()(awaitCompletion, item)
            end

            return
        end

        if className == "Sound" then
            playSound(item)
        end
    end
end
end)() :: unknown)

standaloneModules.createUiCleanup = ((function()
type Bindings = {
    getChildren: (unknown) -> { unknown },
    destroy: (unknown) -> (),
    wait: (unknown) -> (),
}
type Tween = { Completed: unknown }

return function(bindings: Bindings)
    local getChildren = bindings.getChildren
    local destroyInstance = bindings.destroy
    local wait = bindings.wait

    local function destroy(object: unknown)
        if not object then
            return
        end

        local children = getChildren(object)

        for index = 1, #children do
            destroyInstance(children[index])
        end

        destroyInstance(object)
    end

    local function awaitCompletion(tween: Tween)
        wait(tween.Completed)
        destroy(tween)
    end

    return { destroy = destroy, awaitCompletion = awaitCompletion }
end
end)() :: unknown)

