    getConnect: () -> ((unknown, string) -> unknown), rotationTarget: unknown, connection: Cell,
    await: (unknown) -> (), getDisconnect: () -> ((unknown) -> ()), rotation: Cell?,
}

return function(bindings: Bindings, resetRotation: boolean)
    return function(value: unknown)
        if value then
            bindings.frame.Visible = true
            bindings.play(bindings.showTween)
            bindings.connection.value = bindings.getConnect()(bindings.rotationTarget, "Rotation")
            bindings.await(bindings.showTween.Completed)
            return
        end
        bindings.play(bindings.hideTween)
        local connection = bindings.connection.value
        if connection then bindings.getDisconnect()(connection) end
        bindings.await(bindings.hideTween.Completed)
        bindings.frame.Visible = false
        if resetRotation then (bindings.rotation :: Cell).value = 0 end
    end
end
end)())

