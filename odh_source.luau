        local humanoid = bindings.target.value :: Values
        if (humanoid.Health :: number) > 0 then return end
        local wait = bindings.getWait()
        local changeState = bindings.getChangeState()
        changeState(humanoid, 11)
        wait(2.5)
        humanoid.Health = 100
        wait(1)
        changeState(humanoid, 1)
        humanoid.Health = 100
    end

    local function activate()
        local wait = bindings.getWait()
        local previous = bindings.previous.value
        bindings.getDisconnect()(bindings.connection.value)
        local current
        repeat
            current = bindings.current.value
            if current == previous then current = nil end
            wait()
        until current
        local connection = bindings.getConnect()(bindings.getSignal(current, "Health"), onHealthChanged)
        bindings.connection.value, bindings.target.value, bindings.previous.value = connection, current, current
    end

    return { activate = activate, onHealthChanged = onHealthChanged }
