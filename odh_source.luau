standaloneModules.performanceActions = ((function()
type Object = { ClassName: unknown, Enabled: unknown, Parent: { Parent: unknown }, Material: unknown }
type Terrain = { WaterWaveSize: unknown, WaterWaveSpeed: unknown, WaterReflectance: unknown, WaterTransparency: unknown }
type Lighting = { FogEnd: unknown }
type FpsBindings = {
    remove: (Object) -> (), isA: (Object, string) -> unknown,
    findChild: (unknown, string) -> unknown, getDescendants: (unknown) -> { Object },
    world: { value: unknown },
}
type LagBindings = {
    lighting: { value: Lighting? }, findChild: (unknown, string) -> Terrain?, world: { value: unknown },
}

local function fpsBoost(bindings: FpsBindings)
    local remove = bindings.remove
    local isA = bindings.isA
    local findChild = bindings.findChild
    local getDescendants = bindings.getDescendants
    local world = bindings.world

    return function()
        local objects = getDescendants(world.value)

        for index = 1, #objects do
            local object = objects[index]
            local className = object.ClassName

            if className == "Texture" then
                remove(object)
                continue
            end

            if className == "ParticleEmitter" or className == "Trail" or className == "PointLight"
                or className == "SpotLight" or className == "SurfaceLight" then
                object.Enabled = false
                continue
            end

            if not isA(object, "BasePart") then
                continue
            end

            local parent = object.Parent

            if findChild(parent, "Humanoid") then
                continue
            end

            if findChild(parent.Parent, "Humanoid") then
                continue
            end

            object.Material = "SmoothPlastic"
        end
    end
end

local function reduceLag(bindings: LagBindings)
    local lighting = bindings.lighting
    local findChild = bindings.findChild
    local world = bindings.world

    return function()
        local currentLighting = lighting.value

        if not currentLighting then
            return
        end

        local terrain = findChild(world.value, "Terrain")

        if not terrain then
            return
        end

        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 0
        currentLighting.FogEnd = 900000000
    end
end

return { fpsBoost = fpsBoost, reduceLag = reduceLag }
end)())

