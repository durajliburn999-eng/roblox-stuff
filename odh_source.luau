        local particles = particleSetup.particles
        local owner = ownerCore.owner :: Values
        local busy: unknown = nil
        local scroll: unknown = nil
        local getOwner = function() return owner end
        local getOffset = function() return (environment.UDim2 :: Values).fromOffset end
        local getPosition = function() return (environment.UDim2 :: Values).new end
        local getWait = function() return wait end
