local createLiveEsp = (function()
-- Record538: classify newly added objects and apply enabled ESP styles.

type Object = { Name: string, ClassName: string }
type Bindings = {
    styles: { string },
    options: { [string]: { [number]: unknown } },
    active: { [unknown]: unknown },
    getFormat: () -> ((string, ...unknown) -> string),
    getGameName: () -> unknown,
    getWait: () -> ((number) -> ()),
    getCoinColors: () -> unknown,
    getAttribute: (unknown, string) -> unknown,
    getRgb: () -> unknown,
    getWorkspace: () -> unknown,
    getDefaultColor: () -> unknown,
    getDepthMode: () -> unknown,
    environment: unknown,
    write: (unknown, string, unknown) -> (),
    render: { [string]: unknown },
}
type Context = { [string]: unknown }
local classify = (classifyEspObject :: unknown) :: (Context) -> ()
local render = (renderLiveEsp :: unknown) :: (Context) -> ()
local stylesWithRenderers = { Cham = true, Outline = true, Highlight = true, ESP = true, Tracer = true, ["ESP Box"] = true }

return function(bindings: Bindings)
    return function(object: Object)
        local styles, options, active = bindings.styles, bindings.options, bindings.active
        local format = bindings.getFormat()
        local gameName = bindings.getGameName()
        local name, className = object.Name, object.ClassName
        local wait = bindings.getWait()
        wait(0.1)
        local renderBindings = table.clone(bindings.render)
        renderBindings.active = active
        local context: Context = {
            environment = bindings.environment,
            write = bindings.write,
            object = object,
            objectName = name,
            className = className,
            styles = styles,
            options = options,
            active = active,
            format = format,
            gameName = gameName,
            bindings = renderBindings,
            getCoinColors = bindings.getCoinColors,
            getAttribute = bindings.getAttribute,
            getRgb = bindings.getRgb,
            getWorkspace = bindings.getWorkspace,
            getDefaultColor = bindings.getDefaultColor,
            getDepthMode = bindings.getDepthMode,
        }
        classify(context)
        local count = #styles

        for index = 1, count do
            local style = styles[index]
            local key = format("%*%*%*", style, context.objectName, className)
            local option = options[key]

            if not option or not option[6] then
                continue
            end

            local title, global = option[2], option[5]

            if not stylesWithRenderers[style] then
                continue
            end

            context.style, context.key, context.title, context.global = style, key, title, global
            render(context)
        end
    end
end
end)()

