standaloneModules.createUiDraggable = ((function()
type Vector = typeof(setmetatable({ X = 0, Y = 0, Magnitude = 0 }, {
    __sub = function(left, _right) return left end,
    __div = function(left, _right) return left end,
}))
type Dimension = { Scale: number, Offset: number }
type Position = { X: Dimension, Y: Dimension }
type Input = { UserInputType: unknown, Position: Vector }
type Target = { InputBegan: unknown, InputChanged: unknown, InputEnded: unknown, Position: Position }
type InputTypes = { Touch: unknown, MouseButton1: unknown, MouseMovement: unknown }
type Bindings = {
    getClock: () -> (() -> number),
    clickData: unknown,
    getConnect: () -> ((unknown, (Input) -> ()) -> ()),
    getInputTypes: () -> InputTypes,
    getVector: () -> ((number?, number?) -> Vector),
    getPosition: () -> ((number, number, number, number) -> Position),
}

return function(bindings: Bindings)
    return function(target: Target, releaseData: unknown, startData: unknown, notify: (unknown) -> (), click: (() -> ())?, lockable: unknown)
        local clock = bindings.getClock()
        local clickData = bindings.clickData
        local connect = bindings.getConnect()
        local inputTypes = bindings.getInputTypes()
        local makeVector = bindings.getVector()
        local makePosition = bindings.getPosition()
        local previous = makeVector()
        local started = 0
        local active: boolean? = nil
        local initialInput: Vector? = nil
        local initialPosition: Position? = nil
        local lock: { [number]: unknown }? = if lockable then {} else nil

        connect(target.InputBegan, function(input: Input)
            local inputType = input.UserInputType
            if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then
                return
            end

            started = clock()
            initialInput = input.Position
            initialPosition = target.Position
            active = true
            notify(startData)
        end)
        connect(target.InputChanged, function(input: Input)
            if not active or (lock and lock[1]) then
                return
            end

            local inputType = input.UserInputType
            if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseMovement then
                return
            end

            local position = initialPosition :: Position
            local x, y = position.X, position.Y
            local delta = (input.Position - (initialInput :: Vector)) / 1.25
            local nextX, nextY = x.Offset + delta.X, y.Offset + delta.Y
            local nextPosition = makePosition(x.Scale, nextX, y.Scale, nextY)
            local point = makeVector(nextX, nextY)
            if (previous - point).Magnitude > 99 then
                return
            end

            target.Position = nextPosition
            previous = point
        end)
        connect(target.InputEnded, function(input: Input)
            if not active then
                return
            end

            local inputType = input.UserInputType
            if inputType ~= inputTypes.Touch and inputType ~= inputTypes.MouseButton1 then
                return
            end

            active = false
            notify(releaseData)
            if clock() - started >= 0.3 or not click then
                return
            end

            notify(clickData)
            local activate = click :: () -> ()
            activate()
        end)
        return lock
    end
end
end)() :: unknown)

standaloneModules.createUiOpen = ((function()
type Node = { [string]: unknown }
type Dimension = { Scale: number, Offset: number }
type Position = { X: Dimension, Y: Dimension }
type Tween = { Completed: unknown }
type Entry = { [number]: unknown }
type Owner = { MaximizeCanDrag: unknown, NoMinimizeMaximizeAnimations: unknown, GuiCanDrag: unknown }
type Bindings = {
    play: (unknown, boolean?) -> (),
    sound: unknown,
    getBusy: () -> unknown,
    setBusy: (boolean) -> (),
    getOwner: () -> Owner,
    window: Node,
    maximize: Node,
    getPosition: () -> ((number, number, number, number) -> unknown),
    getOffset: () -> ((number, number) -> unknown),
    getParent: () -> unknown,
    openingTween: unknown,
    getWait: () -> ((number) -> ()),
    particles: { Entry },
    tweenInfo: unknown,
    getConnect: () -> ((unknown, unknown) -> unknown),
    getRandom: () -> ((number, number) -> number),
    getCreateTween: () -> ((unknown, unknown, unknown, unknown) -> Tween),
    getTweenService: () -> unknown,
    particleGoal: Node,
    startTween: unknown,
    finishTween: Tween,
    waitCompleted: (unknown) -> (),
}

return function(bindings: Bindings)
    local play = bindings.play
    local window = bindings.window
    local maximize = bindings.maximize
    local particles = bindings.particles
    local sound = bindings.sound
    local openingTween = bindings.openingTween
    local tweenInfo = bindings.tweenInfo
    local particleGoal = bindings.particleGoal
    local startTween = bindings.startTween
    local finishTween = bindings.finishTween
    local waitCompleted = bindings.waitCompleted

    return function()
        play(sound)
        if bindings.getBusy() or not bindings.getOwner().MaximizeCanDrag then
            return
        end

        bindings.setBusy(true)
        local makePosition = bindings.getPosition()
        local fromOffset = bindings.getOffset()
        bindings.getOwner().MaximizeCanDrag = false
        window.Parent = bindings.getParent()

        if bindings.getOwner().NoMinimizeMaximizeAnimations then
            window.Size = fromOffset(600, 300)
            maximize.Size = fromOffset(0, 0)
        else
            local wait = bindings.getWait()
            local connect = bindings.getConnect()
            local random = bindings.getRandom()
            local createTween = bindings.getCreateTween()
            local tweenService = bindings.getTweenService()
            local position = window.Position :: Position
            local x, y = position.X, position.Y
            local xScale, xOffset, yScale, yOffset = x.Scale, x.Offset, y.Scale, y.Offset
            local smallSize = fromOffset(10, 10)
            local origin = maximize.Position
            play(startTween)
            wait(0.25)
            play(openingTween)

            for index = 1, #particles do
                local entry = particles[index]
                local particle = entry[1] :: Node
                particleGoal.Position = makePosition(xScale, xOffset + random(-10000, 10000) / 100, yScale, yOffset + random(-10000, 10000) / 100)
                local tween = createTween(tweenService, particle, tweenInfo, particleGoal)
                particle.Position = origin
                particle.Size = smallSize
                particle.Visible = true
                play(tween, true)
                entry[3] = connect(tween.Completed, entry[2])
                wait(random(10, 50) / 10000)
                play(finishTween)
            end

            waitCompleted(finishTween.Completed)
        end

        maximize.Visible = false
        bindings.getOwner().GuiCanDrag = true
        bindings.setBusy(false)
    end
end
end)() :: unknown)

standaloneModules.createUiClose = ((function()
type Node = { [string]: unknown }
type Dimension = { Scale: number, Offset: number }
type Position = { X: Dimension, Y: Dimension }
type Tween = { Completed: unknown }
type Entry = { [number]: unknown }
type Owner = { MaximizeCanDrag: unknown, NoMinimizeMaximizeAnimations: unknown, GuiCanDrag: unknown }
type Bindings = {
    window: Node,
    minimize: Node,
    getOwner: () -> Owner,
    maximize: Node,
    play: (unknown, boolean?) -> (),
    sound: unknown,
    getOffset: () -> ((number, number) -> unknown),
    getColor: () -> ((number, number, number) -> unknown),
    getPosition: () -> ((number, number, number, number) -> unknown),
    waitCompleted: (unknown) -> (),
    finishTween: Tween,
    getRandom: () -> ((number, number) -> number),
    particles: { Entry },
    tweenInfo: unknown,
    getConnect: () -> ((unknown, unknown) -> unknown),
    getTweenService: () -> unknown,
    getCreateTween: () -> ((unknown, unknown, unknown, unknown) -> Tween),
    startTween: unknown,
    getWait: () -> ((number) -> ()),
    intermediateTween: unknown,
    minimizeColor: unknown,
}

return function(bindings: Bindings)
    local window = bindings.window
    local minimize = bindings.minimize
    local maximize = bindings.maximize
    local play = bindings.play
    local sound = bindings.sound
    local waitCompleted = bindings.waitCompleted
    local finishTween = bindings.finishTween
    local particles = bindings.particles
    local tweenInfo = bindings.tweenInfo
    local startTween = bindings.startTween
    local intermediateTween = bindings.intermediateTween
    local minimizeColor = bindings.minimizeColor

    return function()
        local owner = bindings.getOwner()
        play(sound)
        owner.GuiCanDrag = false
        owner.MaximizeCanDrag = false

        if owner.NoMinimizeMaximizeAnimations then
            window.Size = bindings.getOffset()(0, 0)
            maximize.BackgroundTransparency = 0.5
            maximize.BackgroundColor3 = bindings.getColor()(20, 20, 20)
            maximize.Size = bindings.getPosition()(0.025, 35, 0.025, 35)
            maximize.Visible = true
        else
            local random = bindings.getRandom()
            local makePosition = bindings.getPosition()
            local connect = bindings.getConnect()
            local tweenService = bindings.getTweenService()
            local createTween = bindings.getCreateTween()
            local position = window.Position :: Position
            play(startTween)
            bindings.getWait()(0.25)
            play(intermediateTween)
            maximize.BackgroundTransparency = 0.5
            maximize.BackgroundColor3 = bindings.getColor()(20, 20, 20)
            maximize.Visible = true
            local x, y = position.X, position.Y
            local xScale, xOffset, yScale, yOffset = x.Scale, x.Offset, y.Scale, y.Offset
            local smallSize = bindings.getOffset()(10, 10)
            local goal = { Position = maximize.Position }

            for index = 1, #particles do
                local entry = particles[index]
                local particle = entry[1] :: Node
                particle.Position = makePosition(xScale, xOffset + random(-10000, 10000) / 100, yScale, yOffset + random(-10000, 10000) / 100)
                particle.Size = smallSize
                particle.Visible = true
                local tween = createTween(tweenService, particle, tweenInfo, goal)
                play(tween, true)
                entry[3] = connect(tween.Completed, entry[2])
                bindings.getWait()(random(10, 50) / 1000)
                play(finishTween)
            end

            waitCompleted(finishTween.Completed)
        end

        owner.MaximizeCanDrag = true
        window.Parent = nil
        minimize.BackgroundTransparency = 0.5
        minimize.BackgroundColor3 = minimizeColor
    end
end
end)() :: unknown)

