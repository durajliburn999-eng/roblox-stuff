standaloneModules.createCombatDualItems = ((function()
type Values = { [string]: any }

return function(bindings: Values): Values
    local weapon = bindings.weapon
    local function added(item: Values)
        if item.Name ~= weapon or item.ClassName ~= "Tool" then return end
        bindings.getWait()()
        local character = bindings.character.value
        if not character then return end
        local handle = bindings.find(item, "Handle")
        if not handle then return end
        if not bindings.humanoid.value then return end
        local leftHand = bindings.find(character, "LeftHand")
        if not leftHand then return end
        local rightHand = bindings.find(character, "RightHand")
        if not rightHand then return end
        local rightGrip = bindings.find(rightHand, "RightGrip")
        if not rightGrip then return end
        local track = bindings.activeTrack.value
        local clone = rightGrip.Clone
        local secondHandle, leftGrip = clone(handle), clone(rightGrip)
        secondHandle.Name = "Handle1"
        secondHandle.Parent = item
        leftGrip.Name = "LeftGrip"
        leftGrip.Parent = leftHand
        leftGrip.Part0 = leftHand
        leftGrip.Part1 = secondHandle
        bindings.object1.value, bindings.object2.value = secondHandle, leftGrip
        track:Play()
    end
    local function removed(item: Values)
        if item.Name ~= weapon or item.ClassName ~= "Tool" then return end
        local track = bindings.activeTrack.value
        bindings.remove(bindings.object1.value)
        bindings.remove(bindings.object2.value)
        if track then track:Stop() end
    end
    return { added = added, removed = removed }
end
end)() :: unknown)

standaloneModules.createCombatDualCharacter = ((function()
type Values = { [string]: any }

return function(bindings: Values)
    return function(character: Values)
        local wait = bindings.getWait()
        local previous = bindings.previousHumanoid.value
        bindings.object1.value = nil
        bindings.object2.value = nil
        local humanoid
        repeat
            humanoid = bindings.getHumanoid()
            wait()
        until humanoid and humanoid ~= previous
        local disconnect, connect = bindings.getDisconnect(), bindings.getConnect()
        local children = bindings.getChildren(character)
        disconnect(bindings.childAddedConnection.value)
        disconnect(bindings.childRemovedConnection.value)
        bindings.activeTrack.value = humanoid:LoadAnimation(bindings.animation)
        bindings.childAddedConnection.value = connect(character.ChildAdded, bindings.onAdded)
        bindings.childRemovedConnection.value = connect(character.ChildRemoved, bindings.onRemoved)
        bindings.previousHumanoid.value = humanoid
        for index = 1, #children do bindings.onAdded(children[index]) end
    end
end
end)() :: unknown)

standaloneModules.createCombatShootTransfer = ((function()
type Values = { [string]: any }

return function(offset: unknown)
    return function(character: Values, targetCharacter: Values, root: Values, targetRoot: Values, wait: () -> ())
        while character.Parent and targetCharacter.Parent do
            root.CFrame = targetRoot.CFrame * offset
            wait()
        end
    end
end
end)() :: unknown)

standaloneModules.createCombatGunPredictionSelect = ((function()
type Values = { [string]: any }
local revert = 'Revert <font color="rgb(0, 255, 0)">(Exclusive)</font>'
local tiancai = 'Tiāncái <font color="rgb(0, 255, 0)">(Exclusive)</font>'
local ubuntu = 'Ubuntu <font color="rgb(0, 0, 255)">(Premium)</font>'
local electro = 'Electro <font color="rgb(0, 0, 255)">(Premium)</font>'
local rectum = 'Rectum <font color="rgb(0, 0, 255)">(Premium)</font>'
local premiumFallback = 'Only exclusive users can use this prediction type, changing to <font color="rgb(0, 0, 255)">Electro</font> prediction.'
local exclusiveFallback = 'Only premium users can use this prediction type, changing to <font color="rgb(0, 0, 255)">Revert</font> prediction.'
local missingPremium = 'Only premium users can use this prediction type, changing to <font color="rgb(0, 0, 255)">Remi</font> prediction.'
local missingExclusive = 'Only exclusive users can use this prediction type, changing to <font color="rgb(0, 0, 255)">Remi</font> prediction.'

return function(bindings: Values)
    return function(value: unknown)
        local wait = bindings.getWait()
        local control
        repeat
            control = bindings.control.value
            wait()
        until control
        if value == revert or value == tiancai then
            if bindings.exclusive then
                bindings.settings.GunSilentAimPrediction = if value == revert then "Revert" else "Tiāncái"
                return
            end
            if bindings.premium then
                bindings.getNotify()(premiumFallback, 2)
                control:Select(electro)
                return
            end
            bindings.getNotify()(missingExclusive, 2)
            control:Select("Remi")
            return
        end
        if value == ubuntu or value == electro or value == rectum then
            if bindings.premium then
                bindings.settings.GunSilentAimPrediction = if value == ubuntu then "Ubuntu" elseif value == electro then "Electro" else "Rectum"
                return
            end
            if bindings.exclusive then
                bindings.getNotify()(exclusiveFallback, 2)
                control:Select(revert)
                return
            end
            bindings.getNotify()(missingPremium, 2)
            control:Select("Remi")
            return
        end
        bindings.settings.GunSilentAimPrediction = value
    end
end
end)() :: unknown)

