standaloneModules.movementActions = ((function()
type Frame = typeof(setmetatable({}, { __mul = function(left, _right) return left end }))
type Humanoid = { Sit: unknown }
type Root = { CFrame: Frame }
type Cell = { value: unknown }

local function setFloatOffset(makeFrame: Cell, offset: Cell)
    return function(value: number)
        local frame = makeFrame.value :: (number, number, number) -> unknown
        offset.value = frame(0, -(value / 100), 0)
    end
end

local function sit(humanoid: Cell)
    return function()
        local current = humanoid.value :: Humanoid?

        if not current then
            return
        end

        current.Sit = true
    end
end

local function lay(humanoid: Cell, root: Cell, rotation: Frame)
    return function()
        local currentHumanoid = humanoid.value :: Humanoid?

        if not currentHumanoid then
            return
        end

        local currentRoot = root.value :: Root?

        if not currentRoot then
            return
        end

        currentHumanoid.Sit = true
        currentRoot.CFrame *= rotation
    end
end

return { floatOffset = setFloatOffset, sit = sit, lay = lay }
end)())

