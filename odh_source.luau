-- Record5593: favorites and emote cards arranged in groups of three.

type Item = { id: string | number, name: unknown }
type Context = {
    favoriteIds: { [unknown]: unknown },
    grid: unknown,
    gridEntries: { [unknown]: { unknown } },
    slot: number,
    getCreate: () -> ((string) -> unknown),
    write: (unknown, string, unknown) -> (),
    parent: unknown,
    gridSize: unknown,
}
type Selection = {
    getSelected: () -> unknown,
    setSelected: (boolean) -> (),
    getEntry: () -> unknown,
    setEntry: (unknown) -> (),
}

local layout = (layoutEmoteCard :: unknown) :: (unknown, unknown, unknown) -> { unknown }
local connect = (connectEmoteCard :: unknown) :: (unknown, { unknown }, unknown, Selection) -> ()

local function renderEmote(context: Context, item: Item, favorite: unknown)
    local id = item.id

    if not favorite and context.favoriteIds[id] then
        return
    end

    local name = item.name
    local suffix = id .. "&w=150&h=150"
    local emote = { id = id, name = name, thumbnail = "rbxthumb://type=Asset&id=" .. suffix }
    local selected: unknown = favorite
    local favoriteEntry: unknown = nil
    local entries

    if context.grid then
        entries = context.gridEntries[context.grid]
    end

    if not context.grid then
        local grid = context.getCreate()("Frame")
        context.grid = grid
        context.write(grid, "Name", "Grid")
        context.write(grid, "Parent", context.parent)
        context.write(grid, "BackgroundTransparency", 1)
        context.write(grid, "Size", context.gridSize)
        entries = {}
        context.gridEntries[grid] = entries
    end

    local parts = layout(context, emote, favorite)
    local selection = {
        getSelected = function() return selected end,
        setSelected = function(value: boolean) selected = value end,
        getEntry = function() return favoriteEntry end,
        setEntry = function(value: unknown) favoriteEntry = value end,
    }
    connect(context, parts, emote, selection)
    local entriesList = entries :: { unknown }
    local last = #entriesList + 1
    entriesList[last] = parts[1]
    entriesList[last + 1] = name
    context.slot += 1

    if context.slot == 3 then
        context.grid, context.slot = nil, 0
    end
end

return function(context: Context, items: { Item }, favorite: unknown)
    local count = #items

    for index = 1, count do
        renderEmote(context, items[index], favorite)
    end
end
