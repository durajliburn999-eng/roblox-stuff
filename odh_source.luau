standaloneModules.createCustomizationRefresh = ((function()
-- Recovered record1603. Refresh saved UI customizations.
type Presets = { [string]: unknown }
type Selector = { ChangeItems: (Selector, { string }) -> () }
type Bindings = {
    getClock: () -> (() -> number),
    getLastRefresh: () -> number,
    setLastRefresh: (number) -> (),
    getNotify: () -> ((string, number) -> ()),
    getFormat: () -> ((string, ...unknown) -> string),
    getNames: () -> { string },
    getPresets: () -> Presets,
    getSubstring: () -> ((string, number, number) -> string),
    decode: (string) -> unknown,
    getSelector: () -> Selector,
    getListFiles: () -> ((string) -> { string }),
    setEmpty: (boolean) -> (),
    getFallback: () -> { string },
    readFile: (string) -> string,
}

local function customizationName(path: string, substring: (string, number, number) -> string): string
    local prefix = substring(path, 1, #path - 5)
    local index, name = #prefix, ""

    while true do
        local character = substring(prefix, index, index)

        if character == "" or character == "/" or character == "\\" then
            return name
        end

        name = character .. name
        index -= 1
    end
end

return function(bindings: Bindings)
    return function()
        local now = bindings.getClock()()
        local elapsed = now - bindings.getLastRefresh()

        if elapsed < 5 then
            local notify = bindings.getNotify()
            local format = bindings.getFormat()
            local message = format('Slow down! Try again in <font color="rgb(0, 0, 255)">%.2f</font>', 5 - elapsed)
            notify(message, 2)
            return
        end

        bindings.setLastRefresh(now)
        local names, presets = bindings.getNames(), bindings.getPresets()
        local substring = bindings.getSubstring()

        for index = 1, #names do
            names[index] = nil
        end

        for key in bindings.getPresets() do
            presets[key] = nil
        end

        local files = bindings.getListFiles()("Ixry Shizuka/customs/ui_customizations")

        for index = 1, #files do
            local path = files[index]
            local length = #path
            local extension = substring(path, length - 4, length)

            if extension ~= ".json" then
                continue
            end

            local content = bindings.readFile(path)

            if #content < 5 then
                continue
            end

            local decoded = bindings.decode(content)

            if not decoded then
                continue
            end

            local name = customizationName(path, substring)
            names[#names + 1] = name
            presets[name] = decoded
        end

        local isEmpty = #names < 1
        bindings.setEmpty(isEmpty)
        local selector = bindings.getSelector()
        local changeItems = selector.ChangeItems
        local items = bindings.getNames()

        if isEmpty then
            items = bindings.getFallback()
        end

        changeItems(selector, items)
    end
end
end)())

standaloneModules.createRoleUpdater = ((function()
type PlayerData = {
    Role: string?,
    KnifeEnabled: unknown,
    GunEnabled: unknown,
    Perk: unknown,
    Dead: unknown,
    Killed: unknown,
}

type Player = { Character: unknown }
type PlayerRoles = { [string | number]: string? }
type PlayerPerks = { [string | number]: unknown }
type Roles = {
    Murderers: PlayerRoles,
    MurderersPerk: PlayerPerks,
    Sheriffs: PlayerRoles,
    Hero: boolean,
}
type PlayerDataMap = { [string]: PlayerData }
type State = { roles: Roles, roles_data: PlayerDataMap? }
type Bindings = {
    callbacks: { [Player]: (() -> ())? },
    getState: () -> State,
    fetch: (unknown) -> PlayerDataMap?,
    remote: unknown,
    setData: (PlayerDataMap) -> (),
    findPlayer: (string) -> Player?,
}

local function clearRoles(roles: Roles, murderers: PlayerRoles, perks: PlayerPerks, sheriffs: PlayerRoles)

    for key in murderers do
        murderers[key] = nil
        perks[key] = nil
    end

    for key in sheriffs do
        sheriffs[key] = nil
    end

    roles.Hero = false
end

local function classifyPlayer(
    roles: Roles,
    murderers: PlayerRoles,
    perks: PlayerPerks,
    sheriffs: PlayerRoles,
    name: string,
    data: PlayerData,
    murdererCount: number,
    sheriffCount: number
): (number, number)
    local role = data.Role

    if role == "Assassin" then
        return murdererCount, sheriffCount
    end

    if role == "Murderer" or data.KnifeEnabled then
        murdererCount += 1
        murderers[murdererCount] = name
        perks[murdererCount] = data.Perk
        return murdererCount, sheriffCount
    end

    if role == "Sheriff" or data.GunEnabled then
        sheriffCount += 1
        sheriffs[sheriffCount] = name
        return murdererCount, sheriffCount
    end

    if role == "Hero" then
        sheriffs[1] = name
        roles.Hero = true
    end

    return murdererCount, sheriffCount
end

return function(bindings: Bindings)
    return function(data: PlayerDataMap?)
        local callbacks = bindings.callbacks
        local roles = bindings.getState().roles
        local murderers = roles.Murderers
        local perks = roles.MurderersPerk
        local sheriffs = roles.Sheriffs

        if not data then
            data = bindings.fetch(bindings.remote)
        end

        clearRoles(roles, murderers, perks, sheriffs)

        if not data then
            return
        end

        bindings.setData(data)
        bindings.getState().roles_data = data
        local murdererCount = 0
        local sheriffCount = 0

        for name, playerData in data do
            if playerData.Dead or playerData.Killed then
                continue
            end

            local player = bindings.findPlayer(name)

            if not player or not player.Character then
                continue
            end

            local callback = callbacks[player]
            murdererCount, sheriffCount = classifyPlayer(roles, murderers, perks, sheriffs, name, playerData, murdererCount, sheriffCount)

            if callback then
                callback()
            end
        end
    end
end
end)())

standaloneModules.createMapTracker = ((function()
-- Track the current map, dropped gun, coins and round time.
type State = { GunDrop: unknown, Map: unknown, CoinContainer: unknown, RoundTime: unknown }
type MapSearch = { state: State, getAttribute: (unknown, string) -> unknown, findChild: (unknown, string) -> unknown, usesMapId: unknown }
type Bindings = {
    world: { RoundTimerPart: unknown },
    state: State,
    wait: (number) -> (),
    toNumber: (unknown) -> unknown,
    getAttribute: (unknown, string) -> unknown,
    initialized: () -> (),
    findChild: (unknown, string) -> unknown,
    getChildren: (unknown) -> { unknown },
    usesMapId: unknown,
}

local function findInitialMap(bindings: MapSearch, children: { unknown })
    local state = bindings.state
    local getAttribute = bindings.getAttribute
    local findChild = bindings.findChild

    if bindings.usesMapId then
        for index = 1, #children do
            local candidate = children[index]

            if getAttribute(candidate, "MapID") then
                state.GunDrop = findChild(candidate, "GunDrop")
                state.Map = candidate
                return
            end
        end

        return
    end

    for index = 1, #children do
        local candidate = children[index]

        if findChild(candidate, "CoinAreas") then
            state.GunDrop = findChild(candidate, "GunDrop")
            state.Map = candidate
            return
        end

        local container = findChild(candidate, "CoinContainer")

        if container then
            state.GunDrop = findChild(candidate, "GunDrop")
            state.Map = candidate
            state.CoinContainer = container
            return
        end
    end
end

local function findNextMap(bindings: MapSearch, children: { unknown })
    local state = bindings.state
    local getAttribute = bindings.getAttribute
    local findChild = bindings.findChild

    if bindings.usesMapId then
        for index = 1, #children do
            local candidate = children[index]

            if getAttribute(candidate, "MapID") then
                state.Map = candidate
                return
            end
        end

        return
    end

    for index = 1, #children do
        local candidate = children[index]

        if findChild(candidate, "CoinAreas") then
            state.Map = candidate
            return
        end
    end
end

return function(bindings: Bindings)
    return function()
        local world = bindings.world
        local state = bindings.state
        local wait = bindings.wait
        local toNumber = bindings.toNumber
        local getAttribute = bindings.getAttribute
        local initialized = bindings.initialized
        local findChild = bindings.findChild
        local getChildren = bindings.getChildren
        local search = { state = state, getAttribute = getAttribute, findChild = findChild, usesMapId = bindings.usesMapId }
        local timer = world.RoundTimerPart
        local children = getChildren(world)
        findInitialMap(search, children)
        initialized()

        while true do
            wait(0.5)
            local remaining = getAttribute(timer, "Time")
            state.RoundTime = toNumber(remaining)

            if not state.Map then
                children = getChildren(world)
                findNextMap(search, children)
            end

            if not state.CoinContainer then
                local map = state.Map

                if map then
                    state.CoinContainer = findChild(map, "CoinContainer")
                end
            end
        end
    end
end
end)())

standaloneModules.createItemDetails = ((function()
-- Record3944, family6966 variant15. Constant3822 was decoded as " - ".
type Bindings = {
    getWait: () -> (() -> ()),
    getRarity: () -> unknown,
    getCategories: () -> { [unknown]: { [unknown]: { [unknown]: unknown } } },
    show: (string) -> (),
    getValueType: () -> ((unknown) -> string),
    getNumber: () -> ((unknown) -> unknown),
    getJoin: () -> ((unknown, string) -> string),
}

local function formatDetails(name: unknown, details: { [unknown]: unknown }, valueType: (unknown) -> string, number: (unknown) -> unknown, join: (unknown, string) -> string): string
    local text = ('<u><font size="23">%*</font></u>'):format(name)

    for key, value in details do
        if valueType(value) == "table" then
            text ..= ("\n%*%* %*"):format(key, ":", join(value, " - "))
            continue
        end

        if number(value) then
            text ..= ('\n%*%* <font color="rgb(0, 0, 255)">%*</font>'):format(key, ":", value)
            continue
        end

        if value then
            text ..= ('\n%*%* <font color="rgb(0, 255, 0)">%*</font>'):format(key, ":", value)
        end
    end

    return text
end

return function(bindings: Bindings)
    return function(name: unknown)
        local waitForData = bindings.getWait()
        local rarity

        repeat
            rarity = bindings.getRarity()
            waitForData()
        until rarity

        local category = bindings.getCategories()[rarity]

        if not category then
            return
        end

        local details = category[name]

        if not details then
            bindings.show("Not Found")
            return
        end

        local valueType = bindings.getValueType()
        local number = bindings.getNumber()
        local join = bindings.getJoin()
        local text = formatDetails(name, details, valueType, number, join)
        bindings.show(text)
    end
end
end)())

standaloneModules.createTradeValues = ((function()
-- Record5748, family6966 variant178: four trade slots and their total.
type Weapon = { Image: unknown, Chroma: unknown, Rarity: string, ItemName: string, ItemType: string }
type Details = { name: string, chroma: unknown, value: number? }
type Label = { Text: string }
type Bindings = {
    getItems: () -> { Weapon }?,
    getNumber: () -> ((unknown) -> number?),
    getPanels: () -> { { [number]: unknown } },
    cache: { [unknown]: Weapon },
    getStripBust: () -> ((string, string, string) -> unknown),
    getValues: () -> { [string]: { [string]: { Value: unknown } } },
    getMatch: () -> ((string, string) -> unknown),
    totals: { [number]: number },
    getSide: () -> number,
    getTotalLabel: () -> Label,
}

local function resolveWeapon(bindings: Bindings, panel: { [number]: unknown }): Weapon?
    local cache = bindings.cache
    -- These original lookups can invoke UI proxy accessors even though unused.
    local _unused = panel[2]
    _unused = panel[3]
    local image = panel[4] :: { Image: string }
    local stripBust = bindings.getStripBust()
    local identifier = stripBust(image.Image, "&bust=(%d+)", "")
    local weapon = cache[identifier]

    if weapon then
        return weapon
    end

    for _, entry in bindings.getItems() :: { Weapon } do
        if entry.Image == identifier then
            cache[identifier] = entry
            return entry
        end
    end

    return nil
end

local function categoryName(chroma: unknown, rarity: string): string
    if chroma or rarity == "Godly" then
        return "Godlies"
    end

    if rarity == "Legendary" then
        return "Legendaries"
    end

    return rarity .. "s"
end

local function valueOf(bindings: Bindings, number: (unknown) -> number?, weapon: Weapon): Details?
    local chroma = weapon.Chroma
    local rarity = weapon.Rarity
    local name = weapon.ItemName
    local category = categoryName(chroma, rarity)
    local values = bindings.getValues()[category]

    if not values then
        return nil
    end

    local details = values[name]

    if details then
        return { name = name, chroma = chroma, value = number(details.Value) }
    end

    local suffix = weapon.ItemType .. ")"
    local key = " (" .. suffix
    key = name .. key
    details = values[key]

    if details then
        return { name = name, chroma = chroma, value = number(details.Value) }
    end

    return { name = name, chroma = chroma, value = 1 }
end

local function writeWeaponLabel(label: Label, details: Details)
    if details.chroma then
        label.Text = ('Name: <font color="rgb(0, 255, 0)">Chroma %*</font>\nValue: <font color="rgb(0, 0, 255)">%*</font>'):format(details.name, details.value)
        return
    end

    label.Text = ('Name: <font color="rgb(0, 255, 0)">%*</font>\nValue: <font color="rgb(0, 0, 255)">%*</font>'):format(details.name, details.value)
end

local function readQuantity(bindings: Bindings, number: (unknown) -> number?, panel: { [number]: unknown }): number?
    local quantity = panel[5] :: { Visible: unknown, Text: string }

    if not quantity.Visible then
        return 1
    end

    local match = bindings.getMatch()
    return number(match(quantity.Text, "(%d+)"))
end

local function writeTotal(bindings: Bindings, total: number)
    local totals = bindings.totals
    local side = bindings.getSide()
    local otherSide = 1

    if side == 1 then
        otherSide = 2
    end

    local otherTotal = totals[otherSide]
    totals[side] = total
    local result = '<font color="rgb(255, 255, 255)">(Tie)</font>'

    if total ~= otherTotal then
        result = '<font color="rgb(255, 0, 0)">(Lose)</font>'

        if total < otherTotal then
            result = '<font color="rgb(0, 255, 0)">(Win)</font>'
        end
    end

    local label = bindings.getTotalLabel()
    label.Text = ('Total Value: <font color="rgb(0, 0, 255)">%*</font> %*'):format(total, result)
end

return function(bindings: Bindings)
    return function()
        if not bindings.getItems() then
            return
        end

        local number = bindings.getNumber()
        local panels = bindings.getPanels()
        local total = 0

        for index = 1, 4 do
            local panel = panels[index]
            local frame = panel[1] :: { Visible: unknown }

            if not frame.Visible then
                continue
            end

            local weapon = resolveWeapon(bindings, panel)

            if not weapon then
                return
            end

            local details = valueOf(bindings, number, weapon)

            if not details then
                continue
            end

            writeWeaponLabel(panel[6] :: Label, details)
            local quantity = readQuantity(bindings, number, panel)

            for _ = 1, quantity :: number do
                total += details.value :: number
            end
        end

        writeTotal(bindings, total)
    end
end
end)())

standaloneModules.createTradeMonitor = ((function()
type Node = { [string]: unknown }
type Cell = { value: unknown }
type Bindings = {
    startedAt: Cell,
    checking: Cell,
    enabled: Cell,
    ready: Cell,
    findChild: (unknown, string) -> Node?,
    playerGui: unknown,
    stringify: (unknown) -> string,
}
type Context = {
    parentKey: string,
    defaultError: unknown,
    firstGui: string,
    secondGui: string,
    enabledKey: string,
    fullNamePrefix: string,
    classKey: string,
    guiClass: string,
    detectionMessage: unknown,
    containerName: string,
    containerClass: string,
    visibleKey: string,
    transparencyKey: string,
    sizeKey: string,
    size: string,
    positionKey: string,
    position: string,
    wait: (number) -> (),
    protected: { [string]: unknown },
    cleanupFirst: (unknown) -> (),
    firstResource: unknown,
    cleanupSecond: (unknown) -> (),
    secondResource: unknown,
    exit: (unknown) -> (),
    clock: () -> number,
    format: (unknown, unknown) -> unknown,
    fullName: (Node?) -> string,
}

local function stop(context: Context, message: unknown)
    context.cleanupFirst(context.firstResource)
    context.cleanupSecond(context.secondResource)
    context.exit(message)
end

local function checkGui(bindings: Bindings, context: Context, name: string, count: number, hidden: boolean, ready: unknown): (number, boolean, boolean)
    local gui = bindings.findChild(bindings.playerGui, name)
    local nextHidden = if gui and gui[context.enabledKey] then false else hidden
    local invalid = if gui then gui[context.parentKey] ~= bindings.playerGui else true

    if invalid or context.fullName(gui) ~= context.fullNamePrefix .. name or (gui :: Node)[context.classKey] ~= context.guiClass then
        if not bindings.enabled.value then
            return 0, nextHidden, false
        end

        count += 1

        if count > 4 then
            context.cleanupFirst(context.firstResource)
            context.cleanupSecond(context.secondResource)
            context.exit(context.format(context.detectionMessage, ready))
            return count, nextHidden, true
        end
    end

    local container = bindings.findChild(gui, context.containerName)
    local validContainer = container
        and container[context.classKey] == context.containerClass
        and container[context.visibleKey]
        and (container[context.transparencyKey] :: number) < 0.15
        and bindings.stringify(container[context.sizeKey]) == context.size
        and bindings.stringify(container[context.positionKey]) == context.position

    if validContainer or not bindings.enabled.value then
        return 0, nextHidden, false
    end

    count += 1

    if count > 4 then
        context.cleanupFirst(context.firstResource)
        context.cleanupSecond(context.secondResource)
        context.exit(context.format(context.detectionMessage, ready))
        return count, nextHidden, true
    end

    return count, nextHidden, false
end

return function(bindings: Bindings)
    return function(context: Context)
        local count = 0

        while true do
            context.wait(0.5)

            if context.clock() - (bindings.startedAt.value :: number) < 2 then
                continue
            end

            local checking = bindings.checking.value
            local invalid = checking

            if checking then
                local protected = context.protected[context.parentKey]
                invalid = if protected then not bindings.enabled.value else not protected
            end

            if invalid then
                count += 1

                if count > 4 then
                    stop(context, context.defaultError)
                    return
                end
            end

            local ready = bindings.ready.value

            if not ready and bindings.enabled.value then
                count += 1

                if count > 4 then
                    stop(context, context.defaultError)
                    return
                end
            end

            local hidden = true
            local stopped: boolean
            count, hidden, stopped = checkGui(bindings, context, context.firstGui, count, hidden, ready)

            if stopped then
                return
            end

            count, hidden, stopped = checkGui(bindings, context, context.secondGui, count, hidden, ready)

            if stopped then
                return
            end

            if if bindings.enabled.value then not hidden else not bindings.enabled.value then
                count = 0
                continue
            end

            count += 1

            if count > 4 then
                context.cleanupFirst(context.firstResource)
                context.cleanupSecond(context.secondResource)
                context.exit(context.format(context.detectionMessage, ready))
                return
            end
        end
    end
end
end)())

standaloneModules.createTradeLifecycle = ((function()
type Cell = { value: unknown }
type Remote = { Parent: unknown }
type Bindings = {
    oldAccept: Remote,
    newAccept: Remote,
    trade: unknown,
    active: Cell,
    partner: Cell,
    other: Cell,
    last: Cell,
    timestamp: Cell,
    getString: () -> ((unknown) -> string),
    getClock: () -> (() -> number),
    getPlayer: () -> unknown,
    decline: unknown,
    fire: (unknown) -> (),
    destroy: (unknown) -> (),
    report: (string) -> (),
}

return function(bindings: Bindings)
    local oldAccept, newAccept, trade = bindings.oldAccept, bindings.newAccept, bindings.trade
    local active, partner, other, last, timestamp = bindings.active, bindings.partner, bindings.other, bindings.last, bindings.timestamp

    local function start(_: unknown, second: unknown)
        oldAccept.Parent = nil
        newAccept.Parent = trade
        active.value = true
        partner.value = bindings.getString()(second)
        timestamp.value = bindings.getClock()()
        last.value = nil
    end

    local function decline()
        oldAccept.Parent = nil
        newAccept.Parent = trade
        local now = bindings.getClock()()
        timestamp.value, active.value, partner.value, other.value, last.value = now, nil, nil, nil, nil
    end

    local function update(data: unknown)
        if not active.value then
            return
        end

        local contents = data :: { Player1: { Player: unknown, Offer: unknown }, Player2: { Offer: unknown } }
        local first = contents.Player1
        other.value = if first.Player == bindings.getPlayer() then first.Offer else contents.Player2.Offer
        if not partner.value then
            bindings.fire(bindings.decline)
            bindings.destroy(trade)
            bindings.report('An unexpected error had occurred.\n\nError Code: <font color="rgb(255, 0, 0)">3</font>')
            return
        end

        oldAccept.Parent = trade
        newAccept.Parent = nil
        timestamp.value = bindings.getClock()()
        last.value = true
    end

    return { start = start, decline = decline, update = update }
end
end)())

standaloneModules.createTradeHistory = ((function()
type Values = { [string]: unknown }
type CatalogItem = { ItemName: string, ItemType: string }
type Catalog = { [string]: CatalogItem }
type Field = { name: string, value: string }
type Payload = {
    content: string,
    embeds: { { title: string, description: string, color: number, fields: { Field } } },
}
type Trade = { ownOffer: unknown, partnerOffer: unknown, partner: string }
type Bindings = {
    settings: Values,
    items: Catalog,
    playerName: string,
    getOwner: () -> Values,
    notify: (string, number) -> (),
    remember: ((Payload) -> ())?,
}

local function describeOffer(offer: unknown, catalog: Catalog): string?
    if type(offer) ~= "table" or type(catalog) ~= "table" then return nil end
    local entries = offer :: { { unknown } }
    for index in entries do
        if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #entries then return nil end
    end
    if #entries == 0 then return "\n- (NO ITEMS)" end

    local lines: { string } = {}
    for index = 1, #entries do
        local entry = entries[index]
        if type(entry) ~= "table" then return nil end
        local identifier, quantity = entry[1], entry[2]
        if type(identifier) ~= "string" then return nil end
        if type(quantity) ~= "number" and type(quantity) ~= "string" then return nil end
        local amount = tonumber(quantity)
        if not amount or amount <= 0 or amount >= math.huge or amount % 1 ~= 0 then return nil end
        local item = catalog[identifier]
        if type(item) ~= "table" or type(item.ItemName) ~= "string" or type(item.ItemType) ~= "string" then return nil end

        lines[#lines + 1] = ("\n- x%* **%*** (%*)"):format(quantity, item.ItemName, item.ItemType)
    end

    return table.concat(lines)
end

local function buildPayload(bindings: Bindings, trade: Trade, owner: Values): Payload?
    local ownDescription = describeOffer(trade.ownOffer, bindings.items)
    local partnerDescription = describeOffer(trade.partnerOffer, bindings.items)
    if not ownDescription or not partnerDescription then return nil end

    local content = ""
    if bindings.settings.TradeHistory_PingUser and owner.Discord_ID ~= nil then
        content = ("<@%*>"):format(owner.Discord_ID)
    end

    return {
        content = content,
        embeds = { {
            title = "Overdrive H - Trade History",
            description = "Trade Status: **Complete**",
            color = 255,
            fields = {
                { name = "Player 1:", value = ("Player: **%***\nOffers: %s"):format(bindings.playerName, ownDescription) },
                { name = "Player 2:", value = ("Player: **%***\nOffers: %s"):format(trade.partner, partnerDescription) },
            },
        } },
    }
end

return function(bindings: Bindings): (Trade) -> Payload?
    return function(trade: Trade): Payload?
        local owner = bindings.getOwner()
        local payload = buildPayload(bindings, trade, owner)
        if not payload then
            bindings.notify("An error occurred while sending data.", 2)
            return nil
        end

        if bindings.remember then bindings.remember(payload) end
        local encode = owner.json_encode :: (Payload) -> string?
        local request = owner.REQ :: (unknown, string, unknown, string) -> unknown
        local encoded, body = pcall(encode, payload)
        if not encoded or type(body) ~= "string" then
            bindings.notify("An error occurred while sending data.", 2)
            return nil
        end

        -- REQ belongs to the existing local adapter; webhook requests remain stubbed.
        local sent, response = pcall(request, bindings.settings.TradeHistory_Webhook, "POST", nil, body)
        if not sent or response ~= "" then
            bindings.notify("An error occurred while sending data.", 2)
            return nil
        end

        bindings.notify("Webhook sending is disabled in this local build.", 1)
        return payload
    end
end
end)())

standaloneModules.createTradeAccept = ((function()
