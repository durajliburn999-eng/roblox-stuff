standaloneModules.setupTransferStartup = ((function()
local createTransfer = createTransferProgress
local createDeferred = createDeferredDispatch
local template = standaloneModules.transferTemplate

type Values = { [string]: any }

return function(bindings: Values)
    local environment, state, owner = bindings.environment, bindings.state, bindings.owner
    local enabled: { value: unknown } = { value = nil }
    local submit = environment.queue_on_teleport
    local transfer = createTransfer({ isEnabled = function() return enabled.value end, getSubmit = function() return submit end,
        settings = state, format = environment.string.format, clock = environment.os.time,
        sign = function(value: string) return owner.AES(value) end, getTemplate = function() return template :: string end,
        substring = environment.string.sub })
    bindings.connect(bindings.player.OnTeleport, transfer)

    local game = environment.game
    local teleportService = game:FindService("TeleportService") or game:GetService("TeleportService")
    local prompt = bindings.find(bindings.coreGui, "RobloxPromptGui")
    local overlay = bindings.find(prompt, "promptOverlay")
    local deferred = createDeferred({ setResult = function(value: unknown) enabled.value = value end })
    local dispatch = teleportService.Teleport
    local placeId = game.PlaceId
    local task = bindings.spawn(deferred, "ErrorPrompt", "AutoFarm", "FarmMisc_AutoRejoin", state, bindings.wait,
        bindings.player, overlay, bindings.find, teleportService, dispatch, placeId)
    return { enabled = enabled, transfer = transfer, deferred = deferred, task = task }
end
end)() :: unknown)

